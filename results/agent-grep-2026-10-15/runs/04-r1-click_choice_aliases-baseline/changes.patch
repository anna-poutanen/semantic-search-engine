diff --git a/tests/test_choice_aliases.py b/tests/test_choice_aliases.py
new file mode 100644
index 0000000..6e50e52
--- /dev/null
+++ b/tests/test_choice_aliases.py
@@ -0,0 +1,234 @@
+from collections import UserDict
+from types import MappingProxyType
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize("mapping_type", [dict, UserDict, MappingProxyType])
+def test_aliases_are_copied(mapping_type):
+    source = {"quick": "fast"}
+    aliases = mapping_type(source)
+    choice = click.Choice(["fast", "slow"], aliases=aliases)
+    mutable_aliases = source if mapping_type is MappingProxyType else aliases
+    mutable_aliases["quick"] = "slow"
+    mutable_aliases["new"] = "fast"
+
+    assert choice.convert("quick", None, None) == "fast"
+
+    with pytest.raises(click.BadParameter):
+        choice.convert("new", None, None)
+
+
+@pytest.mark.parametrize(
+    "aliases",
+    [False, 0, "", "quick", [], [("quick", "fast")], {"quick"}],
+)
+def test_aliases_must_be_a_mapping(aliases):
+    with pytest.raises(ValueError):
+        click.Choice(["fast", "slow"], aliases=aliases)
+
+
+@pytest.mark.parametrize(
+    "aliases",
+    [
+        {1: "fast"},
+        {None: "fast"},
+        {b"quick": "fast"},
+        {"quick": 1},
+        {"quick": None},
+        {"quick": b"fast"},
+        {"quick": []},
+        {"quick": "missing"},
+        {"quick": "FAST"},
+        {"quick": "other-alias", "other-alias": "fast"},
+    ],
+)
+def test_aliases_require_string_names_and_exact_targets(aliases):
+    with pytest.raises(ValueError):
+        click.Choice(["fast", "slow"], case_sensitive=False, aliases=aliases)
+
+
+def test_alias_target_requires_a_choice():
+    with pytest.raises(ValueError):
+        click.Choice([], aliases={"quick": "fast"})
+
+
+@pytest.mark.parametrize("parameter_type", [click.Option, click.Argument])
+def test_alias_returns_original_choice(runner, parameter_type):
+    class ChoiceString(str):
+        pass
+
+    canonical = ChoiceString("fast")
+    choice = click.Choice([canonical, "slow"], aliases={"quick": "fast"})
+    names = ["--mode"] if parameter_type is click.Option else ["mode"]
+    cli = click.Command(
+        "cli",
+        params=[parameter_type(names, type=choice)],
+        callback=lambda mode: mode,
+    )
+    args = ["--mode", "quick"] if parameter_type is click.Option else ["quick"]
+    result = runner.invoke(cli, args, standalone_mode=False)
+
+    assert result.exception is None
+    assert result.return_value is canonical
+    assert choice.convert("fast", None, None) is canonical
+
+
+@pytest.mark.parametrize("case_sensitive", [True, False])
+def test_alias_case_sensitivity(case_sensitive):
+    choice = click.Choice(
+        ["fast"], case_sensitive=case_sensitive, aliases={"Straße": "fast"}
+    )
+    assert choice.convert("Straße", None, None) == "fast"
+
+    if case_sensitive:
+        with pytest.raises(click.BadParameter):
+            choice.convert("STRASSE", None, None)
+    else:
+        assert choice.convert("STRASSE", None, None) == "fast"
+
+
+@pytest.mark.parametrize("value", ["X-ß", "q_SS", "Fast-Mode", "FAST_MODE"])
+def test_token_normalization_precedes_casefold(value):
+    choice = click.Choice(
+        ["Fast-Mode"], case_sensitive=False, aliases={"X-ß": "Fast-Mode"}
+    )
+    ctx = click.Context(
+        click.Command("cli"),
+        token_normalize_func=lambda v: v.replace("X", "q").replace("-", "_"),
+    )
+
+    assert choice.convert(value, None, ctx) == "Fast-Mode"
+
+
+@pytest.mark.parametrize(
+    ("aliases", "case_sensitive", "normalize"),
+    [
+        ({"fast": "slow"}, True, None),
+        ({"FAST": "slow"}, False, None),
+        ({"Quick": "fast", "quick": "slow"}, False, None),
+        ({"Straße": "fast", "STRASSE": "slow"}, False, None),
+        ({"f-ast": "slow"}, True, lambda v: v.replace("-", "")),
+        (
+            {"q-uick": "fast", "quick": "slow"},
+            True,
+            lambda v: v.replace("-", ""),
+        ),
+        (
+            {"Q-uick": "fast", "quick": "slow"},
+            False,
+            lambda v: v.replace("-", ""),
+        ),
+    ],
+)
+@pytest.mark.parametrize("value", ["fast", "slow", "missing"])
+def test_conflicting_aliases_fail_during_conversion(
+    aliases, case_sensitive, normalize, value
+):
+    choice = click.Choice(
+        ["fast", "slow"], case_sensitive=case_sensitive, aliases=aliases
+    )
+    param = click.Option(["--mode"], type=choice)
+    ctx = click.Context(click.Command("cli"), token_normalize_func=normalize)
+
+    with pytest.raises(click.BadParameter, match="conflict") as exc_info:
+        choice.convert(value, param, ctx)
+
+    assert exc_info.value.param is param
+    assert exc_info.value.ctx is ctx
+
+
+@pytest.mark.parametrize("target", ["Fast", "fast"])
+def test_alias_is_checked_against_every_canonical_choice(target):
+    choice = click.Choice(
+        ["Fast", "fast"], case_sensitive=False, aliases={"FAST": target}
+    )
+
+    with pytest.raises(click.BadParameter):
+        choice.convert("FAST", None, None)
+
+
+@pytest.mark.parametrize("value", ["fast", "FAST", "quick", "Q-UICK"])
+def test_collisions_with_the_same_target_are_allowed(value):
+    choice = click.Choice(
+        ["fast", "slow"],
+        case_sensitive=False,
+        aliases={"FAST": "fast", "Quick": "fast", "q-uick": "fast"},
+    )
+    ctx = click.Context(
+        click.Command("cli"), token_normalize_func=lambda v: v.replace("-", "")
+    )
+
+    assert choice.convert(value, None, ctx) == "fast"
+
+
+def test_alias_collisions_depend_on_the_current_context():
+    choice = click.Choice(
+        ["fast", "slow"], aliases={"q-uick": "fast", "quick": "slow"}
+    )
+    ctx = click.Context(
+        click.Command("cli"), token_normalize_func=lambda v: v.replace("-", "")
+    )
+
+    assert choice.convert("q-uick", None, None) == "fast"
+
+    with pytest.raises(click.BadParameter):
+        choice.convert("quick", None, ctx)
+
+    assert choice.convert("quick", None, None) == "slow"
+
+
+@pytest.mark.parametrize("aliases", [None, {}])
+def test_no_aliases_preserves_existing_normalized_choice_behavior(aliases):
+    choice = click.Choice(["Fast", "fast"], case_sensitive=False, aliases=aliases)
+
+    assert choice.convert("FAST", None, None) == "fast"
+
+
+@pytest.mark.parametrize("aliases", [None, {}])
+def test_no_aliases_preserves_two_stage_normalization_order(aliases):
+    choice = click.Choice(["A", "a", "A "], case_sensitive=False, aliases=aliases)
+    ctx = click.Context(click.Command("cli"), token_normalize_func=str.strip)
+
+    assert choice.convert("A", None, ctx) == "a"
+
+
+@pytest.mark.parametrize("choices", [["fast"], ["fast", "slow"]])
+@pytest.mark.parametrize("parameter_type", [click.Option, click.Argument])
+@pytest.mark.parametrize("args", [["--help"], ["missing"], []])
+def test_help_and_errors_show_only_canonical_choices(
+    runner, choices, parameter_type, args
+):
+    names = ["--mode"] if parameter_type is click.Option else ["mode"]
+    if parameter_type is click.Option and args == ["missing"]:
+        args = ["--mode", "missing"]
+
+    def invoke(aliases):
+        param = parameter_type(
+            names, type=click.Choice(choices, aliases=aliases), required=True
+        )
+        return runner.invoke(click.Command("cli", params=[param]), args)
+
+    expected = invoke(None)
+    result = invoke({"quick": "fast"})
+
+    assert result.exit_code == expected.exit_code == (0 if args == ["--help"] else 2)
+    assert result.output == expected.output
+    assert "quick" not in result.output
+
+
+@pytest.mark.parametrize("case_sensitive", [True, False])
+@pytest.mark.parametrize(
+    ("incomplete", "expected"), [("", ["fast", "slow"]), ("f", ["fast"]), ("q", [])]
+)
+def test_completion_shows_only_canonical_choices(case_sensitive, incomplete, expected):
+    choice = click.Choice(
+        ["fast", "slow"], case_sensitive=case_sensitive, aliases={"quick": "fast"}
+    )
+    param = click.Option(["--mode"], type=choice)
+    ctx = click.Context(click.Command("cli"))
+
+    completions = choice.shell_complete(ctx, param, incomplete)
+    assert [item.value for item in completions] == expected
