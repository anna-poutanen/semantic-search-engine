diff --git a/tests/test_session_timeout.py b/tests/test_session_timeout.py
new file mode 100644
index 0000000..01ff520
--- /dev/null
+++ b/tests/test_session_timeout.py
@@ -0,0 +1,206 @@
+"""Regression tests for session-wide timeout defaults."""
+
+import pickle
+import threading
+
+import pytest
+from urllib3.util import Timeout as Urllib3Timeout
+
+import requests
+from requests.adapters import BaseAdapter
+
+from .testserver.server import Server
+
+URL = "http://127.0.0.1/"
+METHODS = ("get", "options", "head", "post", "put", "patch", "delete")
+ENTRY_POINTS = ("request", *METHODS, "send")
+TIMEOUTS = (None, 4, 1.5, (2, 7), (None, 7), Urllib3Timeout(connect=2, read=7))
+
+
+class RecordingAdapter(BaseAdapter):
+    def __init__(self, redirects=0):
+        self.timeouts = []
+        self.redirects = redirects
+
+    def send(self, request, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        response = requests.Response()
+        response.request = request
+        response.url = request.url
+        response._content = b""
+        if len(self.timeouts) <= self.redirects:
+            response.status_code = 302
+            response.headers["Location"] = f"/redirect/{len(self.timeouts)}"
+        else:
+            response.status_code = 200
+        return response
+
+    def close(self):
+        pass
+
+
+@pytest.fixture
+def adapter():
+    return RecordingAdapter()
+
+
+@pytest.fixture
+def session(adapter):
+    with requests.Session() as session:
+        session.trust_env = False
+        session.mount("http://", adapter)
+        yield session
+
+
+def send_request(session, entry_point, **kwargs):
+    if entry_point == "request":
+        return session.request("GET", URL, **kwargs)
+    if entry_point == "send":
+        request = session.prepare_request(requests.Request("GET", URL))
+        return session.send(request, **kwargs)
+    return getattr(session, entry_point)(URL, **kwargs)
+
+
+def test_default_timeout_is_unlimited(session, adapter):
+    assert session.timeout is None
+    session.get(URL)
+    assert adapter.timeouts == [None]
+
+
+@pytest.mark.parametrize("timeout", TIMEOUTS)
+@pytest.mark.parametrize("entry_point", ENTRY_POINTS)
+def test_constructor_timeout_is_inherited(adapter, timeout, entry_point):
+    with requests.Session(timeout=timeout) as session:
+        session.trust_env = False
+        session.mount("http://", adapter)
+        assert session.timeout is timeout
+        assert send_request(session, entry_point).status_code == 200
+        assert adapter.timeouts == [timeout]
+
+
+@pytest.mark.parametrize("entry_point", ENTRY_POINTS)
+def test_mutating_timeout_changes_subsequent_requests(session, adapter, entry_point):
+    for timeout in TIMEOUTS:
+        session.timeout = timeout
+        send_request(session, entry_point)
+        assert adapter.timeouts[-1] is timeout
+
+
+@pytest.mark.parametrize("timeout", (*TIMEOUTS, 0))
+@pytest.mark.parametrize("entry_point", ENTRY_POINTS)
+def test_explicit_timeout_overrides_without_mutation(
+    session, adapter, timeout, entry_point
+):
+    session.timeout = (3, 9)
+    send_request(session, entry_point, timeout=timeout)
+    assert adapter.timeouts[-1] is timeout
+    assert session.timeout == (3, 9)
+    send_request(session, entry_point)
+    assert adapter.timeouts == [timeout, (3, 9)]
+
+
+@pytest.mark.parametrize("entry_point", ENTRY_POINTS)
+@pytest.mark.parametrize("kwargs", ({}, {"timeout": None}, {"timeout": (1, 5)}))
+@pytest.mark.parametrize("default_timeout", (None, 4, (2, 7)))
+def test_redirects_keep_initial_timeout(
+    session, adapter, entry_point, kwargs, default_timeout
+):
+    adapter.redirects = 2
+    session.timeout = default_timeout
+    effective_timeout = kwargs.get("timeout", default_timeout)
+    hook_timeouts = []
+
+    def change_default(response, **kwargs):
+        hook_timeouts.append(kwargs["timeout"])
+        session.timeout = 99
+
+    session.hooks["response"].append(change_default)
+    response = send_request(session, entry_point, allow_redirects=True, **kwargs)
+    assert response.status_code == 200
+    assert len(response.history) == 2
+    assert adapter.timeouts == [effective_timeout] * 3
+    assert hook_timeouts == [effective_timeout] * 3
+
+
+@pytest.mark.parametrize("timeout", (None, 4, (2, 7)))
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize("entry_point", ("request", "send"))
+def test_timeout_survives_pickling(timeout, protocol, entry_point):
+    with requests.Session(timeout=1) as original:
+        original.timeout = timeout
+        restored = pickle.loads(pickle.dumps(original, protocol=protocol))
+    with restored:
+        assert restored.timeout == timeout
+        restored.trust_env = False
+        adapter = RecordingAdapter()
+        restored.mount("http://", adapter)
+        send_request(restored, entry_point)
+        assert adapter.timeouts == [timeout]
+
+
+def test_loading_state_without_timeout_is_unlimited(session, adapter):
+    state = session.__getstate__()
+    state.pop("timeout")
+    restored = requests.Session.__new__(requests.Session)
+    restored.__setstate__(state)
+    assert restored.timeout is None
+    restored.get(URL)
+    assert adapter.timeouts == [None]
+
+
+@pytest.mark.parametrize("entry_point", ("request", *METHODS))
+@pytest.mark.parametrize("kwargs", ({}, {"timeout": None}, {"timeout": (1, 5)}))
+def test_module_helpers_preserve_timeout_behavior(
+    monkeypatch, adapter, entry_point, kwargs
+):
+    monkeypatch.setattr(requests.Session, "get_adapter", lambda self, url: adapter)
+    if entry_point == "request":
+        response = requests.request("GET", URL, **kwargs)
+    else:
+        response = getattr(requests, entry_point)(URL, **kwargs)
+    assert response.status_code == 200
+    assert adapter.timeouts == [kwargs.get("timeout")]
+
+
+@pytest.mark.parametrize("entry_point", ("request", "send"))
+@pytest.mark.parametrize("timeout", (0, -1, "invalid", (1, 2, 3)))
+def test_invalid_session_timeout_is_rejected_by_http_adapter(entry_point, timeout):
+    with requests.Session(timeout=timeout) as session:
+        session.trust_env = False
+        with pytest.raises(ValueError):
+            send_request(session, entry_point)
+
+
+@pytest.mark.parametrize("entry_point", ("request", "send"))
+@pytest.mark.parametrize("timeout", TIMEOUTS)
+def test_http_adapter_accepts_session_timeout(httpbin, entry_point, timeout):
+    with requests.Session(timeout=timeout) as session:
+        session.trust_env = False
+        url = httpbin("get")
+        if entry_point == "request":
+            response = session.request("GET", url)
+        else:
+            response = session.send(requests.Request("GET", url).prepare())
+        assert response.status_code == 200
+
+
+@pytest.mark.parametrize("entry_point", ("request", "send"))
+def test_session_timeout_is_enforced_by_http_adapter(entry_point):
+    release_response = threading.Event()
+
+    def delayed_response(sock):
+        release_response.wait(2)
+        sock.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
+
+    with Server(delayed_response, host="127.0.0.1") as (host, port):
+        with requests.Session(timeout=(1, 0.1)) as session:
+            session.trust_env = False
+            url = f"http://{host}:{port}/"
+            try:
+                with pytest.raises(requests.exceptions.ReadTimeout):
+                    if entry_point == "request":
+                        session.request("GET", url)
+                    else:
+                        session.send(requests.Request("GET", url).prepare())
+            finally:
+                release_response.set()
