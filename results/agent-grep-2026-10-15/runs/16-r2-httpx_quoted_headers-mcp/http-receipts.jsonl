    get_header_key = key.lower().encode(self.encoding)\n\n        values = [\n            item_value.decode(self.encoding)\n            for _, item_key, item_value in self._list\n            if item_key.lower() == get_header_key\n        ]\n\n        if not split_commas:\n            return values\n\n        split_values = []\n        for value in values:\n            split_values.extend([item.strip() for item in value.split(\",\")])\n        return split_values\n", "content_hash": "c8a896e7cff95231c3871cd977c2f35c799c574615df84393b0c2aec25ae8c10", "source_hash": "c8a896e7cff95231c3871cd977c2f35c799c574615df84393b0c2aec25ae8c10", "retrieval_score": 0.8327822238206863, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "httpx/_models.py:Headers.__getitem__:284-302", "path": "httpx/_models.py", "symbol": "Headers.__getitem__", "start_line": 284, "end_line": 302, "window_end_line": 302, "source": "    def __getitem__(self, key: str) -> str:\n        \"\"\"\n        Return a single header value.\n\n        If there are multiple headers with the same key, then we concatenate\n        them with commas. See: https://tools.ietf.org/html/rfc7230#section-3.2.2\n        \"\"\"\n        normalized_key = key.lower().encode(self.encoding)\n\n        items = [\n            header_value.decode(self.encoding)\n            for _, header_key, header_value in self._list\n            if header_key == normalized_key\n        ]\n\n        if items:\n            return \", \".join(items)\n\n        raise KeyError(key)\n", "content_hash": "7c220df74e99968a848c1bf3b88f363f98a351dc779857f61f8482d90dbf686d", "source_hash": "7c220df74e99968a848c1bf3b88f363f98a351dc779857f61f8482d90dbf686d", "retrieval_score": 0.7014581263065338, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "httpx/_models.py:Headers.items:216-229", "path": "httpx/_models.py", "symbol": "Headers.items", "start_line": 216, "end_line": 229, "window_end_line": 229, "source": "    def items(self) -> typing.ItemsView[str, str]:\n        \"\"\"\n        Return `(key, value)` items of headers. Concatenate headers\n        into a single comma separated value when a key occurs multiple times.\n        \"\"\"\n        values_dict: dict[str, str] = {}\n        for _, key, value in self._list:\n            str_key = key.decode(self.encoding)\n            str_value = value.decode(self.encoding)\n            if str_key in values_dict:\n                values_dict[str_key] += f\", {str_value}\"\n            else:\n                values_dict[str_key] = str_value\n        return values_dict.items()\n", "content_hash": "b8308a0eeaa3c71c50299db32d91d410893241af0c03d721cf2b677bcc84b0e0", "source_hash": "b8308a0eeaa3c71c50299db32d91d410893241af0c03d721cf2b677bcc84b0e0", "retrieval_score": 0.6563394963741302, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "httpx/_models.py:Headers.get:242-250", "path": "httpx/_models.py", "symbol": "Headers.get", "start_line": 242, "end_line": 250, "window_end_line": 250, "source": "    def get(self, key: str, default: typing.Any = None) -> typing.Any:\n        \"\"\"\n        Return a header value. If multiple occurrences of the header occur\n        then concatenate them together with commas.\n        \"\"\"\n        try:\n            return self[key]\n        except KeyError:\n            return default\n", "content_hash": "1cf47d6e3bba1f9f3050089b1062ac98a31928dc1e06ee6bc5790663d7b05b67", "source_hash": "1cf47d6e3bba1f9f3050089b1062ac98a31928dc1e06ee6bc5790663d7b05b67", "retrieval_score": 0.6480711996555328, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "httpx/_models.py:Headers.multi_items:231-240", "path": "httpx/_models.py", "symbol": "Headers.multi_items", "start_line": 231, "end_line": 240, "window_end_line": 240, "source": "    def multi_items(self) -> list[tuple[str, str]]:\n        \"\"\"\n        Return a list of `(key, value)` pairs of headers. Allow multiple\n        occurrences of the same key without concatenating into a single\n        comma separated value.\n        \"\"\"\n        return [\n            (key.decode(self.encoding), value.decode(self.encoding))\n            for _, key, value in self._list\n        ]\n", "content_hash": "75eabdb50accd2e5ebcedce73cf9433abae124a3e9b38d7dcd2f8ebb8f3382b6", "source_hash": "75eabdb50accd2e5ebcedce73cf9433abae124a3e9b38d7dcd2f8ebb8f3382b6", "retrieval_score": 0.6290062367916107, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}], "candidate_windows": 50, "available_symbols": 48, "source_budget": 12000, "total_source_chars": 2638, "budget_exhausted": false, "indexstats": {"indexed_windows": 0, "reused_windows": 0, "deleted_windows": 0, "total_windows": 438, "memory_cache_hit": true, "model_fingerprint": "74f94ad704c7b37c24def6f651c4d203f92e8f8564167ff41c48db947f4d8849", "source_manifest": "a3084eecf2877fe1020c2a0f87e0ef525e7e7624f06e250373140e7d79bee6ae", "source_files": 23, "elapsed_s": 0.028643958998145536}, "timings": {"index_s": 0.028643958998145536, "query_embedding_s": 0.04048937500920147, "retrieval_s": 0.0027919590065721422, "h2o_s": 0.0, "qwen_s": 0.0, "packaging_s": 0.04930958297336474, "total_s": 0.12141462502768263}, "match_status": "candidates", "match_evidence": {"top_cosine": 0.8327822238206863, "threshold": null, "meaning": "Candidate relevance is not proof that a behavior exists or is absent."}, "token_usage": {"encoding": "cl100k_base", "tokens": 1159, "budget": 2000, "truncated": false}}, "compact_text_sha256": "4afc1709a3ba6c4356447521994f5da5051789d5dc73acec790e68a9541be610", "success": true, "returned_source_checks": [{"id": "httpx/_models.py:Headers.get_list:252-272", "path": "httpx/_models.py", "source_matches_snapshot": true, "physical_bounds_match": true, "