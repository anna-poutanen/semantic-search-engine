@@ -0,0 +1,77 @@
+import pytest
+
+import httpx
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        ("a, b", ["a", "b"]),
+        ('"a,b", c', ['"a,b"', "c"]),
+        (
+            'text/plain; title="a,b", text/html',
+            ['text/plain; title="a,b"', "text/html"],
+        ),
+        ('a"b,c"d, e', ['a"b,c"d', "e"]),
+        ('"a,b", "c,d"', ['"a,b"', '"c,d"']),
+        ('"a,b"; title="c,d", e', ['"a,b"; title="c,d"', "e"]),
+        (r'"a\",b", c', [r'"a\",b"', "c"]),
+        (r'"a\\", b', [r'"a\\"', "b"]),
+        (r'"a\\\",b", c', [r'"a\\\",b"', "c"]),
+        (r'"a\\\\", b', [r'"a\\\\"', "b"]),
+        (r'"a\,b", c', [r'"a\,b"', "c"]),
+        (r'"a\q", b', [r'"a\q"', "b"]),
+        (r"a\, b", ["a\\", "b"]),
+        (r'\"a,b", c', [r'\"a,b"', "c"]),
+        ("'a,b', c", ["'a", "b'", "c"]),
+        ("", [""]),
+        (" \t ", [""]),
+        (",", ["", ""]),
+        (",a,, b,", ["", "a", "", "b", ""]),
+        (', "", ,', ["", '""', "", ""]),
+        (
+            ' \t" a, b " \t, text/plain ; title=" c, d " \t',
+            ['" a, b "', 'text/plain ; title=" c, d "'],
+        ),
+        ('a, "b,c,d', ["a", '"b,c,d']),
+        (r'a, "b\",c,d', ["a", r'"b\",c,d']),
+        ('a, "b,c\\', ["a", '"b,c\\']),
+    ],
+)
+def test_get_list_split_quoted_commas(value, expected):
+    headers = httpx.Headers({"X-Test": value})
+
+    assert headers.get_list("x-TEST", split_commas=True) == expected
+
+
+@pytest.mark.parametrize("unfinished", ['"unclosed,a', '"unclosed,a\\'])
+def test_get_list_resets_quoted_state_between_headers(unfinished):
+    raw_headers = [
+        (b"X-Test", unfinished.encode("ascii")),
+        (b"Other", b'"ignored,header'),
+        (b"x-test", b'"b,c", d'),
+        (b"X-TEST", b" ,e,"),
+        (b"X-Test", b""),
+    ]
+    headers = httpx.Headers(raw_headers)
+    values = [unfinished, '"b,c", d', " ,e,", ""]
+
+    assert headers.get_list("X-tEsT", split_commas=True) == [
+        unfinished,
+        '"b,c"',
+        "d",
+        "",
+        "e",
+        "",
+        "",
+    ]
+    assert headers.get_list("x-test") == values
+    assert headers.get_list("X-TEST", split_commas=False) == values
+    assert headers.raw == raw_headers
+
+
+@pytest.mark.parametrize("split_commas", [False, True])
+def test_get_list_missing_header(split_commas):
+    headers = httpx.Headers({"X-Test": '"a,b", c'})
+
+    assert headers.get_list("missing", split_commas=split_commas) == []
