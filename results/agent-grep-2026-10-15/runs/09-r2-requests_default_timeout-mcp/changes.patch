diff --git a/tests/test_session_timeout.py b/tests/test_session_timeout.py
new file mode 100644
index 0000000..d09778c
--- /dev/null
+++ b/tests/test_session_timeout.py
@@ -0,0 +1,214 @@
+"""Regression tests for session defaults and per-request timeout overrides."""
+
+import pickle
+import time
+from unittest import mock
+
+import pytest
+from urllib3.util import Timeout
+
+import requests
+from requests.adapters import BaseAdapter
+
+from .testserver.server import Server
+
+URL = "http://127.0.0.1/"
+ENTRYPOINTS = (
+    "request",
+    "get",
+    "options",
+    "head",
+    "post",
+    "put",
+    "patch",
+    "delete",
+    "send",
+)
+TIMEOUT_CASES = [
+    pytest.param({}, (2, 5), id="inherited"),
+    pytest.param({"timeout": None}, None, id="disabled"),
+    pytest.param({"timeout": 1.5}, 1.5, id="scalar"),
+    pytest.param({"timeout": (None, 3)}, (None, 3), id="tuple"),
+]
+
+
+class RecordingAdapter(BaseAdapter):
+    def __init__(self):
+        self.timeouts = []
+        self.redirects = 0
+
+    def send(self, request, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        response = requests.Response()
+        response.request = request
+        response.url = request.url
+        response._content = b""
+        response.status_code = 200
+        if self.redirects:
+            self.redirects -= 1
+            response.status_code = 302
+            response.headers["Location"] = f"/redirect/{self.redirects}"
+        return response
+
+    def close(self):
+        pass
+
+
+@pytest.fixture
+def adapter():
+    return RecordingAdapter()
+
+
+@pytest.fixture
+def session(adapter):
+    with requests.Session() as session:
+        session.trust_env = False
+        session.mount("http://", adapter)
+        yield session
+
+
+def make_request(session, entrypoint, url=URL, **kwargs):
+    if entrypoint == "request":
+        return session.request("GET", url, **kwargs)
+    if entrypoint == "send":
+        request = requests.Request("GET", url, hooks=session.hooks).prepare()
+        return session.send(request, **kwargs)
+    return getattr(session, entrypoint)(url, **kwargs)
+
+
+@pytest.mark.parametrize("timeout", [None, 4.5, (1, None), Timeout(connect=1, read=2)])
+def test_constructor_timeout(timeout):
+    with requests.Session(timeout=timeout) as session:
+        assert session.timeout is timeout
+
+
+@pytest.mark.parametrize("entrypoint", ENTRYPOINTS)
+def test_default_is_unlimited(session, adapter, entrypoint):
+    assert session.timeout is None
+    make_request(session, entrypoint)
+    assert adapter.timeouts == [None]
+
+
+@pytest.mark.parametrize("entrypoint", ENTRYPOINTS)
+@pytest.mark.parametrize("kwargs, expected", TIMEOUT_CASES)
+def test_request_timeout_selection(session, adapter, entrypoint, kwargs, expected):
+    session.timeout = (2, 5)
+    response = make_request(session, entrypoint, **kwargs)
+    assert response.status_code == 200
+    assert adapter.timeouts == [expected]
+    assert session.timeout == (2, 5)
+
+
+@pytest.mark.parametrize("entrypoint", ENTRYPOINTS)
+def test_mutable_timeout_and_urllib3_timeout(session, adapter, entrypoint):
+    timeout = Timeout(connect=1, read=2)
+    session.timeout = timeout
+    make_request(session, entrypoint)
+    make_request(session, entrypoint, timeout=3)
+    make_request(session, entrypoint)
+    session.timeout = None
+    make_request(session, entrypoint)
+    make_request(session, entrypoint, timeout=timeout)
+    assert adapter.timeouts == [timeout, 3, timeout, None, timeout]
+    assert adapter.timeouts[0] is timeout
+    assert adapter.timeouts[-1] is timeout
+    assert session.timeout is None
+
+
+def test_request_passes_effective_timeout_to_overridden_send(session, monkeypatch):
+    session.timeout = 7
+    send = mock.Mock(wraps=session.send)
+    monkeypatch.setattr(session, "send", send)
+    session.request("GET", URL)
+    assert send.call_args.kwargs["timeout"] == 7
+
+
+@pytest.mark.parametrize("entrypoint", ENTRYPOINTS)
+@pytest.mark.parametrize("kwargs, expected", TIMEOUT_CASES)
+def test_redirects_keep_initial_timeout(session, adapter, entrypoint, kwargs, expected):
+    session.timeout = (2, 5)
+    adapter.redirects = 2
+    hook_timeouts = []
+
+    def change_default(response, **hook_kwargs):
+        hook_timeouts.append(hook_kwargs["timeout"])
+        session.timeout = 99
+
+    session.hooks["response"].append(change_default)
+    response = make_request(session, entrypoint, allow_redirects=True, **kwargs)
+    assert len(response.history) == 2
+    assert adapter.timeouts == [expected] * 3
+    assert hook_timeouts == [expected] * 3
+    assert session.timeout == 99
+    make_request(session, entrypoint)
+    assert adapter.timeouts[-1] == 99
+
+
+@pytest.mark.parametrize("timeout", [None, 4.5, (1, None)])
+@pytest.mark.parametrize("protocol", [0, pickle.HIGHEST_PROTOCOL])
+def test_pickle_preserves_mutated_timeout(session, adapter, timeout, protocol):
+    session.timeout = timeout
+    with pickle.loads(pickle.dumps(session, protocol=protocol)) as restored:
+        assert restored.timeout == timeout
+        restored.mount("http://", adapter)
+        restored.get(URL)
+        assert adapter.timeouts == [timeout]
+
+
+def test_unpickle_state_without_timeout(session, adapter):
+    state = session.__getstate__()
+    state.pop("timeout", None)
+    with requests.Session.__new__(requests.Session) as restored:
+        restored.__setstate__(state)
+        assert restored.timeout is None
+        restored.get(URL)
+        assert adapter.timeouts == [None]
+
+
+@pytest.mark.parametrize("entrypoint", ENTRYPOINTS[:-1])
+@pytest.mark.parametrize(
+    "kwargs, expected",
+    [({}, None), ({"timeout": None}, None), ({"timeout": 3}, 3)],
+)
+def test_module_helpers_keep_timeout_behavior(
+    adapter, monkeypatch, tmp_path, entrypoint, kwargs, expected
+):
+    monkeypatch.setenv("NETRC", str(tmp_path / "netrc"))
+    monkeypatch.setattr(requests.Session, "get_adapter", lambda self, url: adapter)
+    make_request(requests, entrypoint, **kwargs)
+    assert adapter.timeouts == [expected]
+
+
+@pytest.mark.parametrize("timeout", [0, -1, "invalid", (1, 2, 3)])
+def test_invalid_default_uses_adapter_validation(timeout):
+    with requests.Session(timeout=timeout) as session:
+        session.trust_env = False
+        with pytest.raises(ValueError):
+            session.get(URL)
+
+
+@pytest.mark.parametrize("entrypoint", ["get", "send"])
+@pytest.mark.parametrize(
+    "kwargs, times_out",
+    [({}, True), ({"timeout": None}, False), ({"timeout": (1, 2)}, False)],
+)
+def test_default_reaches_http_adapter(entrypoint, kwargs, times_out):
+    def delayed_response(sock):
+        sock.recv(65536)
+        time.sleep(0.25)
+        try:
+            sock.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK")
+        except OSError:
+            # The client may have closed the connection after timing out.
+            pass
+
+    with Server(delayed_response, host="127.0.0.1") as (host, port):
+        with requests.Session(timeout=(1, 0.05)) as session:
+            session.trust_env = False
+            url = f"http://{host}:{port}/"
+            if times_out:
+                with pytest.raises(requests.exceptions.ReadTimeout):
+                    make_request(session, entrypoint, url, **kwargs)
+            else:
+                assert make_request(session, entrypoint, url, **kwargs).content == b"OK"
+            assert session.timeout == (1, 0.05)
