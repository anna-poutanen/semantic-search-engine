diff --git a/tests/test_session_timeout.py b/tests/test_session_timeout.py
new file mode 100644
index 0000000..d52f0b8
--- /dev/null
+++ b/tests/test_session_timeout.py
@@ -0,0 +1,205 @@
+"""Regression tests for session defaults and per-request timeout overrides."""
+
+import pickle
+
+import pytest
+from urllib3.util import Timeout as Urllib3Timeout
+
+import requests
+from requests.adapters import BaseAdapter, HTTPAdapter
+
+URL = "http://timeout.invalid/"
+HTTP_METHODS = ("get", "options", "head", "post", "put", "patch", "delete")
+ENTRY_POINTS = ("request", "send", *HTTP_METHODS)
+
+
+class RecordingAdapter(BaseAdapter):
+    def __init__(self, redirects=0):
+        self.redirects = redirects
+        self.timeouts = []
+        self.methods = []
+
+    def send(self, request, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        self.methods.append(request.method)
+        response = requests.Response()
+        response.request = request
+        response.url = request.url
+        response._content = b"ok"
+        if len(self.timeouts) <= self.redirects:
+            response.status_code = 302
+            response.headers["Location"] = f"/redirect/{len(self.timeouts)}"
+        else:
+            response.status_code = 200
+        return response
+
+    def close(self):
+        pass
+
+
+@pytest.fixture
+def recorded_session():
+    with requests.Session() as session:
+        session.trust_env = False
+        adapter = RecordingAdapter()
+        session.mount("http://", adapter)
+        yield session, adapter
+
+
+def send(session, entry_point, **kwargs):
+    if entry_point == "request":
+        return session.request("GET", URL, **kwargs)
+    if entry_point == "send":
+        return session.send(requests.Request("GET", URL).prepare(), **kwargs)
+    return getattr(session, entry_point)(URL, **kwargs)
+
+
+@pytest.mark.parametrize(
+    "kwargs, expected",
+    (
+        ({}, None),
+        ({"timeout": None}, None),
+        ({"timeout": 2.5}, 2.5),
+        ({"timeout": (1, None)}, (1, None)),
+    ),
+)
+def test_constructor_timeout(kwargs, expected):
+    with requests.Session(**kwargs) as session:
+        assert session.timeout == expected
+        session.trust_env = False
+        adapter = RecordingAdapter()
+        session.mount("http://", adapter)
+        session.get(URL)
+        session.send(requests.Request("GET", URL).prepare())
+        assert adapter.timeouts == [expected, expected]
+
+
+def test_positional_constructor_timeout():
+    with requests.Session(2.5) as session:
+        assert session.timeout == 2.5
+
+
+@pytest.mark.parametrize("entry_point", ENTRY_POINTS)
+def test_omitted_timeout_inherits_current_session_value(recorded_session, entry_point):
+    session, adapter = recorded_session
+    values = (None, 2.5, (1, None), Urllib3Timeout(connect=1, read=2), None)
+    for value in values:
+        session.timeout = value
+        response = send(session, entry_point)
+        assert response.status_code == 200
+        assert adapter.timeouts[-1] is value
+        assert session.timeout is value
+    assert adapter.methods == [
+        "GET" if entry_point in ("request", "send") else entry_point.upper()
+    ] * len(values)
+
+
+@pytest.mark.parametrize("entry_point", ENTRY_POINTS)
+@pytest.mark.parametrize(
+    "timeout", (None, 4.5, (None, 6), Urllib3Timeout(connect=3, read=4), 0)
+)
+def test_explicit_timeout_overrides_without_mutation(
+    recorded_session, entry_point, timeout
+):
+    session, adapter = recorded_session
+    session.timeout = (1, 2)
+    send(session, entry_point, timeout=timeout)
+    assert adapter.timeouts == [timeout]
+    assert adapter.timeouts[0] is timeout
+    assert session.timeout == (1, 2)
+    send(session, entry_point)
+    assert adapter.timeouts[-1] == (1, 2)
+
+
+@pytest.mark.parametrize("entry_point", ("request", "send"))
+@pytest.mark.parametrize(
+    "kwargs, expected", (({}, (1, 2)), ({"timeout": None}, None), ({"timeout": 4}, 4))
+)
+def test_redirects_keep_initial_timeout(recorded_session, entry_point, kwargs, expected):
+    session, adapter = recorded_session
+    session.timeout = (1, 2)
+    adapter.redirects = 2
+    hook_timeouts = []
+
+    def change_session_timeout(response, **kwargs):
+        hook_timeouts.append(kwargs["timeout"])
+        session.timeout = 99
+
+    hooks = {"response": change_session_timeout}
+    if entry_point == "send":
+        prepared = requests.Request("GET", URL, hooks=hooks).prepare()
+        response = session.send(prepared, **kwargs)
+    else:
+        response = session.request("GET", URL, hooks=hooks, **kwargs)
+
+    assert response.status_code == 200
+    assert len(response.history) == 2
+    assert adapter.timeouts == [expected] * 3
+    assert hook_timeouts == [expected] * 3
+    assert session.timeout == 99
+
+
+@pytest.mark.parametrize("entry_point", ("request", *HTTP_METHODS))
+@pytest.mark.parametrize(
+    "kwargs, expected",
+    (({}, None), ({"timeout": None}, None), ({"timeout": (1, 2)}, (1, 2))),
+)
+def test_module_helpers_keep_timeout_behavior(
+    monkeypatch, entry_point, kwargs, expected
+):
+    adapter = RecordingAdapter()
+    monkeypatch.setattr(HTTPAdapter, "send", adapter.send)
+    monkeypatch.setattr("requests.sessions.get_netrc_auth", lambda url: None)
+    if entry_point == "request":
+        response = requests.request("GET", URL, **kwargs)
+    else:
+        response = getattr(requests, entry_point)(URL, **kwargs)
+    assert response.status_code == 200
+    assert adapter.timeouts == [expected]
+
+
+@pytest.mark.parametrize("timeout", (None, 2.5, (1, None)))
+@pytest.mark.parametrize("protocol", (0, pickle.HIGHEST_PROTOCOL))
+def test_pickle_preserves_mutated_timeout(timeout, protocol):
+    with requests.Session(timeout=5) as session:
+        session.trust_env = False
+        session.timeout = timeout
+        restored = pickle.loads(pickle.dumps(session, protocol=protocol))
+    with restored:
+        assert restored.timeout == timeout
+        adapter = RecordingAdapter()
+        restored.mount("http://", adapter)
+        restored.get(URL)
+        restored.send(requests.Request("GET", URL).prepare())
+        assert adapter.timeouts == [timeout, timeout]
+        restored.get(URL, timeout=None)
+        assert adapter.timeouts[-1] is None
+        assert restored.timeout == timeout
+
+
+def test_restore_session_state_without_timeout(recorded_session):
+    session, _ = recorded_session
+    state = session.__getstate__()
+    state.pop("timeout", None)
+    restored = requests.Session.__new__(requests.Session)
+    restored.__setstate__(state)
+    assert restored.timeout is None
+    assert restored.get(URL).status_code == 200
+
+
+@pytest.mark.parametrize("entry_point", ("get", "send"))
+def test_default_read_timeout_and_overrides_on_loopback(httpbin, entry_point):
+    with requests.Session(timeout=(1, 0.01)) as session:
+        session.trust_env = False
+        url = httpbin("delay/0.2")
+
+        def request(**kwargs):
+            if entry_point == "send":
+                return session.send(requests.Request("GET", url).prepare(), **kwargs)
+            return session.get(url, **kwargs)
+
+        with pytest.raises(requests.exceptions.ReadTimeout):
+            request()
+        assert request(timeout=None).status_code == 200
+        assert request(timeout=(1, 2)).status_code == 200
+        assert session.timeout == (1, 0.01)
