; Git-tracked files only in Git projects", "source_exclusions": [], "exclusions_omitted": 0}, "query": "click Choice constructor choices convert normalize case_sensitive token_normalize_func shell_complete get_metavar", "retrieval": "dense", "rerank": false, "rerank_provider": "h2o", "reranker_batch_size": null, "retrieval_candidate_windows": 50, "results": [{"id": "src/click/types.py:Choice.shell_complete:310-331", "path": "src/click/types.py", "symbol": "Choice.shell_complete", "start_line": 310, "end_line": 331, "window_end_line": 331, "source": "    def shell_complete(\n        self, ctx: \"Context\", param: \"Parameter\", incomplete: str\n    ) -> t.List[\"CompletionItem\"]:\n        \"\"\"Complete choices that start with the incomplete value.\n\n        :param ctx: Invocation context for this command.\n        :param param: The parameter that is requesting completion.\n        :param incomplete: Value being completed. May be empty.\n\n        .. versionadded:: 8.0\n        \"\"\"\n        from click.shell_completion import CompletionItem\n\n        str_choices = map(str, self.choices)\n\n        if self.case_sensitive:\n            matched = (c for c in str_choices if c.startswith(incomplete))\n        else:\n            incomplete = incomplete.lower()\n            matched = (c for c in str_choices if c.lower().startswith(incomplete))\n\n        return [CompletionItem(c) for c in matched]\n", "content_hash": "b44fbdcec9d4f1cad3a5284efc7d1c0dd329c848ac900988cc9a9f5c9e7186f6", "source_hash": "b44fbdcec9d4f1cad3a5284efc7d1c0dd329c848ac900988cc9a9f5c9e7186f6", "retrieval_score": 0.7301370799541473, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "src/click/core.py:MultiCommand.shell_complete:1770-1787", "path": "src/click/core.py", "symbol": "MultiCommand.shell_complete", "start_line": 1770, "end_line": 1787, "window_end_line": 1787, "source": "    def shell_complete(self, ctx: Context, incomplete: str) -> t.List[\"CompletionItem\"]:\n        \"\"\"Return a list of completions for the incomplete value. Looks\n        at the names of options, subcommands, and chained\n        multi-commands.\n\n        :param ctx: Invocation context for this command.\n        :param incomplete: Value being completed. May be empty.\n\n        .. versionadded:: 8.0\n        \"\"\"\n        from click.shell_completion import CompletionItem\n\n        results = [\n            CompletionItem(name, help=command.get_short_help_str())\n            for name, command in _complete_visible_commands(ctx, incomplete)\n        ]\n        results.extend(super().shell_complete(ctx, incomplete))\n        return results\n", "content_hash": "4ba239ed2fbc68f3f1ceeb47a68c036b35095ff382effd97684724d352ae0056", "source_hash": "4ba239ed2fbc68f3f1ceeb47a68c036b35095ff382effd97684724d352ae0056", "retrieval_score": 0.6625901758670807, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "src/click/core.py:Command.shell_complete:1445-1478", "path": "src/click/core.py", "symbol": "Command.shell_complete", "start_line": 1445, "end_line": 1478, "window_end_line": 1478, "source": "    def shell_complete(self, ctx: Context, incomplete: str) -> t.List[\"CompletionItem\"]:\n        \"\"\"Return a list of completions for the incomplete value. Looks\n        at the names of options and chained multi-commands.\n\n        :param ctx: Invocation context for this command.\n        :param incomplete: Value being completed. May be empty.\n\n        .. versionadded:: 8.0\n        \"\"\"\n        from click.shell_completion import CompletionItem\n\n        results: t.List[CompletionItem] = []\n\n        if incomplete and not incomplete[0].isalnum():\n            for param in self.get_params(ctx):\n                if (\n                    not isinstance(param, Option)\n                    or param.hidden\n                    or (\n                        not param.multiple\n                        and ctx.get_parameter_source(param.name)  # type: ignore\n                        is ParameterSource.COMMANDLINE\n                    )\n                ):\n                    continue\n\n                results.extend(\n                    CompletionItem(name, help=param.help)\n                    for name in [*param.opts, *param.secondary_opts]\n                    if name.startswith(incomplete)\n                )\n\n        results.extend(super().shell_complete(ctx, incomplete))\n        return results\n", "content_hash": "a0eb9eef956e0d4fffa2f1f6d1a7570fa999e00ccce88b2fae2d60eb76ae6d96", "source_hash": "a0eb9eef956e0d4fffa2f1f6d1a7570fa999e00ccce88b2fae2d60eb76ae6d96", "retrieval_score": 0.6567168533802032, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "src/click/core.py:Parameter.shell_complete:2428-2449", "path": "src/click/core.py", "symbol": "Parameter.shell_complete", "start_line": 2428, "end_line": 2449, "window_end_line": 2449, "source": "    def shell_complete(self, ctx: Context, incomplete: str) -> t.List[\"CompletionItem\"]:\n        \"\"\"Return a list of completions for the incomplete value. If a\n        ``shell_complete`` function was given during init, it is used.\n        Otherwise, the :attr:`type`\n        :meth:`~click.types.ParamType.shell_complete` function is used.\n\n        :param ctx: Invocation context for this command.\n        :param incomplete: Value being completed. May be empty.\n\n        .. versionadded:: 8.0\n        \"\"\"\n        if self._custom_shell_complete is not None:\n            results = self._custom_shell_complete(ctx, self, incomplete)\n\n            if results and isinstance(results[0], str):\n                from click.shell_completion import CompletionItem\n\n                results = [CompletionItem(c) for c in results]\n\n            return t.cast(t.List[\"CompletionItem\"], results)\n\n        return self.type.shell_complete(ctx, self, incomplete)\n", "content_hash": "a7b3d78dd744584a5a86ae340fdb4686fddc182f479ebe7fa98b0353361de3df", "source_hash": "a7b3d78dd744584a5a86ae340fdb4686fddc182f479ebe7fa98b0353361de3df", "retrieval_score": 0.6541111767292023, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}, {"id": "src/click/shell_completion.py:ShellComplete.__init__:216-226", "path": "src/click/shell_completion.py", "symbol": "ShellComplete.__init__", "start_line": 216, "end_line": 226, "window_end_line": 226, "source": "    def __init__(\n        self,\n        cli: BaseCommand,\n        ctx_args: t.MutableMapping[str, t.Any],\n        prog_name: str,\n        complete_var: str,\n    ) -> None:\n        self.cli = cli\n        self.ctx_args = ctx_args\n        self.prog_name = prog_name\n        self.complete_var = complete_var\n", "content_hash": "defedbce0744ca1c3aa83ffec2016ad1f7b4545a786962861c90cb19a4b92ad3", "source_hash": "defedbce0744ca1c3aa83ffec2016ad1f7b4545a786962861c90cb19a4b92ad3", "retrieval_score": 0.6463358700275421, "h2o_score": null, "qwen_score": null, "origin": "retrieval", "related_to": null, "truncated": false}], "candidate_windows": 50, "available_symbols": 50, "source_budget": 12000, "total_source_chars": 4095, "budget_exhausted": false, "indexstats": {"indexed_windows": 0, "reused_windows": 0, "deleted_windows": 0, "total_windows": 474, "memory_cache_hit": true, "model_fingerprint": "74f94ad704c7b37c24def6f651c4d203f92e8f8564167ff41c48db947f4d8849", "source_manifest": "9468db944943a0f5d5eafa6d4ea8063d148c6fb77a9d85693c27386d6c35175c", "source_files": 16, "elapsed_s": 0.03037141601089388}, "timings": {"index_s": 0.03037141601089388, "query_embedding_s": 0.05111041700001806, "retrieval_s": 0.002990125009091571, "h2o_s": 0.0, "qwen_s": 0.0, "packaging_s": 0.05882654199376702, "total_s": 0.14339983300305903}, "match_status": "candidates", "match_evidence": {"top_cosine": 0.7301370799541473, "threshold": null,