  "semantic_review": {
    "tanstack_inflight_reuse_and_success_delivery": "Active retryer reuse, success/callback completion, dispatch delivery and observer refresh are separate necessary links; cancelRefetch remains conditional.",
    "tanstack_last_observer_signal_cancellation": "Final-observer policy, signal-consumption getter, retryer cancellation and query abort/revert callback require both sides of the callback boundary; transport compliance is not assumed.",
    "tanstack_mutation_scope_serial_continuation": "Execution supplies canRun, cache restricts named scope, finally always requests runNext, and cache continues a paused peer. No cross-scope ordering is asserted.",
    "tanstack_invalidation_and_refetch_filter": "Client invalidation/refetchType dispatch, query invalidation transition, and disabled/static refetch filtering are distinct required operations. The reducer's invalidate branch was read as linkage context.",
    "tanstack_infinite_pages_bounded_both_directions": "Direction selection, paired page/pageParam update, append truncation and prepend truncation are all required. Application page-parameter callbacks remain outside the claim.",
    "tanstack_optimistic_result_and_result_promise": "Optimistic overlay, fetch-state construction, conditional actual pending-thenable finalization call through line 623, and thenable mutation/cleanup are all required; both named configuration conditions are retained.",
    "tanstack_hydrate_pending_promise_without_second_query_fn": "Hydration guards and deserialization, initialPromise forwarding, and first-attempt retryer reuse are separate links. Later retries can invoke the query function; no JSON promise serialization is asserted.",
    "tanstack_selector_memoization_and_deep_sharing": "Reference/selector memoization, sharing configuration dispatch, and recursive plain-array/object sharing are all required. This does not promise arbitrary-object equality semantics.",
    "tanstack_stable_query_hash": "The JSON replacer recursively sorts plain-object property names and preserves array order; no collision-free or cyclic serialization claim.",
    "tanstack_recursive_partial_key_match": "Object.keys of the requested subset recurses directionally into the larger key; this is not symmetric equality.",
    "tanstack_nested_notification_batch_finally": "The transaction counter decrements in finally and flushes only at zero; actual nested-batch and thrown-callback tests were read.",
    "tanstack_gc_time_never_shortens": "Math.max preserves the prior duration and the configured or environment-dependent default; timer-provider implementation is not required.",
    "tanstack_atomic_disk_cache": "All included imports are relative implementation modules. No filesystem or browser-storage implementation occurs; persister callouts delegate to caller-supplied functions. Other monorepo packages are outside scope.",
    "tanstack_cross_tab_broadcast": "Local listener dispatch and browser focus/online handlers do not implement a cross-tab send/receive channel; no BroadcastChannel or postMessage occurs in included source. Other monorepo packages are outside scope."
  },
