+@pytest.mark.parametrize("fail", [False, True])
+def test_cleanup_failure_restores_stack_and_context_can_be_reused(fail):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    events = []
+    callback_error = RuntimeError("callback")
+    cleanup_error = OSError("cleanup failed")
+    previous = click.get_current_context(silent=True)
+
+    with outer:
+        with pytest.raises(RuntimeError if fail else OSError) as caught:
+            with ctx:
+                ctx.with_resource(RecordingResource(events, cleanup_error))
+                if fail:
+                    raise callback_error
+        assert click.get_current_context() is outer
+        assert caught.value is (callback_error if fail else cleanup_error)
+        if fail:
+            notes = getattr(callback_error, "__notes__", [])
+            assert any("cleanup failed" in note for note in notes) or (
+                callback_error.__context__ is cleanup_error
+                or callback_error.__cause__ is cleanup_error
+            )
+        with ctx:
+            ctx.with_resource(RecordingResource(events))
+        assert click.get_current_context() is outer
+    assert len(events) == 2
+    assert click.get_current_context(silent=True) is previous
+
+
+def test_cleanup_failure_uses_chaining_without_exception_notes():
+    class LegacyError(RuntimeError):
+        add_note = None
+
+    error = LegacyError("callback")
+    cleanup_error = OSError("cleanup failed")
+    ctx = click.Context(click.Command("test"))
+    with pytest.raises(LegacyError) as caught:
+        with ctx:
+            ctx.with_resource(RecordingResource([], cleanup_error))
+            raise error
+    assert caught.value is error
+    assert error.__context__ is cleanup_error
+    assert cleanup_error.__context__ is None
