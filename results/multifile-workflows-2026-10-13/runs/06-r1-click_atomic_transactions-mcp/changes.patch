+import io
+import os
+import stat
+import sys
+
+import pytest
+
+import click
+
+
+def assert_destination(path, expected):
+    if expected is None:
+        assert not path.exists()
+    else:
+        assert path.read_bytes() == expected
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_open_file_transaction(tmp_path, lazy, binary, existing, fail):
+    path = tmp_path / "output"
+    original = b"original" if existing else None
+    if existing:
+        path.write_bytes(original)
+        path.chmod(0o640)
+    data = b"\x00\xffnew" if binary else "new snowman: \u2603"
+    expected = data if binary else data.encode("utf-8")
+    error = RuntimeError("body failed")
+    output = click.open_file(
+        path, "wb" if binary else "w", encoding="utf-8", atomic=True, lazy=lazy
+    )
+
+    try:
+        with output:
+            output.write(data)
+            output.flush()
+            fd = output.fileno()
+            assert_destination(path, original)
+            assert len(list(tmp_path.glob(".__atomic-write*"))) == 1
+            if fail:
+                raise error
+    except RuntimeError as caught:
+        assert fail
+        assert caught is error
+    else:
+        assert not fail
+
+    assert_destination(path, original if fail else expected)
+    if existing:
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+    assert output.closed
+    with pytest.raises(OSError):
+        os.fstat(fd)
+    output.close()
+    output.close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("parameter", ["argument", "option"])
+@pytest.mark.parametrize(
+    "outcome", ["return", "error", "click_error", "abort", "exit_zero", "exit_nonzero"]
+)
+def test_command_file_transaction(
+    runner, tmp_path, lazy, binary, existing, parameter, outcome
+):
+    path = tmp_path / "output"
+    original = b"original" if existing else None
+    if existing:
+        path.write_bytes(original)
+        path.chmod(0o640)
+    data = b"\x00\xffnew" if binary else "new snowman: \u2603"
+    expected = data if binary else data.encode("utf-8")
+    error = RuntimeError("callback failed")
+    files = []
+    file_type = click.File(
+        "wb" if binary else "w", encoding="utf-8", atomic=True, lazy=lazy
+    )
+
+    def callback(output):
+        files.append(output)
+        output.write(data)
+        output.flush()
+        assert_destination(path, original)
+        if outcome == "error":
+            raise error
+        if outcome == "click_error":
+            raise click.ClickException("callback failed")
+        if outcome == "abort":
+            click.get_current_context().abort()
+        if outcome.startswith("exit_"):
+            click.get_current_context().exit(0 if outcome == "exit_zero" else 3)
+
+    if parameter == "argument":
+        cli = click.command()(click.argument("output", type=file_type)(callback))
+        args = [str(path)]
+    else:
+        cli = click.command()(click.option("--output", type=file_type)(callback))
+        args = ["--output", str(path)]
+
+    outer = click.Context(click.Command("outer"))
+    with outer:
+        result = runner.invoke(cli, args)
+        assert click.get_current_context() is outer
+    success = outcome in ("return", "exit_zero")
+    assert result.exit_code == (0 if success else 3 if outcome == "exit_nonzero" else 1)
+    if outcome == "error":
+        assert result.exception is error
+    assert_destination(path, expected if success else original)
+    if existing:
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+    assert files[0].closed
+    files[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_unused_lazy_open_file(tmp_path, existing, fail):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+    output = click.open_file(path, "w", atomic=True, lazy=True)
+    try:
+        with output:
+            if fail:
+                raise RuntimeError("unused")
+    except RuntimeError:
+        assert fail
+    else:
+        assert not fail
+    assert output._f is None
+    output.close()
+    assert output._f is None
+    assert_destination(path, b"original" if existing else None)
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [True, None])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("outcome", ["return", "error", "exit_zero", "exit_nonzero"])
+def test_unused_lazy_command(runner, tmp_path, lazy, existing, outcome):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+    files = []
+
+    @click.command()
+    @click.argument("output", type=click.File("w", atomic=True, lazy=lazy))
+    def cli(output):
+        files.append(output)
+        if outcome == "error":
+            raise RuntimeError("unused")
+        if outcome.startswith("exit_"):
+            click.get_current_context().exit(0 if outcome == "exit_zero" else 3)
+
+    result = runner.invoke(cli, [str(path)])
+    expected_exit_code = {"return": 0, "exit_zero": 0, "exit_nonzero": 3}.get(
+        outcome, 1
+    )
+    assert result.exit_code == expected_exit_code
+    assert files[0]._f is None
+    assert_destination(path, b"original" if existing else None)
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
