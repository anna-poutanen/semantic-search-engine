+def test_contextmanager_resource_receives_callback_exception(runner):
+    error = RuntimeError("callback")
+    seen = []
+
+    @contextmanager
+    def resource():
+        try:
+            yield
+        except RuntimeError as caught:
+            seen.append(caught)
+            raise
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(resource())
+        raise error
+
+    result = runner.invoke(cli)
+    assert result.exception is error
+    assert seen == [error]
