@@ -0,0 +1,186 @@
+from contextlib import contextmanager
+
+import pytest
+
+import click
+
+
+class RecordingResource:
+    def __init__(self, events, cleanup_error=None):
+        self.events = events
+        self.cleanup_error = cleanup_error
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, tb):
+        self.events.append((exc_type, exc_value, tb, click.get_current_context()))
+        if self.cleanup_error is not None:
+            raise self.cleanup_error
+
+
+@pytest.mark.parametrize("fail", [False, True])
+@pytest.mark.parametrize("scope", [False, True])
+def test_resources_get_exception_at_outermost_exit(fail, scope):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    events = []
+    error = RuntimeError("callback")
+    previous = click.get_current_context(silent=True)
+
+    with outer:
+        try:
+            with ctx:
+                resource = RecordingResource(events)
+                assert ctx.with_resource(resource) is resource
+                with ctx.scope() if scope else ctx:
+                    assert click.get_current_context() is ctx
+                    assert events == []
+                assert events == []
+                assert click.get_current_context() is ctx
+                if fail:
+                    raise error
+        except RuntimeError as caught:
+            assert fail
+            assert caught is error
+        else:
+            assert not fail
+        assert click.get_current_context() is outer
+
+    assert click.get_current_context(silent=True) is previous
+    assert len(events) == 1
+    exc_type, exc_value, tb, current = events[0]
+    assert current is ctx
+    if fail:
+        assert exc_type is RuntimeError
+        assert exc_value is error
+        assert tb is error.__traceback__
+    else:
+        assert (exc_type, exc_value, tb) == (None, None, None)
+    ctx.close()
+    assert len(events) == 1
+
