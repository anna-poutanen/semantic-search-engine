+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("standalone_mode", [False, True])
+@pytest.mark.parametrize("explicit_exit", [False, True])
+def test_command_commit_failure_is_failure(
+    runner, tmp_path, lazy, standalone_mode, explicit_exit
+):
+    path = tmp_path / "output"
+    path.write_text("original")
+    files = []
+
+    @click.command()
+    @click.argument("output", type=click.File("w", atomic=True, lazy=lazy))
+    def cli(output):
+        files.append(output)
+        output.write("replacement")
