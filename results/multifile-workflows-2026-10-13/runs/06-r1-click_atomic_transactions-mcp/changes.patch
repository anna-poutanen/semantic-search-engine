+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("command", [False, True])
+@pytest.mark.parametrize("cleanup_error", [False, True])
+def test_abort_cleanup_preserves_primary_exception(
+    runner, tmp_path, monkeypatch, lazy, command, cleanup_error
+):
+    path = tmp_path / "output"
+    path.write_text("original")
+    error = RuntimeError("primary callback failure")
+    cleanup = PermissionError("cleanup denied")
+    files = []
+    temporary = []
+
+    def callback(output):
+        files.append(output)
+        output.write("replacement")
+        temporary.append(next(tmp_path.glob(".__atomic-write*")))
+        if not cleanup_error:
+            temporary[0].unlink()
+        raise error
+
+    def fail_unlink(filename):
+        assert os.fspath(filename) == str(temporary[0])
+        raise cleanup
+
+    with monkeypatch.context() as patch:
+        if cleanup_error:
+            patch.setattr(os, "unlink", fail_unlink)
+        if command:
+            cli = click.command()(
+                click.argument("output", type=click.File("w", atomic=True, lazy=lazy))(
+                    callback
+                )
+            )
+            result = runner.invoke(cli, [str(path)])
+            assert result.exit_code == 1
+            assert result.exception is error
+        else:
+            with pytest.raises(RuntimeError) as caught:
+                with click.open_file(path, "w", atomic=True, lazy=lazy) as output:
+                    callback(output)
+            assert caught.value is error
+
+    assert path.read_text() == "original"
+    assert files[0].closed
+    files[0].close()
+    if cleanup_error:
+        notes = getattr(error, "__notes__", [])
