+@pytest.mark.parametrize("scope", [False, True])
+def test_error_propagating_through_nested_context_defers_cleanup(scope):
+    ctx = click.Context(click.Command("test"))
+    events = []
+    error = RuntimeError("nested callback")
+    previous = click.get_current_context(silent=True)
+    with pytest.raises(RuntimeError) as caught:
+        with ctx:
+            ctx.with_resource(RecordingResource(events))
+            try:
+                with ctx.scope() if scope else ctx:
+                    raise error
+            except RuntimeError:
+                assert events == []
+                assert click.get_current_context() is ctx
+                raise
+    assert caught.value is error
+    assert len(events) == 1
+    assert events[0][1] is error
+    assert click.get_current_context(silent=True) is previous
