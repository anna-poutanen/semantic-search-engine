@@ -0,0 +1,54 @@
+"""Loopback integration coverage for NDJSON content decoding."""
+
+import gzip
+
+import pytest
+
+import requests
+from tests.testserver.server import Server
+
+
+@pytest.mark.parametrize("stream", [True, False], ids=["streaming", "cached"])
+def test_gzip_chunked_ndjson_with_conflicting_charset(stream):
+    body = '\ufeff{"text":"café 🚀"}\r\n\ntrue\n[1,null]'.encode()
+    compressed = gzip.compress(body)
+
+    def handler(sock):
+        request = b""
+        while b"\r\n\r\n" not in request:
+            data = sock.recv(4096)
+            if not data:
+                raise AssertionError("Client closed before sending request headers")
+            request += data
+        sock.sendall(
+            b"HTTP/1.1 200 OK\r\n"
+            b"Content-Type: application/x-ndjson; charset=iso-8859-1\r\n"
+            b"Content-Encoding: gzip\r\n"
+            b"Transfer-Encoding: chunked\r\n"
+            b"Connection: close\r\n\r\n"
+        )
+        for offset in range(0, len(compressed), 3):
+            chunk = compressed[offset : offset + 3]
+            sock.sendall(f"{len(chunk):x}\r\n".encode("ascii") + chunk + b"\r\n")
+        sock.sendall(b"0\r\n\r\n")
+        return request
+
+    with (
+        Server(handler, host="127.0.0.1") as (host, port),
+        requests.Session() as session,
+    ):
+        session.trust_env = False
+        with session.get(
+            f"http://{host}:{port}/", stream=stream, timeout=5
+        ) as response:
+            assert response.encoding == "iso-8859-1"
+            assert list(response.iter_json_lines(chunk_size=1)) == [
+                {"text": "café 🚀"},
+                True,
+                [1, None],
+            ]
+            assert response._content_consumed is True
+            if stream:
+                assert response._content is False
+            else:
+                assert response.content == body
