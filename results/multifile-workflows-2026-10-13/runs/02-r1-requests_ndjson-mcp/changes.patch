@@ -0,0 +1,298 @@
+"""Regression coverage for lazy newline-delimited JSON responses."""
+
+import io
+import math
+
+import pytest
+
+import requests
+from requests.compat import JSONDecodeError, json
+from requests.exceptions import InvalidJSONError, JSONLineDecodeError
+
+
+class TrackingBytesIO(io.BytesIO):
+    def __init__(self, body):
+        super().__init__(body)
+        self.read_sizes = []
+
+    def read(self, size=-1):
+        self.read_sizes.append(size)
+        return super().read(size)
+
+
+class StreamingResponse(requests.Response):
+    @property
+    def content(self):
+        raise AssertionError("iter_json_lines must not access Response.content")
+
+
+def response_from_bytes(body, response_class=requests.Response):
+    response = response_class()
+    response.status_code = 200
+    response.request = requests.Request("GET", "http://localhost/ndjson").prepare()
+    response.raw = TrackingBytesIO(body)
+    return response
+
+
+@pytest.fixture(params=[False, True], ids=["streaming", "cached"])
+def make_response(request):
+    def make(body):
+        response = response_from_bytes(body)
+        if request.param:
+            response._content = body
+            response._content_consumed = True
+        return response
+
+    return make
+
+
+def test_exception_public_identity():
+    assert requests.JSONLineDecodeError is JSONLineDecodeError
+    assert requests.exceptions.JSONLineDecodeError is JSONLineDecodeError
+    assert issubclass(JSONLineDecodeError, InvalidJSONError)
+    assert "JSONLineDecodeError" in requests.__all__
+
+
+@pytest.mark.parametrize("chunk_size", [1, 2, 3, 7, 512])
+def test_json_values_utf8_bom_and_split_delimiters(make_response, chunk_size):
+    body = (
+        '\ufeff{"text":"café 雪 🚀"}\r\n'
+        '[1,"two",null]\n"a string"\r\n42\n-1.25\ntrue\nfalse\nnull'
+    ).encode()
+    response = make_response(body)
+    response.encoding = "iso-8859-1"
+    expected = [
+        {"text": "café 雪 🚀"},
+        [1, "two", None],
+        "a string",
+        42,
+        -1.25,
+        True,
+        False,
+        None,
+    ]
+
+    actual = list(response.iter_json_lines(chunk_size=chunk_size))
+
+    assert actual == expected
+    assert [type(value) for value in actual] == [type(value) for value in expected]
+    assert response.encoding == "iso-8859-1"
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        '{"duplicate":1,"duplicate":2}',
+        "123456789012345678901234567890",
+        "-0.0",
+        "1e400",
+        "NaN",
+        "Infinity",
+        "-Infinity",
+        '"\\ud800"',
+    ],
+)
+def test_ordinary_json_decoder_value_semantics(make_response, text):
+    response = make_response((text + "\n").encode("utf-8"))
+    try:
+        expected = json.loads(text)
+    except JSONDecodeError:
+        with pytest.raises(JSONLineDecodeError) as caught:
+            list(response.iter_json_lines())
+        assert isinstance(caught.value.__cause__, JSONDecodeError)
+    else:
+        actual = list(response.iter_json_lines())
+        assert len(actual) == 1
+        if isinstance(expected, float) and math.isnan(expected):
+            assert math.isnan(actual[0])
+        else:
+            assert actual[0] == expected
+
+
+@pytest.mark.parametrize(
+    "body, expected",
+    [
+        (b"", []),
+        (b"1", [1]),
+        (b"1\n", [1]),
+        (b"1\r\n", [1]),
+        (b"1\r", [1]),
+        (b"\n", []),
+        (b"\r\n", []),
+        (b"\n\n", []),
+        (b" \t", []),
+        (b"\xef\xbb\xbf", []),
+        (b"\xef\xbb\xbf\n1\n", [1]),
+        (b"\n \t\r\n1\n\t\r\n2\r\n", [1, 2]),
+        ("\u2003\n1\n".encode(), [1]),
+    ],
+)
+def test_empty_blank_and_final_lines(make_response, body, expected):
+    assert list(make_response(body).iter_json_lines(chunk_size=1)) == expected
+
+
+@pytest.mark.parametrize("body", [b"\n", b" \t\r\n", b" \t", b"\xef\xbb\xbf\n"])
+def test_blank_lines_are_errors_when_requested(make_response, body):
+    response = make_response(body)
+    with pytest.raises(JSONLineDecodeError) as caught:
+        list(response.iter_json_lines(chunk_size=1, skip_blank=False))
+    assert caught.value.line_number == 1
+    assert caught.value.line == body.removesuffix(b"\n").removesuffix(b"\r")
+    assert isinstance(caught.value.__cause__, JSONDecodeError)
+
+
+def test_empty_input_and_trailing_newline_with_skip_blank_false(make_response):
+    assert list(make_response(b"").iter_json_lines(skip_blank=False)) == []
+    assert list(make_response(b"null\r\n").iter_json_lines(skip_blank=False)) == [None]
+
+
+def test_later_blank_line_fails_lazily(make_response):
+    response = make_response(b"true\n \t\r\nfalse\n")
+    values = response.iter_json_lines(skip_blank=False)
+    assert next(values) is True
+    with pytest.raises(JSONLineDecodeError) as caught:
+        next(values)
+    assert caught.value.line_number == 2
+    assert caught.value.line == b" \t"
+
+
+@pytest.mark.parametrize("chunk_size", [1, 512])
+@pytest.mark.parametrize(
+    "line, cause",
+    [
+        (b'{"broken":}', JSONDecodeError),
+        (b"null trailing", JSONDecodeError),
+        (b'"\xff"', UnicodeDecodeError),
+        (b'"\xc3"', UnicodeDecodeError),
+        (b'"\xe2\x82', UnicodeDecodeError),
+    ],
+)
+@pytest.mark.parametrize("delimiter", [b"\n", b"\r\n", b""])
+def test_later_errors_preserve_physical_lines_and_context(
+    make_response, chunk_size, line, cause, delimiter
+):
+    body = b'\n \t\r\n{"ok":1}\n' + line + delimiter
+    response = make_response(body)
+    response.status_code = 400  # Error responses still carry response context.
+    values = response.iter_json_lines(chunk_size=chunk_size)
+
+    assert next(values) == {"ok": 1}
+    with pytest.raises(JSONLineDecodeError) as caught:
+        next(values)
+
+    error = caught.value
+    assert error.line_number == 4
+    assert error.line == line
+    assert error.response is response
+    assert error.request is response.request
+    assert isinstance(error.__cause__, cause)
+    assert "4" in str(error)
+
+
+@pytest.mark.parametrize(
+    "body, line_number, line",
+    [
+        (b"\n\xef\xbb\xbf{}\n", 2, b"\xef\xbb\xbf{}"),
+        (b" \t\r\n\xef\xbb\xbf\n", 2, b"\xef\xbb\xbf"),
+        (b" \xef\xbb\xbf{}\n", 1, b" \xef\xbb\xbf{}"),
+        (b"\xef\xbb\xbf\xef\xbb\xbf{}\n", 1, b"\xef\xbb\xbf\xef\xbb\xbf{}"),
+        (b"\xef\xbb\xbf{bad}\r\n", 1, b"\xef\xbb\xbf{bad}"),
+        (b"\xef\xbb\xbf\xff\n", 1, b"\xef\xbb\xbf\xff"),
+    ],
+)
+def test_bom_placement_and_original_error_bytes(make_response, body, line_number, line):
+    with pytest.raises(JSONLineDecodeError) as caught:
+        list(make_response(body).iter_json_lines(chunk_size=1))
+    assert caught.value.line_number == line_number
+    assert caught.value.line == line
+    assert isinstance(caught.value.__cause__, (JSONDecodeError, UnicodeDecodeError))
+
+
+def test_bom_characters_inside_json_strings(make_response):
+    response = make_response('"\ufeff"\n{"text":"\ufeff"}\n'.encode())
+    assert list(response.iter_json_lines(chunk_size=1)) == [
+        "\ufeff",
+        {"text": "\ufeff"},
+    ]
+
+
+@pytest.mark.parametrize("body", [b"1\r2\n", b"1\v2\n", b"1\f2\n"])
+def test_only_lf_and_crlf_separate_records(make_response, body):
+    with pytest.raises(JSONLineDecodeError) as caught:
+        list(make_response(body).iter_json_lines(chunk_size=1))
+    assert caught.value.line_number == 1
+    assert caught.value.line == body[:-1]
+
+
+def test_unicode_line_separators_inside_strings(make_response):
+    response = make_response('"a\u0085b\u2028c\u2029d"\n'.encode())
+    assert list(response.iter_json_lines(chunk_size=1)) == ["a\u0085b\u2028c\u2029d"]
+
+
+def test_final_error_preserves_carriage_return(make_response):
+    with pytest.raises(JSONLineDecodeError) as caught:
+        list(make_response(b"bad\r").iter_json_lines(chunk_size=1))
+    assert caught.value.line == b"bad\r"
+
+
+@pytest.mark.parametrize(
+    "chunk_size", [True, False, 0, -1, 1.0, "512", None, b"1", object()]
+)
+def test_invalid_chunk_size_is_rejected_before_reading(chunk_size):
+    response = response_from_bytes(b"{}\n")
+    with pytest.raises(ValueError, match="chunk_size"):
+        response.iter_json_lines(chunk_size=chunk_size)
+    assert response.raw.read_sizes == []
+
+
+@pytest.mark.parametrize("skip_blank", [0, 1, "true", None, [], object()])
+def test_invalid_skip_blank_is_rejected_before_reading(skip_blank):
+    response = response_from_bytes(b"{}\n")
+    with pytest.raises(ValueError, match="skip_blank"):
+        response.iter_json_lines(skip_blank=skip_blank)
+    assert response.raw.read_sizes == []
+
+
+def test_default_read_size_and_lazy_byte_stream():
+    response = response_from_bytes(b'1\n"\xff"\n', StreamingResponse)
+    values = response.iter_json_lines()
+    assert response.raw.read_sizes == []
+    assert next(values) == 1
+    assert response.raw.read_sizes == [512]
+    assert response._content is False
+    with pytest.raises(JSONLineDecodeError):
+        next(values)
+
+
+def test_reading_stops_at_the_requested_record():
+    first = b'{"first":1}\r\n'
+    response = response_from_bytes(first + b'{"second":2}\n', StreamingResponse)
+    values = response.iter_json_lines(chunk_size=1)
+    assert next(values) == {"first": 1}
+    assert response.raw.tell() == len(first)
+    assert response._content_consumed is False
+    assert list(values) == [{"second": 2}]
+    assert response._content_consumed is True
+    assert response._content is False
+
+
+def test_long_record_across_many_chunks():
+    value = {"text": "é" * 10000}
+    response = response_from_bytes(json.dumps(value).encode("utf-8"), StreamingResponse)
+    assert list(response.iter_json_lines(chunk_size=17)) == [value]
+    assert set(response.raw.read_sizes) == {17}
+
+
+def test_cached_response_can_be_replayed_without_changing_other_methods():
+    response = response_from_bytes(b'{"text":"caf\xc3\xa9"}\n')
+    original = response.content
+    read_sizes = response.raw.read_sizes[:]
+    response.encoding = "iso-8859-1"
+
+    assert list(response.iter_json_lines(chunk_size=1)) == [{"text": "café"}]
+    assert list(response.iter_json_lines()) == [{"text": "café"}]
+    assert response.content is original
+    assert response.raw.read_sizes == read_sizes
+    assert response.json() == {"text": "cafÃ©"}
+    assert list(response.iter_lines()) == [b'{"text":"caf\xc3\xa9"}']
+    assert b"".join(response.iter_content(chunk_size=2)) == original
