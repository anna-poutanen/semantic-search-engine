diff --git a/tests/test_response_limits.py b/tests/test_response_limits.py
new file mode 100644
index 0000000..4d7ea76
--- /dev/null
+++ b/tests/test_response_limits.py
@@ -0,0 +1,370 @@
+"""Regression coverage for decoded response byte budgets."""
+
+import io
+import pickle
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter, HTTPAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+
+class CountingBody(io.BytesIO):
+    def __init__(self, body, fail_close=False):
+        super().__init__(body)
+        self.reads = 0
+        self.closes = 0
+        self.releases = 0
+        self.close_error = OSError("cleanup failed") if fail_close else None
+
+    def read(self, size=-1):
+        self.reads += 1
+        return super().read(size)
+
+    def close(self):
+        self.closes += 1
+        if self.close_error is not None:
+            raise self.close_error
+        super().close()
+
+    def release_conn(self):
+        self.releases += 1
+
+
+class StreamingBody(CountingBody):
+    def stream(self, size, decode_content=False):
+        assert decode_content is True
+        while chunk := self.read(size):
+            yield chunk
+
+
+def make_response(body, raw_type=CountingBody, cached=False, **raw_kwargs):
+    response = requests.Response()
+    response.status_code = 200
+    response.encoding = "utf-8"
+    response.raw = raw_type(body, **raw_kwargs)
+    if cached:
+        response._content = body
+        response._content_consumed = True
+    return response
+
+
+class ResponseAdapter(BaseAdapter):
+    def __init__(self, *responses):
+        self.responses = iter(responses)
+        self.calls = []
+
+    # An explicit transport signature detects leaked budget kwargs.
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        self.calls.append(request)
+        response = next(self.responses)
+        response.request = request
+        response.url = request.url
+        return response
+
+    def close(self):
+        pass
+
+
+def make_session(*responses, limit=None):
+    session = requests.Session(max_response_bytes=limit)
+    session.trust_env = False
+    adapter = ResponseAdapter(*responses)
+    session.mount("http://", adapter)
+    return session, adapter
+
+
+def send(session, direct=False, **kwargs):
+    if direct:
+        prepared = requests.Request("GET", "http://example.test/body").prepare()
+        return session.send(prepared, **kwargs)
+    return session.get("http://example.test/body", **kwargs)
+
+
+def test_exception_is_public():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    assert issubclass(ResponseTooLarge, RequestException)
+
+
+@pytest.mark.parametrize("invalid", [True, False, -1, 1.0, "1", b"1", [], {}, object()])
+@pytest.mark.parametrize(
+    "entrypoint", ["constructor", "request", "module", "send", "setting"]
+)
+def test_invalid_budget_is_rejected_before_transport(monkeypatch, invalid, entrypoint):
+    def unexpected_transport(*args, **kwargs):
+        pytest.fail("invalid budget reached the transport")
+
+    monkeypatch.setattr(HTTPAdapter, "send", unexpected_transport)
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        if entrypoint == "constructor":
+            requests.Session(max_response_bytes=invalid)
+        elif entrypoint == "module":
+            requests.get("http://example.test/body", max_response_bytes=invalid)
+        else:
+            with requests.Session() as session:
+                if entrypoint == "setting":
+                    session.max_response_bytes = invalid
+                    send(session)
+                else:
+                    send(
+                        session, direct=entrypoint == "send", max_response_bytes=invalid
+                    )
+
+
+@pytest.mark.parametrize("limit", [None, 0, 4, 2**80])
+def test_session_budget_survives_pickle(limit):
+    with requests.Session(max_response_bytes=limit) as original:
+        with pickle.loads(pickle.dumps(original)) as restored:
+            assert restored.max_response_bytes == limit
+            response = make_response(b"abcd")
+            restored.mount("http://", ResponseAdapter(response))
+            restored.trust_env = False
+            if limit == 0:
+                with pytest.raises(ResponseTooLarge):
+                    send(restored)
+            else:
+                assert send(restored).content == b"abcd"
+
+
+@pytest.mark.parametrize("direct", [False, True])
+@pytest.mark.parametrize(
+    "session_limit, override, allowed",
+    [(None, 3, False), (3, None, True), (3, 4, True), (4, 3, False)],
+)
+def test_request_override_and_explicit_none(direct, session_limit, override, allowed):
+    response = make_response(b"abcd")
+    session, _ = make_session(response, limit=session_limit)
+    if allowed:
+        assert send(session, direct, max_response_bytes=override).content == b"abcd"
+    else:
+        with pytest.raises(ResponseTooLarge) as caught:
+            send(session, direct, max_response_bytes=override)
+        assert caught.value.limit == override
+
+
+@pytest.mark.parametrize("direct", [False, True])
+def test_omitted_request_budget_inherits_setting(direct):
+    response = make_response(b"abcdef")
+    session, adapter = make_session(response, limit=5)
+    with pytest.raises(ResponseTooLarge) as caught:
+        send(session, direct)
+    error = caught.value
+    assert error.limit == 5
+    assert error.received == 6
+    assert error.response is response
+    assert error.request is adapter.calls[0]
+    assert response.raw.closed
+    assert response.raw.closes == 1
+
+
+@pytest.mark.parametrize("raw_type", [CountingBody, StreamingBody])
+@pytest.mark.parametrize("body, limit", [(b"", 0), (b"abcd", 4)])
+@pytest.mark.parametrize("stream", [False, True])
+def test_exact_boundary_and_empty_zero_budget(raw_type, body, limit, stream):
+    response = make_response(body, raw_type)
+    # The decoded body, rather than Content-Length, controls the budget.
+    response.headers["Content-Length"] = "999999"
+    session, _ = make_session(response, limit=limit)
+    result = send(session, stream=stream)
+    assert result.content == body
+    for _ in range(3):
+        assert result.content == body
+        assert result.text == body.decode()
+        assert b"".join(result.iter_content(1)) == body
+    assert not response.raw.closed
+
+
+@pytest.mark.parametrize("raw_type", [CountingBody, StreamingBody])
+def test_total_is_shared_and_failed_response_stops_all_readers(raw_type):
+    response = make_response(b"abcdefgh", raw_type)
+    session, _ = make_session(response, limit=4)
+    send(session, stream=True)
+    first = response.iter_content(2)
+    dormant = response.iter_content(1)
+    assert next(first) == b"ab"
+    with pytest.raises(ResponseTooLarge) as caught:
+        next(response.iter_content(4))
+    assert caught.value.received == 6
+    reads = response.raw.reads
+    readers = [
+        lambda: next(first),
+        lambda: next(dormant),
+        lambda: response.content,
+        lambda: response.text,
+        lambda: response.json(),
+        lambda: next(response.iter_content()),
+        lambda: next(response.iter_lines()),
+        lambda: next(iter(response)),
+    ]
+    for read in readers:
+        with pytest.raises(ResponseTooLarge) as later:
+            read()
+        assert later.value is caught.value
+        assert later.value.received == 6
+        assert response.raw.reads == reads
+    assert response.raw.closes == 1
+
+
+@pytest.mark.parametrize("raw_type", [CountingBody, StreamingBody])
+def test_partial_iterator_then_content_keeps_total(raw_type):
+    response = make_response(b"abcdef", raw_type)
+    session, _ = make_session(response, limit=5)
+    send(session, stream=True)
+    assert next(response.iter_content(2)) == b"ab"
+    with pytest.raises(ResponseTooLarge) as caught:
+        response.content
+    assert caught.value.received == 6
+
+
+def test_existing_line_iterator_stops_after_another_reader_exceeds_budget():
+    response = make_response(b"a\nb\ncdef")
+    session, _ = make_session(response, limit=5)
+    send(session, stream=True)
+    lines = response.iter_lines(chunk_size=4)
+    assert next(lines) == b"a"
+    with pytest.raises(ResponseTooLarge):
+        response.content
+    with pytest.raises(ResponseTooLarge):
+        next(lines)
+
+
+def test_existing_cached_iterator_stops_after_response_exceeds_new_budget():
+    response = make_response(b"abcd", cached=True)
+    session, _ = make_session(response, response, limit=4)
+    send(session)
+    chunks = response.iter_content(1)
+    with pytest.raises(ResponseTooLarge):
+        send(session, max_response_bytes=3)
+    with pytest.raises(ResponseTooLarge):
+        next(chunks)
+
+
+def test_partial_iterator_then_cached_content_does_not_double_count():
+    response = make_response(b"abcdef")
+    session, _ = make_session(response, limit=6)
+    send(session, stream=True)
+    assert next(response.iter_content(2)) == b"ab"
+    assert response.content == b"cdef"
+    for _ in range(3):
+        assert response.text == "cdef"
+        assert b"".join(response.iter_content(2)) == b"cdef"
+    assert response._decoded_bytes_received == 6
+
+
+@pytest.mark.parametrize(
+    "read", [lambda r: r.content, lambda r: r.text, lambda r: list(r.iter_content(2))]
+)
+def test_hooks_cannot_read_past_budget(read):
+    response = make_response(b"abcdef")
+    session, _ = make_session(response, limit=3)
+    with pytest.raises(ResponseTooLarge):
+        send(session, stream=True, hooks={"response": lambda r, **kw: read(r)})
+    assert response.raw.closed
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("limit, allowed", [(3, False), (4, True), (None, True)])
+def test_hook_returned_cached_response_is_checked(stream, limit, allowed):
+    original = make_response(b"")
+    cached = make_response(b"abcd", cached=True)
+    session, _ = make_session(original, limit=limit)
+
+    def replace(response, **kwargs):
+        response.close()
+        cached.request = response.request
+        return cached
+
+    if allowed:
+        result = send(session, stream=stream, hooks={"response": replace})
+        assert result is cached
+        assert result.content == b"abcd"
+        assert result.text == "abcd"
+        assert b"".join(result.iter_content()) == b"abcd"
+    else:
+        with pytest.raises(ResponseTooLarge) as caught:
+            send(session, stream=stream, hooks={"response": replace})
+        assert caught.value.response is cached
+        assert caught.value.request is original.request
+        assert caught.value.received == 4
+        assert cached.raw.releases == 1
+        with pytest.raises(ResponseTooLarge):
+            cached.content
+
+
+@pytest.mark.parametrize("cached", [False, True])
+def test_hook_replacements_get_budget_before_next_hook(cached):
+    original = make_response(b"")
+    replacement = make_response(b"abcd", cached=cached)
+    session, _ = make_session(original, limit=3)
+    seen = []
+
+    def replace(response, **kwargs):
+        assert "max_response_bytes" not in kwargs
+        response.close()
+        replacement.request = response.request
+        return replacement
+
+    def consume(response, **kwargs):
+        for chunk in response.iter_content(2):
+            seen.append(chunk)
+
+    with pytest.raises(ResponseTooLarge) as caught:
+        send(session, stream=True, hooks={"response": [replace, consume]})
+    assert caught.value.response is replacement
+    assert seen == ([] if cached else [b"ab"])
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_cleanup_failure_preserves_budget_error(stream):
+    response = make_response(b"abcd", fail_close=True)
+    session, _ = make_session(response, limit=3)
+    with pytest.raises(ResponseTooLarge) as caught:
+        result = send(session, stream=stream)
+        result.content
+    assert caught.value.__cause__ is response.raw.close_error
+    assert caught.value.received == 4
+    reads = response.raw.reads
+    with pytest.raises(ResponseTooLarge) as later:
+        response.text
+    assert later.value is caught.value
+    assert response.raw.reads == reads
+    assert response.raw.closes == 1
+    # Allow BytesIO teardown to close normally after testing the failure.
+    response.raw.close_error = None
+    response.raw.close()
+
+
+def test_response_context_manager_preserves_budget_error_when_cleanup_fails():
+    response = make_response(b"abcd", fail_close=True)
+    session, _ = make_session(response, limit=3)
+    try:
+        with pytest.raises(ResponseTooLarge) as caught:
+            with send(session, stream=True) as result:
+                result.content
+        assert caught.value.__cause__ is response.raw.close_error
+        assert response.raw.closes == 1
+    finally:
+        response.raw.close_error = None
+        response.raw.close()
+
+
+def test_unicode_stream_counts_bytes_before_character_decoding():
+    response = make_response("€🙂".encode())
+    session, _ = make_session(response, limit=4)
+    send(session, stream=True)
+    chunks = response.iter_content(3, decode_unicode=True)
+    assert next(chunks) == "€"
+    with pytest.raises(ResponseTooLarge) as caught:
+        next(chunks)
+    assert caught.value.received == 6
+
+
+def test_unlimited_streaming_preserves_unicode_behavior():
+    response = make_response("€🙂".encode())
+    session, _ = make_session(response)
+    assert session.max_response_bytes is None
+    send(session, stream=True)
+    assert "".join(response.iter_content(1, decode_unicode=True)) == "€🙂"
