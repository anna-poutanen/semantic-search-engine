+"""Loopback integration tests for response limits and transport decoding."""
+
+import gzip
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import requests
+
+BODY = b"0123456789" * 40
+
+
+@pytest.fixture(scope="module")
+def budget_server():
+    paths = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            paths.append(self.path)
+            body = (
+                BODY
+                if self.path
+                in ("/body", "/gzip", "/deflate", "/chunked", "/redirect-large")
+                else b"abcd"
+            )
+            if self.path == "/empty":
+                body = b""
+            self.send_response(302 if self.path.startswith("/redirect") else 200)
+            if self.path.startswith("/redirect"):
+                self.send_header(
+                    "Location",
+                    "/body" if self.path == "/redirect-final-large" else "/small",
+                )
+            if self.path in ("/gzip", "/deflate"):
+                encoding = self.path[1:]
+                body = (
+                    gzip.compress(body) if encoding == "gzip" else zlib.compress(body)
+                )
+                self.send_header("Content-Encoding", encoding)
+            self.send_header("Content-Type", "text/plain; charset=utf-8")
+            if self.path == "/chunked":
+                self.send_header("Transfer-Encoding", "chunked")
+            else:
+                self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            if self.command == "HEAD":
+                return
+            try:
+                if self.path == "/chunked":
+                    for start in range(0, len(body), 23):
+                        chunk = body[start : start + 23]
+                        self.wfile.write(
+                            f"{len(chunk):x}\r\n".encode() + chunk + b"\r\n"
+                        )
+                    self.wfile.write(b"0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+            except (BrokenPipeError, ConnectionResetError):
+                # Exceeding the budget intentionally closes the client socket.
+                pass
+
+        do_HEAD = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = do_GET
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=lambda: server.serve_forever(poll_interval=0.01))
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}", paths
+    finally:
+        server.shutdown()
+        thread.join()
+        server.server_close()
+
+
+@pytest.mark.parametrize("path", ["/gzip", "/deflate", "/chunked", "/body"])
+@pytest.mark.parametrize("stream", [False, True])
+def test_budget_counts_decoded_transport_bytes(budget_server, path, stream):
+    url, _ = budget_server
+    with pytest.raises(requests.ResponseTooLarge) as caught:
+        response = requests.get(url + path, max_response_bytes=100, stream=stream)
+        assert b"".join(response.iter_content(50)) == BODY
+    error = caught.value
+    assert error.limit == 100
+    assert error.received > 100
+    assert error.response.raw.closed
+    if path in ("/gzip", "/deflate"):
+        assert int(error.response.headers["Content-Length"]) < error.limit
+    with pytest.raises(requests.ResponseTooLarge):
+        error.response.text
+
+
+@pytest.mark.parametrize(
+    "path, limit", [("/gzip", len(BODY)), ("/empty", 0), ("/small", 4)]
+)
+def test_transport_exact_boundary_and_cached_rereads(budget_server, path, limit):
+    url, _ = budget_server
+    with requests.get(url + path, max_response_bytes=limit, stream=True) as response:
+        body = response.content
+        assert len(body) == limit
+        assert response.text.encode() == body
+        assert b"".join(response.iter_content(3)) == body
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_redirect_budget_is_independent_for_each_response(budget_server, stream):
+    url, _ = budget_server
+    with requests.Session(max_response_bytes=4) as session:
+        with session.get(url + "/redirect-small", stream=stream) as response:
+            assert response.content == b"abcd"
+            assert [r.content for r in response.history] == [b"abcd"]
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("path", ["/redirect-large", "/redirect-final-large"])
+def test_intermediate_and_final_redirect_overflow(budget_server, stream, path):
+    url, paths = budget_server
+    start = len(paths)
+    with pytest.raises(requests.ResponseTooLarge) as caught:
+        response = requests.get(url + path, max_response_bytes=4, stream=stream)
+        response.content
+    expected_path = path if path == "/redirect-large" else "/body"
+    assert caught.value.response.url == url + expected_path
+    assert caught.value.received == len(BODY)
+    assert caught.value.response.raw.closed
+    assert paths[start:] == ([path] if path == "/redirect-large" else [path, "/body"])
+
+
+@pytest.mark.parametrize("direct", [False, True])
+@pytest.mark.parametrize("stream", [False, True])
+def test_explicit_none_disables_budget_for_whole_redirect_chain(
+    budget_server, direct, stream
+):
+    url, _ = budget_server
+    with requests.Session(max_response_bytes=0) as session:
+        if direct:
+            prepared = requests.Request("GET", url + "/redirect-large").prepare()
+            response = session.send(prepared, max_response_bytes=None, stream=stream)
+        else:
+            response = session.get(
+                url + "/redirect-large", max_response_bytes=None, stream=stream
+            )
+        with response:
+            assert response.content == b"abcd"
+            assert response.history[0].content == BODY
+        assert session.max_response_bytes == 0
+
+
+@pytest.mark.parametrize("module_level", [False, True])
+@pytest.mark.parametrize(
+    "method", ["get", "post", "put", "patch", "delete", "head", "options", "request"]
+)
+def test_all_convenience_helpers_accept_budget(budget_server, module_level, method):
+    url, _ = budget_server
+    with requests.Session(max_response_bytes=0) as session:
+        helper = getattr(requests if module_level else session, method)
+        args = ("GET", url + "/small") if method == "request" else (url + "/small",)
+        with helper(*args, max_response_bytes=4) as response:
+            assert response.content == (b"" if method == "head" else b"abcd")
+
+
+def test_head_ignores_content_length_with_zero_budget(budget_server):
+    url, _ = budget_server
+    with requests.head(url + "/body", max_response_bytes=0) as response:
+        assert int(response.headers["Content-Length"]) == len(BODY)
+        assert response.content == b""
