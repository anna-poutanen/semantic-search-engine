@@ -0,0 +1,87 @@
+import pytest
+
+import click
+
+
+class Resource:
+    def __init__(self, ctx, cleanup_error=None):
+        self.ctx = ctx
+        self.cleanup_error = cleanup_error
+        self.exits = []
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, tb):
+        assert click.get_current_context() is self.ctx
+        self.exits.append((exc_type, exc_value, tb))
+        if self.cleanup_error is not None:
+            raise self.cleanup_error
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_nested_context_resources_receive_exception(fail):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    resource = Resource(ctx)
+    error = RuntimeError("callback failed")
+
+    with parent:
+        try:
+            with ctx:
+                assert ctx.with_resource(resource) is resource
+                try:
+                    with ctx:
+                        assert click.get_current_context() is ctx
+                        if fail:
+                            raise error
+                finally:
+                    assert resource.exits == []
+        except RuntimeError as caught:
+            assert caught is error
+        assert click.get_current_context() is parent
+
+    assert len(resource.exits) == 1
+    exc_type, exc_value, tb = resource.exits[0]
+    assert exc_type is (RuntimeError if fail else None)
+    assert exc_value is (error if fail else None)
+    assert (tb is not None) is fail
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("kind", ["resource", "callback"])
+@pytest.mark.parametrize("fail", [False, True])
+def test_cleanup_failure_restores_stack_and_preserves_primary(kind, fail):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    error = RuntimeError("callback failed")
+    cleanup_error = OSError("resource cleanup failed")
+
+    with parent:
+        with pytest.raises(RuntimeError if fail else OSError) as caught:
+            with ctx:
+                if kind == "resource":
+                    ctx.with_resource(Resource(ctx, cleanup_error))
+                else:
+
+                    def cleanup():
+                        assert click.get_current_context() is ctx
+                        raise cleanup_error
+
+                    ctx.call_on_close(cleanup)
+                if fail:
+                    raise error
+        assert caught.value is (error if fail else cleanup_error)
+        if fail:
+            notes = getattr(error, "__notes__", ())
+            assert any(str(cleanup_error) in note for note in notes) or (
+                error.__cause__ is cleanup_error or error.__context__ is cleanup_error
+            )
+        assert click.get_current_context() is parent
+
+    # A failed cleanup must leave the context reusable without stale callbacks.
+    resource = Resource(ctx)
+    with ctx:
+        ctx.with_resource(resource)
+    assert resource.exits == [(None, None, None)]
+    assert click.get_current_context(silent=True) is None
