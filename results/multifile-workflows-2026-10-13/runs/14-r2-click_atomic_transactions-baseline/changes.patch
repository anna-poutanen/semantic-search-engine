+        with output:
+            if fail:
+                raise RuntimeError("unused output")
+    except RuntimeError:
+        assert fail
+    assert output._f is None
+    assert not list(tmp_path.iterdir())
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Windows has limited chmod support.")
+@pytest.mark.parametrize("lazy", [False, True, None])
+def test_command_atomic_permissions(runner, tmp_path, lazy):
+    path = tmp_path / "output"
+    path.write_text("original")
+    path.chmod(0o640)
+
+    @click.command()
+    @click.argument("output", type=click.File("w", atomic=True, lazy=lazy))
+    def cli(output):
+        output.write("replacement")
+
+    result = runner.invoke(cli, [str(path)])
+    assert result.exception is None
+    assert path.read_text() == "replacement"
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
