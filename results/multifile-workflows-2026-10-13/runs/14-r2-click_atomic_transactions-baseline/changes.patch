+import os
+import stat
+
+import pytest
+
+import click
+from click import _compat
+
+
+def assert_destination(path, expected):
+    if expected is None:
+        assert not path.exists()
+    else:
+        assert path.read_bytes() == expected
+
+
+def assert_cleanup_error(primary, cleanup):
+    notes = getattr(primary, "__notes__", ())
+    assert any(str(cleanup) in note for note in notes) or (
+        primary.__cause__ is cleanup or primary.__context__ is cleanup
+    )
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize(
+    "outcome", ["success", "error", "explicit-close", "error-after-close"]
+)
+def test_direct_atomic_transaction(tmp_path, lazy, mode, existing, outcome):
+    path = tmp_path / "output"
+    original = b"original" if existing else None
+    if existing:
+        path.write_bytes(original)
+    error = RuntimeError("body failed")
+    output = click.open_file(path, mode, atomic=True, lazy=lazy)
+
+    def write():
+        with output:
+            output.write(b"replacement" if "b" in mode else "replacement")
+            output.flush()
+            assert_destination(path, original)
+            if outcome in {"explicit-close", "error-after-close"}:
+                output.close()
+                assert_destination(path, b"replacement")
+            if outcome in {"error", "error-after-close"}:
+                raise error
+
+    if outcome in {"error", "error-after-close"}:
+        with pytest.raises(RuntimeError) as caught:
+            write()
+        assert caught.value is error
+    else:
+        write()
+
+    assert output.closed
+    output.close()
+    assert_destination(path, original if outcome == "error" else b"replacement")
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize(
+    "outcome",
+    [
+        "return",
+        "error",
+        "abort",
+        "click-error",
+        "exit-zero",
+        "exit-nonzero",
+        "system-exit-zero",
+        "system-exit-nonzero",
+        "explicit-close",
+        "error-after-close",
+    ],
+)
+def test_command_atomic_transaction(runner, tmp_path, lazy, mode, existing, outcome):
+    path = tmp_path / "output"
+    original = b"original" if existing else None
+    if existing:
+        path.write_bytes(original)
+    error = RuntimeError("callback failed")
+    handles = []
+
+    @click.command()
+    @click.argument("output", type=click.File(mode, atomic=True, lazy=lazy))
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        output.write(b"replacement" if "b" in mode else "replacement")
+        output.flush()
+        assert_destination(path, original)
+        if outcome == "error":
+            raise error
+        if outcome == "abort":
+            ctx.abort()
+        if outcome == "click-error":
+            raise click.ClickException("callback failed")
+        if outcome.startswith("exit-"):
+            ctx.exit(0 if outcome == "exit-zero" else 3)
+        if outcome.startswith("system-exit-"):
+            raise SystemExit(0 if outcome == "system-exit-zero" else 3)
+        if outcome in {"explicit-close", "error-after-close"}:
+            output.close()
+            assert_destination(path, b"replacement")
+            if outcome == "error-after-close":
+                raise error
+
+    result = runner.invoke(cli, [str(path)])
+    success = outcome in {"return", "exit-zero", "system-exit-zero", "explicit-close"}
+    assert (result.exit_code == 0) is success
+    if outcome in {"error", "error-after-close"}:
+        assert result.exception is error
+    committed = success or outcome == "error-after-close"
+    assert_destination(path, b"replacement" if committed else original)
+    assert handles[0].closed
+    handles[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [True, None])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_unused_lazy_command_output(runner, tmp_path, lazy, existing, fail):
+    path = tmp_path / "output"
