+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("missing", [False, True])
+def test_direct_abort_cleanup_preserves_exception(tmp_path, monkeypatch, lazy, missing):
+    path = tmp_path / "output"
+    path.write_text("original")
+    output = click.open_file(path, "w", atomic=True, lazy=lazy)
+    error = RuntimeError("body failed")
+    cleanup_error = PermissionError("cannot remove temporary output")
+
+    with pytest.raises(RuntimeError) as caught:
+        with output:
+            output.write("replacement")
+            if missing:
+                next(tmp_path.glob(".__atomic-write*")).unlink()
+            else:
+
+                def fail_unlink(filename):
+                    raise cleanup_error
+
+                monkeypatch.setattr(_compat.os, "unlink", fail_unlink)
+            raise error
+
+    assert caught.value is error
+    if not missing:
+        assert_cleanup_error(error, cleanup_error)
+    assert output.closed
+    assert output._f.closed
+    output.close()
+    assert path.read_text() == "original"
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("missing", [False, True])
+def test_command_abort_cleanup_preserves_exception(
+    runner, tmp_path, monkeypatch, lazy, missing
+):
+    path = tmp_path / "output"
+    path.write_text("original")
+    error = RuntimeError("callback failed")
+    cleanup_error = PermissionError("cannot remove temporary output")
+    handles = []
+
+    @click.command()
+    @click.argument("output", type=click.File("w", atomic=True, lazy=lazy))
