+        if fail:
+            raise RuntimeError("unused output")
+
+    result = runner.invoke(cli, [str(path)])
+    assert result.exit_code == int(fail)
+    assert handles[0]._f is None
+    assert_destination(path, original)
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_unused_lazy_direct_output(tmp_path, fail):
+    path = tmp_path / "output"
+    output = click.open_file(path, "w", atomic=True, lazy=True)
