@@ -1031,6 +1032,76 @@ class Response:
         if pending is not None:
             yield pending
 
+    def iter_json_lines(
+        self, chunk_size: int = ITER_CHUNK_SIZE, skip_blank: bool = True
+    ) -> Iterator[Any]:
+        """Lazily decode newline-delimited JSON from the response's byte stream.
+
+        When stream=True is set on the request, this avoids reading the full
+        response into memory. Already cached responses are also supported.
+        Each LF or CRLF-delimited line is decoded as UTF-8, regardless of
+        the response encoding. A UTF-8 BOM is accepted only at the start of
+        the first physical line. Whitespace-only lines are skipped by default.
+        The final line need not end with a newline.
+
+        :param chunk_size: Positive, non-boolean integer byte chunk size.
+        :param skip_blank: Whether to skip whitespace-only lines.
+        :raises ValueError: If either argument is invalid, before reading.
+        :raises requests.exceptions.JSONLineDecodeError: If a line contains
+            malformed JSON or UTF-8. The error includes its physical line
+            number, original bytes, response, request, and decoding cause.
+
+        .. note:: This method is not reentrant safe.
+        """
+        if (
+            not isinstance(chunk_size, int)
+            or isinstance(chunk_size, bool)
+            or chunk_size <= 0
+        ):
+            raise ValueError("chunk_size must be a positive, non-boolean integer")
+        if not isinstance(skip_blank, bool):
+            raise ValueError("skip_blank must be a boolean")
+
+        def lines() -> Iterator[bytes]:
+            pending = bytearray()
+            for chunk in self.iter_content(chunk_size=chunk_size, decode_unicode=False):
+                start = 0
+                while True:
+                    end = chunk.find(b"\n", start)
+                    if end == -1:
+                        pending.extend(chunk[start:])
+                        break
+                    pending.extend(chunk[start:end])
+                    if pending.endswith(b"\r"):
+                        del pending[-1:]
+                    line = bytes(pending)
+                    pending.clear()
+                    yield line
+                    start = end + 1
+            if pending:
+                yield bytes(pending)
+
+        def generate() -> Iterator[Any]:
+            for line_number, line in enumerate(lines(), start=1):
+                try:
+                    text = line.decode("utf-8")
+                    if line_number == 1 and text.startswith("\ufeff"):
+                        text = text[1:]
+                    # Some JSON decoders also accept a BOM on later lines.
+                    if text.lstrip(" \t\r\n").startswith("\ufeff"):
+                        raise JSONDecodeError(
+                            "Unexpected UTF-8 BOM", text, text.index("\ufeff")
+                        )
+                    if skip_blank and not text.strip():
+                        continue
+                    yield complexjson.loads(text)
+                except (UnicodeDecodeError, JSONDecodeError) as e:
+                    raise JSONLineDecodeError(
+                        str(e), line_number=line_number, line=line, response=self
+                    ) from e
+
+        return generate()
+
     @property
     def content(self) -> bytes:
         """Content of the response, in bytes."""
