+class JSONLineDecodeError(InvalidJSONError):
+    """Couldn't decode a UTF-8 JSON line from a response.
+
+    ``line_number`` is the one-based physical line number, including blank
+    lines. ``line`` contains the original bytes without the LF/CRLF delimiter.
+    """
+
+    line_number: int
+    line: bytes
+
+    def __init__(
+        self, message: str, *, line_number: int, line: bytes, **kwargs: Any
+    ) -> None:
+        self.line_number = line_number
+        self.line = line
+        super().__init__(message, **kwargs)
+
+
 class JSONDecodeError(InvalidJSONError, CompatJSONDecodeError):
     """Couldn't decode the text into json"""
 
