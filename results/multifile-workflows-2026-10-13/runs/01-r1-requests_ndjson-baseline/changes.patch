+    def iter_json_lines(
+        self, chunk_size: int = ITER_CHUNK_SIZE, skip_blank: bool = True
+    ) -> Iterator[Any]:
+        """Lazily decode newline-delimited JSON values from the response.
+
+        Lines are separated by LF or CRLF and decoded as UTF-8, regardless of
+        the response encoding. A UTF-8 BOM is accepted only at the start of
+        the first physical line. The final line need not have a delimiter.
+
+        :param chunk_size: Positive, non-boolean integer size for byte reads.
+        :param skip_blank: Whether to skip whitespace-only lines (default True).
+        :raises ValueError: If either argument is invalid, before reading.
+        :raises requests.exceptions.JSONLineDecodeError: If a line contains
+            malformed JSON or UTF-8. The error includes the physical line
+            number, original line bytes, response and request, and chains the
+            original decoding error as its cause.
+
+        .. note:: This method is not reentrant safe.
+        """
+        if (
+            isinstance(chunk_size, bool)
+            or not isinstance(chunk_size, int)
+            or chunk_size <= 0
+        ):
+            raise ValueError("chunk_size must be a positive, non-boolean integer")
+        if not isinstance(skip_blank, bool):
+            raise ValueError("skip_blank must be a boolean")
+
+        def line_bytes() -> Iterator[bytes]:
+            pending = bytearray()
+            for chunk in self.iter_content(chunk_size=chunk_size, decode_unicode=False):
+                start = 0
+                while (end := chunk.find(b"\n", start)) != -1:
+                    pending.extend(chunk[start:end])
+                    if pending.endswith(b"\r"):
+                        del pending[-1:]
+                    yield bytes(pending)
+                    pending.clear()
+                    start = end + 1
+                pending.extend(chunk[start:])
+            if pending:
+                yield bytes(pending)
+
+        def generate() -> Iterator[Any]:
+            for line_number, line in enumerate(line_bytes(), 1):
+                try:
+                    text = line.decode("utf-8-sig" if line_number == 1 else "utf-8")
+                    # Some JSON decoders accept a BOM on their own. Enforce
+                    # its position even when using those decoders.
+                    if text.startswith("\ufeff"):
+                        raise JSONDecodeError("Unexpected UTF-8 BOM", text, 0)
+                    if skip_blank and not text.strip():
+                        continue
+                    yield complexjson.loads(text)
+                except (JSONDecodeError, UnicodeDecodeError) as e:
+                    raise JSONLineDecodeError(
+                        f"Could not decode JSON on line {line_number}: {e}",
+                        line_number=line_number,
+                        line=line,
+                        response=self,
+                    ) from e
+
+        return generate()
+
     @property
     def content(self) -> bytes:
         """Content of the response, in bytes."""
