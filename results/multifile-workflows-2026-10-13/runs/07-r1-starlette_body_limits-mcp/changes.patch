+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+async def unreachable_app(scope: Scope, receive: Receive, send: Send) -> None:
+    raise AssertionError("Downstream app must not be called")
+
+
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, "1", b"1", [], {}, object()])
+def test_invalid_middleware_limit(max_bytes: Any) -> None:
+    with pytest.raises(ValueError):
+        RequestBodyLimitMiddleware(unreachable_app, max_bytes=max_bytes)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("headers", [[], [(b"content-length", b"1")], [(b"content-length", b"1000")]])
+@pytest.mark.parametrize("max_bytes, chunks", [(3, [b"ab", b"cd", b"later"]), (0, [b"x", b"later"])])
+async def test_middleware_rejects_observed_bytes_without_reading_later_chunks(
+    headers: list[tuple[bytes, bytes]], max_bytes: int, chunks: list[bytes]
+) -> None:
+    messages: list[Message] = [{"type": "http.request", "body": chunk, "more_body": True} for chunk in chunks]
+    sent: list[Message] = []
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    middleware = RequestBodyLimitMiddleware(unreachable_app, max_bytes=max_bytes)
+    await middleware({"type": "http", "headers": headers}, receive, send)
+
+    assert messages == [{"type": "http.request", "body": b"later", "more_body": True}]
+    assert len(sent) == 2
+    assert sent[0]["type"] == "http.response.start"
+    assert sent[0]["status"] == 413
+    assert (b"content-type", b"text/plain; charset=utf-8") in sent[0]["headers"]
+    assert sent[1] == {"type": "http.response.body", "body": b"Request body too large"}
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "max_bytes, chunks",
+    [(4, [b"ab", b"", b"cd"]), (5, [b"ab", b"cd"]), (0, [b"", b""]), (0, [b""])],
+)
+async def test_middleware_buffers_then_replays_body_and_delegates_disconnect(
+    max_bytes: int, chunks: list[bytes]
+) -> None:
+    disconnect: Message = {"type": "http.disconnect"}
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": i < len(chunks) - 1} for i, chunk in enumerate(chunks)
+    ] + [disconnect]
+    expected = b"".join(chunks)
+    called = False
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        pass
+
+    async def app(scope: Scope, downstream_receive: Receive, downstream_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert messages == [disconnect]
+        replay = await downstream_receive()
+        assert replay == {"type": "http.request", "body": expected, "more_body": False}
+        assert await downstream_receive() is disconnect
+        assert downstream_send is send
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=max_bytes)
+    # An overstated Content-Length must not reject an accepted body.
+    await middleware({"type": "http", "headers": [(b"content-length", b"1000")]}, receive, send)
+
+    assert called
+    assert messages == []
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("scope_type, max_bytes", [("http", None), ("websocket", 0), ("lifespan", 0)])
+async def test_middleware_passes_through_without_buffering(scope_type: str, max_bytes: int | None) -> None:
+    scope: Scope = {"type": scope_type}
+    called = False
+
+    async def receive() -> Message:
+        raise AssertionError("Pass-through must not read")
+
+    async def send(message: Message) -> None:
+        pass
+
+    async def app(downstream_scope: Scope, downstream_receive: Receive, downstream_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert downstream_scope is scope
+        assert downstream_receive is receive
+        assert downstream_send is send
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+    assert called
+
+
+@pytest.mark.anyio
+async def test_middleware_preserves_client_disconnect_while_buffering() -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"ab", "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        raise AssertionError("Disconnected request must not send")
+
+    middleware = RequestBodyLimitMiddleware(unreachable_app, max_bytes=2)
+    with pytest.raises(ClientDisconnect):
+        await middleware({"type": "http"}, receive, send)
+    assert messages == []
+
+
+@pytest.mark.parametrize("max_bytes, body", [(None, b'{"value": 1}'), (2, b"{}"), (0, b"")])
+def test_middleware_body_and_json_caching(
+    test_client_factory: TestClientFactory, max_bytes: int | None, body: bytes
+) -> None:
+    async def endpoint(request: Request) -> JSONResponse:
+        buffered = await request.body()
+        assert buffered == body
+        assert await request.body() is buffered
+        assert await request.body(max_bytes=len(body)) is buffered
+        if body:
+            parsed = await request.json()
+            assert await request.json() is parsed
+        else:
+            parsed = None
+        return JSONResponse(parsed)
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    response = test_client_factory(app).post("/", content=body)
+    assert response.status_code == 200
+    assert response.json() == ({"value": 1} if max_bytes is None else {} if body else None)
+
+
+@pytest.mark.parametrize("max_bytes", [None, 2])
+def test_middleware_preserves_endpoint_failures(test_client_factory: TestClientFactory, max_bytes: int | None) -> None:
+    error = RuntimeError("Endpoint failed")
+
+    async def endpoint(request: Request) -> PlainTextResponse:
+        assert await request.body() == b"ab"
+        raise error
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    with pytest.raises(RuntimeError, match="Endpoint failed") as caught:
+        test_client_factory(app).post("/", content=b"ab")
+    assert caught.value is error
+
+    response = test_client_factory(app, raise_server_exceptions=False).post("/", content=b"ab")
+    assert response.status_code == 500
+    assert response.text == "Internal Server Error"
