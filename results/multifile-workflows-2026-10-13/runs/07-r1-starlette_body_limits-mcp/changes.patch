+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+
+def make_request(messages: list[Message]) -> Request:
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    return Request({"type": "http", "headers": [(b"content-length", b"0")]}, receive)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "max_bytes, chunks",
+    [(None, [b"ab", b"cd"]), (4, [b"ab", b"", b"cd"]), (0, [b"", b""]), (0, [b""])],
+)
+async def test_body_limit_accepts_complete_body(max_bytes: int | None, chunks: list[bytes]) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": i < len(chunks) - 1} for i, chunk in enumerate(chunks)
+    ]
+    request = make_request(messages)
+    body = await request.body(max_bytes=max_bytes)
+
+    assert body == b"".join(chunks)
+    assert messages == []
+    assert await request.body() is body
+    assert await request.body(max_bytes=None) is body
+    assert await request.body(max_bytes=len(body)) is body
+    assert [chunk async for chunk in request.stream()] == [body, b""]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "max_bytes, chunks, received, read_count",
+    [
+        (0, [b"x", b"later"], 1, 1),
+        (3, [b"ab", b"", b"cd", b"later"], 4, 3),
+        (3, [b"abcd"], 4, 1),
+        (1, ["é".encode(), b"later"], 2, 1),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    max_bytes: int, chunks: list[bytes], received: int, read_count: int
+) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": i < len(chunks) - 1} for i, chunk in enumerate(chunks)
+    ]
+    remaining = messages[read_count:]
+    request = make_request(messages)
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=max_bytes)
+
+    assert isinstance(caught.value, HTTPException)
+    assert caught.value.status_code == 413
+    assert caught.value.detail == "Request body too large"
+    assert caught.value.limit == max_bytes
+    assert caught.value.received == received
+    assert messages == remaining
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, "1", b"1", [], {}, object()])
+@pytest.mark.parametrize("cached", [False, True])
+async def test_invalid_body_limit_does_not_receive(max_bytes: Any, cached: bool) -> None:
+    messages: list[Message] = [{"type": "http.request", "body": b"body"}]
+    request = make_request(messages)
+    if cached:
+        assert await request.body() == b"body"
+    remaining = messages.copy()
+
+    with pytest.raises(ValueError):
+        await request.body(max_bytes=max_bytes)
+
+    assert messages == remaining
+    assert hasattr(request, "_body") is cached
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_stricter_limit_checks_cached_body_without_receiving(json_first: bool) -> None:
+    body = b'{"value": 1}'
+    messages: list[Message] = [{"type": "http.request", "body": body}]
+    request = make_request(messages)
+    if json_first:
+        assert await request.json() == {"value": 1}
+    else:
+        assert await request.body(max_bytes=len(body)) == body
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=len(body) - 1)
+
+    assert caught.value.limit == len(body) - 1
+    assert caught.value.received == len(body)
+    assert await request.body() is request._body
+    parsed = await request.json()
+    assert parsed == {"value": 1}
+    assert await request.json() is parsed
+    assert messages == []
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [None, 2])
+@pytest.mark.parametrize("partial_body", [b"", b"ab"])
+async def test_body_limit_preserves_client_disconnect(max_bytes: int | None, partial_body: bytes) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": partial_body, "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+    request = make_request(messages)
+
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+
+    assert not hasattr(request, "_body")
+    assert await request.is_disconnected()
+    assert messages == []
+
+
+def test_body_limit_uses_http_exception_handler(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        return PlainTextResponse(await request.body(max_bytes=2))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    client = test_client_factory(app)
+    assert client.post("/", content=b"ab").content == b"ab"
+    response = client.post("/", content=b"abc")
+    assert response.status_code == 413
+    assert response.content == b"Request body too large"
