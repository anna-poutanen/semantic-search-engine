+@pytest.mark.parametrize(
+    "path, expected",
+    [
+        ("body/0", b""),
+        ("body/8", b"a" * 8),
+        ("gzip", b"a" * 40000),
+        ("unicode", "ééé".encode()),
+    ],
+    ids=["empty", "plain", "gzip", "unicode"],
+)
+@pytest.mark.parametrize("stream", [False, True])
+def test_unlimited_and_exact_boundaries_remain_compatible(
+    body_server, path, expected, stream
+):
+    base, _ = body_server
+    for limit in (None, len(expected)):
+        with requests.get(
