diff --git a/tests/test_response_limits.py b/tests/test_response_limits.py
new file mode 100644
index 0000000..6d36067
--- /dev/null
+++ b/tests/test_response_limits.py
@@ -0,0 +1,342 @@
+"""Regression tests for decoded response budgets without network access."""
+
+import io
+import pickle
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter, HTTPAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+
+class TrackedRaw(io.BytesIO):
+    def __init__(self, body, close_error=None):
+        super().__init__(body)
+        self.read_calls = []
+        self.close_calls = 0
+        self.close_error = close_error
+
+    def read(self, size=-1):
+        self.read_calls.append(size)
+        return super().read(size)
+
+    def close(self):
+        self.close_calls += 1
+        if self.close_error is not None:
+            raise self.close_error
+        super().close()
+
+
+class TrackedStreamingRaw(TrackedRaw):
+    def stream(self, size, decode_content):
+        assert decode_content is True
+        while True:
+            chunk = self.read(-1 if size is None else size)
+            if not chunk:
+                return
+            yield chunk
+
+
+class StrictAdapter(BaseAdapter):
+    """The explicit signature catches any budget passed to the transport."""
+
+    def __init__(self, response):
+        self.response = response
+        self.calls = 0
+
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        self.calls += 1
+        self.response.request = request
+        self.response.url = request.url
+        return self.response
+
+    def close(self):
+        pass
+
+
+def make_response(
+    body=b"abcdefgh", raw_type=TrackedRaw, cached=False, close_error=None
+):
+    response = requests.Response()
+    response.status_code = 200
+    response.raw = raw_type(body, close_error=close_error)
+    response.encoding = "utf-8"
+    if cached:
+        response._content = body
+        response._content_consumed = True
+    return response
+
+
+def send_response(response, limit, **kwargs):
+    session = requests.Session(max_response_bytes=limit)
+    session.trust_env = False
+    session.mount("http://", StrictAdapter(response))
+    return session.get("http://127.0.0.1/", **kwargs)
+
+
+def test_public_exception_is_request_exception():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    assert issubclass(ResponseTooLarge, RequestException)
+
+
+INVALID_LIMITS = [True, False, -1, 1.0, 0.0, "1", b"1", [], {}, object()]
+
+
+@pytest.mark.parametrize("limit", INVALID_LIMITS)
+@pytest.mark.parametrize(
+    "entrypoint", ["constructor", "request", "send", "get", "setting"]
+)
+def test_invalid_limits_fail_before_transport(monkeypatch, limit, entrypoint):
+    def unexpected_send(*args, **kwargs):
+        pytest.fail("transport called with an invalid response budget")
+
+    monkeypatch.setattr(HTTPAdapter, "send", unexpected_send)
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        if entrypoint == "constructor":
+            requests.Session(max_response_bytes=limit)
+        elif entrypoint == "get":
+            requests.get("http://127.0.0.1/", max_response_bytes=limit)
+        else:
+            with requests.Session() as session:
+                session.trust_env = False
+                if entrypoint == "request":
+                    session.request(
+                        "GET", "http://127.0.0.1/", max_response_bytes=limit
+                    )
+                elif entrypoint == "setting":
+                    session.max_response_bytes = limit
+                    session.get("http://127.0.0.1/")
+                else:
+                    prepared = requests.Request("GET", "http://127.0.0.1/").prepare()
+                    session.send(prepared, max_response_bytes=limit)
+
+
+@pytest.mark.parametrize("limit", [None, 0, 8])
+def test_session_setting_survives_pickle(limit):
+    with requests.Session(max_response_bytes=limit) as session:
+        restored = pickle.loads(pickle.dumps(session))
+    with restored:
+        assert restored.max_response_bytes == limit
+        restored.trust_env = False
+        response = make_response(b"abcdefghi")
+        restored.mount("http://", StrictAdapter(response))
+        if limit is None:
+            assert restored.get("http://127.0.0.1/").content == b"abcdefghi"
+        else:
+            with pytest.raises(ResponseTooLarge):
+                restored.get("http://127.0.0.1/")
+
+
+def test_old_session_pickle_defaults_to_unlimited():
+    with requests.Session() as session:
+        state = session.__getstate__()
+    state.pop("max_response_bytes")
+    restored = requests.Session.__new__(requests.Session)
+    restored.__setstate__(state)
+    with restored:
+        assert restored.max_response_bytes is None
+
+
+@pytest.mark.parametrize("direct_send", [False, True])
+@pytest.mark.parametrize("override", [None, 8])
+def test_request_can_override_session_budget(direct_send, override):
+    response = make_response()
+    with requests.Session(max_response_bytes=0) as session:
+        session.trust_env = False
+        adapter = StrictAdapter(response)
+        session.mount("http://", adapter)
+        if direct_send:
+            prepared = requests.Request("GET", "http://127.0.0.1/").prepare()
+            actual = session.send(prepared, max_response_bytes=override)
+        else:
+            actual = session.get("http://127.0.0.1/", max_response_bytes=override)
+    assert actual.content == b"abcdefgh"
+    assert adapter.calls == 1
+
+
+@pytest.mark.parametrize("raw_type", [TrackedRaw, TrackedStreamingRaw])
+@pytest.mark.parametrize("direct_send", [False, True])
+def test_omission_inherits_session_setting(raw_type, direct_send):
+    response = make_response(raw_type=raw_type)
+    with requests.Session(max_response_bytes=3) as session:
+        session.trust_env = False
+        session.mount("http://", StrictAdapter(response))
+        with pytest.raises(ResponseTooLarge) as exc:
+            if direct_send:
+                session.send(requests.Request("GET", "http://127.0.0.1/").prepare())
+            else:
+                session.get("http://127.0.0.1/")
+    assert exc.value.limit == 3
+    assert exc.value.received == 8
+    assert exc.value.response is response
+    assert exc.value.request is response.request
+    assert response.raw.close_calls == 1
+
+
+@pytest.mark.parametrize("raw_type", [TrackedRaw, TrackedStreamingRaw])
+def test_total_persists_across_iterators_and_failure_stops_all_reads(raw_type):
+    response = send_response(make_response(raw_type=raw_type), 4, stream=True)
+    first = response.iter_content(2)
+    second = response.iter_content(2)
+    waiting = response.iter_content(2)
+    assert next(first) == b"ab"
+    assert next(second) == b"cd"
+    with pytest.raises(ResponseTooLarge) as exc:
+        next(second)
+    assert exc.value.received == 6
+    assert response.raw.read_calls == [2, 2, 2]
+    assert response.raw.close_calls == 1
+
+    reads = list(response.raw.read_calls)
+    for read in (
+        lambda: next(first),
+        lambda: next(waiting),
+        lambda: response.content,
+        lambda: response.text,
+        lambda: response.json(),
+        lambda: response.iter_content(1),
+        lambda: next(response.iter_lines()),
+        lambda: next(iter(response)),
+    ):
+        with pytest.raises(ResponseTooLarge) as later:
+            read()
+        assert later.value is exc.value
+        assert later.value.received == 6
+    assert response.raw.read_calls == reads
+    assert response.raw.close_calls == 1
+
+
+@pytest.mark.parametrize("raw_type", [TrackedRaw, TrackedStreamingRaw])
+def test_partial_iterator_then_content_counts_previous_bytes(raw_type):
+    response = send_response(make_response(raw_type=raw_type), 6, stream=True)
+    assert next(response.iter_content(2)) == b"ab"
+    with pytest.raises(ResponseTooLarge) as exc:
+        response.content
+    assert exc.value.received == 8
+
+
+@pytest.mark.parametrize("raw_type", [TrackedRaw, TrackedStreamingRaw])
+def test_partial_iterator_then_cached_content_does_not_double_count(raw_type):
+    response = send_response(make_response(raw_type=raw_type), 8, stream=True)
+    assert next(response.iter_content(2)) == b"ab"
+    assert response.content == b"cdefgh"
+    assert response.content == b"cdefgh"
+    assert response.text == "cdefgh"
+    assert b"".join(response.iter_content(1)) == b"cdefgh"
+    assert b"".join(response.iter_content(None)) == b"cdefgh"
+    reads = list(response.raw.read_calls)
+    restored = pickle.loads(pickle.dumps(response))
+    assert restored.content == b"cdefgh"
+    assert b"".join(restored.iter_content(2)) == b"cdefgh"
+    assert response.raw.read_calls == reads
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("body, limit", [(b"", 0), (b"abcdefgh", 8)])
+def test_empty_and_exact_boundary_ignore_content_length(stream, body, limit):
+    response = make_response(body)
+    response.headers["Content-Length"] = "999999999"
+    response = send_response(response, limit, stream=stream)
+    if stream:
+        assert b"".join(response.iter_content(2)) == body
+    else:
+        assert response.content == body
+        assert b"".join(response.iter_content(2)) == body
+
+
+def test_zero_budget_rejects_first_nonempty_chunk():
+    response = send_response(make_response(b"x"), 0, stream=True)
+    with pytest.raises(ResponseTooLarge) as exc:
+        next(response.iter_content(1))
+    assert exc.value.received == 1
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_cleanup_failure_keeps_size_error_and_stops_reads(stream):
+    cleanup_error = RuntimeError("close failed")
+    response = make_response(close_error=cleanup_error)
+    with pytest.raises(ResponseTooLarge) as exc:
+        response = send_response(response, 1, stream=stream)
+        next(response.iter_content(2))
+    assert exc.value.__cause__ is cleanup_error
+    assert exc.value.response is response
+    assert exc.value.request is response.request
+    assert response.raw.close_calls == 1
+    reads = list(response.raw.read_calls)
+    with pytest.raises(ResponseTooLarge) as later:
+        response.content
+    assert later.value is exc.value
+    assert response.raw.read_calls == reads
+    # Permit BytesIO's eventual cleanup without a destructor exception.
+    response.raw.close_error = None
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_cached_response_returned_by_hook_is_checked_even_when_streaming(stream):
+    original = make_response(b"")
+    cached = make_response(cached=True)
+    called = []
+
+    def replacement(response, **kwargs):
+        return cached
+
+    def later_hook(response, **kwargs):
+        called.append(response)
+
+    with pytest.raises(ResponseTooLarge) as exc:
+        send_response(
+            original, 4, stream=stream, hooks={"response": [replacement, later_hook]}
+        )
+    assert exc.value.response is cached
+    assert exc.value.request is original.request
+    assert exc.value.received == 8
+    assert cached.raw.read_calls == []
+    assert called == []
+
+
+@pytest.mark.parametrize("cached", [False, True])
+def test_hooks_cannot_read_past_budget(cached):
+    response = make_response(cached=cached)
+
+    def consume(response, **kwargs):
+        response.text
+
+    with pytest.raises(ResponseTooLarge) as exc:
+        send_response(response, 4, stream=True, hooks={"response": consume})
+    assert exc.value.response is response
+    assert exc.value.received == 8
+
+
+def test_replacement_live_response_is_limited_before_next_hook_reads():
+    replacement = make_response()
+
+    def replace(response, **kwargs):
+        return replacement
+
+    def consume(response, **kwargs):
+        assert next(response.iter_content(4)) == b"abcd"
+        response.content
+
+    with pytest.raises(ResponseTooLarge) as exc:
+        send_response(
+            make_response(b""), 4, stream=True, hooks={"response": [replace, consume]}
+        )
+    assert exc.value.response is replacement
+    assert exc.value.received == 8
+    assert exc.value.request is not None
+
+
+def test_cached_hook_response_can_be_read_repeatedly_at_boundary():
+    cached = make_response(cached=True)
+    response = send_response(
+        make_response(b""), 8, stream=True, hooks={"response": lambda r, **kw: cached}
+    )
+    for _ in range(3):
+        assert response.content == b"abcdefgh"
+        assert response.text == "abcdefgh"
+        assert b"".join(response.iter_content(2)) == b"abcdefgh"
+        assert "".join(response.iter_content(1, decode_unicode=True)) == "abcdefgh"
+    assert response.raw.read_calls == []
