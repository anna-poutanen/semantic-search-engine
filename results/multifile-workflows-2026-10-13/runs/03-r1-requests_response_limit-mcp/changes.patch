+@pytest.mark.parametrize("direct_send", [False, True])
+@pytest.mark.parametrize("stream", [False, True])
+def test_explicit_none_disables_session_budget_for_entire_chain(
+    body_server, direct_send, stream
+):
+    base, _ = body_server
+    with requests.Session(max_response_bytes=0) as session:
+        if direct_send:
+            prepared = requests.Request("GET", base + "/chain/2/8").prepare()
+            response = session.send(
+                prepared, max_response_bytes=None, stream=stream, timeout=3
+            )
+        else:
+            response = session.get(
+                base + "/chain/2/8", max_response_bytes=None, stream=stream, timeout=3
+            )
+    assert [r.content for r in response.history] == [b"a" * 8, b"a" * 8]
+    assert response.content == b"a" * 8
+
