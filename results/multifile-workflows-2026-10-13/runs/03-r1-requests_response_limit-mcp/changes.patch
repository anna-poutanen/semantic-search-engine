+def test_resolved_request_budget_survives_session_changes_during_hooks(body_server):
+    base, _ = body_server
+    with requests.Session(max_response_bytes=4) as session:
+
+        def change_default(response, **kwargs):
+            session.max_response_bytes = 0
+
+        response = session.get(
+            base + "/chain/2/4", hooks={"response": change_default}, timeout=3
+        )
+    assert response.content == b"aaaa"
+    assert len(response.history) == 2
+
