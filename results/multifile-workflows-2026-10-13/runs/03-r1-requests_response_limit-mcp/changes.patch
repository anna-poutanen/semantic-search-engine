+"""Decoded response budgets exercised against a loopback HTTP server."""
+
+import gzip
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import requests
+from requests.exceptions import ResponseTooLarge
+
+
+@pytest.fixture(scope="module")
+def body_server():
+    seen = []
+
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, *args):
+            pass
+
+        def handle_body(self):
+            seen.append(self.path)
+            path = self.path.strip("/").split("/")
+            status = 200
+            headers = {
+                "Content-Type": "text/plain; charset=utf-8",
+                "Connection": "close",
+            }
+            if path[0] == "body":
+                body = b"a" * int(path[1])
+            elif path[0] == "unicode":
+                body = "ééé".encode()
+            elif path[0] in ("gzip", "deflate", "gzip-redirect"):
+                if path[0] == "deflate":
+                    body = zlib.compress(b"a" * 40000)
+                    headers["Content-Encoding"] = "deflate"
+                else:
+                    body = gzip.compress(b"a" * 40000)
+                    headers["Content-Encoding"] = "gzip"
+                if path[0] == "gzip-redirect":
+                    status = 302
+                    headers["Location"] = "/body/1"
+            elif path[0] == "redirect":
+                body = b"a" * int(path[1])
+                status = 302
+                headers["Location"] = f"/body/{path[2]}"
+            elif path[0] == "chain":
+                remaining, size = map(int, path[1:])
+                body = b"a" * size
+                if remaining:
+                    status = 302
+                    headers["Location"] = f"/chain/{remaining - 1}/{size}"
+            else:
+                body = b"abcdefghijkl"
+
+            if path[0] == "chunked":
+                headers["Transfer-Encoding"] = "chunked"
+            elif path[0] != "no-length":
+                headers["Content-Length"] = str(len(body))
+            self.send_response(status)
+            for name, value in headers.items():
+                self.send_header(name, value)
+            self.end_headers()
+            if self.command != "HEAD":
+                if path[0] == "chunked":
+                    for start in range(0, len(body), 4):
+                        chunk = body[start : start + 4]
+                        self.wfile.write(b"4\r\n" + chunk + b"\r\n")
+                    self.wfile.write(b"0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+            self.close_connection = True
+
+        do_GET = do_HEAD = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = (
+            handle_body
+        )
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever)
+    thread.start()
+    yield f"http://127.0.0.1:{server.server_port}", seen
+    server.shutdown()
+    thread.join()
+    server.server_close()
+
+
+@pytest.mark.parametrize(
+    "method", ["get", "options", "post", "put", "patch", "delete", "request"]
+)
+@pytest.mark.parametrize("use_session", [False, True])
+def test_http_helpers_surface_eager_size_error(body_server, method, use_session):
+    base, _ = body_server
+    with requests.Session() as session:
+        helper = getattr(session if use_session else requests, method)
+        args = ("GET", base + "/body/8") if method == "request" else (base + "/body/8",)
+        with pytest.raises(ResponseTooLarge) as exc:
+            helper(*args, max_response_bytes=4, timeout=3)
+    assert exc.value.limit == 4
+    assert exc.value.received == 8
+    assert exc.value.response.request is exc.value.request
+    assert exc.value.response.raw.closed
+
+
+@pytest.mark.parametrize("use_session", [False, True])
+def test_head_helper_accepts_zero_budget_despite_nonzero_length(
+    body_server, use_session
+):
+    base, _ = body_server
+    with requests.Session() as session:
+        helper = (session if use_session else requests).head
+        response = helper(base + "/body/8", max_response_bytes=0, timeout=3)
+    assert response.content == b""
+    assert response.headers["Content-Length"] == "8"
+
+
+@pytest.mark.parametrize("coding", ["gzip", "deflate"])
+def test_eager_budget_counts_decompressed_bytes(body_server, coding):
+    base, _ = body_server
+    with pytest.raises(ResponseTooLarge) as exc:
+        requests.get(base + "/" + coding, max_response_bytes=200, timeout=3)
+    assert int(exc.value.response.headers["Content-Length"]) < 200
+    assert exc.value.received > 200
+    assert exc.value.response.raw.closed
+
+
+@pytest.mark.parametrize("coding", ["gzip", "deflate"])
+def test_streaming_decompressed_boundary_and_first_crossing(body_server, coding):
+    base, _ = body_server
+    with requests.get(
+        base + "/" + coding, max_response_bytes=64, stream=True, timeout=3
+    ) as response:
+        chunks = response.iter_content(32)
+        assert next(chunks) == b"a" * 32
+        assert next(chunks) == b"a" * 32
+        with pytest.raises(ResponseTooLarge) as exc:
+            next(chunks)
+        assert exc.value.received == 96
+        assert response.raw.closed
+        with pytest.raises(ResponseTooLarge):
+            response.text
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_budget_counts_utf8_bytes_before_unicode_decoding(body_server, stream):
+    base, _ = body_server
+    yielded = []
+    with pytest.raises(ResponseTooLarge) as exc:
+        response = requests.get(
+            base + "/unicode", max_response_bytes=4, stream=stream, timeout=3
+        )
+        for chunk in response.iter_content(1, decode_unicode=True):
+            yielded.append(chunk)
+    if stream:
+        assert yielded == ["é", "é"]
+        assert exc.value.received == 5
+    else:
+        assert exc.value.received == 6
+
+
+@pytest.mark.parametrize("path", ["chunked", "no-length"])
+def test_budget_works_without_content_length(body_server, path):
+    base, _ = body_server
+    response = requests.get(
+        base + "/" + path, max_response_bytes=5, stream=True, timeout=3
+    )
+    assert "Content-Length" not in response.headers
+    chunks = response.iter_content(4)
+    assert next(chunks) == b"abcd"
+    with pytest.raises(ResponseTooLarge) as exc:
+        next(chunks)
+    assert exc.value.received == 8
+    assert response.raw.closed
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_redirect_budgets_are_independent(body_server, stream):
+    base, _ = body_server
+    with requests.Session(max_response_bytes=4) as session:
+        response = session.get(base + "/chain/2/4", stream=stream, timeout=3)
+    assert [r.content for r in response.history] == [b"aaaa", b"aaaa"]
+    assert response.content == b"aaaa"
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("allow_redirects", [False, True])
+def test_oversized_intermediate_redirect_stops_chain(
+    body_server, stream, allow_redirects
+):
+    base, seen = body_server
+    start = len(seen)
+    with pytest.raises(ResponseTooLarge) as exc:
+        requests.get(
+            base + "/redirect/8/1",
+            max_response_bytes=4,
+            stream=stream,
+            allow_redirects=allow_redirects,
+            timeout=3,
+        )
+    assert seen[start:] == ["/redirect/8/1"]
+    assert exc.value.response.status_code == 302
+    assert exc.value.received == 8
+    assert exc.value.response.raw.closed
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_final_redirect_response_has_its_own_budget(body_server, stream):
+    base, _ = body_server
+    with pytest.raises(ResponseTooLarge) as exc:
+        response = requests.get(
+            base + "/redirect/4/8", max_response_bytes=4, stream=stream, timeout=3
+        )
+        response.content
+    assert exc.value.response.status_code == 200
+    assert exc.value.response.url == base + "/body/8"
+    assert exc.value.received == 8
+
+
+def test_compressed_redirect_body_is_checked(body_server):
+    base, seen = body_server
+    start = len(seen)
+    with pytest.raises(ResponseTooLarge) as exc:
+        requests.get(
+            base + "/gzip-redirect", max_response_bytes=200, stream=True, timeout=3
+        )
+    assert seen[start:] == ["/gzip-redirect"]
+    assert exc.value.response.status_code == 302
+    assert exc.value.received > 200
+
