@@ -0,0 +1,69 @@
+from contextlib import contextmanager
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_nested_context_resource_receives_exception(failure):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    error = ValueError("callback failed")
+    exits = []
+
+    @contextmanager
+    def resource():
+        try:
+            yield
+        except BaseException as caught:
+            exits.append(caught)
+            raise
+        else:
+            exits.append(None)
+        finally:
+            assert click.get_current_context() is ctx
+
+    def run():
+        with ctx:
+            ctx.with_resource(resource())
+            with ctx:
+                assert click.get_current_context() is ctx
+                assert exits == []
+                if failure:
+                    raise error
+            assert exits == []
+
+    with outer:
+        if failure:
+            with pytest.raises(ValueError) as caught:
+                run()
+            assert caught.value is error
+        else:
+            run()
+        assert click.get_current_context() is outer
+        assert exits == [error if failure else None]
+        with ctx:
+            ctx.with_resource(resource())
+        assert exits[-1] is None
+    assert click.get_current_context(silent=True) is None
+
+
+def test_cleanup_failure_restores_context_stack():
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    error = RuntimeError("cleanup failed")
+
+    def fail():
+        assert click.get_current_context() is ctx
+        raise error
+
+    with outer:
+        with pytest.raises(RuntimeError) as caught:
+            with ctx:
+                ctx.call_on_close(fail)
+        assert caught.value is error
+        assert click.get_current_context() is outer
+        with ctx:
+            pass
+    assert click.get_current_context(silent=True) is None
