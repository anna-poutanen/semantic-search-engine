+import os
+import stat
+
+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("failure", [False, True])
+def test_open_file_transaction(tmp_path, lazy, mode, existing, failure):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+    error = ValueError("body failed")
+    payload = b"replacement" if "b" in mode else "replacement"
+    output = click.open_file(path, mode, lazy=lazy, atomic=True)
+
+    def write():
+        with output:
+            output.write(payload)
+            output.flush()
+            if existing:
+                assert path.read_bytes() == b"original"
+            else:
+                assert not path.exists()
+            if failure:
+                raise error
+
+    if failure:
+        with pytest.raises(ValueError) as caught:
+            write()
+        assert caught.value is error
+    else:
+        write()
+
+    if failure and not existing:
+        assert not path.exists()
+    else:
+        assert path.read_bytes() == (b"original" if failure else b"replacement")
+    assert output.closed
+    output.close()
+    assert list(tmp_path.glob(".__atomic-write*")) == []
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("outcome", ["return", "exit-zero", "exit-error", "raise"])
+@pytest.mark.parametrize("standalone", [False, True])
+def test_command_transaction(runner, tmp_path, lazy, mode, existing, outcome, standalone):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+    error = ValueError("callback failed")
+    handles = []
+
+    @click.command()
+    @click.argument("output", type=click.File(mode, lazy=lazy, atomic=True))
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        output.write(b"replacement" if "b" in mode else "replacement")
+        output.flush()
+        if existing:
+            assert path.read_bytes() == b"original"
+        else:
+            assert not path.exists()
+        if outcome == "exit-zero":
+            ctx.exit(0)
+        if outcome == "exit-error":
+            ctx.exit(7)
+        if outcome == "raise":
+            raise error
+
+    result = runner.invoke(cli, [str(path)], standalone_mode=standalone)
+    success = outcome in {"return", "exit-zero"}
+    if success:
+        assert result.exit_code == 0
+        assert result.exception is None
+    elif outcome == "raise":
+        assert result.exit_code != 0
+        assert result.exception is error
+    elif standalone:
+        assert result.exit_code == 7
+    else:
+        assert result.return_value == 7
+
+    if not success and not existing:
+        assert not path.exists()
+    else:
+        assert path.read_bytes() == (b"replacement" if success else b"original")
+    assert handles[0].closed
+    handles[0].close()
+    assert list(tmp_path.glob(".__atomic-write*")) == []
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [True, None])
+@pytest.mark.parametrize("failure", [False, True])
+def test_unused_lazy_output(runner, tmp_path, lazy, failure):
+    path = tmp_path / "missing-parent" / "output"
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    def cli(output):
+        if failure:
+            raise ValueError("callback failed")
+
+    result = runner.invoke(cli, [str(path)])
+    assert result.exit_code == int(failure)
+    assert not path.parent.exists()
+
+    with click.open_file(path, "w", lazy=True, atomic=True):
+        pass
+    assert not path.parent.exists()
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+def test_explicit_close_commits_before_later_error(tmp_path, lazy):
+    path = tmp_path / "output"
+    path.write_text("original")
+    with pytest.raises(ValueError):
+        with click.open_file(path, "w", lazy=lazy, atomic=True) as output:
+            output.write("replacement")
+            output.close()
+            output.close()
+            assert path.read_text() == "replacement"
+            raise ValueError("later error")
+    assert path.read_text() == "replacement"
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+def test_direct_context_exit_exception_aborts(tmp_path, lazy):
+    path = tmp_path / "output"
+    with pytest.raises(Exit):
+        with click.open_file(path, "w", lazy=lazy, atomic=True) as output:
+            output.write("replacement")
+            raise Exit(0)
+    assert not path.exists()
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("exit_zero", [False, True])
+def test_command_commit_failure_propagates(runner, tmp_path, monkeypatch, lazy, exit_zero):
+    path = tmp_path / "output"
+    path.write_text("original")
+    error = FileNotFoundError("commit failed")
+    handles = []
+
+    def fail_replace(*args):
+        raise error
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        output.write("replacement")
+        monkeypatch.setattr(os, "replace", fail_replace)
+        if exit_zero:
+            ctx.exit(0)
+
+    result = runner.invoke(cli, [str(path)])
+    assert result.exit_code != 0
+    assert result.exception is error
+    assert path.read_text() == "original"
+    assert handles[0].closed
+    handles[0].close()
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("cleanup", ["missing", "denied"])
+@pytest.mark.parametrize("command", [False, True])
+def test_abort_cleanup_preserves_error(runner, tmp_path, monkeypatch, lazy, cleanup, command):
+    path = tmp_path / "output"
+    path.write_text("original")
+    primary = ValueError("callback failed")
+    cleanup_error = PermissionError("abort cleanup denied")
+    handles = []
+
+    def fail_unlink(*args):
+        raise cleanup_error
+
+    def write(output):
+        handles.append(output)
+        output.write("replacement")
+        if cleanup == "missing":
+            for temp in tmp_path.glob(".__atomic-write*"):
+                temp.unlink()
+        else:
+            monkeypatch.setattr(os, "unlink", fail_unlink)
+        raise primary
+
+    if command:
+
+        @click.command()
+        @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+        def cli(output):
+            write(output)
+
+        result = runner.invoke(cli, [str(path)])
+        assert result.exception is primary
+        assert result.exit_code != 0
+    else:
+        with pytest.raises(ValueError) as caught:
+            with click.open_file(path, "w", lazy=lazy, atomic=True) as output:
+                write(output)
+        assert caught.value is primary
+
+    if cleanup == "denied":
+        notes = " ".join(getattr(primary, "__notes__", []))
+        assert "abort cleanup denied" in notes or primary.__context__ is cleanup_error
+    assert path.read_text() == "original"
+    assert handles[0].closed
+    handles[0].close()
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Windows has limited permission support")
+@pytest.mark.parametrize("lazy", [False, True, None])
+def test_command_preserves_permissions(runner, tmp_path, lazy):
+    path = tmp_path / "output"
+    path.write_text("original")
+    path.chmod(0o640)
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    def cli(output):
+        output.write("replacement")
+
+    result = runner.invoke(cli, [str(path)])
+    assert result.exit_code == 0
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+def test_non_atomic_file_still_writes_on_error(tmp_path, lazy):
+    path = tmp_path / "output"
+    with pytest.raises(ValueError):
+        with click.open_file(path, "w", lazy=lazy) as output:
+            output.write("replacement")
+            raise ValueError("body failed")
+    assert path.read_text() == "replacement"
+    assert output.closed
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+def test_standard_output_is_not_closed(runner, lazy, mode):
+    handles = []
+
+    @click.command()
+    @click.argument("output", type=click.File(mode, lazy=lazy, atomic=True))
+    def cli(output):
+        handles.append(output)
+        output.write(b"hello" if "b" in mode else "hello")
+        raise ValueError("callback failed")
+
+    # Check while the runner still owns its streams. Restoring stdout can
+    # destroy its text wrapper and close the buffer independently of Click.
+    with runner.isolation() as (stdout, _):
+        with pytest.raises(ValueError):
+            cli.main(["-"], prog_name="test", standalone_mode=False)
+        assert not handles[0].closed
+        handles[0].flush()
+        assert stdout.getvalue() == b"hello"
+        with pytest.raises(ValueError):
+            with click.open_file("-", mode, lazy=bool(lazy), atomic=True) as output:
+                raise ValueError("body failed")
+        assert not output.closed
