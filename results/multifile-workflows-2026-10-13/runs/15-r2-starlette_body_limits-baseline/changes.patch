@@ -0,0 +1,168 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import Response
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+
+class BodyStream:
+    def __init__(self, messages: list[Message]) -> None:
+        self.messages = messages
+        self.calls = 0
+
+    async def __call__(self) -> Message:
+        assert self.calls < len(self.messages), "Unexpected receive"
+        message = self.messages[self.calls]
+        self.calls += 1
+        return message
+
+
+def body_stream(chunks: list[bytes]) -> BodyStream:
+    return BodyStream(
+        [
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("cached", [False, True])
+@pytest.mark.parametrize("max_bytes", [True, False, -1, 1.0, float("nan"), float("inf"), "1", b"1", object()])
+async def test_invalid_body_limit_does_not_receive(max_bytes: Any, cached: bool) -> None:
+    receive = body_stream([b"abc"])
+    request = Request({"type": "http"}, receive)
+    if cached:
+        assert await request.body() == b"abc"
+    calls = receive.calls
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        await request.body(max_bytes=max_bytes)
+
+    assert receive.calls == calls
+    assert await request.body() == b"abc"
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,max_bytes",
+    [
+        ([b"ab", b"cd"], None),
+        ([b""], 0),
+        ([b"", b"", b""], 0),
+        ([b"ab", b"", b"cd"], 4),
+        ([b"abc"], 4),
+        (["é".encode()], 2),
+    ],
+)
+async def test_body_limit_accepts_boundary(chunks: list[bytes], max_bytes: int | None) -> None:
+    receive = body_stream(chunks)
+    request = Request({"type": "http", "headers": [(b"content-length", b"999999")]}, receive)
+
+    body = await request.body(max_bytes=max_bytes)
+
+    assert body == b"".join(chunks)
+    assert receive.calls == len(chunks)
+    assert await request.body(max_bytes=max_bytes) is body
+    assert await request.body() is body
+    assert receive.calls == len(chunks)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,max_bytes,received,calls",
+    [
+        ([b"abcd", b"later"], 3, 4, 1),
+        ([b"ab", b"cd", b"later"], 3, 4, 2),
+        ([b"ab", b"", b"cd", b"later"], 3, 4, 3),
+        ([b"ab", b"cd"], 3, 4, 2),
+        ([b"", b"x", b"later"], 0, 1, 2),
+        (["é".encode(), b"later"], 1, 2, 1),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    chunks: list[bytes], max_bytes: int, received: int, calls: int
+) -> None:
+    receive = body_stream(chunks)
+    request = Request({"type": "http", "headers": [(b"content-length", b"0")]}, receive)
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=max_bytes)
+
+    assert isinstance(caught.value, HTTPException)
+    assert caught.value.status_code == 413
+    assert caught.value.limit == max_bytes
+    assert caught.value.received == received
+    assert receive.calls == calls
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_cached_body_limit_and_json(json_first: bool) -> None:
+    data = b'{"value":123}'
+    receive = body_stream([data[:5], data[5:]])
+    request = Request({"type": "http"}, receive)
+    if json_first:
+        parsed = await request.json()
+        body = await request.body()
+    else:
+        body = await request.body(max_bytes=len(data))
+        parsed = await request.json()
+
+    assert parsed == {"value": 123}
+    for limit in (0, len(data) - 1):
+        with pytest.raises(RequestBodyTooLarge) as caught:
+            await request.body(max_bytes=limit)
+        assert caught.value.limit == limit
+        assert caught.value.received == len(data)
+
+    assert await request.body(max_bytes=len(data)) is body
+    assert await request.body(max_bytes=None) is body
+    assert await request.json() is parsed
+    assert b"".join([chunk async for chunk in request.stream()]) == data
+    assert receive.calls == 2
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [None, 4])
+async def test_body_limit_preserves_disconnect(max_bytes: int | None) -> None:
+    receive = BodyStream(
+        [
+            {"type": "http.request", "body": b"ab", "more_body": True},
+            {"type": "http.disconnect"},
+            {"type": "http.request", "body": b"later"},
+        ]
+    )
+    request = Request({"type": "http"}, receive)
+
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+
+    assert receive.calls == 2
+    assert not hasattr(request, "_body")
+    assert await request.is_disconnected()
+    assert receive.calls == 2
+
+
+def test_body_limit_http_exception_integration(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        return Response(await request.body(max_bytes=3))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    client = test_client_factory(app)
+
+    response = client.post("/", content=b"abc")
+    assert response.status_code == 200
+    assert response.content == b"abc"
+    response = client.post("/", content=b"abcd")
+    assert response.status_code == 413
+    assert response.text == "Request body too large"
