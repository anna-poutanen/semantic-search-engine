+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+@pytest.mark.parametrize("max_bytes", [True, False, -1, 1.0, float("nan"), float("inf"), "1", b"1", object()])
+def test_invalid_middleware_limit(max_bytes: Any) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("App should not be called during construction")
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        RequestBodyLimitMiddleware(app, max_bytes=max_bytes)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("scope_type,max_bytes", [("http", None), ("websocket", 0), ("lifespan", 0)])
+async def test_body_limit_passthrough(scope_type: str, max_bytes: int | None) -> None:
+    called = False
+    scope: Scope = {"type": scope_type}
+
+    async def receive() -> Message:
+        pytest.fail("Middleware must not receive")
+
+    async def send(message: Message) -> None:
+        pytest.fail("Middleware must not send")
+
+    async def app(app_scope: Scope, app_receive: Receive, app_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert app_scope is scope
+        assert app_receive is receive
+        assert app_send is send
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+    assert called
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,max_bytes,content_length",
+    [
+        ([b""], 0, b"9999"),
+        ([b"", b"", b""], 0, None),
+        ([b"ab", b"", b"cd"], 4, b"9999"),
+        ([b"abc"], 4, b"0"),
+        (["é".encode()], 2, b"invalid"),
+    ],
+)
+async def test_body_limit_buffers_then_replays(
+    chunks: list[bytes], max_bytes: int, content_length: bytes | None
+) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    disconnect: Message = {"type": "http.disconnect"}
+    calls = 0
+    called = False
+
+    async def receive() -> Message:
+        nonlocal calls
+        calls += 1
+        assert calls <= len(messages) + 1
+        return messages[calls - 1] if calls <= len(messages) else disconnect
+
+    async def send(message: Message) -> None:
+        pytest.fail("No response expected")
+
+    async def app(scope: Scope, app_receive: Receive, send: Send) -> None:
+        nonlocal called
+        called = True
+        assert calls == len(messages)
+        replayed = [await app_receive() for _ in messages]
+        assert replayed == messages
+        assert b"".join(message.get("body", b"") for message in replayed) == b"".join(chunks)
+        assert calls == len(messages)
+        assert await app_receive() is disconnect
+        assert calls == len(messages) + 1
+
+    headers = [] if content_length is None else [(b"content-length", content_length)]
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)({"type": "http", "headers": headers}, receive, send)
+    assert called
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,max_bytes,expected_calls",
+    [
+        ([b"abcd", b"later"], 3, 1),
+        ([b"ab", b"cd", b"later"], 3, 2),
+        ([b"ab", b"", b"cd", b"later"], 3, 3),
+        ([b"ab", b"cd"], 3, 2),
+        ([b"", b"x", b"later"], 0, 2),
+        (["é".encode(), b"later"], 1, 1),
+    ],
+)
+@pytest.mark.parametrize("content_length", [None, b"0", b"1", b"9999", b"invalid"])
+async def test_body_limit_rejects_before_app(
+    chunks: list[bytes], max_bytes: int, expected_calls: int, content_length: bytes | None
+) -> None:
+    calls = 0
+    sent: list[Message] = []
+
+    async def receive() -> Message:
+        nonlocal calls
+        assert calls < expected_calls, "Read beyond first crossing"
+        chunk = chunks[calls]
+        calls += 1
+        return {"type": "http.request", "body": chunk, "more_body": calls < len(chunks)}
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Oversize requests must not reach the app")
+
+    headers = [] if content_length is None else [(b"content-length", content_length)]
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)({"type": "http", "headers": headers}, receive, send)
+
+    assert calls == expected_calls
+    assert sent[0]["type"] == "http.response.start"
+    assert sent[0]["status"] == 413
+    assert dict(sent[0]["headers"])[b"content-type"] == b"text/plain; charset=utf-8"
+    assert sent[1:] == [{"type": "http.response.body", "body": b"Request body too large"}]
+
+
+@pytest.mark.anyio
+async def test_body_limit_preserves_disconnect() -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"ab", "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+    calls = 0
+    called = False
+
+    async def receive() -> Message:
+        nonlocal calls
+        assert calls < len(messages)
+        message = messages[calls]
+        calls += 1
+        return message
+
+    async def send(message: Message) -> None:
+        pytest.fail("No response expected")
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        nonlocal called
+        called = True
+        with pytest.raises(ClientDisconnect):
+            await Request(scope, receive).body()
+
+    await RequestBodyLimitMiddleware(app, max_bytes=4)({"type": "http"}, receive, send)
+    assert called
+    assert calls == 2
+
+
+@pytest.mark.parametrize("max_bytes", [None, 13])
+def test_body_limit_json_and_cached_reads(test_client_factory: TestClientFactory, max_bytes: int | None) -> None:
+    async def endpoint(request: Request) -> JSONResponse:
+        parsed = await request.json()
+        body = await request.body()
+        assert await request.body(max_bytes=len(body)) is body
+        assert await request.body() is body
+        assert await request.json() is parsed
+        return JSONResponse(parsed)
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    response = test_client_factory(app).post("/", content=b'{"value":123}')
+    assert response.status_code == 200
+    assert response.json() == {"value": 123}
+
+
+def test_body_limit_rejection_integration(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        pytest.fail("Oversize requests must not reach the endpoint")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=3)],
+    )
+    response = test_client_factory(app).post("/", content=b"abcd")
+    assert response.status_code == 413
+    assert response.content == b"Request body too large"
+    assert response.headers["content-type"] == "text/plain; charset=utf-8"
+
+
+@pytest.mark.parametrize("raise_server_exceptions", [False, True])
+def test_body_limit_preserves_endpoint_failure(
+    test_client_factory: TestClientFactory, raise_server_exceptions: bool
+) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        assert await request.body() == b"abc"
+        raise RuntimeError("endpoint failed")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=3)],
+    )
+    client = test_client_factory(app, raise_server_exceptions=raise_server_exceptions)
+    if raise_server_exceptions:
+        with pytest.raises(RuntimeError, match="endpoint failed"):
+            client.post("/", content=b"abc")
+    else:
+        response = client.post("/", content=b"abc")
+        assert response.status_code == 500
+        assert response.text == "Internal Server Error"
