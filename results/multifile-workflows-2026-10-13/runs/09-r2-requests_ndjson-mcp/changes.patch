@@ -0,0 +1,88 @@
+"""Loopback HTTP coverage for newline-delimited JSON responses."""
+
+import gzip
+import threading
+
+import pytest
+
+import requests
+from requests.compat import JSONDecodeError
+from tests.testserver.server import Server, consume_socket_content
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("compressed", [False, True])
+@pytest.mark.parametrize("chunk_size", [1, 512])
+def test_chunked_http_json_lines(stream, compressed, chunk_size):
+    body = b"\xef\xbb\xbf" + '{"text":"雪😀"}\r\n \t\nnull\n\n'.encode()
+    bad_line = b'{"broken": }'
+    body += bad_line + b"\r\n"
+    wire_body = gzip.compress(body) if compressed else body
+
+    def handler(sock):
+        consume_socket_content(sock, timeout=0.05)
+        headers = (
+            b"HTTP/1.1 200 OK\r\n"
+            b"Content-Type: application/x-ndjson; charset=iso-8859-1\r\n"
+            b"Transfer-Encoding: chunked\r\n"
+        )
+        if compressed:
+            headers += b"Content-Encoding: gzip\r\n"
+        chunked_body = bytearray()
+        for start in range(0, len(wire_body), 3):
+            chunk = wire_body[start : start + 3]
+            chunked_body.extend(f"{len(chunk):x}\r\n".encode() + chunk + b"\r\n")
+        sock.sendall(headers + b"\r\n" + chunked_body + b"0\r\n\r\n")
+
+    with Server(handler, host="127.0.0.1") as (host, port):
+        with requests.Session() as session:
+            session.trust_env = False
+            with session.get(
+                f"http://{host}:{port}/", stream=stream, timeout=5
+            ) as response:
+                assert response.encoding == "iso-8859-1"
+                values = response.iter_json_lines(chunk_size)
+                assert next(values) == {"text": "雪😀"}
+                assert next(values) is None
+                with pytest.raises(requests.JSONLineDecodeError) as caught:
+                    next(values)
+                assert caught.value.line_number == 5
+                assert caught.value.line == bad_line
+                assert caught.value.response is response
+                assert caught.value.request is response.request
+                assert isinstance(caught.value.__cause__, JSONDecodeError)
+                if stream:
+                    assert response._content is False
+                else:
+                    assert response.content == body
+
+
+def test_first_record_is_available_before_http_body_finishes():
+    finish_body = threading.Event()
+
+    def handler(sock):
+        consume_socket_content(sock, timeout=0.05)
+        sock.sendall(
+            b"HTTP/1.1 200 OK\r\n"
+            b"Content-Type: application/x-ndjson\r\n"
+            b"Transfer-Encoding: chunked\r\n\r\n"
+            b"2\r\n1\n\r\n"
+        )
+        if finish_body.wait(5):
+            sock.sendall(b"2\r\n2\n\r\n0\r\n\r\n")
+
+    with Server(handler, host="127.0.0.1") as (host, port):
+        with requests.Session() as session:
+            session.trust_env = False
+            try:
+                with session.get(
+                    f"http://{host}:{port}/", stream=True, timeout=2
+                ) as response:
+                    values = response.iter_json_lines()
+                    assert next(values) == 1
+                    assert response._content is False
+                    assert not finish_body.is_set()
+                    finish_body.set()
+                    assert list(values) == [2]
+            finally:
+                finish_body.set()
