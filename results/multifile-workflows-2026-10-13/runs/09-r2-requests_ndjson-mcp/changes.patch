             yield pending
 
+    def iter_json_lines(
+        self, chunk_size: int = ITER_CHUNK_SIZE, skip_blank: bool = True
+    ) -> Iterator[Any]:
+        """Lazily decode newline-delimited JSON values from the response.
+
+        Lines are separated by LF or CRLF and decoded as UTF-8 regardless of
+        :attr:`encoding`. A UTF-8 BOM is accepted only at the start of the
+        first physical line. With ``stream=True``, only the current line and
+        chunk are buffered. Cached response content is also supported.
+
+        :param chunk_size: Positive, non-boolean integer byte chunk size.
+        :param skip_blank: Whether to skip whitespace-only lines.
+        :raises ValueError: If either argument is invalid.
+        :raises requests.exceptions.JSONLineDecodeError: If a line contains
+            malformed JSON or UTF-8. The error includes the physical line
+            number and original bytes, and chains the decoding exception.
+
+        .. note:: This method is not reentrant safe.
+        """
+        if (
+            isinstance(chunk_size, bool)
+            or not isinstance(chunk_size, int)
+            or chunk_size <= 0
+        ):
+            raise ValueError("chunk_size must be a positive, non-boolean integer")
+        if not isinstance(skip_blank, bool):
+            raise ValueError("skip_blank must be a boolean")
+
+        def decode_line(line: bytes, line_number: int) -> Iterator[Any]:
+            try:
+                text = line.decode("utf-8-sig" if line_number == 1 else "utf-8")
+                if text.startswith("\ufeff"):
+                    raise JSONDecodeError("Unexpected UTF-8 BOM", text, 0)
+                if skip_blank and not text.strip():
+                    return
+                value = complexjson.loads(text)
+            except (UnicodeDecodeError, JSONDecodeError) as e:
+                raise JSONLineDecodeError(
+                    f"Failed to decode JSON on line {line_number}: {e}",
+                    line_number=line_number,
+                    line=line,
+                    response=self,
+                ) from e
+            yield value
+
+        def generate() -> Iterator[Any]:
+            pending = bytearray()
+            line_number = 0
+            for chunk in self.iter_content(chunk_size=chunk_size):
+                start = 0
+                while True:
+                    end = chunk.find(b"\n", start)
+                    if end < 0:
+                        pending.extend(chunk[start:])
+                        break
+                    pending.extend(chunk[start:end])
+                    line = bytes(pending)
+                    pending.clear()
+                    if line.endswith(b"\r"):
+                        line = line[:-1]
+                    line_number += 1
+                    yield from decode_line(line, line_number)
+                    start = end + 1
+            if pending:
+                yield from decode_line(bytes(pending), line_number + 1)
+
+        return generate()
+
     @property
     def content(self) -> bytes:
         """Content of the response, in bytes."""
