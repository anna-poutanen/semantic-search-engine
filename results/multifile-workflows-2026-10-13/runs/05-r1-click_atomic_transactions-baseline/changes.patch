+++ b/tests/test_context_resources.py
@@ -0,0 +1,108 @@
+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+class Resource:
+    def __init__(self, ctx, events, cleanup_error=None):
+        self.ctx = ctx
+        self.events = events
+        self.cleanup_error = cleanup_error
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, tb):
+        assert click.get_current_context() is self.ctx
+        self.events.append((exc_type, exc_value, tb))
+        if self.cleanup_error is not None:
+            raise self.cleanup_error
+
+
+@pytest.mark.parametrize(
+    "error", [None, ValueError("callback"), Exit(3), SystemExit(4), KeyboardInterrupt()]
+)
+def test_context_resources_receive_exception_at_outermost_exit(error):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    events = []
+    with parent:
+
+        def run():
+            with ctx:
+                resource = Resource(ctx, events)
+                assert ctx.with_resource(resource) is resource
+                with ctx.scope():
+                    with ctx:
+                        assert click.get_current_context() is ctx
+                        if error is not None:
+                            raise error
+                assert events == []
+
+        if error is None:
+            run()
+        else:
+            with pytest.raises(type(error)) as caught:
+                run()
+            assert caught.value is error
+        assert click.get_current_context() is parent
+        assert len(events) == 1
+        exc_type, exc_value, tb = events[0]
+        assert exc_type is (type(error) if error is not None else None)
+        assert exc_value is error
+        assert (tb is not None) == (error is not None)
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("body_error", [False, True])
+def test_context_cleanup_failure_restores_stack_and_preserves_callback(body_error):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    events = []
+    primary = ValueError("callback failed")
+    cleanup = OSError("resource cleanup failed")
+    with parent:
+        with pytest.raises(ValueError if body_error else OSError) as caught:
+            with ctx:
+                ctx.with_resource(Resource(ctx, events, cleanup))
+                if body_error:
+                    raise primary
+        assert caught.value is (primary if body_error else cleanup)
+        assert click.get_current_context() is parent
+        assert len(events) == 1
+        if body_error:
+            assert (
+                any(
+                    "resource cleanup failed" in note
+                    for note in getattr(primary, "__notes__", ())
+                )
+                or primary.__context__ is cleanup
+            )
+        with ctx:
+            ctx.with_resource(Resource(ctx, events))
+        assert len(events) == 2
+        assert events[-1] == (None, None, None)
+    assert click.get_current_context(silent=True) is None
+
+
+def test_context_close_remains_explicit_success():
+    ctx = click.Context(click.Command("test"))
+    events = []
+    with ctx:
+        ctx.with_resource(Resource(ctx, events))
+        ctx.close()
+        ctx.close()
+        assert events == [(None, None, None)]
+    assert events == [(None, None, None)]
+
+
+def test_context_resources_close_in_reverse_order():
+    events = []
+    with click.Context(click.Command("test")) as ctx:
+        ctx.call_on_close(lambda: events.append("first"))
+        ctx.call_on_close(lambda: events.append("second"))
+        with ctx.scope(cleanup=False):
+            assert events == []
+        assert events == []
+    assert events == ["second", "first"]
