+import io
+import os
+import stat
+import sys
+
+import pytest
+
+import click
+
+
+def assert_destination(path, existing, committed, payload):
+    if committed:
+        assert path.read_bytes() == payload
+    elif existing:
+        assert path.read_bytes() == b"original"
+    else:
+        assert not path.exists()
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("mode, payload", [("w", "updated"), ("wb", b"updated")])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_direct_atomic_transaction(tmp_path, lazy, mode, payload, existing, fail):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+        path.chmod(0o640)
+    error = ValueError("body failed")
+
+    def write():
+        with click.open_file(path, mode, lazy=lazy, atomic=True) as output:
+            output.write(payload)
+            output.flush()
+            assert_destination(path, existing, False, b"updated")
+            assert len(list(tmp_path.glob(".__atomic-write*"))) == 1
+            if fail:
+                raise error
+        return output
+
+    if fail:
+        with pytest.raises(ValueError) as caught:
+            write()
+        assert caught.value is error
+    else:
+        output = write()
+        assert output.closed
+        output.close()
+
+    assert_destination(path, existing, not fail, b"updated")
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    if existing and os.name != "nt":
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode, payload", [("w", "updated"), ("wb", b"updated")])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize(
+    "outcome", ["return", "exit-zero", "exit-error", "error", "abort", "system-exit"]
+)
+@pytest.mark.parametrize("standalone", [False, True])
+def test_command_atomic_transaction(
+    runner, tmp_path, lazy, mode, payload, existing, outcome, standalone
+):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+        path.chmod(0o640)
+    error = ValueError("callback failed")
+    files = []
+
+    @click.command()
+    @click.argument("output", type=click.File(mode, lazy=lazy, atomic=True))
+    @click.pass_context
+    def cli(ctx, output):
+        files.append(output)
+        output.write(payload)
+        output.flush()
+        assert_destination(path, existing, False, b"updated")
+        if outcome == "exit-zero":
+            ctx.exit(0)
+        if outcome == "exit-error":
+            ctx.exit(3)
+        if outcome == "error":
+            raise error
+        if outcome == "abort":
+            ctx.abort()
+        if outcome == "system-exit":
+            sys.exit(4)
+
+    result = runner.invoke(cli, [str(path)], standalone_mode=standalone)
+    committed = outcome in {"return", "exit-zero"}
+    if outcome == "exit-error" and not standalone:
+        assert result.exit_code == 0
+        assert result.return_value == 3
+    else:
+        assert (result.exit_code == 0) == committed
+    if outcome == "error":
+        assert result.exception is error
+    assert_destination(path, existing, committed, b"updated")
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert files[0].closed
+    files[0].close()
+    assert click.get_current_context(silent=True) is None
+    if existing and os.name != "nt":
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize("command", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("outcome", ["return", "exit-zero", "error"])
+@pytest.mark.parametrize("lazy", [True, None])
+def test_unused_lazy_atomic_file(runner, tmp_path, command, existing, outcome, lazy):
+    path = tmp_path / "output"
+    if existing:
+        path.write_bytes(b"original")
+    files = []
+    error = ValueError("unused output")
+
+    def use(output):
+        files.append(output)
+        assert output._f is None
+        if outcome == "error":
+            raise error
+
+    if command:
+
+        @click.command()
+        @click.option("--output", type=click.File("w", lazy=lazy, atomic=True))
+        @click.pass_context
+        def cli(ctx, output):
+            use(output)
+            if outcome == "exit-zero":
+                ctx.exit()
+
+        result = runner.invoke(cli, ["--output", str(path)])
+        assert (
+            result.exception is error if outcome == "error" else result.exit_code == 0
+        )
+    else:
+
+        def use_context():
+            with click.open_file(path, "w", lazy=True, atomic=True) as output:
+                use(output)
+
+        if outcome == "error":
+            with pytest.raises(ValueError, match="unused output"):
+                use_context()
+        else:
+            use_context()
+
+    assert files[0]._f is None
+    files[0].close()
+    assert files[0]._f is None
+    assert_destination(path, existing, False, b"")
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("explicit_close", [False, True])
+def test_direct_atomic_close_is_final(tmp_path, lazy, explicit_close):
+    path = tmp_path / "output"
+    path.write_text("original")
+    output = click.open_file(path, "w", lazy=lazy, atomic=True)
+    with pytest.raises(ValueError, match="body failed"):
+        with output:
+            output.write("updated")
+            if explicit_close:
+                output.close()
+                output.close()
+                assert path.read_text() == "updated"
+            raise ValueError("body failed")
+    assert output.closed
+    output.close()
+    assert path.read_text() == ("updated" if explicit_close else "original")
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("standalone", [False, True])
+@pytest.mark.parametrize("explicit_exit", [False, True])
+def test_command_commit_failure_propagates(
+    runner, tmp_path, lazy, standalone, explicit_exit
+):
+    path = tmp_path / "output"
+    path.write_text("original")
+    files = []
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=lazy, atomic=True))
+    @click.pass_context
+    def cli(ctx, output):
+        files.append(output)
+        output.write("updated")
+        next(tmp_path.glob(".__atomic-write*")).unlink()
+        if explicit_exit:
+            ctx.exit(0)
+
+    result = runner.invoke(cli, ["--output", str(path)], standalone_mode=standalone)
+    assert result.exit_code != 0
+    assert isinstance(result.exception, FileNotFoundError)
+    assert files[0].closed
+    files[0].close()
+    assert path.read_text() == "original"
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+def test_direct_commit_failure_propagates(tmp_path, lazy):
+    path = tmp_path / "output"
+    with pytest.raises(FileNotFoundError):
+        with click.open_file(path, "w", lazy=lazy, atomic=True) as output:
+            output.write("updated")
+            next(tmp_path.glob(".__atomic-write*")).unlink()
+    assert output.closed
+    output.close()
+    assert not path.exists()
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("command", [False, True])
+@pytest.mark.parametrize("cleanup", ["missing", "unlink-error", "close-error"])
+def test_abort_preserves_primary_exception(
+    runner, tmp_path, monkeypatch, lazy, command, cleanup
+):
+    path = tmp_path / "output"
+    path.write_text("original")
+    error = ValueError("primary callback error")
+    cleanup_error = OSError("abort cleanup failed")
+    files = []
+    real_unlink = os.unlink
+
+    def use(output):
+        files.append(output)
+        output.write("updated")
+        temporary = next(tmp_path.glob(".__atomic-write*"))
+        if cleanup == "missing":
+            temporary.unlink()
+        elif cleanup == "unlink-error":
+
+            def fail_unlink(filename, *args, **kwargs):
+                if os.fspath(filename) == str(temporary):
+                    raise cleanup_error
+                return real_unlink(filename, *args, **kwargs)
+
+            monkeypatch.setattr(os, "unlink", fail_unlink)
+        else:
+            atomic = output._f if lazy is not False else output
+            real_close = atomic._f.close
+
+            def fail_close():
+                real_close()
+                raise cleanup_error
+
+            monkeypatch.setattr(atomic._f, "close", fail_close)
+        raise error
+
+    if command:
+
+        @click.command()
+        @click.option("--output", type=click.File("w", lazy=lazy, atomic=True))
+        def cli(output):
+            use(output)
+
+        result = runner.invoke(cli, ["--output", str(path)])
+        assert result.exception is error
+        assert result.exit_code != 0
+    else:
+        with pytest.raises(ValueError) as caught:
+            with click.open_file(
+                path, "w", lazy=lazy is not False, atomic=True
+            ) as output:
+                use(output)
+        assert caught.value is error
+
+    assert files[0].closed
+    files[0].close()
+    assert path.read_text() == "original"
+    if cleanup != "missing":
+        assert (
+            any(
+                "abort cleanup failed" in note
+                for note in getattr(error, "__notes__", ())
+            )
+            or error.__context__ is cleanup_error
+        )
+    if cleanup == "unlink-error":
+        real_unlink(next(tmp_path.glob(".__atomic-write*")))
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("mode, payload", [("w", "updated"), ("wb", b"updated")])
+def test_standard_output_is_not_owned(monkeypatch, lazy, atomic, mode, payload):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    with monkeypatch.context() as patch:
+        patch.setattr(sys, "stdout", stream)
+        with click.open_file("-", mode, lazy=lazy, atomic=atomic) as output:
+            output.write(payload)
+            output.close()
+            output.close()
+        assert not stream.closed
+        with click.Context(click.Command("test")) as ctx:
+            output = click.File(mode, lazy=lazy, atomic=atomic).convert("-", None, ctx)
+            output.write(payload)
+        assert not stream.closed
+    stream.close()
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+def test_non_atomic_output_still_writes_on_failure(runner, tmp_path, lazy):
+    path = tmp_path / "output"
+    path.write_text("original")
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy))
+    def cli(output):
+        output.write("updated")
+        output.flush()
+        assert path.read_text() == "updated"
+        raise ValueError("callback failed")
+
+    result = runner.invoke(cli, [str(path)])
+    assert isinstance(result.exception, ValueError)
+    assert path.read_text() == "updated"
