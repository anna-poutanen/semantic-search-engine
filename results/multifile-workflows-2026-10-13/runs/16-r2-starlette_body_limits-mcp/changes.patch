+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+
+class ScriptedReceive:
+    def __init__(self, messages: list[Message]) -> None:
+        self.messages = iter(messages)
+        self.calls = 0
+
+    async def __call__(self) -> Message:
+        self.calls += 1
+        return next(self.messages)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("cached", [False, True])
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 0.0, 1.0, "1", b"1", [], {}, object()])
+async def test_invalid_body_limit_does_not_receive(max_bytes: Any, cached: bool) -> None:
+    receive = ScriptedReceive([{"type": "http.request", "body": b"abc"}])
+    request = Request({"type": "http"}, receive)
+    if cached:
+        assert await request.body() == b"abc"
+    calls = receive.calls
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        await request.body(max_bytes=max_bytes)
+
+    assert receive.calls == calls
+    assert hasattr(request, "_body") == cached
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    ("chunks", "max_bytes"),
+    [
+        ([b"ab", b"", b"cd"], None),
+        ([b"ab", b"", b"cd"], 4),
+        ([b"ab", b"cd"], 5),
+        ([b""], 0),
+        ([b"", b""], 0),
+        (["é".encode(), b"x"], 3),
+    ],
+)
+async def test_body_limit_accepts_boundary_and_caches(chunks: list[bytes], max_bytes: int | None) -> None:
+    receive = ScriptedReceive(
+        [
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+    request = Request({"type": "http"}, receive)
+
+    body = await request.body(max_bytes=max_bytes)
+
+    assert body == b"".join(chunks)
+    assert await request.body() is body
+    assert await request.body(max_bytes=len(body)) is body
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+    assert receive.calls == len(chunks)
+
+
+@pytest.mark.anyio
+async def test_zero_budget_accepts_request_without_body_field() -> None:
+    receive = ScriptedReceive([{"type": "http.request"}])
+    request = Request({"type": "http"}, receive)
+
+    assert await request.body(max_bytes=0) == b""
+    assert await request.body() == b""
+    assert receive.calls == 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    ("max_bytes", "chunks", "received", "calls"),
+    [
+        (0, [b"a", b"later"], 1, 1),
+        (3, [b"abcd", b"later"], 4, 1),
+        (3, [b"ab", b"", b"cd", b"later"], 4, 3),
+        (4, [b"ab", b"cd", b"e", b"later"], 5, 3),
+        (1, ["é".encode(), b"later"], 2, 1),
+        (3, [b"ab", b"cd"], 4, 2),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    max_bytes: int, chunks: list[bytes], received: int, calls: int
+) -> None:
+    receive = ScriptedReceive(
+        [
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+    request = Request({"type": "http", "headers": [(b"content-length", b"0")]}, receive)
+
+    with pytest.raises(RequestBodyTooLarge) as exc_info:
+        await request.body(max_bytes=max_bytes)
+
+    exc = exc_info.value
+    assert isinstance(exc, HTTPException)
+    assert exc.status_code == 413
+    assert exc.detail == "Request body too large"
+    assert exc.limit == max_bytes
+    assert exc.received == received
+    assert receive.calls == calls
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("first_limit", [None, 4])
+@pytest.mark.parametrize("stricter_limit", [0, 3])
+async def test_stricter_cached_body_limit_does_not_receive(first_limit: int | None, stricter_limit: int) -> None:
+    receive = ScriptedReceive([{"type": "http.request", "body": b"abcd"}])
+    request = Request({"type": "http"}, receive)
+    body = await request.body(max_bytes=first_limit)
+
+    with pytest.raises(RequestBodyTooLarge) as exc_info:
+        await request.body(max_bytes=stricter_limit)
+
+    assert exc_info.value.limit == stricter_limit
+    assert exc_info.value.received == 4
+    assert await request.body() is body
+    assert await request.body(max_bytes=4) is body
+    assert receive.calls == 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_bounded_body_preserves_json_cache(json_first: bool) -> None:
+    body = b'{"answer":42}'
+    receive = ScriptedReceive([{"type": "http.request", "body": body}])
+    request = Request({"type": "http"}, receive)
+    if json_first:
+        data = await request.json()
+        assert await request.body(max_bytes=len(body)) == body
+    else:
+        assert await request.body(max_bytes=len(body)) == body
+        data = await request.json()
+
+    with pytest.raises(RequestBodyTooLarge):
+        await request.body(max_bytes=len(body) - 1)
+
+    assert data == {"answer": 42}
+    assert await request.json() is data
+    assert await request.body() == body
+    assert receive.calls == 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [None, 3])
+async def test_bounded_body_preserves_client_disconnect(max_bytes: int | None) -> None:
+    receive = ScriptedReceive(
+        [
+            {"type": "http.request", "body": b"ab", "more_body": True},
+            {"type": "http.disconnect"},
+        ]
+    )
+    request = Request({"type": "http"}, receive)
+
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+
+    assert receive.calls == 2
+    assert request._is_disconnected
+    assert not hasattr(request, "_body")
+
+
+def test_body_limit_is_handled_as_http_exception(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        return PlainTextResponse(await request.body(max_bytes=3))
+
+    client = test_client_factory(Starlette(routes=[Route("/", endpoint, methods=["POST"])]))
+
+    accepted = client.post("/", content=b"abc")
+    assert accepted.status_code == 200
+    assert accepted.content == b"abc"
+    rejected = client.post("/", content=b"abcd")
+    assert rejected.status_code == 413
+    assert rejected.content == b"Request body too large"
