+@pytest.mark.parametrize("direct_send", [False, True])
+@pytest.mark.parametrize("stream", [False, True])
+def test_redirect_inheritance_override_and_independent_budgets(budget_server, direct_send, stream):
+    base, _ = budget_server
+    with requests.Session(max_response_bytes=0) as session:
+        def send(path, **kwargs):
+            if direct_send:
+                return session.send(requests.Request("GET", base + path).prepare(), stream=stream, timeout=5, **kwargs)
+            return session.get(base + path, stream=stream, timeout=5, **kwargs)
+
+        with pytest.raises(ResponseTooLarge):
+            send("/chain")
+        for limit in (None, 3):
+            response = send("/chain", max_response_bytes=limit)
+            assert [r.content for r in response.history] == [b"a", b"aa"]
+            assert response.content == b"bbb"
+        session.max_response_bytes = 4
+        response = send("/redirect/4/4")
+        assert response.history[0].content == b"aaaa"
+        assert response.content == b"bbbb"
+
+
+def test_resolved_budget_survives_session_mutation_in_hook(budget_server):
+    base, _ = budget_server
+    with requests.Session(max_response_bytes=4) as session:
+        def mutate(response, **kwargs):
+            session.max_response_bytes = 0
+
+        response = session.get(base + "/redirect/4/4", hooks={"response": mutate}, timeout=5)
+        assert response.content == b"bbbb"
+
