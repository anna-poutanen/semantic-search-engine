+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("path", ["/redirect/4/3", "/redirect/2/4"])
+def test_redirect_and_final_response_each_enforce_budget(budget_server, stream, path):
+    base, paths = budget_server
+    start = len(paths)
+    with pytest.raises(ResponseTooLarge) as raised:
+        response = requests.get(base + path, max_response_bytes=3, stream=stream, timeout=5)
+        response.content
+    assert raised.value.received == 4
+    assert raised.value.response.raw.closed
+    assert paths[start:] == ([path] if path == "/redirect/4/3" else [path, "/sized/4"])
+
