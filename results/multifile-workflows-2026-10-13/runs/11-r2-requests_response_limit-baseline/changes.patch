+def test_budget_survives_response_pickle(body_session):
+    session, _ = body_session
+    response = session.get("http://localhost/body", max_response_bytes=6)
+    restored = pickle.loads(pickle.dumps(response))
+    assert restored.content == b"abcdef"
+    assert list(restored.iter_content(2)) == [b"ab", b"cd", b"ef"]
+    assert restored._max_response_bytes == 6
+    assert restored._response_bytes_received == 6
