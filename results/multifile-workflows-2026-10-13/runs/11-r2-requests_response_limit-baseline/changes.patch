diff --git a/tests/test_response_limit.py b/tests/test_response_limit.py
new file mode 100644
index 0000000..7ce79bc
--- /dev/null
+++ b/tests/test_response_limit.py
@@ -0,0 +1,425 @@
+"""Regression tests for decoded response byte budgets."""
+
+import gzip
+import io
+import pickle
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import Mock
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+
+class CountingBody(io.BytesIO):
+    def __init__(self, body):
+        super().__init__(body)
+        self.read_calls = 0
+
+    def read(self, size=-1):
+        self.read_calls += 1
+        return super().read(size)
+
+
+class StreamingBody(CountingBody):
+    def stream(self, size, decode_content):
+        assert decode_content is True
+        while chunk := self.read(-1 if size is None else size):
+            yield chunk
+
+
+class BodyAdapter(BaseAdapter):
+    """A strict transport signature also checks that the budget isn't leaked."""
+
+    def __init__(self, body=b"abcdef", streaming=False, cached=False):
+        self.body = body
+        self.streaming = streaming
+        self.cached = cached
+        self.calls = 0
+
+    def send(self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None):
+        self.calls += 1
+        response = requests.Response()
+        response.status_code = 200
+        response.url = request.url
+        response.request = request
+        response.encoding = "utf-8"
+        response.raw = (StreamingBody if self.streaming else CountingBody)(self.body)
+        if self.cached:
+            response._content = self.body
+            response._content_consumed = True
+        self.response = response
+        return response
+
+    def close(self):
+        pass
+
+
+@pytest.fixture
+def body_session():
+    with requests.Session() as session:
+        session.trust_env = False
+        adapter = BodyAdapter()
+        session.mount("http://", adapter)
+        yield session, adapter
+
+
+@pytest.fixture(scope="module")
+def budget_server():
+    paths = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def handle_request(self):
+            paths.append(self.path)
+            headers = {}
+            status = 200
+            body = b"abcdef"
+            if self.path == "/empty":
+                body = b""
+            elif self.path == "/unicode":
+                body = "é🙂".encode("utf-8")
+                headers["Content-Type"] = "text/plain; charset=utf-8"
+            elif self.path == "/gzip":
+                body = gzip.compress(b"a" * 65536)
+                headers["Content-Encoding"] = "gzip"
+            elif self.path == "/chunked":
+                headers["Transfer-Encoding"] = "chunked"
+            elif self.path == "/chain":
+                status, body = 302, b"a"
+                headers["Location"] = "/redirect/2/3"
+            elif self.path.startswith("/redirect/"):
+                _, _, size, final_size = self.path.split("/")
+                status, body = 302, b"a" * int(size)
+                headers["Location"] = f"/sized/{final_size}"
+            elif self.path.startswith("/sized/"):
+                body = b"b" * int(self.path.rsplit("/", 1)[1])
+
+            self.send_response(status)
+            if "Transfer-Encoding" not in headers:
+                self.send_header("Content-Length", str(len(body)))
+            for name, value in headers.items():
+                self.send_header(name, value)
+            self.end_headers()
+            if self.command != "HEAD":
+                try:
+                    if self.path == "/chunked":
+                        self.wfile.write(b"2\r\nab\r\n2\r\ncd\r\n2\r\nef\r\n0\r\n\r\n")
+                    else:
+                        self.wfile.write(body)
+                except (BrokenPipeError, ConnectionResetError):
+                    pass
+
+        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = do_HEAD = handle_request
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever)
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}", paths
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+def test_exception_is_public():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    assert issubclass(ResponseTooLarge, RequestException)
+
+
+@pytest.mark.parametrize("limit", [None, 0, 6, 10**100])
+def test_session_setting_and_pickle(limit):
+    with requests.Session(max_response_bytes=limit) as session:
+        assert session.max_response_bytes == limit
+        with pickle.loads(pickle.dumps(session)) as restored:
+            assert restored.max_response_bytes == limit
+
+
+@pytest.mark.parametrize("invalid", [-1, True, False, 1.0, "6", b"6", [], {}, object()])
+@pytest.mark.parametrize("entry", ["constructor", "request", "send", "module", "session_setting"])
+def test_invalid_budget_fails_before_transport(body_session, monkeypatch, invalid, entry):
+    session, adapter = body_session
+    transport = Mock(side_effect=AssertionError("transport must not be called"))
+    monkeypatch.setattr(requests.adapters.HTTPAdapter, "send", transport)
+    prepared = requests.Request("GET", "http://localhost/body").prepare()
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        if entry == "constructor":
+            requests.Session(max_response_bytes=invalid)
+        elif entry == "request":
+            session.get(prepared.url, max_response_bytes=invalid)
+        elif entry == "send":
+            session.send(prepared, max_response_bytes=invalid)
+        elif entry == "module":
+            requests.get(prepared.url, max_response_bytes=invalid)
+        else:
+            session.max_response_bytes = invalid
+            session.get(prepared.url)
+    assert adapter.calls == 0
+    transport.assert_not_called()
+
+
+@pytest.mark.parametrize("direct_send", [False, True])
+def test_inheritance_override_and_explicit_none(body_session, direct_send):
+    session, adapter = body_session
+    session.max_response_bytes = 3
+
+    def send(**kwargs):
+        if direct_send:
+            return session.send(requests.Request("GET", "http://localhost/body").prepare(), **kwargs)
+        return session.get("http://localhost/body", **kwargs)
+
+    with pytest.raises(ResponseTooLarge) as raised:
+        send()
+    assert raised.value.limit == 3
+    assert raised.value.received == 6
+    assert raised.value.response is adapter.response
+    assert raised.value.request is adapter.response.request
+    assert adapter.response.raw.closed
+    assert send(max_response_bytes=6).content == b"abcdef"
+    assert send(max_response_bytes=None).text == "abcdef"
+    assert session.max_response_bytes == 3
+
+
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("chunk_size", [1, 2, 4, None])
+def test_streaming_crossing_and_terminal_reads(body_session, streaming, chunk_size):
+    session, adapter = body_session
+    adapter.streaming = streaming
+    response = session.get("http://localhost/body", stream=True, max_response_bytes=3)
+    iterator = response.iter_content(chunk_size)
+    suspended = response.iter_content(1)
+    yielded = b""
+    with pytest.raises(ResponseTooLarge) as raised:
+        while True:
+            yielded += next(iterator)
+    assert len(yielded) <= 3
+    assert raised.value.received == {1: 4, 2: 4, 4: 4, None: 6}[chunk_size]
+    assert response.raw.closed
+    reads = response.raw.read_calls
+    for read in (
+        lambda: response.content,
+        lambda: response.text,
+        lambda: response.json(),
+        lambda: list(response.iter_content()),
+        lambda: list(response.iter_lines()),
+        lambda: next(suspended),
+    ):
+        with pytest.raises(ResponseTooLarge) as later:
+            read()
+        assert later.value is raised.value
+        assert response.raw.read_calls == reads
+
+
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("finish_with", ["new_iterator", "content", "text"])
+def test_partial_reads_share_total(body_session, streaming, finish_with):
+    session, adapter = body_session
+    adapter.streaming = streaming
+    response = session.get("http://localhost/body", stream=True, max_response_bytes=4)
+    first = response.iter_content(2)
+    assert next(first) == b"ab"
+    with pytest.raises(ResponseTooLarge) as raised:
+        if finish_with == "new_iterator":
+            second = response.iter_content(2)
+            assert next(second) == b"cd"
+            next(second)
+        else:
+            getattr(response, finish_with)
+    assert raised.value.received == 6
+    assert response.raw.closed
+    reads = response.raw.read_calls
+    with pytest.raises(ResponseTooLarge):
+        next(first)
+    assert response.raw.read_calls == reads
+
+
+def test_cleanup_failure_preserves_size_error(body_session):
+    session, adapter = body_session
+    response = session.get("http://localhost/body", stream=True, max_response_bytes=0)
+    cleanup_error = RuntimeError("close failed")
+    response.close = Mock(side_effect=cleanup_error)
+    with pytest.raises(ResponseTooLarge) as raised:
+        response.content
+    assert raised.value.__cause__ is cleanup_error
+    assert raised.value.received == 6
+    with pytest.raises(ResponseTooLarge) as later:
+        response.text
+    assert later.value is raised.value
+    assert adapter.response.raw.read_calls == 1
+    response.close.assert_called_once_with()
+    response.raw.close()
+
+
+@pytest.mark.parametrize("cached", [False, True])
+def test_cached_rereads_do_not_spend_budget_again(body_session, cached):
+    session, adapter = body_session
+    adapter.cached = cached
+    response = session.get("http://localhost/body", max_response_bytes=6)
+    for _ in range(3):
+        assert response.content == b"abcdef"
+        assert response.text == "abcdef"
+        assert list(response.iter_content(2)) == [b"ab", b"cd", b"ef"]
+    assert response._response_bytes_received == 6
+
+
+def test_partial_content_cache_does_not_double_count(body_session):
+    session, _ = body_session
+    response = session.get("http://localhost/body", stream=True, max_response_bytes=6)
+    assert next(response.iter_content(2)) == b"ab"
+    assert response.content == b"cdef"
+    assert list(response.iter_content(2)) == [b"cd", b"ef"]
+    assert response._response_bytes_received == 6
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("size", [0, 3, 4])
+def test_cached_hook_response_is_budgeted(body_session, stream, size):
+    session, _ = body_session
+    replacement = requests.Response()
+    replacement.status_code = 200
+    replacement._content = b"x" * size
+    replacement._content_consumed = True
+    replacement.close = Mock()
+
+    def replace(response, **kwargs):
+        replacement.request = response.request
+        return replacement
+
+    if size > 3:
+        with pytest.raises(ResponseTooLarge) as raised:
+            session.get("http://localhost/body", stream=stream, max_response_bytes=3, hooks={"response": replace})
+        assert raised.value.response is replacement
+        assert raised.value.received == size
+        replacement.close.assert_called_once_with()
+        with pytest.raises(ResponseTooLarge):
+            replacement.content
+    else:
+        response = session.get("http://localhost/body", stream=stream, max_response_bytes=3, hooks={"response": replace})
+        assert response is replacement
+        assert response.content == b"x" * size
+        assert b"".join(response.iter_content(1)) == b"x" * size
+        replacement.close.assert_not_called()
+
+
+def test_hook_reads_obey_budget(body_session):
+    session, adapter = body_session
+
+    def consume(response, **kwargs):
+        response.text
+
+    with pytest.raises(ResponseTooLarge):
+        session.get("http://localhost/body", max_response_bytes=3, hooks={"response": consume})
+    assert adapter.response.raw.closed
+
+
+@pytest.mark.parametrize("method", ["get", "post", "put", "patch", "delete", "options", "request", "head"])
+@pytest.mark.parametrize("use_session", [False, True])
+def test_public_helpers_accept_budget(budget_server, method, use_session):
+    base, _ = budget_server
+    with requests.Session() as session:
+        target = session if use_session else requests
+        args = ("GET", base) if method == "request" else (base,)
+        helper = getattr(target, method)
+        if method == "head":
+            assert helper(*args, max_response_bytes=0, timeout=5).content == b""
+        else:
+            assert helper(*args, max_response_bytes=6, timeout=5).content == b"abcdef"
+            with pytest.raises(ResponseTooLarge):
+                helper(*args, max_response_bytes=5, timeout=5)
+
+
+@pytest.mark.parametrize("path,body", [("/empty", b""), ("/body", b"abcdef"), ("/chunked", b"abcdef"), ("/unicode", "é🙂".encode("utf-8"))])
+@pytest.mark.parametrize("stream", [False, True])
+def test_exact_boundary_and_unlimited(budget_server, path, body, stream):
+    base, _ = budget_server
+    for kwargs in ({}, {"max_response_bytes": None}, {"max_response_bytes": len(body)}):
+        with requests.get(base + path, stream=stream, timeout=5, **kwargs) as response:
+            assert b"".join(response.iter_content(2)) == body
+
+
+@pytest.mark.parametrize("reader", ["content", "text", "unicode_chunks"])
+def test_unicode_budget_counts_bytes(budget_server, reader):
+    base, _ = budget_server
+    with requests.get(base + "/unicode", stream=True, max_response_bytes=2, timeout=5) as response:
+        with pytest.raises(ResponseTooLarge) as raised:
+            if reader == "unicode_chunks":
+                iterator = response.iter_content(2, decode_unicode=True)
+                assert next(iterator) == "é"
+                next(iterator)
+            else:
+                getattr(response, reader)
+        assert raised.value.received == (4 if reader == "unicode_chunks" else 6)
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_gzip_counts_decoded_bytes(budget_server, stream):
+    base, _ = budget_server
+    assert len(gzip.compress(b"a" * 65536)) < 1024
+    with pytest.raises(ResponseTooLarge) as raised:
+        response = requests.get(base + "/gzip", max_response_bytes=1024, stream=stream, timeout=5)
+        response.content
+    assert raised.value.received > 1024
+    assert raised.value.response.raw.closed
+    with requests.get(base + "/gzip", max_response_bytes=65536, timeout=5) as response:
+        assert response.content == b"a" * 65536
+
