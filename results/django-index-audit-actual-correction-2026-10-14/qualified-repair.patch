+def verify_owned_command(ownership, plan, study):
+    """The native hash binds raw absolute argv, before public path redaction."""
+    require(type(ownership["owner_pid"]) is int and ownership["owner_pid"] > 1,
+            "Owned parent identity must be a strict process ID")
+    published = ownership["command"]
+    require(isinstance(published, list) and all(type(value) is str for value in published),
+            "Owned published command must be an exact string argv")
+    actual = [value.replace("<PROJECT>", str(ROOT)) for value in published]
+    expected = [str(local_path(plan["runtime"]["executable"])), "-B",
+                str(ROOT / "scripts/run_django_index_profile.py"), "--_worker",
+                str(Path(study).resolve()), "--owner-pid", str(ownership["owner_pid"])]
+    require(actual == expected, "Owned command differs from exact frozen interpreter/worker/study/parent argv")
+    require(ownership["command_sha256"] == sha(json.dumps(actual).encode()),
+            "Owned raw absolute command hash differs")
+    private_path = local_path(plan["work"]) / "owned-process.json"
+    private = read(private_path)
+    require(private["command"] == actual and private["command_sha256"] == ownership["command_sha256"],
+            "Current private owned argv/hash differs from published restoration")
+    expected_private = {**ownership, "command": actual}
+    require(typed_equal(private, expected_private), "Private owned proof identity/clock/schema differs")
+    return {"publication": "literal <PROJECT> prefix redaction after raw argv hash",
+            "raw_command_sha256": ownership["command_sha256"],
