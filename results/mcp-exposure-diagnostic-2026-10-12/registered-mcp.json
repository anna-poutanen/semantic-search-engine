{
  "args": [
    "-m",
    "semantic_search.mcp_server",
    "--server",
    "http://127.0.0.1:54444"
  ],
  "command": "<PROJECT>/.venv/bin/python",
  "cwd": "<PROJECT>",
  "default_tools_approval_mode": "auto",
  "enabled_tools": [
    "search_code"
  ],
  "env": {
    "PYTHONPATH": "<PROJECT>/src"
  },
  "required": true,
  "server_name": "semantic_search",
  "startup_timeout_sec": 20,
  "tool_timeout_sec": 180
}
