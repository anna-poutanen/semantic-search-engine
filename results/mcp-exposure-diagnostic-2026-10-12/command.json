[
  "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
  "--no-daemon",
  "exec",
  "--ignore-user-config",
  "--ignore-rules",
  "--strict-config",
  "--ephemeral",
  "--json",
  "--color",
  "never",
  "--sandbox",
  "workspace-write",
  "-m",
  "gpt-6.1-sol",
  "-C",
  "<WORKSPACE>",
  "-o",
  "<DIAGNOSTIC_LOG>/final.txt",
  "-c",
  "approval_policy=\"never\"",
  "-c",
  "features.apps=false",
  "-c",
  "features.browser_use=false",
  "-c",
  "features.browser_use_external=false",
  "-c",
  "features.computer_use=false",
  "-c",
  "features.hooks=false",
  "-c",
  "features.image_generation=false",
  "-c",
  "features.memories=false",
  "-c",
  "features.multi_agent=false",
  "-c",
  "features.multi_agent_v2=false",
  "-c",
  "features.plugins=false",
  "-c",
  "features.remote_plugin=false",
  "-c",
  "features.skill_search=false",
  "-c",
  "features.skip_host_skill_discovery=true",
  "-c",
  "features.tool_suggest=false",
  "-c",
  "features.workspace_dependencies=false",
  "-c",
  "model_reasoning_effort=\"ultra\"",
  "-c",
  "project_doc_max_bytes=0",
  "-c",
  "service_tier=\"default\"",
  "-c",
  "skills.bundled.enabled=false",
  "-c",
  "skills.include_instructions=false",
  "-c",
  "suppress_unstable_features_warning=true",
  "-c",
  "web_search=\"disabled\"",
  "-c",
  "shell_environment_policy.set={\"PYTHONPATH\" = \"<WORKSPACE>\", \"PYTHONDONTWRITEBYTECODE\" = \"1\"}",
  "-c",
  "mcp_servers.semantic_search.command=\"<PROJECT>/.venv/bin/python\"",
  "-c",
  "mcp_servers.semantic_search.args=[\"-m\", \"semantic_search.mcp_server\", \"--server\", \"http://127.0.0.1:54444\"]",
  "-c",
  "mcp_servers.semantic_search.cwd=\"<PROJECT>\"",
  "-c",
  "mcp_servers.semantic_search.env={\"PYTHONPATH\" = \"<PROJECT>/src\"}",
  "-c",
  "mcp_servers.semantic_search.enabled_tools=[\"search_code\"]",
  "-c",
  "mcp_servers.semantic_search.required=true",
  "-c",
  "mcp_servers.semantic_search.startup_timeout_sec=20",
  "-c",
  "mcp_servers.semantic_search.tool_timeout_sec=180",
  "-c",
  "mcp_servers.semantic_search.default_tools_approval_mode=\"auto\"",
  "This is a tool-exposure diagnostic, not a coding task. Before running any shell command, call the registered semantic_search MCP server's search_code tool with these exact arguments: {\"include_dependencies\": false, \"max_results\": 3, \"query\": \"encoded hex checksum\", \"rerank\": false, \"retrieval\": \"bm25\", \"token_budget\": 4096}. Then report the tool's returned implementation names and repository-relative paths, and whether the call succeeded. Do not use shell commands, edit files, launch subagents, or access parent directories, other repositories, home files, evaluation materials or the network. Do not infer the answer from source files. If the tool is unavailable, state that limitation and stop."
]
