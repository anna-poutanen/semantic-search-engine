@@ -0,0 +1,437 @@
+import io
+import os
+import stat
+
+import pytest
+
+import click
+from click import _compat
+from click.exceptions import Exit
+
+
+def assert_destination(path, exists, content=b"original"):
+    if exists:
+        assert path.read_bytes() == content
+    else:
+        assert not path.exists()
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_direct_atomic_transaction(tmp_path, lazy, binary, exists, fail):
+    destination = tmp_path / "output"
+    if exists:
+        destination.write_bytes(b"original")
+    error = RuntimeError("body failed")
+    output = click.open_file(
+        destination, "wb" if binary else "w", lazy=lazy, atomic=True
+    )
+
+    def write():
+        with output:
+            output.write(b"replacement" if binary else "replacement")
+            output.flush()
+            assert_destination(destination, exists)
+            if fail:
+                raise error
+
+    if fail:
+        with pytest.raises(RuntimeError) as caught:
+            write()
+        assert caught.value is error
+        assert_destination(destination, exists)
+    else:
+        write()
+        assert destination.read_bytes() == b"replacement"
+
+    assert output.closed
+    with pytest.raises(ValueError):
+        output.fileno()
+    output.close()
+    output.close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize(
+    "outcome", ["return", "exit-zero", "system-exit-zero", "exit-error", "raise"]
+)
+def test_command_atomic_transaction(runner, tmp_path, lazy, binary, exists, outcome):
+    destination = tmp_path / "output"
+    if exists:
+        destination.write_bytes(b"original")
+    error = RuntimeError("callback failed")
+    handles = []
+
+    @click.command()
+    @click.argument(
+        "output", type=click.File("wb" if binary else "w", lazy=lazy, atomic=True)
+    )
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        output.write(b"replacement" if binary else "replacement")
+        output.flush()
+        assert_destination(destination, exists)
+        if outcome == "exit-zero":
+            ctx.exit(0)
+        if outcome == "system-exit-zero":
+            raise SystemExit(0)
+        if outcome == "exit-error":
+            ctx.exit(3)
+        if outcome == "raise":
+            raise error
+
+    result = runner.invoke(cli, [str(destination)])
+    if outcome in ("return", "exit-zero", "system-exit-zero"):
+        assert result.exit_code == 0, result.exception
+        assert destination.read_bytes() == b"replacement"
+    else:
+        assert result.exit_code == (3 if outcome == "exit-error" else 1)
+        if outcome == "raise":
+            assert result.exception is error
+        assert_destination(destination, exists)
+
+    assert handles[0].closed
+    with pytest.raises(ValueError):
+        handles[0].fileno()
+    handles[0].close()
+    handles[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize(
+    "error", [click.ClickException("failed"), click.Abort(), SystemExit(4)]
+)
+def test_command_abort_types(runner, tmp_path, lazy, error):
+    destination = tmp_path / "output"
+    destination.write_bytes(b"original")
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    def cli(output):
+        output.write("replacement")
+        raise error
+
+    result = runner.invoke(cli, [str(destination)])
+    assert result.exit_code != 0
+    assert_destination(destination, True)
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("command,lazy", [(False, True), (True, True), (True, None)])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_unused_lazy_output(runner, tmp_path, monkeypatch, command, exists, fail, lazy):
+    destination = tmp_path / "output"
+    if exists:
+        destination.write_bytes(b"original")
+
+    def unexpected_open(*args, **kwargs):
+        pytest.fail("unused lazy output was opened")
+
+    monkeypatch.setattr(_compat, "_wrap_io_open", unexpected_open)
+    error = RuntimeError("failed without writing")
+    if command:
+
+        @click.command()
+        @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+        def cli(output):
+            if fail:
+                raise error
+
+        result = runner.invoke(cli, [str(destination)])
+        assert result.exit_code == int(fail)
+        assert result.exception is (error if fail else None)
+    else:
+        output = click.open_file(destination, "w", lazy=True, atomic=True)
+        if fail:
+            with pytest.raises(RuntimeError):
+                with output:
+                    raise error
+        else:
+            with output:
+                pass
+        output.close()
+
+    assert_destination(destination, exists)
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+def test_explicit_close_commits_even_if_callback_later_fails(runner, tmp_path, lazy):
+    destination = tmp_path / "output"
+    error = RuntimeError("failed after committing")
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    def cli(output):
+        output.write("replacement")
+        output.close()
+        output.close()
+        assert destination.read_bytes() == b"replacement"
+        raise error
+
+    result = runner.invoke(cli, [str(destination)])
+    assert result.exception is error
+    assert destination.read_bytes() == b"replacement"
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Unix permission bits are required")
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("permissions", [0o400, 0o640, 0o755])
+def test_transaction_preserves_permissions(runner, tmp_path, lazy, permissions):
+    destination = tmp_path / "output"
+    destination.write_bytes(b"original")
+    destination.chmod(permissions)
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    def cli(output):
+        output.write("replacement")
+
+    result = runner.invoke(cli, [str(destination)])
+    assert result.exit_code == 0, result.exception
+    assert destination.read_bytes() == b"replacement"
+    assert stat.S_IMODE(destination.stat().st_mode) == permissions
+
+
+@pytest.mark.parametrize("command", [False, True])
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("missing", [False, True])
+def test_abort_cleanup_preserves_primary_error(
+    runner, tmp_path, monkeypatch, command, lazy, missing
+):
+    destination = tmp_path / "output"
+    destination.write_bytes(b"original")
+    error = RuntimeError("primary failure")
+    cleanup_error = PermissionError("cannot delete temporary file")
+    handles = []
+
+    def fail_unlink(path):
+        raise cleanup_error
+
+    def body(output):
+        handles.append(output)
+        output.write("replacement")
+        if missing:
+            next(tmp_path.glob(".__atomic-write*")).unlink()
+        raise error
+
+    with monkeypatch.context() as patch:
+        # Limit the injected unlink failure to the file transaction.
+        if not missing:
+            patch.setattr(_compat.os, "unlink", fail_unlink)
+        if command:
+
+            @click.command()
+            @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+            def cli(output):
+                body(output)
+
+            result = runner.invoke(cli, [str(destination)])
+            assert result.exception is error
+        else:
+            with pytest.raises(RuntimeError) as caught:
+                with click.open_file(
+                    destination, "w", lazy=lazy, atomic=True
+                ) as output:
+                    body(output)
+            assert caught.value is error
+
+    assert_destination(destination, True)
+    assert handles[0].closed
+    with pytest.raises(ValueError):
+        handles[0].fileno()
+    handles[0].close()
+    if missing:
+        assert not list(tmp_path.glob(".__atomic-write*"))
+    else:
+        notes = getattr(error, "__notes__", ())
+        assert (
+            any("cannot delete temporary file" in note for note in notes)
+            or error.__cause__ is cleanup_error
+        )
+        for temporary in tmp_path.glob(".__atomic-write*"):
+            temporary.unlink()
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("outcome", ["return", "exit-zero", "system-exit-zero"])
+@pytest.mark.parametrize("standalone", [False, True])
+def test_command_commit_failure_is_failure(runner, tmp_path, lazy, outcome, standalone):
+    destination = tmp_path / "output"
+    destination.write_bytes(b"original")
+    handles = []
+
+    @click.command()
+    @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        output.write("replacement")
+        next(tmp_path.glob(".__atomic-write*")).unlink()
+        if outcome == "exit-zero":
+            ctx.exit(0)
+        if outcome == "system-exit-zero":
+            raise SystemExit(0)
+
+    result = runner.invoke(cli, [str(destination)], standalone_mode=standalone)
+    assert result.exit_code != 0
+    assert isinstance(result.exception, FileNotFoundError)
+    assert_destination(destination, True)
+    assert handles[0].closed
+    with pytest.raises(ValueError):
+        handles[0].fileno()
+    handles[0].close()
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+def test_direct_commit_failure_propagates(tmp_path, lazy):
