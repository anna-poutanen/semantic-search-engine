+from contextlib import contextmanager
+
+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+class ErrorWithoutNotes(RuntimeError):
+    add_note = None
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_resource_receives_exception_after_outermost_exit(fail):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    error = RuntimeError("callback failed")
+    received = []
+
+    class Resource:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, exc_type, exc_value, tb):
+            assert click.get_current_context() is ctx
+            received.append((exc_type, exc_value, tb))
+
+    def run():
+        with ctx:
+            ctx.with_resource(Resource())
+            try:
+                with ctx:
+                    assert click.get_current_context() is ctx
+                    if fail:
+                        raise error
+            finally:
+                assert received == []
+                assert click.get_current_context() is ctx
+            assert received == []
+            assert click.get_current_context() is ctx
+
+    with outer:
+        if fail:
+            with pytest.raises(RuntimeError) as caught:
+                run()
+            assert caught.value is error
+        else:
+            run()
+        assert click.get_current_context() is outer
+
+    assert click.get_current_context(silent=True) is None
+    assert len(received) == 1
+    exc_type, exc_value, tb = received[0]
+    if fail:
+        assert exc_type is RuntimeError
+        assert exc_value is error
+        assert tb is not None
+    else:
+        assert (exc_type, exc_value, tb) == (None, None, None)
+
+
+def test_generator_resource_receives_callback_exception(runner):
+    error = RuntimeError("callback failed")
+    received = []
+
+    @contextmanager
+    def resource():
+        try:
+            yield
+        except RuntimeError as caught:
+            received.append(caught)
+            raise
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(resource())
+        raise error
+
+    result = runner.invoke(cli)
+    assert result.exception is error
+    assert received == [error]
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("fail", [False, True])
+@pytest.mark.parametrize("error_type", [RuntimeError, ErrorWithoutNotes])
+def test_cleanup_failure_restores_stack_and_preserves_primary(fail, error_type):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    error = error_type("callback failed")
+    cleanup_error = OSError("cleanup failed")
+    calls = []
+
+    def cleanup():
+        assert click.get_current_context() is ctx
+        calls.append(True)
+        raise cleanup_error
+
+    ctx.call_on_close(cleanup)
+    with outer:
+        with pytest.raises(RuntimeError if fail else OSError) as caught:
+            with ctx:
+                if fail:
+                    raise error
+        assert caught.value is (error if fail else cleanup_error)
+        assert click.get_current_context() is outer
+        with ctx:
+            assert click.get_current_context() is ctx
+        assert calls == [True]
+
+    assert click.get_current_context(silent=True) is None
+    if fail:
+        notes = getattr(error, "__notes__", ())
+        assert (
+            any("cleanup failed" in note for note in notes)
+            or error.__cause__ is cleanup_error
+        )
+
+
+def test_resource_cannot_suppress_callback_exception():
+    error = RuntimeError("callback failed")
+
+    class Resource:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *exc_info):
+            return True
+
+    with pytest.raises(RuntimeError) as caught:
+        with click.Context(click.Command("test")) as ctx:
+            ctx.with_resource(Resource())
+            raise error
+    assert caught.value is error
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("error", [ValueError("failed"), Exit(3), SystemExit(4)])
+def test_command_resource_receives_actual_failure(runner, error):
+    received = []
+
+    class Resource:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, exc_type, exc_value, tb):
+            received.append((exc_type, exc_value, tb))
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(Resource())
+        raise error
+
+    result = runner.invoke(cli)
+    assert result.exit_code != 0
+    assert len(received) == 1
+    exc_type, exc_value, tb = received[0]
+    assert exc_type is type(error)
+    assert exc_value is error
+    assert tb is not None
+    assert click.get_current_context(silent=True) is None
