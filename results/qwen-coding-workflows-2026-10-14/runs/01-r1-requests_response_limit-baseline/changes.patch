diff --git a/tests/test_response_limits.py b/tests/test_response_limits.py
new file mode 100644
index 0000000..b33d674
--- /dev/null
+++ b/tests/test_response_limits.py
@@ -0,0 +1,494 @@
+"""Decoded response budgets, using controlled streams and loopback HTTP only."""
+
+import gzip
+import io
+import pickle
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import Mock
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+
+class TrackingRaw(io.BytesIO):
+    def __init__(self, body):
+        super().__init__(body)
+        self.reads = 0
+        self.closes = 0
+        self.releases = 0
+
+    def read(self, size=None):
+        self.reads += 1
+        return super().read(size)
+
+    def close(self):
+        self.closes += 1
+        super().close()
+
+    def release_conn(self):
+        self.releases += 1
+
+
+class StreamingRaw(TrackingRaw):
+    def stream(self, size, decode_content):
+        assert decode_content is True
+        while True:
+            chunk = self.read(size)
+            if not chunk:
+                return
+            yield chunk
+
+
+class BodyAdapter(BaseAdapter):
+    def __init__(self, body=b"abcdef", raw_type=StreamingRaw):
+        self.body = body
+        self.raw_type = raw_type
+        self.responses = []
+
+    # Deliberately accept only transport options: a leaked budget must fail.
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        response = requests.Response()
+        response.status_code = 200
+        response.url = request.url
+        response.request = request
+        response.raw = self.raw_type(self.body)
+        response.encoding = "utf-8"
+        self.responses.append(response)
+        return response
+
+    def close(self):
+        pass
+
+
+def budget_session(limit=None, body=b"abcdef", raw_type=StreamingRaw):
+    session = requests.Session(max_response_bytes=limit)
+    session.trust_env = False
+    adapter = BodyAdapter(body, raw_type)
+    session.mount("http://", adapter)
+    return session, adapter
+
+
+URL = "http://127.0.0.1/body"
+INVALID_LIMITS = [True, False, -1, 1.0, "1", b"1", [], {}, object()]
+
+
+@pytest.mark.parametrize("limit", INVALID_LIMITS)
+@pytest.mark.parametrize("entry", ["constructor", "request", "send", "setting"])
+def test_invalid_budgets_fail_before_transport(limit, entry):
+    session, adapter = budget_session()
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        if entry == "constructor":
+            requests.Session(max_response_bytes=limit)
+        elif entry == "request":
+            session.get(URL, max_response_bytes=limit)
+        elif entry == "send":
+            session.send(
+                requests.Request("GET", URL).prepare(), max_response_bytes=limit
+            )
+        else:
+            session.max_response_bytes = limit
+            session.get(URL)
+    assert not adapter.responses
+
+
+@pytest.mark.parametrize("entry", ["request", "send"])
+@pytest.mark.parametrize(
+    "session_limit, override, succeeds",
+    [
+        (None, {}, True),
+        (5, {}, False),
+        (5, {"max_response_bytes": None}, True),
+        (5, {"max_response_bytes": 6}, True),
+        (None, {"max_response_bytes": 5}, False),
+    ],
+)
+def test_budget_inheritance_and_overrides(entry, session_limit, override, succeeds):
+    session, adapter = budget_session(session_limit)
+
+    def send():
+        if entry == "send":
+            return session.send(requests.Request("GET", URL).prepare(), **override)
+        return session.request("GET", URL, **override)
+
+    if succeeds:
+        assert send().content == b"abcdef"
+    else:
+        with pytest.raises(ResponseTooLarge) as caught:
+            send()
+        assert caught.value.response is adapter.responses[0]
+        assert caught.value.request is adapter.responses[0].request
+        assert caught.value.limit == 5
+        assert caught.value.received == 6
+    assert len(adapter.responses) == 1
+
+
+def test_public_exception_and_pickled_session_setting():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    assert issubclass(ResponseTooLarge, RequestException)
+    assert requests.Session().max_response_bytes is None
+    session = pickle.loads(pickle.dumps(requests.Session(max_response_bytes=5)))
+    assert session.max_response_bytes == 5
+    session.mount("http://", BodyAdapter())
+    with pytest.raises(ResponseTooLarge):
+        session.get(URL)
+    session.max_response_bytes = 6
+    assert session.get(URL).content == b"abcdef"
+
+
+@pytest.mark.parametrize("raw_type", [TrackingRaw, StreamingRaw])
+@pytest.mark.parametrize(
+    "second_read", ["iterator", "content", "text", "same_iterator"]
+)
+def test_partial_reads_share_total_and_failure_is_terminal(raw_type, second_read):
+    session, _ = budget_session(3, raw_type=raw_type)
+    response = session.get(URL, stream=True)
+    first = response.iter_content(2)
+    dormant = response.iter_content(1)
+    assert next(first) == b"ab"
+    with pytest.raises(ResponseTooLarge) as caught:
+        if second_read == "iterator":
+            next(response.iter_content(2))
+        elif second_read == "same_iterator":
+            next(first)
+        else:
+            getattr(response, second_read)
+    error = caught.value
+    assert error.limit == 3
+    assert error.received == (4 if "iterator" in second_read else 6)
+    assert error.response is response
+    assert error.request is response.request
+    assert response.raw.closes == 1
+    assert response.raw.releases == 1
+    reads = response.raw.reads
+    for read in (
+        lambda: response.content,
+        lambda: response.text,
+        lambda: response.json(),
+        lambda: next(response.iter_content(1)),
+        lambda: next(response.iter_lines()),
+        lambda: next(dormant),
+    ):
+        with pytest.raises(ResponseTooLarge) as later:
+            read()
+        assert later.value is error
+        assert response.raw.reads == reads
+    assert error.received == caught.value.received
+
+
+@pytest.mark.parametrize("body, limit", [(b"", 0), (b"abcdef", 6)])
+@pytest.mark.parametrize("chunk_size", [1, 2, None])
+def test_boundary_bodies_and_cached_rereads(body, limit, chunk_size):
+    session, _ = budget_session(limit, body)
+    response = session.get(URL)
+    reads = response.raw.reads
+    assert response.content == body
+    assert response.text == body.decode()
+    assert b"".join(response.iter_content(chunk_size)) == body
+    assert response._response_bytes_received == len(body)
+    assert response.raw.reads == reads
+    restored = pickle.loads(pickle.dumps(response))
+    assert restored.content == body
+    assert b"".join(restored.iter_content(1)) == body
+
+
+def test_partial_iterator_then_cached_tail_does_not_count_twice():
+    session, _ = budget_session(6)
+    response = session.get(URL, stream=True)
+    assert next(response.iter_content(2)) == b"ab"
+    assert response.content == b"cdef"
+    assert response.content == b"cdef"
+    assert b"".join(response.iter_content(1)) == b"cdef"
+    assert response._response_bytes_received == 6
+
+
+def test_close_failure_is_chained_and_does_not_allow_more_reads():
+    session, _ = budget_session(1)
+    response = session.get(URL, stream=True)
+    cleanup_error = RuntimeError("close failed")
+    response.close = Mock(side_effect=cleanup_error)
+    with pytest.raises(ResponseTooLarge) as caught:
+        response.content
+    assert caught.value.__cause__ is cleanup_error
+    response.close.assert_called_once_with()
+    reads = response.raw.reads
+    with pytest.raises(ResponseTooLarge) as later:
+        response.content
+    assert later.value is caught.value
+    assert response.raw.reads == reads
+    response.raw.close()
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("body, succeeds", [(b"abc", True), (b"abcd", False)])
+def test_cached_hook_replacement_obeys_budget(stream, body, succeeds):
+    session, _ = budget_session(3, b"a")
+    replacement = requests.Response()
+    replacement.status_code = 200
+    replacement._content = body
+    replacement._content_consumed = True
+    replacement.close = Mock()
+
+    def replace(response, **kwargs):
+        assert "max_response_bytes" not in kwargs
+        replacement.request = response.request
+        return replacement
+
+    if succeeds:
+        response = session.get(URL, hooks={"response": replace}, stream=stream)
+        assert response is replacement
+        assert response.content == body
+        assert b"".join(response.iter_content(1)) == body
+        replacement.close.assert_not_called()
+    else:
+        with pytest.raises(ResponseTooLarge) as caught:
+            session.get(URL, hooks={"response": replace}, stream=stream)
+        assert caught.value.response is replacement
+        assert caught.value.received == len(body)
+        replacement.close.assert_called_once_with()
+        with pytest.raises(ResponseTooLarge):
+            replacement.content
+
+
+def test_hook_read_is_protected_before_dispatch():
+    session, adapter = budget_session(3)
+
+    def read_body(response, **kwargs):
+        response.text
+
+    with pytest.raises(ResponseTooLarge):
+        session.get(URL, hooks={"response": read_body}, stream=True)
+    assert adapter.responses[0].raw.closes == 1
+
+
+def test_hook_can_forward_transport_arguments_without_budget_leaking():
+    session, adapter = budget_session(3)
+
+    def retry(response, **kwargs):
+        response.close()
+        return adapter.send(response.request, **kwargs)
+
+    with pytest.raises(ResponseTooLarge) as caught:
+        session.get(URL, hooks={"response": retry})
+    assert len(adapter.responses) == 2
+    assert caught.value.response is adapter.responses[1]
+
+
+@pytest.mark.parametrize("cached", [False, True])
+def test_budget_follows_replacements_before_the_next_hook_reads(cached):
+    session, adapter = budget_session(3)
+    yielded = []
+
+    def replace(response, **kwargs):
+        response.close()
+        replacement = adapter.send(response.request, **kwargs)
+        if cached:
+            replacement._content = b"abcdef"
+            replacement._content_consumed = True
+        return replacement
+
+    def read(response, **kwargs):
+        yielded.append(next(response.iter_content(4)))
+
+    with pytest.raises(ResponseTooLarge) as caught:
+        session.get(URL, stream=True, hooks={"response": [replace, read]})
+    assert caught.value.response is adapter.responses[1]
+    assert caught.value.received == (6 if cached else 4)
+    assert yielded == []
+
+
+def test_digest_auth_retry_obeys_budget(httpbin):
+    with pytest.raises(ResponseTooLarge) as caught:
+        requests.get(
+            httpbin("digest-auth", "auth", "user", "pass"),
+            auth=requests.auth.HTTPDigestAuth("user", "pass"),
+            max_response_bytes=1,
+        )
+    assert caught.value.response.status_code == 200
+    assert caught.value.response.history[0].status_code == 401
+
+
+@pytest.fixture(scope="module")
+def body_server():
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            parts = self.path.strip("/").split("/")
+            status = 200
+            encoding = None
+            chunked = parts[0] == "chunked"
+            if parts[0] == "redirect":
+                status = 302
+                body = b"a" * int(parts[1])
+                location = f"/body/{parts[2]}"
+            elif parts[0] == "chain":
+                status = 302
+                body = b"a" * int(parts[2])
+                location = (
+                    f"/chain/{int(parts[1]) - 1}/{parts[2]}"
+                    if int(parts[1]) > 1
+                    else f"/body/{parts[2]}"
+                )
+            elif parts[0] in ("gzip", "deflate"):
+                encoding = parts[0]
+                body = b"a" * 40000
+                body = (
+                    gzip.compress(body) if encoding == "gzip" else zlib.compress(body)
+                )
+            elif parts[0] == "unicode":
+                body = "éééé".encode()
+            else:
+                body = b"a" * int(parts[1])
+            self.send_response(status)
+            self.send_header("Content-Type", "text/plain; charset=utf-8")
+            if status == 302:
+                self.send_header("Location", location)
+            if encoding:
+                self.send_header("Content-Encoding", encoding)
+            self.send_header(
+                "Transfer-Encoding" if chunked else "Content-Length",
+                "chunked" if chunked else str(len(body)),
+            )
+            self.end_headers()
+            if self.command != "HEAD":
+                if chunked:
+                    for offset in range(0, len(body), 2):
+                        chunk = body[offset : offset + 2]
+                        self.wfile.write(
+                            f"{len(chunk):x}\r\n".encode() + chunk + b"\r\n"
+                        )
+                    self.wfile.write(b"0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+
+        do_HEAD = do_GET
+        do_POST = do_GET
+        do_PUT = do_GET
+        do_PATCH = do_GET
+        do_DELETE = do_GET
+        do_OPTIONS = do_GET
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    yield f"http://127.0.0.1:{server.server_port}"
+    server.shutdown()
+    server.server_close()
+    thread.join(timeout=5)
+
+
+@pytest.mark.parametrize(
+    "method", ["get", "post", "put", "patch", "delete", "options", "request"]
+)
+@pytest.mark.parametrize("use_session", [False, True])
+def test_convenience_helpers_surface_error(body_server, method, use_session):
+    client = requests.Session() if use_session else requests
+    args = ("GET",) if method == "request" else ()
+    with pytest.raises(ResponseTooLarge) as caught:
+        getattr(client, method)(*args, body_server + "/body/6", max_response_bytes=5)
+    assert caught.value.received == 6
+    assert caught.value.response.raw.closed
+    if use_session:
+        client.close()
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("route", ["gzip", "deflate"])
+def test_compression_counts_decoded_bytes(body_server, route, stream):
+    with pytest.raises(ResponseTooLarge) as caught:
+        response = requests.get(
+            body_server + "/" + route, max_response_bytes=100, stream=stream
+        )
+        next(response.iter_content(101))
+    error = caught.value
+    assert int(error.response.headers["Content-Length"]) < error.limit
+    assert error.received > error.limit
+    assert error.response.raw.closed
+    assert (
+        requests.get(body_server + "/" + route, max_response_bytes=40000).content
+        == b"a" * 40000
+    )
+
+
+@pytest.mark.parametrize("decode_unicode", [False, True])
+def test_unicode_stream_counts_bytes_before_character_decoding(
+    body_server, decode_unicode
+):
+    response = requests.get(body_server + "/unicode", stream=True, max_response_bytes=7)
+    chunks = response.iter_content(4, decode_unicode=decode_unicode)
+    assert next(chunks) == ("éé" if decode_unicode else "éé".encode())
+    with pytest.raises(ResponseTooLarge) as caught:
+        next(chunks)
+    assert caught.value.received == 8
+
