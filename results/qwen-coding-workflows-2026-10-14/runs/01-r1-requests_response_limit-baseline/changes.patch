+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("first, last", [(7, 1), (1, 7)])
+def test_intermediate_and_final_redirect_budgets(body_server, stream, first, last):
+    with pytest.raises(ResponseTooLarge) as caught:
+        response = requests.get(
+            f"{body_server}/redirect/{first}/{last}",
+            stream=stream,
+            max_response_bytes=6,
+        )
+        response.content
+    assert caught.value.response.status_code == (302 if first > 6 else 200)
+    assert caught.value.received == 7
+
