+@pytest.mark.parametrize("entry", ["request", "send"])
+def test_redirect_budgets_are_independent_and_none_disables_whole_chain(
+    body_server, entry
+):
+    with requests.Session(max_response_bytes=6) as session:
+        response = session.get(body_server + "/chain/3/6")
+        assert len(response.history) == 3
+        assert all(r.content == b"a" * 6 for r in [*response.history, response])
+        session.max_response_bytes = 0
+        url = body_server + "/redirect/7/8"
+        if entry == "request":
+            response = session.get(url, max_response_bytes=None)
+        else:
+            response = session.send(
+                requests.Request("GET", url).prepare(), max_response_bytes=None
+            )
+        assert response.history[0].content == b"a" * 7
+        assert response.content == b"a" * 8
+        assert session.max_response_bytes == 0
+
+
+def test_redirect_without_following_still_obeys_budget(body_server):
+    with pytest.raises(ResponseTooLarge) as caught:
+        requests.get(
+            body_server + "/redirect/7/1",
+            max_response_bytes=6,
+            stream=True,
+            allow_redirects=False,
+        )
+    assert caught.value.response.status_code == 302
