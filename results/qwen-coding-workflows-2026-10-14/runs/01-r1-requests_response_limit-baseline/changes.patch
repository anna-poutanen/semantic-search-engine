+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("route", ["body", "chunked"])
+def test_local_empty_exact_and_excess_bodies(body_server, route, stream):
+    for size, limit in [(0, 0), (6, 6)]:
+        response = requests.get(
+            f"{body_server}/{route}/{size}", stream=stream, max_response_bytes=limit
+        )
+        assert response.content == b"a" * size
+    with pytest.raises(ResponseTooLarge):
+        response = requests.get(
+            f"{body_server}/{route}/1", stream=stream, max_response_bytes=0
+        )
+        response.text
+    assert requests.head(body_server + "/body/100", max_response_bytes=0).content == b""
+    with requests.Session(max_response_bytes=0) as session:
+        assert session.head(body_server + "/body/100").content == b""
+
