+    error = RuntimeError("failed after close")
+    handles = []
+
+    def use_file(output):
+        handles.append(output)
+        output.write("committed")
+        output.close()
+        output.close()
+        assert path.read_bytes() == b"committed"
+        raise error
+
+    if command:
