@@ -0,0 +1,469 @@
+import io
+import os
+import stat
+
+import pytest
+
+import click
+from click import _compat
+from click.exceptions import Exit
+
+OLD = b"original output\n"
+
+
+def prepare_destination(path, exists):
+    if exists:
+        path.write_bytes(OLD)
+        path.chmod(0o640)
+
+
+def assert_original(path, exists):
+    if exists:
+        assert path.read_bytes() == OLD
+    else:
+        assert not path.exists()
+
+
+def write_output(output, mode):
+    value = "replacement caf\u00e9\n"
+    if "b" in mode:
+        value = value.encode("utf-8")
+    output.write(value)
+    output.flush()
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize("outcome", ["return", "error", "exit_zero"])
+def test_open_file_transaction(tmp_path, lazy, mode, exists, outcome):
+    path = tmp_path / "output"
+    prepare_destination(path, exists)
+    error = RuntimeError("body failed") if outcome == "error" else Exit(0)
+    output = click.open_file(path, mode, encoding="utf-8", lazy=lazy, atomic=True)
+
+    def use_file():
+        with output:
+            write_output(output, mode)
+            assert_original(path, exists)
+            assert len(list(tmp_path.glob(".__atomic-write*"))) == 1
+            if outcome != "return":
+                raise error
+
+    if outcome == "return":
+        use_file()
+        assert path.read_bytes() == "replacement caf\u00e9\n".encode()
+    else:
+        with pytest.raises(type(error)) as caught:
+            use_file()
+        assert caught.value is error
+        assert_original(path, exists)
+
+    assert output.closed
+    output.close()
+    output.close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    if exists and os.name != "nt":
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize("standalone", [False, True])
+@pytest.mark.parametrize(
+    "outcome", ["return", "exit_zero", "exit_nonzero", "error", "click_error", "abort"]
+)
+def test_file_parameter_transaction(
+    runner, tmp_path, lazy, mode, exists, standalone, outcome
+):
+    path = tmp_path / "output"
+    prepare_destination(path, exists)
+    error = (
+        click.ClickException("callback failed")
+        if outcome == "click_error"
+        else RuntimeError("callback failed")
+    )
+    handles = []
+    previous_context = click.get_current_context(silent=True)
+
+    @click.command()
+    @click.argument(
+        "output", type=click.File(mode, encoding="utf-8", lazy=lazy, atomic=True)
+    )
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        write_output(output, mode)
+        assert_original(path, exists)
+        if outcome == "exit_zero":
+            ctx.exit(0)
+        if outcome == "exit_nonzero":
+            ctx.exit(3)
+        if outcome in {"error", "click_error"}:
+            raise error
+        if outcome == "abort":
+            ctx.abort()
+
+    result = runner.invoke(cli, [str(path)], standalone_mode=standalone)
+    success = outcome in {"return", "exit_zero"}
+    if success:
+        assert result.exit_code == 0
+        assert result.exception is None
+        assert path.read_bytes() == "replacement caf\u00e9\n".encode()
+    else:
+        assert_original(path, exists)
+        if outcome == "exit_nonzero" and not standalone:
+            assert result.return_value == 3
+        else:
+            assert result.exit_code != 0
+        if outcome == "error" or (outcome == "click_error" and not standalone):
+            assert result.exception is error
+
+    assert len(handles) == 1
+    assert handles[0].closed
+    handles[0].close()
+    handles[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert click.get_current_context(silent=True) is previous_context
+    if exists and os.name != "nt":
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
