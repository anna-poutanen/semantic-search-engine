+        else:
+            with pytest.raises(error_type) as caught:
+                with click.open_file(path, "w", lazy=lazy, atomic=True) as output:
+                    use_file(output)
+            assert caught.value is error
+
+    assert handles[0].closed
+    handles[0].close()
+    assert_original(path, True)
+    notes = getattr(error, "__notes__", ())
+    assert any("cannot remove temporary output" in note for note in notes) or (
+        error.__context__ is cleanup_error or error.__cause__ is cleanup_error
+    )
