+    handles = []
+
+    def cannot_unlink(filename):
+        raise cleanup_error
+
+    def use_file(output):
+        handles.append(output)
+        output.write("discarded")
+        patch.setattr(_compat.os, "unlink", cannot_unlink)
+        raise error
+
+    with monkeypatch.context() as patch:
+        # Restore unlink before pytest removes its temporary directory.
+        if command:
+
+            @click.command()
+            @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+            def cli(output):
+                use_file(output)
