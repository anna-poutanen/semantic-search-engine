+    if command:
+
+        @click.command()
+        @click.argument("output", type=click.File(mode, lazy=lazy, atomic=atomic))
+        def cli(output):
+            use_file(output)
+
+        result = runner.invoke(cli, ["-"])
+        assert isinstance(result.exception, RuntimeError)
+    else:
+        with pytest.raises(RuntimeError):
+            with click.open_file("-", mode, lazy=lazy, atomic=atomic) as output:
+                use_file(output)
+
+    assert not stream.closed
+    expected = "replacement caf\u00e9\n"
+    assert stream.getvalue() == (expected.encode("utf-8") if "b" in mode else expected)
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("command", [False, True])
+def test_non_atomic_failure_keeps_written_output(runner, tmp_path, lazy, command):
+    path = tmp_path / "output"
+    prepare_destination(path, True)
+
+    def use_file(output):
+        output.write("partial output")
+        raise RuntimeError("failed")
+
+    if command:
+
+        @click.command()
+        @click.argument("output", type=click.File("w", lazy=lazy))
+        def cli(output):
+            use_file(output)
+
+        result = runner.invoke(cli, [str(path)])
+        assert isinstance(result.exception, RuntimeError)
+    else:
+        with pytest.raises(RuntimeError):
+            with click.open_file(path, "w", lazy=lazy) as output:
+                use_file(output)
+    assert path.read_bytes() == b"partial output"
