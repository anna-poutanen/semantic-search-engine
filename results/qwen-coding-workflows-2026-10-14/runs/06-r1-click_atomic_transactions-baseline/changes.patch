+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("command", [False, True])
+@pytest.mark.parametrize("error_type", [RuntimeError, ErrorWithoutNotes])
+def test_abort_cleanup_error_preserves_callback(
+    runner, tmp_path, monkeypatch, lazy, command, error_type
+):
+    path = tmp_path / "output"
+    prepare_destination(path, True)
+    error = error_type("primary failure")
