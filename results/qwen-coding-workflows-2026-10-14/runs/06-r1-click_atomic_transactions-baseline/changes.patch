+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+class Resource:
+    def __init__(self, cleanup_error=None, suppress=False):
+        self.exits = []
+        self.cleanup_error = cleanup_error
+        self.suppress = suppress
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, tb):
+        self.exits.append((exc_type, exc_value, tb, click.get_current_context()))
+        if self.cleanup_error is not None:
+            raise self.cleanup_error
+        return self.suppress
+
+
+@pytest.mark.parametrize(
+    "error", [RuntimeError("callback"), KeyboardInterrupt(), Exit(2)]
+)
+@pytest.mark.parametrize("suppress", [False, True])
+def test_resource_receives_callback_exception_and_context_is_restored(error, suppress):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    resource = Resource(suppress=suppress)
+    previous_context = click.get_current_context(silent=True)
+
+    with outer:
+        with pytest.raises(type(error)) as caught:
+            with ctx:
+                assert ctx.with_resource(resource) is resource
+                raise error
+        assert caught.value is error
+        assert click.get_current_context() is outer
+
+    [(exc_type, exc_value, tb, current)] = resource.exits
+    assert exc_type is type(error)
+    assert exc_value is error
+    assert tb is error.__traceback__
+    assert current is ctx
+    assert click.get_current_context(silent=True) is previous_context
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_nested_context_defers_resource_cleanup(fail):
+    ctx = click.Context(click.Command("nested"))
+    resource = Resource()
+    error = RuntimeError("nested callback")
+    previous_context = click.get_current_context(silent=True)
+
+    def run():
+        with ctx:
+            ctx.with_resource(resource)
+            try:
+                with ctx:
+                    assert click.get_current_context() is ctx
+                    if fail:
+                        raise error
+            finally:
+                assert resource.exits == []
+                assert click.get_current_context() is ctx
+
+    if fail:
+        with pytest.raises(RuntimeError) as caught:
+            run()
+        assert caught.value is error
+    else:
+        run()
+
+    [(exc_type, exc_value, tb, current)] = resource.exits
+    assert exc_type is (RuntimeError if fail else None)
+    assert exc_value is (error if fail else None)
+    assert (tb is not None) == fail
+    assert current is ctx
+    assert click.get_current_context(silent=True) is previous_context
+
+
+def test_caught_nested_error_allows_normal_outer_cleanup():
+    ctx = click.Context(click.Command("nested"))
+    resource = Resource()
+    with ctx:
+        ctx.with_resource(resource)
+        with pytest.raises(RuntimeError):
+            with ctx:
+                raise RuntimeError("handled by callback")
+        assert resource.exits == []
+    assert resource.exits == [(None, None, None, ctx)]
+
+
+def test_scope_without_cleanup_defers_resources():
+    ctx = click.Context(click.Command("scope"))
+    resource = Resource()
+    previous_context = click.get_current_context(silent=True)
+    with ctx.scope(cleanup=False):
+        ctx.with_resource(resource)
+    assert resource.exits == []
+    assert click.get_current_context(silent=True) is previous_context
+    with ctx:
+        pass
+    assert resource.exits == [(None, None, None, ctx)]
+
+
+@pytest.mark.parametrize("resource_kind", ["manager", "callback"])
+@pytest.mark.parametrize("fail", [False, True])
+def test_cleanup_failure_restores_context_and_preserves_primary(resource_kind, fail):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    error = RuntimeError("primary callback")
+    cleanup_error = OSError("cleanup failure")
+    resource = Resource(cleanup_error=cleanup_error)
+
+    def cleanup():
+        assert click.get_current_context() is ctx
+        raise cleanup_error
+
+    with outer:
+        with pytest.raises(RuntimeError if fail else OSError) as caught:
+            with ctx:
+                if resource_kind == "manager":
+                    ctx.with_resource(resource)
+                else:
+                    ctx.call_on_close(cleanup)
+                if fail:
+                    raise error
+        assert caught.value is (error if fail else cleanup_error)
+        assert click.get_current_context() is outer
+        # Reusing a context must not rerun any failed cleanup.
+        with ctx:
+            pass
+        assert click.get_current_context() is outer
+
+    if fail:
+        notes = getattr(error, "__notes__", ())
+        assert any("cleanup failure" in note for note in notes) or (
+            error.__context__ is cleanup_error or error.__cause__ is cleanup_error
+        )
+
+
+@pytest.mark.parametrize("explicit_exit", [False, True])
+def test_successful_command_exit_closes_resource_normally(runner, explicit_exit):
+    resource = Resource()
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(resource)
+        if explicit_exit:
+            ctx.exit()
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0
+    [(exc_type, exc_value, tb, current)] = resource.exits
+    assert (exc_type, exc_value, tb) == (None, None, None)
+    assert current.command is cli
