+def _attach_cleanup_error(
+    exc_value: BaseException, cleanup_error: BaseException
+) -> None:
+    """Keep a cleanup failure visible without replacing the active error."""
+    if cleanup_error is exc_value:
+        return
+
+    add_note = getattr(exc_value, "add_note", None)
+
+    if add_note is not None:
