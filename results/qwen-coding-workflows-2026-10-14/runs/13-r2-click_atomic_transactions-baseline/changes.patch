@@ -0,0 +1,129 @@
+import pytest
+
+import click
+
+
+class Resource:
+    def __init__(self, ctx, cleanup_error=None):
+        self.ctx = ctx
+        self.cleanup_error = cleanup_error
+        self.exits = []
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, tb):
+        assert click.get_current_context() is self.ctx
+        self.exits.append((exc_type, exc_value, tb))
+        if self.cleanup_error is not None:
+            raise self.cleanup_error
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_nested_context_resource_receives_outer_exception(fail):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    resource = Resource(ctx)
+    error = RuntimeError("body failed")
+    callbacks = []
+    with parent:
+        try:
+            with ctx:
+                assert ctx.with_resource(resource) is resource
+                ctx.call_on_close(lambda: callbacks.append(click.get_current_context()))
+                try:
+                    with ctx:
+                        with ctx.scope(cleanup=False):
+                            assert not resource.exits
+                            if fail:
+                                raise error
+                finally:
+                    assert not resource.exits
+                    assert not callbacks
+                    assert click.get_current_context() is ctx
+        except RuntimeError as caught:
+            assert fail
+            assert caught is error
+        assert click.get_current_context() is parent
+    assert click.get_current_context(silent=True) is None
+    assert callbacks == [ctx]
+    assert len(resource.exits) == 1
+    exc_type, exc_value, tb = resource.exits[0]
+    if fail:
+        assert exc_type is RuntimeError
+        assert exc_value is error
+        assert tb is not None
+        assert (
+            tb.tb_frame.f_code.co_name
+            == "test_nested_context_resource_receives_outer_exception"
+        )
+    else:
+        assert (exc_type, exc_value, tb) == (None, None, None)
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_context_cleanup_failure_restores_stack_and_allows_reuse(fail):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    error = RuntimeError("body failed")
+    cleanup_error = OSError("cleanup failed")
+    resource = Resource(ctx, cleanup_error)
+    with parent:
+        with pytest.raises(RuntimeError if fail else OSError) as caught:
+            with ctx:
+                ctx.with_resource(resource)
+                if fail:
+                    raise error
+        assert click.get_current_context() is parent
+        if fail:
+            assert caught.value is error
+            notes = " ".join(getattr(error, "__notes__", ()))
+            assert error.__cause__ is cleanup_error or "cleanup failed" in notes
+        else:
+            assert caught.value is cleanup_error
+        other = Resource(ctx)
+        with ctx:
+            ctx.with_resource(other)
+        assert len(resource.exits) == 1
+        assert other.exits == [(None, None, None)]
+        assert click.get_current_context() is parent
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("outcome", ["return", "error", "exit_zero", "exit_nonzero"])
+def test_command_resource_cleanup_receives_error(runner, outcome):
+    error = RuntimeError("callback failed")
+    resources = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        resource = Resource(ctx)
+        resources.append(resource)
+        ctx.with_resource(resource)
+        with ctx:
+            assert not resource.exits
+            if outcome == "error":
+                raise error
+            if outcome.startswith("exit_"):
+                ctx.exit(0 if outcome == "exit_zero" else 4)
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert result.exit_code == (1 if outcome == "error" else 0)
+    if outcome == "error":
+        assert result.exception is error
+    if outcome == "exit_nonzero":
+        assert result.return_value == 4
+    assert len(resources[0].exits) == 1
+    exc_type, exc_value, tb = resources[0].exits[0]
+    if outcome == "error":
+        assert exc_type is RuntimeError
+        assert exc_value is error
+        assert tb is not None
+    elif outcome == "exit_nonzero":
+        assert exc_type is click.exceptions.Exit
+        assert exc_value.exit_code == 4
+        assert tb is not None
+    else:
+        assert (exc_type, exc_value, tb) == (None, None, None)
+    assert click.get_current_context(silent=True) is None
