+import os
+import stat
+import sys
+
+import pytest
+
+import click
+
+
+def assert_destination(path, existed, contents=b"original"):
+    if existed:
+        assert path.read_bytes() == contents
+    else:
+        assert not path.exists()
+
+
+def atomic_handle(file, lazy):
+    return file._f if lazy else file
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("existed", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_direct_atomic_transaction(tmp_path, lazy, binary, existed, fail):
+    path = tmp_path / "output"
+    if existed:
+        path.write_bytes(b"original")
+        path.chmod(0o640)
+    error = RuntimeError("body failed")
+    data = b"new\x00data" if binary else "new caf\u00e9"
+
+    def write():
+        with click.open_file(
+            path,
+            "wb" if binary else "w",
+            lazy=lazy,
+            atomic=True,
+            encoding=None if binary else "utf-8",
+        ) as file:
+            assert_destination(path, existed)
+            file.write(data)
+            file.flush()
+            assert_destination(path, existed)
+            assert len(list(tmp_path.glob(".__atomic-write*"))) == 1
+            handles.append(file)
+            if fail:
+                raise error
+
+    handles = []
+    if fail:
+        with pytest.raises(RuntimeError) as caught:
+            write()
+        assert caught.value is error
+        assert_destination(path, existed)
+    else:
+        write()
+        assert path.read_bytes() == (data if binary else data.encode("utf-8"))
+    handle = atomic_handle(handles[0], lazy)
+    assert handle.closed
+    assert handle._f.closed
+    handles[0].close()
+    handles[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    if existed and os.name != "nt":
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("existed", [False, True])
+@pytest.mark.parametrize(
+    "outcome", ["return", "error", "abort", "click_error", "exit_zero", "exit_nonzero"]
+)
+def test_command_atomic_transaction(runner, tmp_path, lazy, binary, existed, outcome):
+    path = tmp_path / "output"
+    if existed:
+        path.write_bytes(b"original")
+        path.chmod(0o640)
+    error = RuntimeError("callback failed")
+    data = b"new\x00data" if binary else "new caf\u00e9"
+    handles = []
+
+    @click.command()
+    @click.argument(
+        "output",
+        type=click.File(
+            "wb" if binary else "w",
+            lazy=lazy,
+            atomic=True,
+            encoding=None if binary else "utf-8",
+        ),
+    )
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        assert_destination(path, existed)
+        output.write(data)
+        output.flush()
+        assert_destination(path, existed)
+        if outcome == "error":
+            raise error
+        if outcome == "abort":
+            ctx.abort()
+        if outcome == "click_error":
+            raise click.ClickException("callback failed")
+        if outcome == "exit_zero":
+            ctx.exit(0)
+        if outcome == "exit_nonzero":
+            ctx.exit(7)
+
+    result = runner.invoke(cli, [str(path)])
+    success = outcome in {"return", "exit_zero"}
+    assert result.exit_code == (0 if success else 7 if outcome == "exit_nonzero" else 1)
+    if outcome == "error":
+        assert result.exception is error
+    if success:
+        assert path.read_bytes() == (data if binary else data.encode("utf-8"))
+    else:
+        assert_destination(path, existed)
+    handle = atomic_handle(handles[0], lazy is not False)
+    assert handle.closed
+    assert handle._f.closed
+    handles[0].close()
+    handles[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    if existed and os.name != "nt":
+        assert stat.S_IMODE(path.stat().st_mode) == 0o640
