+"""Loopback integration tests for decompression and redirect response budgets."""
+
+import gzip
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import requests
+
+DECODED_BODY = "é".encode() * 2048
+
+
+@pytest.fixture
+def budget_server():
+    paths = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def do_HEAD(self):
+            self.respond(head=True)
+
+        def do_GET(self):
+            self.respond()
+
+        def respond(self, head=False):
+            paths.append(self.path)
+            status = 200
+            headers = {}
+            body = b"abcdef"
+            chunked = self.path == "/chunked"
+            if self.path == "/empty":
+                body = b""
+            elif self.path in ("/gzip", "/deflate", "/gzip-small", "/gzip-empty"):
+                decoded = DECODED_BODY
+                if self.path == "/gzip-small":
+                    decoded = b"hi"
+                elif self.path == "/gzip-empty":
+                    decoded = b""
+                encoding = "deflate" if self.path == "/deflate" else "gzip"
+                body = (
+                    zlib.compress(decoded)
+                    if encoding == "deflate"
+                    else gzip.compress(decoded)
+                )
+                headers["Content-Encoding"] = encoding
+                headers["Content-Type"] = "text/plain; charset=utf-8"
+            elif self.path.startswith("/redirect/"):
+                sizes = self.path.removeprefix("/redirect/").split("/")
+                body = b"x" * int(sizes[0])
+                if len(sizes) > 1:
+                    status = 302
+                    headers["Location"] = "/redirect/" + "/".join(sizes[1:])
+            elif chunked:
+                body = "ééé".encode()
+                headers["Transfer-Encoding"] = "chunked"
+                headers["Content-Type"] = "text/plain; charset=utf-8"
+
+            self.send_response(status)
+            for name, value in headers.items():
+                self.send_header(name, value)
+            if not chunked:
+                self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            if head:
+                return
+            try:
+                if chunked:
+                    for start in range(0, len(body), 2):
+                        chunk = body[start : start + 2]
+                        self.wfile.write(
+                            f"{len(chunk):x}\r\n".encode() + chunk + b"\r\n"
+                        )
+                    self.wfile.write(b"0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+            except (BrokenPipeError, ConnectionResetError):
+                pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(
+        target=server.serve_forever, kwargs={"poll_interval": 0.01}
+    )
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}", paths
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+@pytest.fixture
+def session():
+    with requests.Session() as session:
+        session.trust_env = False
+        yield session
+
+
+@pytest.mark.parametrize("path", ["/gzip", "/deflate"])
+@pytest.mark.parametrize("stream", [False, True])
+def test_budget_counts_decompressed_bytes(budget_server, session, path, stream):
+    base, paths = budget_server
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        response = session.get(base + path, stream=stream, max_response_bytes=128)
+        list(response.iter_content(64))
+    error = exc.value
+    assert int(error.response.headers["Content-Length"]) < error.limit
+    assert error.limit == 128
+    assert error.received == (192 if stream else len(DECODED_BODY))
+    assert error.request.url == base + path
+    assert error.response.raw.closed
+    assert paths == [path]
+    with pytest.raises(requests.ResponseTooLarge) as later:
+        error.response.text
+    assert later.value is error
+
+
+@pytest.mark.parametrize("path", ["/gzip", "/deflate"])
+@pytest.mark.parametrize("stream", [False, True])
+def test_decompressed_exact_boundary_and_cached_rereads(
+    budget_server, session, path, stream
+):
+    base, _ = budget_server
+    response = session.get(
+        base + path, stream=stream, max_response_bytes=len(DECODED_BODY)
+    )
+    assert response.content == DECODED_BODY
+    assert response.text == "é" * 2048
+    assert "".join(response.iter_content(7, decode_unicode=True)) == response.text
+    assert b"".join(response.iter_content(13)) == DECODED_BODY
+
+
+@pytest.mark.parametrize(
+    "path,limit,expected",
+    [("/empty", 0, b""), ("/gzip-empty", 0, b""), ("/gzip-small", 2, b"hi")],
+)
+@pytest.mark.parametrize("stream", [False, True])
+def test_content_length_does_not_determine_budget(
+    budget_server, session, path, limit, expected, stream
+):
+    base, _ = budget_server
+    response = session.get(base + path, stream=stream, max_response_bytes=limit)
+    assert response.content == expected
+
+
+def test_zero_budget_head_ignores_advertised_body_length(budget_server):
+    base, _ = budget_server
+    response = requests.head(base + "/plain", max_response_bytes=0, timeout=5)
+    assert response.headers["Content-Length"] == "6"
+    assert response.content == b""
+
+
+def test_chunked_unicode_stream_crosses_on_decoded_bytes(budget_server, session):
+    base, _ = budget_server
+    response = session.get(base + "/chunked", stream=True, max_response_bytes=4)
+    chunks = response.iter_content(2, decode_unicode=True)
+    assert next(chunks) == "é"
+    assert next(chunks) == "é"
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        next(chunks)
+    assert exc.value.received == 6
+    assert response.raw.closed
+
+
+@pytest.mark.parametrize("sizes,index", [("7/1", 0), ("2/7/1", 1), ("2/2/7", 2)])
+@pytest.mark.parametrize("stream", [False, True])
+def test_every_redirect_response_has_its_own_budget(
+    budget_server, session, sizes, index, stream
+):
+    base, paths = budget_server
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        response = session.get(
+            base + "/redirect/" + sizes, stream=stream, max_response_bytes=3
+        )
+        response.content
+    offending_path = "/redirect/" + "/".join(sizes.split("/")[index:])
+    assert exc.value.response.url == base + offending_path
+    assert exc.value.received == 7
+    assert exc.value.response.raw.closed
+    assert len(paths) == index + 1
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_redirect_totals_are_independent(budget_server, session, stream):
+    base, _ = budget_server
+    response = session.get(
+        base + "/redirect/3/3/3", stream=stream, max_response_bytes=3
+    )
+    assert [item.content for item in response.history] == [b"xxx", b"xxx"]
+    assert response.content == b"xxx"
+    assert list(response.iter_content(1)) == [b"x", b"x", b"x"]
+
+
+@pytest.mark.parametrize("entry", ["request", "send"])
+@pytest.mark.parametrize("override", [None, 7])
+def test_override_applies_to_entire_redirect_chain(
+    budget_server, session, entry, override
+):
+    base, _ = budget_server
+    session.max_response_bytes = 0
+    url = base + "/redirect/7/7/7"
+    if entry == "send":
+        response = session.send(
+            requests.Request("GET", url).prepare(), max_response_bytes=override
+        )
+    else:
+        response = session.get(url, max_response_bytes=override)
+    assert response.content == b"xxxxxxx"
+    assert [item.content for item in response.history] == [b"xxxxxxx", b"xxxxxxx"]
+    assert session.max_response_bytes == 0
+
+
+def test_disabled_redirects_still_budget_the_redirect_body(budget_server, session):
+    base, paths = budget_server
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        session.get(
+            base + "/redirect/7/1",
+            allow_redirects=False,
+            stream=True,
+            max_response_bytes=3,
+        )
+    assert exc.value.response.status_code == 302
+    assert paths == ["/redirect/7/1"]
+
+
+@pytest.mark.parametrize("entry", ["session", "module"])
+def test_eager_convenience_request_raises_size_error(budget_server, session, entry):
+    base, _ = budget_server
+    owner = session if entry == "session" else requests
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        owner.get(base + "/gzip", max_response_bytes=128, timeout=5)
+    assert exc.value.received == len(DECODED_BODY)
