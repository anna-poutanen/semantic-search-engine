diff --git a/tests/test_response_limit.py b/tests/test_response_limit.py
new file mode 100644
index 0000000..6fe1612
--- /dev/null
+++ b/tests/test_response_limit.py
@@ -0,0 +1,383 @@
+"""Regression coverage for decoded response budgets without network access."""
+
+import io
+import pickle
+from unittest.mock import Mock
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+
+
+class CountingBody(io.BytesIO):
+    def __init__(self, content, close_error=None):
+        super().__init__(content)
+        self.reads = 0
+        self.closes = 0
+        self.close_error = close_error
+
+    def read(self, size=-1):
+        self.reads += 1
+        return super().read(size)
+
+    def close(self):
+        self.closes += 1
+        if self.close_error is not None:
+            raise self.close_error
+        super().close()
+
+
+class StreamingBody(CountingBody):
+    def stream(self, size, decode_content):
+        assert decode_content is True
+        while True:
+            chunk = self.read(size)
+            if not chunk:
+                return
+            yield chunk
+
+
+class MemoryAdapter(BaseAdapter):
+    def __init__(self, body=b"abcdefghij", raw_type=CountingBody):
+        self.body = body
+        self.raw_type = raw_type
+        self.calls = []
+        self.responses = []
+
+    # A strict signature also checks that the budget never reaches transport.
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        self.calls.append(request)
+        response = requests.Response()
+        response.status_code = 200
+        response.url = request.url
+        response.request = request
+        response.connection = self
+        response.encoding = "utf-8"
+        response.raw = self.raw_type(self.body)
+        self.responses.append(response)
+        return response
+
+    def close(self):
+        pass
+
+
+@pytest.fixture
+def memory_session():
+    with requests.Session() as session:
+        session.trust_env = False
+        adapter = MemoryAdapter()
+        session.mount("http://", adapter)
+        yield session, adapter
+
+
+URL = "http://localhost/body"
+INVALID_LIMITS = [-1, True, False, 1.0, "1", b"1", [], {}, object(), float("inf")]
+
+
+@pytest.mark.parametrize("limit", INVALID_LIMITS)
+@pytest.mark.parametrize("entry", ["constructor", "request", "send", "session_setting"])
+def test_invalid_limits_fail_before_transport(memory_session, limit, entry):
+    session, adapter = memory_session
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        if entry == "constructor":
+            requests.Session(max_response_bytes=limit)
+        elif entry == "request":
+            session.request("GET", URL, max_response_bytes=limit)
+        elif entry == "send":
+            session.send(
+                requests.Request("GET", URL).prepare(), max_response_bytes=limit
+            )
+        else:
+            session.max_response_bytes = limit
+            session.get(URL)
+    assert adapter.calls == []
+
+
+@pytest.mark.parametrize("entry", ["request", "send"])
+def test_session_inheritance_and_explicit_overrides(memory_session, entry):
+    session, _ = memory_session
+
+    def send(**kwargs):
+        if entry == "send":
+            return session.send(requests.Request("GET", URL).prepare(), **kwargs)
+        return session.get(URL, **kwargs)
+
+    assert session.max_response_bytes is None
+    assert send().content == b"abcdefghij"
+    session.max_response_bytes = 3
+    with pytest.raises(requests.ResponseTooLarge):
+        send()
+    assert send(max_response_bytes=None).content == b"abcdefghij"
+    assert send(max_response_bytes=10).content == b"abcdefghij"
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        send(max_response_bytes=2)
+    assert exc.value.limit == 2
+    assert session.max_response_bytes == 3
+
+
+@pytest.mark.parametrize(
+    "method", ["get", "options", "head", "post", "put", "patch", "delete", "request"]
+)
+@pytest.mark.parametrize("module_level", [False, True])
+def test_public_helpers_surface_the_same_exception(
+    memory_session, monkeypatch, method, module_level
+):
+    session, adapter = memory_session
+    if module_level:
+        monkeypatch.setattr(requests.sessions, "Session", lambda: session)
+    owner = requests if module_level else session
+    args = ("GET", URL) if method == "request" else (URL,)
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        getattr(owner, method)(*args, max_response_bytes=3)
+    assert requests.ResponseTooLarge is requests.exceptions.ResponseTooLarge
+    assert isinstance(exc.value, requests.exceptions.RequestException)
+    assert exc.value.limit == 3
+    assert exc.value.received == 10
+    assert exc.value.response is adapter.responses[0]
+    assert exc.value.request is adapter.calls[0]
+    assert adapter.responses[0].raw.closes == 1
+
+
+@pytest.mark.parametrize("limit", [None, 0, 7])
+def test_session_setting_survives_pickling(limit):
+    with requests.Session(max_response_bytes=limit) as session:
+        session.trust_env = False
+        restored = pickle.loads(pickle.dumps(session))
+    with restored:
+        assert restored.max_response_bytes == limit
+        adapter = MemoryAdapter(b"12345678")
+        restored.mount("http://", adapter)
+        if limit is None:
+            assert restored.get(URL).content == b"12345678"
+        else:
+            with pytest.raises(requests.ResponseTooLarge) as exc:
+                restored.get(URL)
+            assert exc.value.limit == limit
+
+
+def test_old_pickled_session_defaults_to_unlimited():
+    with requests.Session() as session:
+        state = session.__getstate__()
+    state.pop("max_response_bytes")
+    restored = requests.Session.__new__(requests.Session)
+    restored.__setstate__(state)
+    assert restored.max_response_bytes is None
+    restored.close()
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("body,limit", [(b"", 0), (b"x", 1), (b"abc", 3)])
+def test_empty_and_exact_boundary_bodies(memory_session, stream, body, limit):
+    session, adapter = memory_session
+    adapter.body = body
+    response = session.get(URL, stream=stream, max_response_bytes=limit)
+    assert response.content == body
+    assert response.text == body.decode()
+    for _ in range(2):
+        assert b"".join(response.iter_content(1)) == body
+
+
+def assert_read_apis_stay_failed(response, error):
+    reads = response.raw.reads
+    for read in (
+        lambda: response.content,
+        lambda: response.text,
+        lambda: response.json(),
+        lambda: list(response.iter_content(1)),
+        lambda: list(response.iter_content(1, decode_unicode=True)),
+        lambda: list(response.iter_lines()),
+    ):
+        with pytest.raises(requests.ResponseTooLarge) as exc:
+            read()
+        assert exc.value is error
+        assert response.raw.reads == reads
+
+
+@pytest.mark.parametrize("raw_type", [CountingBody, StreamingBody])
+def test_live_total_persists_across_iterators(memory_session, raw_type):
+    session, adapter = memory_session
+    adapter.raw_type = raw_type
+    response = session.get(URL, stream=True, max_response_bytes=6)
+    first = response.iter_content(4)
+    second = response.iter_content(2)
+    unused = response.iter_content(1)
+    assert next(first) == b"abcd"
+    assert next(second) == b"ef"
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        next(first)
+    assert exc.value.received == 10
+    assert exc.value.response is response
+    assert response.raw.reads == 3
+    assert response.raw.closes == 1
+    for iterator in (second, unused):
+        with pytest.raises(requests.ResponseTooLarge) as later:
+            next(iterator)
+        assert later.value is exc.value
+        assert response.raw.reads == 3
+    assert_read_apis_stay_failed(response, exc.value)
+
+
+@pytest.mark.parametrize("read", ["content", "text"])
+def test_partial_iterator_then_eager_read_uses_live_total(memory_session, read):
+    session, _ = memory_session
+    response = session.get(URL, stream=True, max_response_bytes=8)
+    iterator = response.iter_content(3)
+    assert next(iterator) == b"abc"
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        getattr(response, read)
+    assert exc.value.received == 10
+    assert_read_apis_stay_failed(response, exc.value)
+
+
+def test_partial_iterator_then_cached_reads_do_not_count_twice(memory_session):
+    session, _ = memory_session
+    response = session.get(URL, stream=True, max_response_bytes=10)
+    iterator = response.iter_content(3)
+    assert next(iterator) == b"abc"
+    # Preserve Requests' existing behavior: .content contains the unread suffix.
+    assert response.content == b"defghij"
+    assert response.text == "defghij"
+    assert b"".join(response.iter_content(2)) == b"defghij"
+    assert response.content == b"defghij"
+
+
+def test_unicode_stream_counts_bytes_before_decoding(memory_session):
+    session, adapter = memory_session
+    adapter.body = "ééé".encode()
+    response = session.get(URL, stream=True, max_response_bytes=4)
+    iterator = response.iter_content(2, decode_unicode=True)
+    assert next(iterator) == "é"
+    assert next(iterator) == "é"
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        next(iterator)
+    assert exc.value.received == 6
+
+
+def test_close_failure_keeps_size_error_and_cause(memory_session):
+    session, adapter = memory_session
+    cleanup_error = RuntimeError("close failed")
+    adapter.raw_type = lambda body: CountingBody(body, cleanup_error)
+    response = session.get(URL, stream=True, max_response_bytes=1)
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        response.content
+    assert exc.value.__cause__ is cleanup_error
+    assert exc.value.received == 10
+    assert response.raw.closes == 1
+    assert_read_apis_stay_failed(response, exc.value)
+    response.raw.close_error = None
+    response.close()
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("limit", [None, 0, 3, 4])
+def test_cached_response_returned_by_hook_is_budgeted(memory_session, stream, limit):
+    session, _ = memory_session
+    cached = requests.Response()
+    cached.status_code = 200
+    cached._content = b"data"
+    cached._content_consumed = True
+    cached.encoding = "utf-8"
+    cached.close = Mock()
+
+    def replace(response, **kwargs):
+        response.close()
+        return cached
+
+    kwargs = dict(stream=stream, max_response_bytes=limit, hooks={"response": replace})
+    if limit is not None and limit < 4:
+        with pytest.raises(requests.ResponseTooLarge) as exc:
+            session.get(URL, **kwargs)
+        assert exc.value.response is cached
+        assert exc.value.request is cached.request
+        assert cached.request.url == URL
+        assert exc.value.received == 4
+        cached.close.assert_called_once_with()
+        with pytest.raises(requests.ResponseTooLarge) as later:
+            cached.content
+        assert later.value is exc.value
+    else:
+        response = session.get(URL, **kwargs)
+        assert response is cached
+        assert response.text == "data"
+        assert list(response.iter_content(2)) == [b"da", b"ta"]
+        assert response.content == b"data"
+
+
+def test_hook_body_read_is_budgeted(memory_session):
+    session, adapter = memory_session
+
+    def read_body(response, **kwargs):
+        response.text
+
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        session.get(
+            URL, stream=True, max_response_bytes=2, hooks={"response": read_body}
+        )
+    assert exc.value.response is adapter.responses[0]
+    assert adapter.responses[0].raw.closes == 1
+
+
+@pytest.mark.parametrize("cached", [False, True])
+def test_replacement_budget_applies_before_next_hook(memory_session, cached):
+    session, _ = memory_session
+    replacement = requests.Response()
+    replacement.status_code = 200
+    replacement.raw = CountingBody(b"oversized")
+    if cached:
+        replacement._content = b"oversized"
+        replacement._content_consumed = True
+    later_hook = Mock(side_effect=lambda response, **kwargs: response.content)
+
+    def replace(response, **kwargs):
+        response.close()
+        return replacement
+
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        session.get(
+            URL,
+            stream=True,
+            max_response_bytes=3,
+            hooks={"response": [replace, later_hook]},
+        )
+    assert exc.value.response is replacement
+    assert exc.value.request.url == URL
+    if cached:
+        later_hook.assert_not_called()
+    else:
+        later_hook.assert_called_once()
+    replacement.close()
+
+
+def test_response_context_preserves_size_error_when_close_fails(memory_session):
+    session, adapter = memory_session
+    cleanup_error = RuntimeError("close failed")
+    adapter.raw_type = lambda body: CountingBody(body, cleanup_error)
+    with pytest.raises(requests.ResponseTooLarge) as exc:
+        with session.get(URL, stream=True, max_response_bytes=1) as response:
+            response.content
+    assert exc.value.__cause__ is cleanup_error
+    assert exc.value.response is response
+    response.raw.close_error = None
+    response.close()
+
+
+def test_hook_cached_read_does_not_reset_or_double_count(memory_session):
+    session, _ = memory_session
+
+    def read_body(response, **kwargs):
+        assert response.content == b"abcdefghij"
+        return response
+
+    response = session.get(URL, max_response_bytes=10, hooks={"response": read_body})
+    assert response.text == "abcdefghij"
+    assert list(response.iter_content(5)) == [b"abcde", b"fghij"]
+
+
+def test_unlimited_streaming_response_pickle_remains_readable(memory_session):
+    session, _ = memory_session
+    response = pickle.loads(pickle.dumps(session.get(URL, stream=True)))
+    assert response.content == b"abcdefghij"
+    assert list(response.iter_content(5)) == [b"abcde", b"fghij"]
