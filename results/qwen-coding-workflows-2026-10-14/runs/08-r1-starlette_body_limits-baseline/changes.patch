+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import Response
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+
+def test_request_body_too_large_exception() -> None:
+    exc = RequestBodyTooLarge(limit=3, received=5)
+    assert isinstance(exc, HTTPException)
+    assert exc.status_code == 413
+    assert exc.detail == "Request body too large"
+    assert exc.limit == 3
+    assert exc.received == 5
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "max_bytes, chunks",
+    [
+        (None, [b"ab", b"cd"]),
+        (4, [b"ab", b"", b"cd"]),
+        (5, [b"ab", b"cd"]),
+        (0, [b""]),
+        (0, [b"", b""]),
+        (2, ["é".encode()]),
+    ],
+)
+async def test_body_limit_accepts_chunks(max_bytes: int | None, chunks: list[bytes]) -> None:
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+    request = Request({"type": "http"}, receive)
+    expected = b"".join(chunks)
+
+    body = await request.body(max_bytes=max_bytes)
+    assert body == expected
+    assert await request.body() is body
+    assert await request.body(max_bytes=len(expected)) is body
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+    assert receive.await_count == len(chunks)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("cached", [False, True])
+@pytest.mark.parametrize("max_bytes", [True, False, -1, 1.5, "4", b"4", [], {}, object()])
+async def test_body_limit_validation_before_receive(max_bytes: Any, cached: bool) -> None:
+    receive = AsyncMock(return_value={"type": "http.request", "body": b"abc"})
+    request = Request({"type": "http"}, receive)
+    if cached:
+        assert await request.body() == b"abc"
+
+    with pytest.raises(ValueError):
+        await request.body(max_bytes=max_bytes)
+
+    assert receive.await_count == int(cached)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "max_bytes, chunks, received, calls",
+    [
+        (3, [b"abcdefgh", b"later"], 8, 1),
+        (4, [b"ab", b"cde", b"later"], 5, 2),
+        (3, [b"abc", b"", b"d", b"later"], 4, 3),
+        (0, [b"", b"a", b"later"], 1, 2),
+        (1, ["é".encode(), b"later"], 2, 1),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    max_bytes: int, chunks: list[bytes], received: int, calls: int
+) -> None:
+    receive = AsyncMock(side_effect=[{"type": "http.request", "body": chunk, "more_body": True} for chunk in chunks])
+    request = Request({"type": "http", "headers": [(b"content-length", b"0")]}, receive)
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=max_bytes)
+
+    assert caught.value.limit == max_bytes
+    assert caught.value.received == received
+    assert receive.await_count == calls
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_stricter_limit_on_cached_body_preserves_body_and_json(json_first: bool) -> None:
+    body = b'{"x":1}'
+    receive = AsyncMock(return_value={"type": "http.request", "body": body})
+    request = Request({"type": "http"}, receive)
+    if json_first:
+        data = await request.json()
+    else:
+        assert await request.body(max_bytes=len(body)) == body
+        data = await request.json()
+
+    for limit in (0, len(body) - 1):
+        with pytest.raises(RequestBodyTooLarge) as caught:
+            await request.body(max_bytes=limit)
+        assert caught.value.limit == limit
+        assert caught.value.received == len(body)
+
+    assert await request.body() == body
+    assert await request.body(max_bytes=len(body)) == body
+    assert await request.json() is data
+    assert data == {"x": 1}
+    assert receive.await_count == 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [None, 3])
+@pytest.mark.parametrize("partial", [False, True])
+async def test_body_limit_preserves_disconnect(max_bytes: int | None, partial: bool) -> None:
+    messages: list[Message] = [{"type": "http.disconnect"}]
+    if partial:
+        messages.insert(0, {"type": "http.request", "body": b"ab", "more_body": True})
+    receive = AsyncMock(side_effect=messages)
+    request = Request({"type": "http"}, receive)
+
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+
+    assert request._is_disconnected
+    assert not hasattr(request, "_body")
+    assert receive.await_count == len(messages)
+
+
+def test_body_limit_http_exception_handling(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        return Response(await request.body(max_bytes=3))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"abc")
+        assert response.status_code == 200
+        assert response.content == b"abc"
+
+        response = client.post("/", content=b"abcd")
+        assert response.status_code == 413
+        assert response.content == b"Request body too large"
+        assert response.headers["content-type"] == "text/plain; charset=utf-8"
