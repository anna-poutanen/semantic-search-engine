+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import RequestBodyTooLarge
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+@pytest.mark.parametrize("max_bytes", [True, False, -1, 1.5, "4", b"4", [], {}, object()])
+def test_body_limit_middleware_validation(max_bytes: Any) -> None:
+    with pytest.raises(ValueError):
+        RequestBodyLimitMiddleware(AsyncMock(), max_bytes=max_bytes)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("content_length", [None, b"0", b"9999", b"invalid"])
+@pytest.mark.parametrize(
+    "max_bytes, chunks, calls",
+    [
+        (0, [b"", b"a", b"later"], 2),
+        (3, [b"abcdef", b"later"], 1),
+        (3, [b"ab", b"", b"cd", b"later"], 3),
+        (1, ["é".encode(), b"later"], 1),
+    ],
+)
+async def test_middleware_rejects_at_first_crossing(
+    content_length: bytes | None, max_bytes: int, chunks: list[bytes], calls: int
+) -> None:
+    receive = AsyncMock(side_effect=[{"type": "http.request", "body": chunk, "more_body": True} for chunk in chunks])
+    messages: list[Message] = []
+
+    async def send(message: Message) -> None:
+        messages.append(message)
+
+    app = AsyncMock()
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=max_bytes)
+    headers = [] if content_length is None else [(b"content-length", content_length)]
+    await middleware({"type": "http", "headers": headers}, receive, send)
+
+    app.assert_not_awaited()
+    assert receive.await_count == calls
+    assert len(messages) == 2
+    assert messages[0]["type"] == "http.response.start"
+    assert messages[0]["status"] == 413
+    assert (b"content-type", b"text/plain; charset=utf-8") in messages[0]["headers"]
+    assert messages[1] == {"type": "http.response.body", "body": b"Request body too large"}
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "max_bytes, chunks",
+    [(0, [b"", b""]), (4, [b"ab", b"", b"cd"]), (5, [b"ab", b"cd"]), (2, ["é".encode()])],
+)
+async def test_middleware_buffers_then_replays_bytes_and_delegates_disconnect(
+    max_bytes: int, chunks: list[bytes]
+) -> None:
+    disconnect = {"type": "http.disconnect"}
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+        + [disconnect]
+    )
+    scope: Scope = {"type": "http", "headers": [(b"content-length", b"9999")]}
+    send = AsyncMock()
+    called = False
+
+    async def app(app_scope: Scope, app_receive: Receive, app_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert app_scope is scope
+        assert app_send is send
+        assert receive.await_count == len(chunks)
+        message = await app_receive()
+        assert message["type"] == "http.request"
+        assert message["body"] == b"".join(chunks)
+        assert not message.get("more_body", False)
+        assert receive.await_count == len(chunks)
+        assert await app_receive() is disconnect
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+    assert called
+    assert receive.await_count == len(chunks) + 1
+
+
+@pytest.mark.anyio
+async def test_middleware_accepts_request_without_body_key() -> None:
+    receive = AsyncMock(return_value={"type": "http.request"})
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        assert await Request(scope, receive).body(max_bytes=0) == b""
+
+    await RequestBodyLimitMiddleware(app, max_bytes=0)({"type": "http"}, receive, AsyncMock())
+    receive.assert_awaited_once()
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "scope_type, max_bytes",
+    [("http", None), ("websocket", None), ("websocket", 0), ("lifespan", None), ("lifespan", 0)],
+)
+async def test_middleware_passes_through_without_receiving(scope_type: str, max_bytes: int | None) -> None:
+    app, receive, send = AsyncMock(), AsyncMock(), AsyncMock()
+    scope = {"type": scope_type}
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+    app.assert_awaited_once_with(scope, receive, send)
+    receive.assert_not_awaited()
+    send.assert_not_awaited()
+
+
+@pytest.mark.anyio
+async def test_middleware_preserves_disconnect_during_buffering() -> None:
+    receive = AsyncMock(
+        side_effect=[{"type": "http.request", "body": b"ab", "more_body": True}, {"type": "http.disconnect"}]
+    )
+    app, send = AsyncMock(), AsyncMock()
+    with pytest.raises(ClientDisconnect):
+        await RequestBodyLimitMiddleware(app, max_bytes=3)({"type": "http"}, receive, send)
+    app.assert_not_awaited()
+    send.assert_not_awaited()
+    assert receive.await_count == 2
+
+
+@pytest.mark.parametrize("json_first", [False, True])
+def test_middleware_http_body_and_json_caching(test_client_factory: TestClientFactory, json_first: bool) -> None:
+    body = b'{"x":1}'
+
+    async def endpoint(request: Request) -> JSONResponse:
+        if json_first:
+            data = await request.json()
+            buffered = await request.body()
+        else:
+            buffered = await request.body(max_bytes=len(body))
+            data = await request.json()
+        assert await request.body() is buffered
+        assert await request.body(max_bytes=len(body)) is buffered
+        assert await request.json() is data
+        return JSONResponse({"body": buffered.decode(), "json": data})
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=len(body))],
+    )
+    with test_client_factory(app) as client:
+        for _ in range(2):
+            response = client.post("/", content=body)
+            assert response.status_code == 200
+            assert response.json() == {"body": body.decode(), "json": {"x": 1}}
+
+
+def test_middleware_http_rejection_skips_endpoint(test_client_factory: TestClientFactory) -> None:
+    called = False
+
+    async def endpoint(request: Request) -> JSONResponse:
+        nonlocal called
+        called = True
+        raise AssertionError("Oversize request reached the endpoint")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=3)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"abcd", headers={"content-length": "1"})
+    assert response.status_code == 413
+    assert response.content == b"Request body too large"
+    assert response.headers["content-type"] == "text/plain; charset=utf-8"
+    assert not called
+
+
+@pytest.mark.parametrize("max_bytes", [None, 3])
+@pytest.mark.parametrize("error", [RuntimeError("endpoint failed"), RequestBodyTooLarge(limit=1, received=3)])
+def test_middleware_preserves_endpoint_failures(
+    test_client_factory: TestClientFactory, max_bytes: int | None, error: Exception
+) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        assert await Request(scope, receive).body() == b"abc"
+        raise error
+
+    client = test_client_factory(RequestBodyLimitMiddleware(app, max_bytes=max_bytes))
+    with pytest.raises(type(error)) as caught:
+        client.post("/", content=b"abc")
+    assert caught.value is error
