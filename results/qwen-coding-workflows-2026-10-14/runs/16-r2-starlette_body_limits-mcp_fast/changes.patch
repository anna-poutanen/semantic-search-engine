@@ -0,0 +1,168 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import Response
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+
+def make_request(messages: list[Message]) -> tuple[Request, list[Message]]:
+    received: list[Message] = []
+
+    async def receive() -> Message:
+        assert len(received) < len(messages), "Unexpected receive after the body"
+        message = messages[len(received)]
+        received.append(message)
+        return message
+
+    return Request({"type": "http", "headers": [(b"content-length", b"0")]}, receive), received
+
+
+def body_messages(chunks: list[bytes]) -> list[Message]:
+    return [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,limit",
+    [
+        ([b""], 0),
+        ([b"", b""], 0),
+        ([b"ab", b"", b"cd"], 4),
+        ([b"ab", b"cd"], 5),
+        (["é".encode()], 2),
+        ([b"ab", b"cd"], None),
+        ([b"ab", b"cd"], 10**100),
+    ],
+)
+async def test_body_limit_accepts_and_caches(chunks: list[bytes], limit: int | None) -> None:
+    messages = body_messages(chunks)
+    request, received = make_request(messages)
+
+    body = await request.body(max_bytes=limit)
+    assert body == b"".join(chunks)
+    assert await request.body() is body
+    assert await request.body(limit) is body
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+    assert received == messages
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,limit,calls,total",
+    [
+        ([b"abc", b"unread"], 2, 1, 3),
+        ([b"ab", b"cd", b"unread"], 3, 2, 4),
+        ([b"ab", b"c"], 2, 2, 3),
+        ([b"", b"a", b"unread"], 0, 2, 1),
+        (["é".encode(), b"unread"], 1, 1, 2),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(chunks: list[bytes], limit: int, calls: int, total: int) -> None:
+    messages = body_messages(chunks)
+    request, received = make_request(messages)
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=limit)
+
+    assert isinstance(caught.value, HTTPException)
+    assert caught.value.status_code == 413
+    assert caught.value.limit == limit
+    assert caught.value.received == total
+    assert caught.value.detail == "Request body too large"
+    assert received == messages[:calls]
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("limit", [-1, True, False, 1.5, 0.0, "4", b"4", [], object()])
+@pytest.mark.parametrize("cached", [False, True])
+async def test_body_limit_validates_before_receiving(limit: Any, cached: bool) -> None:
+    request, received = make_request(body_messages([b"data"]))
+    if cached:
+        assert await request.body() == b"data"
+    calls = len(received)
+
+    with pytest.raises(ValueError):
+        await request.body(max_bytes=limit)
+
+    assert len(received) == calls
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("initial_limit", [None, 4])
+async def test_body_limit_rechecks_cached_body(initial_limit: int | None) -> None:
+    request, received = make_request(body_messages([b"ab", b"cd"]))
+    body = await request.body(max_bytes=initial_limit)
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=3)
+
+    assert caught.value.limit == 3
+    assert caught.value.received == 4
+    assert await request.body() is body
+    assert await request.body(max_bytes=4) is body
+    assert len(received) == 2
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_body_limit_preserves_json_cache(json_first: bool) -> None:
+    payload = b'{"a":1}'
+    request, received = make_request(body_messages([payload[:3], payload[3:]]))
+    if json_first:
+        parsed = await request.json()
+        body = await request.body(max_bytes=len(payload))
+    else:
+        body = await request.body(max_bytes=len(payload))
+        parsed = await request.json()
+
+    assert parsed == {"a": 1}
+    assert body == payload
+    assert await request.json() is parsed
+    with pytest.raises(RequestBodyTooLarge):
+        await request.body(max_bytes=len(payload) - 1)
+    assert await request.body() is body
+    assert await request.json() is parsed
+    assert len(received) == 2
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("prefix", [b"", b"ab"])
+async def test_body_limit_preserves_client_disconnect(prefix: bytes) -> None:
+    messages = [
+        {"type": "http.request", "body": prefix, "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+    request, received = make_request(messages)
+
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=2)
+
+    assert await request.is_disconnected()
+    assert received == messages
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.parametrize("payload,status", [(b"ab", 200), (b"abc", 413)])
+def test_body_limit_uses_http_exception_handling(
+    test_client_factory: TestClientFactory, payload: bytes, status: int
+) -> None:
+    async def endpoint(request: Request) -> Response:
+        return Response(await request.body(max_bytes=2))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    with test_client_factory(app) as client:
+        response = client.post("/", content=payload)
+    assert response.status_code == status
+    assert response.content == (payload if status == 200 else b"Request body too large")
