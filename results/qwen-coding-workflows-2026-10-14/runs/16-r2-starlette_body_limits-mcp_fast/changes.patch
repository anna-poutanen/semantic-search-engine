+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, Response
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+def make_receive(messages: list[Message]) -> tuple[Receive, list[Message]]:
+    received: list[Message] = []
+
+    async def receive() -> Message:
+        assert len(received) < len(messages), "Unexpected receive after the supplied messages"
+        message = messages[len(received)]
+        received.append(message)
+        return message
+
+    return receive, received
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("chunks,limit", [([b""], 0), ([b"", b""], 0), ([b"ab", b"", b"cd"], 4)])
+@pytest.mark.parametrize("content_length", [b"0", b"999", b"invalid"])
+async def test_body_limit_replays_bytes_then_delegates(chunks: list[bytes], limit: int, content_length: bytes) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    body_message_count = len(messages)
+    disconnect: Message = {"type": "http.disconnect"}
+    messages.extend([disconnect, disconnect])
+    receive, received = make_receive(messages)
+    sent: list[Message] = []
+    called = False
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        nonlocal called
+        called = True
+        assert len(received) == body_message_count
+        assert await receive() == {"type": "http.request", "body": b"".join(chunks), "more_body": False}
+        assert len(received) == body_message_count
+        assert await receive() is disconnect
+        assert await receive() is disconnect
+        await Response()(scope, receive, send)
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=limit)
+    await middleware({"type": "http", "headers": [(b"content-length", content_length)]}, receive, send)
+    assert called
+    assert received == messages
+    assert sent[0]["status"] == 200
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,limit,calls",
+    [
+        ([b"abc", b"unread"], 2, 1),
+        ([b"ab", b"cd", b"unread"], 3, 2),
+        ([b"ab", b"c"], 2, 2),
+        ([b"", b"a", b"unread"], 0, 2),
+        (["é".encode(), b"unread"], 1, 1),
+    ],
+)
+async def test_body_limit_rejects_before_calling_app(chunks: list[bytes], limit: int, calls: int) -> None:
+    messages = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    receive, received = make_receive(messages)
+    sent: list[Message] = []
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Oversized requests must not reach the app")
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=limit)
+    await middleware({"type": "http", "headers": [(b"content-length", b"0")]}, receive, send)
+
+    assert received == messages[:calls]
+    assert sent[0]["status"] == 413
+    assert dict(sent[0]["headers"])[b"content-type"] == b"text/plain; charset=utf-8"
+    assert sent[1] == {"type": "http.response.body", "body": b"Request body too large"}
+    assert len(sent) == 2
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "scope_type,limit", [("http", None), ("websocket", 0), ("lifespan", 0), ("websocket", None), ("lifespan", None)]
+)
+async def test_body_limit_passes_through_without_reads(scope_type: str, limit: int | None) -> None:
+    scope = {"type": scope_type}
+    called = False
+
+    async def original_receive() -> Message:
+        pytest.fail("The middleware must not read a passthrough stream")
+
+    async def original_send(message: Message) -> None:
+        pytest.fail("The middleware must not send a passthrough response")
+
+    async def app(app_scope: Scope, receive: Receive, send: Send) -> None:
+        nonlocal called
+        called = True
+        assert app_scope is scope
+        assert receive is original_receive
+        assert send is original_send
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=limit)
+    await middleware(scope, original_receive, original_send)
+    assert called
+
+
+@pytest.mark.parametrize("limit", [-1, True, False, 1.5, 0.0, "4", b"4", [], object()])
+def test_body_limit_validates_at_construction(limit: Any) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Construction must not invoke the app")
+
+    with pytest.raises(ValueError):
+        RequestBodyLimitMiddleware(app, max_bytes=limit)
+
+
+@pytest.mark.anyio
+async def test_body_limit_preserves_client_disconnect() -> None:
+    messages = [{"type": "http.request", "body": b"ab", "more_body": True}, {"type": "http.disconnect"}]
+    receive, received = make_receive(messages)
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("An incomplete request must not reach the app")
+
+    async def send(message: Message) -> None:
+        pytest.fail("A disconnect must not become a 413 response")
+
+    with pytest.raises(ClientDisconnect):
+        await RequestBodyLimitMiddleware(app, max_bytes=2)({"type": "http"}, receive, send)
+    assert received == messages
+
+
+@pytest.mark.anyio
+async def test_body_limit_does_not_catch_downstream_body_exception() -> None:
+    error = RequestBodyTooLarge(limit=0, received=1)
+    receive, received = make_receive([{"type": "http.request", "body": b""}])
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        raise error
+
+    async def send(message: Message) -> None:
+        pytest.fail("The downstream exception must propagate")
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await RequestBodyLimitMiddleware(app, max_bytes=0)({"type": "http"}, receive, send)
+    assert caught.value is error
+    assert len(received) == 1
+
+
+@pytest.mark.parametrize("limit", [None, 7, 8])
+def test_body_limit_http_body_and_json_caches(test_client_factory: TestClientFactory, limit: int | None) -> None:
+    async def endpoint(request: Request) -> Response:
+        body = await request.body(max_bytes=7)
+        assert body == b'{"a":1}'
+        assert await request.body() is body
+        data = await request.json()
+        assert await request.json() is data
+        assert await request.body(max_bytes=7) is body
+        return JSONResponse(data)
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=limit)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b'{"a":1}')
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+
+def test_body_limit_http_rejection(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        pytest.fail("Oversized requests must not reach the endpoint")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=0)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"a", headers={"content-length": "0"})
+    assert response.status_code == 413
+    assert response.content == b"Request body too large"
+    assert response.headers["content-type"] == "text/plain; charset=utf-8"
+
+
+@pytest.mark.parametrize("limit", [None, 0, 4])
+def test_body_limit_http_preserves_endpoint_failures(test_client_factory: TestClientFactory, limit: int | None) -> None:
+    error = RuntimeError("endpoint failed")
+
+    async def endpoint(request: Request) -> Response:
+        assert await request.body() == b""
+        raise error
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=limit)],
+    )
+    with test_client_factory(app) as client:
+        with pytest.raises(RuntimeError, match="endpoint failed") as caught:
+            client.post("/")
+    assert caught.value is error
+
+    with test_client_factory(app, raise_server_exceptions=False) as client:
+        response = client.post("/")
+    assert response.status_code == 500
+    assert response.text == "Internal Server Error"
+
+
+def test_body_limit_http_preserves_handled_endpoint_failures(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        assert await request.body() == b"ab"
+        raise HTTPException(status_code=409, detail="endpoint conflict")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=2)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"ab")
+    assert response.status_code == 409
+    assert response.text == "endpoint conflict"
