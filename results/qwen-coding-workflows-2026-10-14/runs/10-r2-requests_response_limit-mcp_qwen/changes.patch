+@pytest.mark.parametrize("direct", [False, True])
+@pytest.mark.parametrize("override", ["omitted", None, 8])
+def test_redirect_chain_inherits_override_and_has_independent_budgets(
+    body_server, direct, override
+):
+    with requests.Session(max_response_bytes=0) as session:
+        kwargs = {} if override == "omitted" else {"max_response_bytes": override}
+        url = body_server + "/chain"
+        if direct:
+            prepared = requests.Request("GET", url).prepare()
+
+            def call():
+                return session.send(prepared, **kwargs)
+        else:
+
+            def call():
+                return session.get(url, **kwargs)
+
+        if override == "omitted":
+            with pytest.raises(ResponseTooLarge):
+                call()
+        else:
+            response = call()
+            assert response.content == BODY
+            assert [r.content for r in response.history] == [BODY, b"hop!"]
+        assert session.max_response_bytes == 0
+
