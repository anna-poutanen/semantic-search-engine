diff --git a/tests/test_response_limit.py b/tests/test_response_limit.py
new file mode 100644
index 0000000..ffcb3e4
--- /dev/null
+++ b/tests/test_response_limit.py
@@ -0,0 +1,547 @@
+"""Regression coverage for decoded response byte budgets."""
+
+import gzip
+import io
+import pickle
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+BODY = b"abcdefgh"
+UNICODE_BODY = "é😀".encode()
+GZIP_BODY = b"a" * 1024
+URL = "http://example.invalid/body"
+
+
+@pytest.fixture(scope="module")
+def body_server():
+    routes = {
+        "/body": (200, BODY, {}),
+        "/empty": (200, b"", {}),
+        "/unicode": (200, UNICODE_BODY, {"Content-Type": "text/plain; charset=utf-8"}),
+        "/gzip": (200, gzip.compress(GZIP_BODY), {"Content-Encoding": "gzip"}),
+        "/gzip-empty": (200, gzip.compress(b""), {"Content-Encoding": "gzip"}),
+        "/redirect": (302, b"hop!", {"Location": "/body"}),
+        "/redirect-large": (302, b"redirect too large", {"Location": "/body"}),
+        "/chain": (302, BODY, {"Location": "/redirect"}),
+    }
+
+    class Handler(BaseHTTPRequestHandler):
+        def respond(self):
+            if self.path == "/chunked":
+                self.send_response(200)
+                self.send_header("Transfer-Encoding", "chunked")
+                self.end_headers()
+                if self.command != "HEAD":
+                    self.wfile.write(b"4\r\nabcd\r\n4\r\nefgh\r\n0\r\n\r\n")
+                return
+            status, body, headers = routes[self.path]
+            self.send_response(status)
+            self.send_header("Content-Length", str(len(body)))
+            for name, value in headers.items():
+                self.send_header(name, value)
+            self.end_headers()
+            if self.command != "HEAD":
+                self.wfile.write(body)
+
+        do_GET = do_HEAD = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = (
+            respond
+        )
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}"
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+class TrackedBody(io.BytesIO):
+    def __init__(self, body=BODY, close_error=None):
+        super().__init__(body)
+        self.read_calls = 0
+        self.close_calls = 0
+        self.close_error = close_error
+
+    def read(self, size=-1):
+        self.read_calls += 1
+        return super().read(size)
+
+    def close(self):
+        self.close_calls += 1
+        super().close()
+        if self.close_error is not None:
+            raise self.close_error
+
+
+class DecodedChunks(TrackedBody):
+    """A shared decoded stream, like urllib3, with observable reads."""
+
+    def __init__(self, chunks, **kwargs):
+        super().__init__(**kwargs)
+        self.chunks = iter(chunks)
+
+    def stream(self, chunk_size, decode_content):
+        assert decode_content is True
+        while True:
+            self.read_calls += 1
+            try:
+                chunk = next(self.chunks)
+            except StopIteration:
+                return
+            yield chunk
+
+
+class StrictAdapter(BaseAdapter):
+    """Rejects unknown transport kwargs and never uses the network."""
+
+    def __init__(self, *responses):
+        self.responses = iter(responses)
+        self.calls = []
+
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        self.calls.append(request)
+        response = next(self.responses)
+        response.request = request
+        response.url = request.url
+        response.connection = self
+        return response
+
+    def close(self):
+        pass
+
+
+def response_with(body=BODY, raw=None, cached=False, status=200, headers=None):
+    response = requests.Response()
+    response.status_code = status
+    response.raw = raw if raw is not None else TrackedBody(body)
+    response.headers.update(headers or {})
+    response.encoding = "utf-8"
+    if cached:
+        response._content = body
+        response._content_consumed = True
+    return response
+
+
+def session_with(*responses, limit=None):
+    session = requests.Session(max_response_bytes=limit)
+    session.trust_env = False
+    adapter = StrictAdapter(*responses)
+    session.mount("http://", adapter)
+    return session, adapter
+
+
+def assert_error(error, response, limit, received):
+    assert isinstance(error, RequestException)
+    assert error.limit == limit
+    assert error.received == received
+    assert error.response is response
+    assert error.request is response.request
+
+
+def test_public_exception_and_session_default():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    with requests.Session() as session:
+        assert session.max_response_bytes is None
+
+
+@pytest.mark.parametrize("limit", [None, 0, 8])
+def test_session_setting_survives_pickling(limit, body_server):
+    with requests.Session(max_response_bytes=limit) as session:
+        restored = pickle.loads(pickle.dumps(session))
+    with restored:
+        assert restored.max_response_bytes == limit
+        assert restored.get(body_server + "/empty").content == b""
+        if limit == 0:
+            with pytest.raises(ResponseTooLarge):
+                restored.get(body_server + "/body")
+
+
+@pytest.mark.parametrize("value", [-1, True, False, 1.0, "8", b"8", [], {}, object()])
+def test_invalid_limit_is_rejected_before_transport(value):
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        requests.Session(max_response_bytes=value)
+
+    session, adapter = session_with(response_with())
+    with session:
+        with pytest.raises(ValueError, match="max_response_bytes"):
+            session.get(URL, max_response_bytes=value)
+        prepared = requests.Request("GET", URL).prepare()
+        with pytest.raises(ValueError, match="max_response_bytes"):
+            session.send(prepared, max_response_bytes=value)
+        session.max_response_bytes = value
+        with pytest.raises(ValueError, match="max_response_bytes"):
+            session.get(URL)
+        with pytest.raises(ValueError, match="max_response_bytes"):
+            session.send(prepared)
+    assert adapter.calls == []
+
+
+@pytest.mark.parametrize("direct", [False, True])
+@pytest.mark.parametrize("override", ["omitted", None, 8, 2])
+def test_request_and_send_inherit_or_override(direct, override):
+    response = response_with()
+    session, adapter = session_with(response, limit=4)
+    kwargs = {} if override == "omitted" else {"max_response_bytes": override}
+    with session:
+        if direct:
+            prepared = requests.Request("GET", URL).prepare()
+
+            def call():
+                return session.send(prepared, **kwargs)
+        else:
+
+            def call():
+                return session.request("GET", URL, **kwargs)
+
+        if override in ("omitted", 2):
+            with pytest.raises(ResponseTooLarge) as caught:
+                call()
+            assert_error(caught.value, response, 4 if override == "omitted" else 2, 8)
+            assert response.raw.closed
+        else:
+            assert call().content == BODY
+        assert session.max_response_bytes == 4
+    assert len(adapter.calls) == 1
+
+
+@pytest.mark.parametrize("scope", ["module", "session"])
+@pytest.mark.parametrize(
+    "method", ["get", "post", "put", "patch", "delete", "options", "head", "request"]
+)
+def test_method_helpers_accept_and_enforce_limit(body_server, scope, method):
+    with requests.Session() as session:
+        owner = requests if scope == "module" else session
+        call = getattr(owner, method)
+        args = (
+            ("GET", body_server + "/body")
+            if method == "request"
+            else (body_server + "/body",)
+        )
+        if method == "head":
+            assert call(*args, max_response_bytes=0).content == b""
+        else:
+            with pytest.raises(ResponseTooLarge) as caught:
+                call(*args, max_response_bytes=0)
+            assert_error(caught.value, caught.value.response, 0, len(BODY))
+            assert call(*args, max_response_bytes=None).content == BODY
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize(
+    "path,body",
+    [
+        ("/body", BODY),
+        ("/empty", b""),
+        ("/gzip-empty", b""),
+        ("/unicode", UNICODE_BODY),
+        ("/gzip", GZIP_BODY),
+        ("/chunked", BODY),
+    ],
+)
+def test_exact_decoded_boundary_and_cached_rereads(body_server, stream, path, body):
+    with requests.get(
+        body_server + path, stream=stream, max_response_bytes=len(body)
+    ) as response:
+        assert response.content == body
+        assert response.content == body
+        assert b"".join(response.iter_content(2)) == body
+        assert b"".join(response.iter_content(None)) == body
+        assert response.text == body.decode("utf-8")
+        restored = pickle.loads(pickle.dumps(response))
+        assert restored.content == body
+        assert b"".join(restored.iter_content(1)) == body
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_gzip_budget_counts_decoded_bytes(body_server, stream):
+    limit = 100
+    if not stream:
+        with pytest.raises(ResponseTooLarge) as caught:
+            requests.get(body_server + "/gzip", max_response_bytes=limit)
+        response = caught.value.response
+    else:
+        response = requests.get(
+            body_server + "/gzip", stream=True, max_response_bytes=limit
+        )
+        with pytest.raises(ResponseTooLarge) as caught:
+            list(response.iter_content(64))
+        assert caught.value.received == 128
+    assert int(response.headers["Content-Length"]) < limit
+    assert caught.value.received > limit
+    assert response.raw.closed
+
+
+def test_unicode_decoding_does_not_change_byte_budget(body_server):
+    with requests.get(
+        body_server + "/unicode", stream=True, max_response_bytes=2
+    ) as response:
+        chunks = response.iter_content(2, decode_unicode=True)
+        assert next(chunks) == "é"
+        with pytest.raises(ResponseTooLarge) as caught:
+            next(chunks)
+        assert_error(caught.value, response, 2, 4)
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize(
+    "path,limit,failed_path",
+    [("/redirect-large", 8, "/redirect-large"), ("/redirect", 4, "/body")],
+)
+def test_redirect_budget_checks_each_response(
+    body_server, stream, path, limit, failed_path
+):
+    if not stream or failed_path == path:
+        with pytest.raises(ResponseTooLarge) as caught:
+            requests.get(body_server + path, stream=stream, max_response_bytes=limit)
+    else:
+        response = requests.get(
+            body_server + path, stream=True, max_response_bytes=limit
+        )
+        with pytest.raises(ResponseTooLarge) as caught:
+            response.text
+    assert caught.value.response.url == body_server + failed_path
+    assert caught.value.response.raw.closed
+    assert caught.value.limit == limit
+
