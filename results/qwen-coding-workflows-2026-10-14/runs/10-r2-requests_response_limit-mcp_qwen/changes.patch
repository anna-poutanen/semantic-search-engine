+@pytest.mark.parametrize("cached", [False, True])
+def test_cleanup_failure_preserves_size_error(cached):
+    cleanup_error = OSError("close failed")
+    response = response_with(raw=TrackedBody(close_error=cleanup_error), cached=cached)
+    if cached:
+
+        def fail_close():
+            raise cleanup_error
+
+        response.close = fail_close
+    session, _ = session_with(response, limit=1)
+    with session:
+        with pytest.raises(ResponseTooLarge) as caught:
+            session.get(URL)
+        assert_error(caught.value, response, 1, len(BODY))
+        assert caught.value.__cause__ is cleanup_error
+        with pytest.raises(ResponseTooLarge) as later:
+            response.content
+        assert later.value is caught.value
+        assert later.value.__cause__ is cleanup_error
