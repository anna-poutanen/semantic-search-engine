+@pytest.mark.parametrize("raw_type", [TrackedBody, DecodedChunks])
+@pytest.mark.parametrize("continuation", ["new_iterator", "content", "text"])
+def test_live_count_persists_across_read_apis(raw_type, continuation):
+    raw = raw_type() if raw_type is TrackedBody else raw_type([b"abcd", b"efgh"])
+    response = response_with(raw=raw)
+    session, _ = session_with(response, limit=6)
+    with session:
+        session.get(URL, stream=True)
+        original = response.iter_content(4)
+        assert next(original) == b"abcd"
+        with pytest.raises(ResponseTooLarge) as caught:
+            if continuation == "new_iterator":
+                next(response.iter_content(4))
+            else:
+                getattr(response, continuation)
+        assert_error(caught.value, response, 6, 8)
+        assert raw.closed
+        assert raw.close_calls == 1
+        reads_at_failure = raw.read_calls
+        later_reads = [
+            lambda: response.content,
+            lambda: response.text,
+            lambda: next(response.iter_content()),
+            lambda: next(response.iter_lines()),
+            lambda: response.json(),
+            lambda: next(original),
+        ]
+        for read in later_reads:
+            with pytest.raises(ResponseTooLarge) as later:
+                read()
+            assert later.value is caught.value
+            assert raw.read_calls == reads_at_failure
+            assert raw.close_calls == 1
+
