+@pytest.mark.parametrize("limit", [4, 8, None])
+def test_cached_hook_history_has_independent_budgets(limit):
+    response = response_with(body=b"", cached=True)
+    intermediate = response_with(cached=True, status=302)
+
+    def hook(response, **kwargs):
+        intermediate.request = response.request
+        response.history = [intermediate]
+
+    session, _ = session_with(response, limit=limit)
+    with session:
+        if limit == 4:
+            with pytest.raises(ResponseTooLarge) as caught:
+                session.get(URL, hooks={"response": hook})
+            assert_error(caught.value, intermediate, limit, len(BODY))
+        else:
+            returned = session.get(URL, hooks={"response": hook})
+            assert returned.content == b""
+            assert returned.history[0].content == BODY
