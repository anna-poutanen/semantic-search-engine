+@pytest.mark.parametrize("replacement", [False, True])
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("limit", [0, 4, 8, None])
+def test_cached_hook_responses_are_checked(replacement, stream, limit):
+    original = response_with(body=b"")
+    cached = response_with(cached=True) if replacement else original
+
+    def hook(response, **kwargs):
+        if replacement:
+            cached.request = response.request
+        else:
+            response._content = BODY
+            response._content_consumed = True
+        return cached
+
+    session, _ = session_with(original, limit=limit)
+    with session:
+        if limit in (0, 4):
+            with pytest.raises(ResponseTooLarge) as caught:
+                session.get(URL, stream=stream, hooks={"response": hook})
+            assert_error(caught.value, cached, limit, len(BODY))
+        else:
+            response = session.get(URL, stream=stream, hooks={"response": hook})
+            assert response is cached
+            assert response.content == BODY
+            assert list(response.iter_content(4)) == [b"abcd", b"efgh"]
+            assert response.text == BODY.decode()
+
