+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+pytestmark = pytest.mark.anyio
+
+
+def recording_receive(messages: list[Message]) -> tuple[Receive, list[Message]]:
+    pending = iter(messages)
+    observed: list[Message] = []
+
+    async def receive() -> Message:
+        message = next(pending)
+        observed.append(message)
+        return message
+
+    return receive, observed
+
+
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, "1", b"1", [], {}, object()])
+def test_invalid_middleware_limit(max_bytes: Any) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Invalid configuration must not call the app")
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        RequestBodyLimitMiddleware(app, max_bytes=max_bytes)
+
+
+async def test_middleware_replays_messages_then_delegates() -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"ab", "more_body": True},
+        {"type": "http.request", "more_body": True},
+        {"type": "http.request", "body": b"", "more_body": True},
+        {"type": "http.request", "body": b"cd"},
+        {"type": "http.disconnect"},
+        {"type": "http.disconnect"},
+    ]
+    receive, observed = recording_receive(messages)
+    sent: list[Message] = []
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    async def app(scope: Scope, replay_receive: Receive, app_send: Send) -> None:
+        assert observed == messages[:4]
+        assert app_send is send
+        for message in messages[:4]:
+            assert await replay_receive() == message
+            assert observed == messages[:4]
+        assert await replay_receive() == messages[4]
+        assert observed == messages[:5]
+        assert await replay_receive() == messages[5]
+        assert observed == messages
+        await PlainTextResponse("OK")(scope, replay_receive, app_send)
+
+    await RequestBodyLimitMiddleware(app, max_bytes=4)({"type": "http"}, receive, send)
+    assert sent[0]["status"] == 200
+    assert sent[1]["body"] == b"OK"
+
+
+@pytest.mark.parametrize("content_length", [None, b"0", b"1000", b"invalid"])
+async def test_middleware_replays_body_and_json_caches(content_length: bytes | None) -> None:
+    payload = b'{"ok":true}'
+    messages: list[Message] = [
+        {"type": "http.request", "body": payload[:4], "more_body": True},
+        {"type": "http.request", "body": payload[4:], "more_body": False},
+        {"type": "http.disconnect"},
+    ]
+    receive, observed = recording_receive(messages)
+    scope: Scope = {"type": "http", "headers": []}
+    if content_length is not None:
+        scope["headers"] = [(b"content-length", content_length)]
+
+    async def send(message: Message) -> None:
+        pytest.fail("The downstream test app sends no response")
+
+    async def app(scope: Scope, replay_receive: Receive, send: Send) -> None:
+        assert observed == messages[:2]
+        request = Request(scope, replay_receive)
+        data = await request.json()
+        assert data == {"ok": True}
+        body = await request.body(max_bytes=len(payload))
+        assert body == payload
+        assert await request.body() is body
+        assert await request.json() is data
+        assert b"".join([chunk async for chunk in request.stream()]) == payload
+        assert observed == messages[:2]
+        assert await request.receive() == {"type": "http.disconnect"}
+
+    await RequestBodyLimitMiddleware(app, max_bytes=len(payload))(scope, receive, send)
+    assert observed == messages
+
+
+@pytest.mark.parametrize("content_length", [None, b"0", b"1000", b"invalid"])
+@pytest.mark.parametrize(
+    "max_bytes,chunks,crossing",
+    [
+        (2, [b"abcdef", b"later"], 1),
+        (3, [b"ab", b"", b"cd", b"later"], 3),
+        (3, [b"ab", b"cd"], 2),
+        (0, [b"", b"a", b"later"], 2),
+        (3, ["é".encode(), "é".encode(), b"later"], 2),
