+)
+async def test_middleware_rejects_at_first_crossing(
+    max_bytes: int, chunks: list[bytes], crossing: int, content_length: bytes | None
+) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    receive, observed = recording_receive(messages)
+    sent: list[Message] = []
+    scope: Scope = {"type": "http", "headers": []}
+    if content_length is not None:
+        scope["headers"] = [(b"content-length", content_length)]
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("An oversized request must not call the downstream app")
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+
+    assert observed == messages[:crossing]
+    assert len(sent) == 2
+    assert sent[0]["status"] == 413
+    assert dict(sent[0]["headers"])[b"content-type"] == b"text/plain; charset=utf-8"
+    assert sent[1]["body"] == b"Request body too large"
+    assert sent[1].get("more_body", False) is False
+
+
+@pytest.mark.parametrize(
+    "messages",
+    [
+        [{"type": "http.request"}],
+        [
+            {"type": "http.request", "body": b"", "more_body": True},
+            {"type": "http.request", "body": b"", "more_body": False},
+        ],
+    ],
+)
+async def test_middleware_accepts_empty_zero_budget(messages: list[Message]) -> None:
+    receive, observed = recording_receive(messages)
+    called = False
+
+    async def send(message: Message) -> None:
+        pytest.fail("The downstream test app sends no response")
+
+    async def app(scope: Scope, replay_receive: Receive, send: Send) -> None:
+        nonlocal called
+        called = True
+        assert observed == messages
+        request = Request(scope, replay_receive)
+        assert await request.body(max_bytes=0) == b""
+        assert await request.body() == b""
+
+    await RequestBodyLimitMiddleware(app, max_bytes=0)({"type": "http"}, receive, send)
+    assert called
+    assert observed == messages
+
+
+@pytest.mark.parametrize(
+    "scope_type,max_bytes", [("http", None), ("websocket", None), ("lifespan", None), ("websocket", 0), ("lifespan", 0)]
+)
+async def test_middleware_passes_through_without_reading(scope_type: str, max_bytes: int | None) -> None:
+    scope: Scope = {"type": scope_type}
+    called = False
+
+    async def receive() -> Message:
+        pytest.fail("Pass-through middleware must not read")
+
+    async def send(message: Message) -> None:
+        pytest.fail("Pass-through middleware must not send")
+
+    async def app(app_scope: Scope, app_receive: Receive, app_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert app_scope is scope
+        assert app_receive is receive
+        assert app_send is send
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+    assert called
+
+
+@pytest.mark.parametrize("partial", [False, True])
+async def test_middleware_preserves_disconnect_during_buffering(partial: bool) -> None:
+    messages: list[Message] = []
+    if partial:
+        messages.append({"type": "http.request", "body": b"ab", "more_body": True})
+    messages.append({"type": "http.disconnect"})
+    receive, observed = recording_receive(messages)
+
+    async def send(message: Message) -> None:
+        pytest.fail("A disconnected request must not send a response")
+
+    async def app(scope: Scope, replay_receive: Receive, send: Send) -> None:
+        assert observed == messages
+        await Request(scope, replay_receive).body()
+
+    with pytest.raises(ClientDisconnect):
+        await RequestBodyLimitMiddleware(app, max_bytes=2)({"type": "http"}, receive, send)
+    assert observed == messages
+
+
+@pytest.mark.parametrize("max_bytes", [None, 11])
+def test_middleware_with_testclient(test_client_factory: TestClientFactory, max_bytes: int | None) -> None:
+    calls = 0
+
+    async def endpoint(request: Request) -> JSONResponse:
+        nonlocal calls
+        calls += 1
+        body = await request.body()
+        assert await request.body(max_bytes=len(body)) is body
+        data = await request.json()
+        assert await request.json() is data
+        return JSONResponse(data)
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b'{"ok":true}', headers={"content-length": "1000"})
+        assert response.status_code == 200
+        assert response.json() == {"ok": True}
+        response = client.post("/", content=b'{"ok":"oversized"}', headers={"content-length": "0"})
+        if max_bytes is None:
+            assert response.status_code == 200
+            assert response.json() == {"ok": "oversized"}
+            assert calls == 2
+        else:
+            assert response.status_code == 413
+            assert response.content == b"Request body too large"
+            assert calls == 1
+
+
+@pytest.mark.parametrize("max_bytes", [None, 0, 100])
+@pytest.mark.parametrize("raise_server_exceptions", [True, False])
+def test_middleware_preserves_endpoint_failures(
+    test_client_factory: TestClientFactory, max_bytes: int | None, raise_server_exceptions: bool
+) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        assert await request.body() == b""
+        raise RuntimeError("endpoint failed")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    with test_client_factory(app, raise_server_exceptions=raise_server_exceptions) as client:
+        if raise_server_exceptions:
+            with pytest.raises(RuntimeError, match="endpoint failed"):
+                client.post("/", content=b"")
+        else:
+            response = client.post("/", content=b"")
+            assert response.status_code == 500
+            assert response.text == "Internal Server Error"
