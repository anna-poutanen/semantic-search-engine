+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+pytestmark = pytest.mark.anyio
+
+
+def make_request(messages: list[Message]) -> tuple[Request, list[Message]]:
+    pending = iter(messages)
+    observed: list[Message] = []
+
+    async def receive() -> Message:
+        message = next(pending)
+        observed.append(message)
+        return message
+
+    return Request({"type": "http"}, receive), observed
+
+
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, "1", b"1", [], {}, object()])
+@pytest.mark.parametrize("cached", [False, True])
+async def test_invalid_limit_does_not_receive(max_bytes: Any, cached: bool) -> None:
+    request, observed = make_request([{"type": "http.request", "body": b"abc"}])
+    if cached:
+        assert await request.body() == b"abc"
+    before = len(observed)
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        await request.body(max_bytes=max_bytes)
+
+    assert len(observed) == before
+
+
+@pytest.mark.parametrize(
+    "max_bytes,chunks",
+    [
+        (None, [b"a", b"bc", b"def"]),
+        (6, [b"a", b"bc", b"def"]),
+        (7, [b"a", b"bc", b"def"]),
+        (3, [b"", b"abc", b""]),
+        (0, [b""]),
+        (0, [b"", b"", b""]),
+        (4, ["é".encode(), "é".encode()]),
+        (10**100, [b"abc"]),
+    ],
+)
+async def test_body_limit_accepts_observed_bytes(max_bytes: int | None, chunks: list[bytes]) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    request, observed = make_request(messages)
+
+    body = await request.body(max_bytes=max_bytes)
+
+    assert body == b"".join(chunks)
+    assert observed == messages
+    assert await request.body() is body
+    assert await request.body(max_bytes=len(body)) is body
+    assert observed == messages
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+
+
+async def test_body_limit_accepts_missing_empty_body() -> None:
+    request, observed = make_request([{"type": "http.request"}])
+    assert await request.body(max_bytes=0) == b""
+    assert len(observed) == 1
+
+
+@pytest.mark.parametrize(
+    "max_bytes,chunks,crossing,received",
+    [
+        (2, [b"abcdef", b"later"], 1, 6),
+        (3, [b"ab", b"", b"cd", b"later"], 3, 4),
+        (3, [b"ab", b"cd"], 2, 4),
+        (0, [b"", b"a", b"later"], 2, 1),
+        (3, ["é".encode(), "é".encode(), b"later"], 2, 4),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    max_bytes: int, chunks: list[bytes], crossing: int, received: int
+) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    request, observed = make_request(messages)
+
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=max_bytes)
+
+    assert isinstance(caught.value, HTTPException)
+    assert caught.value.status_code == 413
+    assert caught.value.detail == "Request body too large"
+    assert caught.value.limit == max_bytes
+    assert caught.value.received == received
+    assert observed == messages[:crossing]
+    assert not hasattr(request, "_body")
+    assert not hasattr(request, "_json")
+
+
+@pytest.mark.parametrize("first_read", ["body", "bounded_body", "json"])
+async def test_cached_body_rejects_stricter_limit_without_receiving(first_read: str) -> None:
+    payload = b'{"ok":true}'
+    request, observed = make_request([{"type": "http.request", "body": payload}])
+    if first_read == "json":
+        assert await request.json() == {"ok": True}
+    elif first_read == "bounded_body":
+        assert await request.body(max_bytes=len(payload)) == payload
+    else:
+        assert await request.body() == payload
+
+    body = await request.body(max_bytes=len(payload))
+    data = await request.json()
+    for max_bytes in (0, len(payload) - 1):
+        with pytest.raises(RequestBodyTooLarge) as caught:
+            await request.body(max_bytes=max_bytes)
+        assert caught.value.limit == max_bytes
+        assert caught.value.received == len(payload)
+
+    assert await request.body(max_bytes=None) is body
+    assert await request.body(max_bytes=len(payload) + 1) is body
+    assert await request.json() is data
+    assert len(observed) == 1
+
+
+@pytest.mark.parametrize("max_bytes", [None, 2, 10])
+async def test_body_limit_preserves_client_disconnect(max_bytes: int | None) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"ab", "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+    request, observed = make_request(messages)
+
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+
+    assert observed == messages
