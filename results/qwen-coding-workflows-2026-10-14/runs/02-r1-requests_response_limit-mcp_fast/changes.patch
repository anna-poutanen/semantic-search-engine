+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("cached_size", [0, 5, 6])
+def test_cached_hook_response_is_checked(stream, cached_size):
+    session, _ = body_session(5)
+    cached = requests.Response()
+    cached.status_code = 200
+    cached._content = b"x" * cached_size
+    cached._content_consumed = True
+    cached.raw = CountingRaw(b"")
+    # Cached hook responses can also be deserialized Responses.
+    cached = pickle.loads(pickle.dumps(cached))
+    closed = []
+    cached.close = lambda: closed.append(True)
+
+    def replace(response, **kwargs):
+        cached.request = response.request
+        return cached
+
+    with session:
+        if cached_size > 5:
+            with pytest.raises(requests.ResponseTooLarge) as caught:
+                session.get(
+                    "http://budget.test/", stream=stream, hooks={"response": replace}
+                )
+            assert caught.value.response is cached
+            assert caught.value.received == cached_size
+            assert caught.value.request is cached.request
+            assert closed == [True]
+        else:
+            response = session.get(
+                "http://budget.test/", stream=stream, hooks={"response": replace}
+            )
+            assert response is cached
+            assert response.content == b"x" * cached_size
+            assert b"".join(response.iter_content(2)) == response.content
+
+
+def test_hook_body_read_is_limited():
+    session, adapter = body_session(5)
+
+    def consume(response, **kwargs):
+        response.content
+
+    with session, pytest.raises(requests.ResponseTooLarge):
+        session.get("http://budget.test/", stream=True, hooks={"response": consume})
+    assert adapter.responses[0].raw.closes == 1
+
