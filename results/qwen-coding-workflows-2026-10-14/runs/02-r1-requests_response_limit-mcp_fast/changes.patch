+def test_cleanup_failure_preserves_budget_exception_and_is_sticky():
+    cleanup_error = OSError("cannot close")
+    session, _ = body_session(5, close_error=cleanup_error)
+    with session:
+        response = session.get("http://budget.test/", stream=True)
+        with pytest.raises(requests.ResponseTooLarge) as caught:
+            response.content
+        assert caught.value.__cause__ is cleanup_error
+        assert caught.value.received == 6
+        reads = response.raw.reads
+        with pytest.raises(requests.ResponseTooLarge) as later:
+            response.text
+        assert later.value is caught.value
+        assert later.value.__cause__ is cleanup_error
+        assert response.raw.reads == reads
+        assert response.raw.closes == 1
+
