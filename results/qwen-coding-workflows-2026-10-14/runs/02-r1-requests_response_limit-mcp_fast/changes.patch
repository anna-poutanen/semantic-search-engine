+class ResponseTooLarge(RequestException):
+    """The decoded response body exceeded its byte budget.
+
+    ``limit`` is the allowed byte count; ``received`` is the cumulative decoded
+    byte count at the first crossing. ``response`` and ``request`` identify the
+    offending response and its request.
+    """
+
