diff --git a/tests/test_response_limits.py b/tests/test_response_limits.py
new file mode 100644
index 0000000..ce58338
--- /dev/null
+++ b/tests/test_response_limits.py
@@ -0,0 +1,479 @@
+"""Regression coverage for decoded response byte budgets."""
+
+import gzip
+import io
+import pickle
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+
+
+class CountingRaw:
+    def __init__(self, body, close_error=None):
+        self.body = io.BytesIO(body)
+        self.reads = 0
+        self.closes = 0
+        self.releases = 0
+        self.close_error = close_error
+
+    def read(self, size):
+        self.reads += 1
+        return self.body.read(size)
+
+    def close(self):
+        self.closes += 1
+        if self.close_error is not None:
+            raise self.close_error
+        self.body.close()
+
+    def release_conn(self):
+        self.releases += 1
+
+
+class StreamingRaw(CountingRaw):
+    def stream(self, size, decode_content):
+        assert decode_content is True
+        while True:
+            chunk = self.read(size)
+            if not chunk:
+                break
+            yield chunk
+
+
+class BodyAdapter(BaseAdapter):
+    def __init__(self, body=b"abcdef", raw_class=CountingRaw, close_error=None):
+        self.body = body
+        self.raw_class = raw_class
+        self.close_error = close_error
+        self.responses = []
+
+    # A strict transport signature also detects any leaked budget keyword.
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        response = requests.Response()
+        response.status_code = 200
+        response.url = request.url
+        response.request = request
+        response.raw = self.raw_class(self.body, self.close_error)
+        self.responses.append(response)
+        return response
+
+    def close(self):
+        pass
+
+
+def body_session(limit=None, **adapter_options):
+    session = requests.Session(max_response_bytes=limit)
+    session.trust_env = False
+    adapter = BodyAdapter(**adapter_options)
+    session.mount("http://", adapter)
+    return session, adapter
+
+
+@pytest.fixture(scope="module")
+def budget_server():
+    paths = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            paths.append(self.path)
+            headers = {}
+            status = 200
+            if self.path.startswith("/redirect/"):
+                sizes = self.path.removeprefix("/redirect/").split("/")
+                body = b"x" * int(sizes[0])
+                status = 302
+                headers["Location"] = (
+                    "/redirect/" + "/".join(sizes[1:])
+                    if len(sizes) > 2
+                    else "/body/" + sizes[-1]
+                )
+            elif self.path in ("/gzip", "/deflate"):
+                encoding = self.path[1:]
+                body = (gzip.compress if encoding == "gzip" else zlib.compress)(
+                    b"x" * 1000
+                )
+                headers["Content-Encoding"] = encoding
+            elif self.path == "/unicode":
+                body = "ééé".encode()
+                headers["Content-Type"] = "text/plain; charset=utf-8"
+            elif self.path == "/chunked":
+                body = b"abcde"
+                headers["Transfer-Encoding"] = "chunked"
+            else:
+                body = b"x" * int(self.path.removeprefix("/body/"))
+            self.send_response(status)
+            if "Transfer-Encoding" not in headers:
+                self.send_header("Content-Length", str(len(body)))
+            for name, value in headers.items():
+                self.send_header(name, value)
+            self.end_headers()
+            if self.command != "HEAD":
+                if "Transfer-Encoding" in headers:
+                    self.wfile.write(b"2\r\nab\r\n3\r\ncde\r\n0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+
+        do_HEAD = do_GET
+        do_OPTIONS = do_GET
+        do_POST = do_GET
+        do_PUT = do_GET
+        do_PATCH = do_GET
+        do_DELETE = do_GET
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}", paths
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+def test_exception_public_identity():
+    assert requests.ResponseTooLarge is requests.exceptions.ResponseTooLarge
+    assert issubclass(requests.ResponseTooLarge, requests.RequestException)
+
+
+@pytest.mark.parametrize("invalid", [-1, True, False, 1.5, "3", b"3", [], {}, object()])
+@pytest.mark.parametrize("entry", ["constructor", "request", "send", "session_setting"])
+def test_invalid_limits_fail_before_transport(invalid, entry):
+    session, adapter = body_session()
+    with session, pytest.raises(ValueError, match="max_response_bytes"):
+        if entry == "constructor":
+            requests.Session(max_response_bytes=invalid)
+        elif entry == "request":
+            session.get("http://budget.test/", max_response_bytes=invalid)
+        elif entry == "send":
+            prepared = requests.Request("GET", "http://budget.test/").prepare()
+            session.send(prepared, max_response_bytes=invalid)
+        else:
+            session.max_response_bytes = invalid
+            session.get("http://budget.test/")
+    assert not adapter.responses
+
+
+@pytest.mark.parametrize("entry", ["request", "send"])
+def test_session_default_and_request_overrides(entry):
+    session, _ = body_session(5)
+    with session:
+        prepared = requests.Request("GET", "http://budget.test/").prepare()
+
+        def send(**kwargs):
+            if entry == "request":
+                return session.get("http://budget.test/", **kwargs)
+            return session.send(prepared, **kwargs)
+
+        with pytest.raises(requests.ResponseTooLarge):
+            send()
+        assert send(max_response_bytes=None).content == b"abcdef"
+        assert send(max_response_bytes=6).content == b"abcdef"
+        assert session.max_response_bytes == 5
+        session.max_response_bytes = 6
+        assert send().content == b"abcdef"
+
+
+@pytest.mark.parametrize("limit", [None, 0, 123])
+def test_session_pickle_preserves_limit(budget_server, limit):
+    base, _ = budget_server
+    with requests.Session(max_response_bytes=limit) as session:
+        with pickle.loads(pickle.dumps(session)) as restored:
+            assert restored.max_response_bytes == limit
+            if limit is None:
+                assert restored.get(base + "/body/124").content == b"x" * 124
+            else:
+                with pytest.raises(requests.ResponseTooLarge) as caught:
+                    restored.get(base + f"/body/{limit + 1}")
+                assert caught.value.limit == limit
+
+
+@pytest.mark.parametrize(
+    "method", ["get", "options", "head", "post", "put", "patch", "delete", "request"]
+)
+@pytest.mark.parametrize("entry", ["module", "session"])
+def test_http_helpers_accept_and_enforce_budget(budget_server, method, entry):
+    base, _ = budget_server
+    with requests.Session() as session:
+        helper = getattr(requests if entry == "module" else session, method)
+        args = ("GET", base + "/body/4") if method == "request" else (base + "/body/4",)
+        if method == "head":
+            assert helper(*args, max_response_bytes=0).content == b""
+        else:
+            with pytest.raises(requests.ResponseTooLarge) as caught:
+                helper(*args, max_response_bytes=3)
+            assert caught.value.limit == 3
+            assert caught.value.received == 4
+            assert caught.value.response.request is caught.value.request
+            assert caught.value.request.method == (
+                "GET" if method == "request" else method.upper()
+            )
+
+
+@pytest.mark.parametrize("raw_class", [CountingRaw, StreamingRaw])
+@pytest.mark.parametrize(
+    "read_api", ["content", "text", "iter_content", "iter_lines", "json"]
+)
+def test_streamed_read_apis_enforce_budget(raw_class, read_api):
+    session, adapter = body_session(5, raw_class=raw_class)
+    with session:
+        response = session.get("http://budget.test/", stream=True)
+        with pytest.raises(requests.ResponseTooLarge) as caught:
+            if read_api in ("content", "text"):
+                getattr(response, read_api)
+            elif read_api == "json":
+                response.json()
+            else:
+                list(getattr(response, read_api)(chunk_size=2))
+        error = caught.value
+        assert error.limit == 5
+        assert error.received == 6
+        assert error.response is response
+        assert error.request is response.request
+        assert adapter.responses[0].raw.closes == 1
+
+
+@pytest.mark.parametrize("raw_class", [CountingRaw, StreamingRaw])
+def test_live_total_survives_multiple_iterators_and_blocks_later_reads(raw_class):
+    session, _ = body_session(5, raw_class=raw_class)
+    with session:
+        response = session.get("http://budget.test/", stream=True)
+        unstarted = response.iter_content(2)
+        first = response.iter_content(2)
+        assert next(first) == b"ab"
+        second = response.iter_content(2)
+        assert next(second) == b"cd"
+        with pytest.raises(requests.ResponseTooLarge) as caught:
+            next(second)
+        assert caught.value.received == 6
+        reads = response.raw.reads
+        for read in (
+            lambda: next(unstarted),
+            lambda: next(first),
+            lambda: response.content,
+            lambda: response.text,
+            lambda: list(response.iter_content(1)),
+            lambda: list(response.iter_lines()),
+            response.json,
+        ):
+            with pytest.raises(requests.ResponseTooLarge) as later:
+                read()
+            assert later.value is caught.value
+            assert later.value.received == 6
+            assert response.raw.reads == reads
+        assert response.raw.closes == 1
+
+
+@pytest.mark.parametrize("raw_class", [CountingRaw, StreamingRaw])
+def test_partial_iterator_followed_by_content_keeps_total(raw_class):
+    session, _ = body_session(5, raw_class=raw_class)
+    with session:
+        response = session.get("http://budget.test/", stream=True)
+        assert next(response.iter_content(2)) == b"ab"
+        with pytest.raises(requests.ResponseTooLarge) as caught:
+            response.content
+        assert caught.value.received == 6
+
+
+@pytest.mark.parametrize("partial", [False, True])
+def test_cached_rereads_do_not_count_twice(partial):
+    session, _ = body_session(6)
+    with session:
+        response = session.get("http://budget.test/", stream=True)
+        if partial:
+            assert next(response.iter_content(2)) == b"ab"
+        expected = b"cdef" if partial else b"abcdef"
+        assert response.content == expected
+        for _ in range(2):
+            assert response.content == expected
+            assert response.text == expected.decode()
+            assert b"".join(response.iter_content(1)) == expected
+
