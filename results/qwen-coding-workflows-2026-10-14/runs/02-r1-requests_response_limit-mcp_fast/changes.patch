+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("sizes", ["6/1/1", "1/6/1", "1/1/6"])
+def test_each_redirect_response_enforces_budget(budget_server, stream, sizes):
+    base, paths = budget_server
+    start = len(paths)
+    with requests.Session(max_response_bytes=5) as session:
+        with pytest.raises(requests.ResponseTooLarge) as caught:
+            response = session.get(base + "/redirect/" + sizes, stream=stream)
+            response.content
+    assert caught.value.received == 6
+    assert caught.value.response.raw.closed
+    assert len(paths) - start == sizes.split("/").index("6") + 1
