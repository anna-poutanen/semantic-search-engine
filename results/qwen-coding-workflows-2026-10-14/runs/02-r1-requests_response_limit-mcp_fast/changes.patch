+@pytest.mark.parametrize("entry", ["request", "send"])
+@pytest.mark.parametrize("override", [None, 6])
+@pytest.mark.parametrize("stream", [False, True])
+def test_redirect_chain_preserves_override_and_has_independent_budgets(
+    budget_server, entry, override, stream
+):
+    base, _ = budget_server
+    with requests.Session(max_response_bytes=0) as session:
+        url = base + "/redirect/4/5/6"
+        kwargs = {"stream": stream, "max_response_bytes": override}
+        if entry == "send":
+            response = session.send(requests.Request("GET", url).prepare(), **kwargs)
+        else:
+            response = session.get(url, **kwargs)
+        with response:
+            assert [len(r.content) for r in response.history] == [4, 5]
+            assert response.content == b"x" * 6
+
