+def test_redirect_chain_keeps_inherited_setting_if_hook_changes_session(budget_server):
+    base, _ = budget_server
+    with requests.Session(max_response_bytes=6) as session:
+
+        def change_session(response, **kwargs):
+            session.max_response_bytes = 0
