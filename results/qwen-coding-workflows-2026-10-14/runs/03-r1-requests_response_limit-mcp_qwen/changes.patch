+@pytest.mark.parametrize("method", METHODS)
+def test_module_helpers_enforce_budget_over_http(local_http, method):
+    if method == "head":
+        result = requests.head(local_http + "/body", max_response_bytes=0)
+        assert result.content == b""
+    else:
+        with pytest.raises(ResponseTooLarge) as caught:
+            getattr(requests, method)(local_http + "/body", max_response_bytes=9)
+        assert caught.value.limit == 9
+        assert caught.value.received == 10
+
