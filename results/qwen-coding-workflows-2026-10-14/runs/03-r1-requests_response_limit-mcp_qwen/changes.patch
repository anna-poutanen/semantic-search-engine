+def test_content_length_is_not_used_to_enforce_budget():
+    result = response(b"abc")
+    result.headers["Content-Length"] = "999999"
+    session, _ = session_for(result, max_response_bytes=3)
+    with session:
+        assert session.get(URL).content == b"abc"
