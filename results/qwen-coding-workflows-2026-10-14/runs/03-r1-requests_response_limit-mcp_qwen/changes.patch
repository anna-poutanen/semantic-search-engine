+def test_cached_response_from_hook_at_boundary_can_be_reread():
+    replacement = response(b"abc", cached=True)
+    session, _ = session_for(response(b"x"), max_response_bytes=3)
+
+    def replace(result, **kwargs):
+        result.close()
+        return replacement
+
+    with session:
+        result = session.get(URL, hooks={"response": replace})
+        assert result is replacement
+        assert result.content == b"abc"
+        assert list(result.iter_content(1)) == [b"a", b"b", b"c"]
+        assert result.text == "abc"
+        assert result.raw.read_calls == 0
+
+
+def test_hook_reads_obey_budget_before_hook_returns():
+    session, _ = session_for(response(), max_response_bytes=3)
+
+    def read(result, **kwargs):
+        result.content
+        pytest.fail("Hook read bypassed the budget")
+
+    with session, pytest.raises(ResponseTooLarge):
+        session.get(URL, stream=True, hooks={"response": read})
+
+
+def test_replacement_is_checked_before_next_hook_reads_it():
+    replacement = response()
+    session, _ = session_for(response(b"x"), max_response_bytes=3)
+
+    def replace(result, **kwargs):
+        result.close()
+        return replacement
+
+    def read(result, **kwargs):
+        result.text
+        pytest.fail("Replacement response bypassed the budget")
+
+    with session, pytest.raises(ResponseTooLarge) as caught:
+        session.get(URL, stream=True, hooks={"response": [replace, read]})
+    assert caught.value.response is replacement
+
