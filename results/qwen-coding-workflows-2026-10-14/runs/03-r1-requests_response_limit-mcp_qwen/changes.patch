diff --git a/tests/test_response_budget.py b/tests/test_response_budget.py
new file mode 100644
index 0000000..e1afc6a
--- /dev/null
+++ b/tests/test_response_budget.py
@@ -0,0 +1,559 @@
+"""Regression tests for decoded response budgets, without external services."""
+
+import gzip
+import io
+import pickle
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+
+class TrackingBody(io.BytesIO):
+    def __init__(self, body, close_error=None):
+        super().__init__(body)
+        self.read_calls = 0
+        self.close_calls = 0
+        self.release_calls = 0
+        self.close_error = close_error
+
+    def read(self, size=-1):
+        self.read_calls += 1
+        return super().read(size)
+
+    def close(self):
+        self.close_calls += 1
+        if self.close_error is not None:
+            raise self.close_error
+        super().close()
+
+    def release_conn(self):
+        self.release_calls += 1
+
+
+class TrackingStream(TrackingBody):
+    def stream(self, chunk_size, decode_content=False):
+        assert decode_content is True
+        while True:
+            chunk = self.read(chunk_size)
+            if not chunk:
+                break
+            yield chunk
+
+
+def response(body=b"abcdefghij", *, cached=False, raw_type=TrackingBody):
+    result = requests.Response()
+    result.status_code = 200
+    result.raw = raw_type(body)
+    result.encoding = "utf-8"
+    if cached:
+        result._content = body
+        result._content_consumed = True
+    return result
+
+
+class StrictAdapter(BaseAdapter):
+    """A transport that rejects any unrecognized keyword arguments."""
+
+    def __init__(self, responses):
+        self.responses = iter(responses)
+        self.calls = []
+
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        self.calls.append(request)
+        result = next(self.responses)
+        result.request = request
+        result.url = request.url
+        return result
+
+    def close(self):
+        pass
+
+
+def session_for(*responses, max_response_bytes=None):
+    session = requests.Session(max_response_bytes=max_response_bytes)
+    adapter = StrictAdapter(responses)
+    session.mount("http://", adapter)
+    return session, adapter
+
+
+URL = "http://budget.test/body"
+INVALID_LIMITS = [-1, True, False, 1.5, "3", b"3", [], {}, object()]
+METHODS = ["get", "options", "head", "post", "put", "patch", "delete"]
+
+
+def test_public_exception_identity():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    assert issubclass(ResponseTooLarge, RequestException)
+
+
+@pytest.mark.parametrize("limit", INVALID_LIMITS)
+def test_invalid_session_constructor_limit(limit):
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        requests.Session(max_response_bytes=limit)
+
+
+@pytest.mark.parametrize("limit", INVALID_LIMITS)
+@pytest.mark.parametrize("entry", ["get", "request", "send", "session_setting"])
+def test_invalid_limit_rejected_before_transport(limit, entry):
+    session, adapter = session_for(response())
+    with session, pytest.raises(ValueError, match="max_response_bytes"):
+        if entry == "session_setting":
+            session.max_response_bytes = limit
+            session.get(URL)
+        elif entry == "send":
+            session.send(
+                requests.Request("GET", URL).prepare(), max_response_bytes=limit
+            )
+        elif entry == "request":
+            session.request("GET", URL, max_response_bytes=limit)
+        else:
+            session.get(URL, max_response_bytes=limit)
+    assert adapter.calls == []
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_module_helpers_validate_before_transport(monkeypatch, method):
+    def unexpected_transport(*args, **kwargs):
+        pytest.fail("Invalid budget reached the transport")
+
+    monkeypatch.setattr(requests.adapters.HTTPAdapter, "send", unexpected_transport)
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        getattr(requests, method)(URL, max_response_bytes=True)
+
+
+@pytest.mark.parametrize("method", METHODS)
+def test_session_method_helpers_apply_budget(method):
+    result = response()
+    session, adapter = session_for(result)
+    with session, pytest.raises(ResponseTooLarge) as caught:
+        getattr(session, method)(URL, max_response_bytes=9)
+    assert len(adapter.calls) == 1
+    assert caught.value.response is result
+    assert caught.value.request is adapter.calls[0]
+    assert caught.value.limit == 9
+    assert caught.value.received == 10
+
+
+@pytest.mark.parametrize("limit", [None, 0, 10])
+def test_session_budget_survives_pickle(limit):
+    with requests.Session(max_response_bytes=limit) as original:
+        with pickle.loads(pickle.dumps(original)) as restored:
+            assert restored.max_response_bytes == limit
+            adapter = StrictAdapter([response(b"x")])
+            restored.mount("http://", adapter)
+            if limit == 0:
+                with pytest.raises(ResponseTooLarge):
+                    restored.get(URL)
+            else:
+                assert restored.get(URL).content == b"x"
+
+
+@pytest.mark.parametrize("entry", ["get", "send"])
+@pytest.mark.parametrize("override", [None, 10])
+def test_request_override_and_omission(entry, override):
+    session, adapter = session_for(response(), response(), max_response_bytes=3)
+    with session:
+
+        def call(**kwargs):
+            if entry == "send":
+                return session.send(requests.Request("GET", URL).prepare(), **kwargs)
+            return session.get(URL, **kwargs)
+
+        assert call(max_response_bytes=override).content == b"abcdefghij"
+        assert session.max_response_bytes == 3
+        with pytest.raises(ResponseTooLarge) as caught:
+            call()
+        assert caught.value.limit == 3
+    assert len(adapter.calls) == 2
+
+
+@pytest.mark.parametrize("raw_type", [TrackingBody, TrackingStream])
+@pytest.mark.parametrize("body, limit", [(b"", 0), (b"abcdefghij", 10)])
+def test_boundary_and_cached_rereads(raw_type, body, limit):
+    session, _ = session_for(
+        response(body, raw_type=raw_type), max_response_bytes=limit
+    )
+    with session:
+        result = session.get(URL)
+        assert result.content == body
+        assert result.content == body
+        assert result.text == body.decode()
+        assert b"".join(result.iter_content(2)) == body
+        assert b"".join(result.iter_content(None)) == body
+        assert result.raw.close_calls == 0
+
+
+@pytest.mark.parametrize("raw_type", [TrackingBody, TrackingStream])
+@pytest.mark.parametrize("continuation", ["iterator", "content", "text"])
+def test_live_total_survives_partial_reads(raw_type, continuation):
+    result = response(raw_type=raw_type)
+    session, _ = session_for(result, max_response_bytes=5)
+    with session:
+        result = session.get(URL, stream=True)
+        assert result.raw.read_calls == 0
+        initial = result.iter_content(3)
+        assert next(initial) == b"abc"
+        with pytest.raises(ResponseTooLarge) as caught:
+            if continuation == "iterator":
+                next(result.iter_content(3))
+            else:
+                getattr(result, continuation)
+        assert caught.value.received == (6 if continuation == "iterator" else 10)
+        assert result.raw.close_calls == 1
+        reads = result.raw.read_calls
+        for read in (
+            lambda: next(initial),
+            lambda: result.content,
+            lambda: result.text,
+            result.json,
+            lambda: next(result.iter_content(1)),
+            lambda: next(result.iter_lines()),
+        ):
+            with pytest.raises(ResponseTooLarge) as later:
+                read()
+            assert later.value is caught.value
+            assert result.raw.read_calls == reads
+            assert result.raw.close_calls == 1
+
+
+def test_preexisting_iterator_stops_before_reading_after_another_fails():
+    result = response(raw_type=TrackingStream)
+    session, _ = session_for(result, max_response_bytes=4)
+    with session:
+        session.get(URL, stream=True)
+        other = result.iter_content(1)
+        assert next(other) == b"a"
+        chunks = result.iter_content(2)
+        assert next(chunks) == b"bc"
+        with pytest.raises(ResponseTooLarge) as caught:
+            next(chunks)
+        assert caught.value.received == 5
+        reads = result.raw.read_calls
+        with pytest.raises(ResponseTooLarge) as later:
+            next(other)
+        assert later.value is caught.value
+        assert result.raw.read_calls == reads
+
+
+@pytest.mark.parametrize("raw_type", [TrackingBody, TrackingStream])
+def test_partial_read_then_cached_remainder_counts_each_byte_once(raw_type):
+    session, _ = session_for(response(raw_type=raw_type), max_response_bytes=10)
+    with session:
+        result = session.get(URL, stream=True)
+        assert next(result.iter_content(3)) == b"abc"
+        assert result.content == b"defghij"
+        assert result.content == b"defghij"
+        assert b"".join(result.iter_content(2)) == b"defghij"
+
+
+@pytest.mark.parametrize("raw_type", [TrackingBody, TrackingStream])
+def test_unicode_stream_budget_counts_bytes_before_characters(raw_type):
+    result = response("ééé".encode(), raw_type=raw_type)
+    session, _ = session_for(result, max_response_bytes=3)
+    with session:
+        session.get(URL, stream=True)
+        chunks = result.iter_content(2, decode_unicode=True)
+        assert next(chunks) == "é"
+        with pytest.raises(ResponseTooLarge) as caught:
+            next(chunks)
+        assert caught.value.received == 4
+
+
+def test_close_failure_preserves_budget_error_and_cause():
+    result = response()
+    cleanup_error = RuntimeError("close failed")
+    result.raw.close_error = cleanup_error
+    session, _ = session_for(result, max_response_bytes=2)
+    try:
+        with session, pytest.raises(ResponseTooLarge) as caught:
+            session.get(URL)
+        assert caught.value.__cause__ is cleanup_error
+        assert caught.value.response is result
+        assert caught.value.received == 10
+        assert result.raw.close_calls == 1
+        reads = result.raw.read_calls
+        with pytest.raises(ResponseTooLarge) as later:
+            result.content
+        assert later.value is caught.value
+        assert result.raw.read_calls == reads
+        assert result.raw.close_calls == 1
+    finally:
+        result.raw.close_error = None
+        result.raw.close()
+
+
+@pytest.mark.parametrize("cached_consumed", [False, True])
+@pytest.mark.parametrize("stream", [False, True])
+def test_cached_response_from_hook_is_checked(cached_consumed, stream):
+    original = response(b"x")
+    replacement = response(cached=True)
+    replacement._content_consumed = cached_consumed
+    session, _ = session_for(original, max_response_bytes=3)
+
+    def replace(result, **kwargs):
+        assert "max_response_bytes" not in kwargs
+        result.close()
+        return replacement
+
+    with session, pytest.raises(ResponseTooLarge) as caught:
+        session.get(URL, stream=stream, hooks={"response": replace})
+    assert caught.value.response is replacement
+    assert caught.value.request is original.request
+    assert caught.value.received == 10
+    assert replacement.raw.read_calls == 0
+    assert replacement.raw.close_calls + replacement.raw.release_calls > 0
+    with pytest.raises(ResponseTooLarge):
+        replacement.content
+
+
+def test_response_context_preserves_budget_error_when_close_fails():
+    result = response()
+    cleanup_error = RuntimeError("close failed")
+    result.raw.close_error = cleanup_error
+    session, _ = session_for(result, max_response_bytes=2)
+    try:
+        with session, pytest.raises(ResponseTooLarge) as caught:
+            with session.get(URL, stream=True) as result:
+                result.content
+        assert caught.value.__cause__ is cleanup_error
+        assert result.raw.close_calls == 1
+    finally:
+        result.raw.close_error = None
+        result.raw.close()
+
