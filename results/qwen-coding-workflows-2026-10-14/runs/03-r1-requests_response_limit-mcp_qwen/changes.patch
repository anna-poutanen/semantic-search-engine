+@pytest.fixture(scope="module")
+def local_http():
+    routes = {
+        "/body": (200, b"abcdefghij", {}),
+        "/empty": (200, b"", {}),
+        "/small": (200, b"def", {}),
+        "/unicode": (200, "ééé".encode(), {}),
+        "/gzip": (200, gzip.compress(b"x" * 4096), {"Content-Encoding": "gzip"}),
+        "/deflate": (200, zlib.compress(b"x" * 4096), {"Content-Encoding": "deflate"}),
+        "/redirect": (302, b"abcdefghij", {"Location": "/body"}),
+        "/empty-redirect": (302, b"", {"Location": "/body"}),
+        "/small-redirect": (302, b"abc", {"Location": "/small"}),
+        "/chain": (302, b"abc", {"Location": "/small-redirect"}),
+        "/gzip-redirect": (
+            302,
+            gzip.compress(b"x" * 4096),
+            {"Content-Encoding": "gzip", "Location": "/body"},
+        ),
+        "/chunked": (200, b"abcdefghi", {"Transfer-Encoding": "chunked"}),
+    }
+
+    class Handler(BaseHTTPRequestHandler):
+        def respond(self):
+            status, body, headers = routes[self.path]
+            self.send_response(status)
+            self.send_header("Content-Type", "text/plain; charset=utf-8")
+            for name, value in headers.items():
+                self.send_header(name, value)
+            if "Transfer-Encoding" not in headers:
+                self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            if self.command == "HEAD":
+                return
+            try:
+                if "Transfer-Encoding" in headers:
+                    for start in range(0, len(body), 3):
+                        chunk = body[start : start + 3]
+                        self.wfile.write(
+                            f"{len(chunk):x}\r\n".encode() + chunk + b"\r\n"
+                        )
+                    self.wfile.write(b"0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+            except (BrokenPipeError, ConnectionResetError):
+                pass
+
+        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = do_HEAD = (
+            respond
+        )
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(
+        target=server.serve_forever, kwargs={"poll_interval": 0.01}
+    )
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}"
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=5)
