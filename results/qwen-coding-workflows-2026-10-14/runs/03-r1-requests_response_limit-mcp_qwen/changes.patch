+@pytest.mark.parametrize("path", ["/gzip", "/deflate"])
+@pytest.mark.parametrize(
+    "read", ["eager", "content", "text", "iterator", "unicode_iterator"]
+)
+def test_http_budget_counts_decompressed_bytes(local_http, path, read):
+    with pytest.raises(ResponseTooLarge) as caught:
+        result = requests.get(
+            local_http + path, max_response_bytes=100, stream=read != "eager"
+        )
+        if read in ("content", "text"):
+            getattr(result, read)
+        elif read in ("iterator", "unicode_iterator"):
+            chunks = result.iter_content(64, decode_unicode=read == "unicode_iterator")
+            assert next(chunks) == (
+                "x" * 64 if read == "unicode_iterator" else b"x" * 64
+            )
+            next(chunks)
+    assert caught.value.received == (128 if "iterator" in read else 4096)
+    assert int(caught.value.response.headers["Content-Length"]) < 100
+    assert caught.value.response.raw.closed
+
