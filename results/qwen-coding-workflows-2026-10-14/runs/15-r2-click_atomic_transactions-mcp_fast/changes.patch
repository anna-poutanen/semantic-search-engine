+import pytest
+
+import click
+
+
+@pytest.mark.parametrize("fail", [False, True])
+@pytest.mark.parametrize("scope", [False, True])
+def test_resource_receives_exception_at_outermost_exit(fail, scope):
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    error = ValueError("body failed")
+    events = []
+
+    class Resource:
+        def __enter__(self):
+            events.append("enter")
+            return self
+
+        def __exit__(self, exc_type, exc_value, tb):
+            assert click.get_current_context() is ctx
+            events.append((exc_type, exc_value, tb))
+
+    def body():
+        with ctx.scope() if scope else ctx:
+            resource = Resource()
+            assert ctx.with_resource(resource) is resource
+            with ctx:
+                with ctx.scope(cleanup=False):
+                    assert click.get_current_context() is ctx
+                    if fail:
+                        raise error
+                assert events == ["enter"]
+            assert events == ["enter"]
+
+    with parent:
+        if fail:
+            with pytest.raises(ValueError) as caught:
+                body()
+            assert caught.value is error
+        else:
+            body()
+        assert click.get_current_context() is parent
+        assert len(events) == 2
+        exc_type, exc_value, tb = events[1]
+        if fail:
+            assert exc_type is ValueError
+            assert exc_value is error
+            assert tb is not None
+        else:
+            assert (exc_type, exc_value, tb) == (None, None, None)
+        with ctx:
+            ctx.call_on_close(lambda: events.append("reused"))
+        assert events[-1] == "reused"
+    assert click.get_current_context(silent=True) is None
+
+
+def test_cleanup_failure_restores_current_context_and_allows_reuse():
+    parent = click.Context(click.Command("parent"))
+    ctx = click.Context(click.Command("child"), parent=parent)
+    error = OSError("cleanup failed")
+    events = []
+
+    def cleanup():
+        assert click.get_current_context() is ctx
+        raise error
+
+    with parent:
+        with pytest.raises(OSError) as caught:
+            with ctx:
+                ctx.call_on_close(cleanup)
+        assert caught.value is error
+        assert click.get_current_context() is parent
+        with ctx:
+            ctx.call_on_close(lambda: events.append("reused"))
+        assert events == ["reused"]
+    assert click.get_current_context(silent=True) is None
+
+
+def test_caught_nested_error_defers_cleanup_until_successful_outer_exit():
+    ctx = click.Context(click.Command("test"))
+    events = []
+
