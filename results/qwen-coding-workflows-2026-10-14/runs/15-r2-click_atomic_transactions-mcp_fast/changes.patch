+import os
+import stat
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_direct_atomic_transaction(tmp_path, lazy, binary, existing, fail):
+    destination = tmp_path / "output"
+    if existing:
+        destination.write_bytes(b"original")
+        destination.chmod(0o640)
+    error = ValueError("body failed")
+    output = click.open_file(
+        destination, "wb" if binary else "w", lazy=lazy, atomic=True
+    )
+
+    def write():
+        with output:
+            output.write(b"replacement" if binary else "replacement")
+            output.flush()
+            if existing:
+                assert destination.read_bytes() == b"original"
+            else:
+                assert not destination.exists()
+            if fail:
+                raise error
+
+    if fail:
+        with pytest.raises(ValueError) as caught:
+            write()
+        assert caught.value is error
+    else:
+        write()
+
+    assert output.closed
+    atomic = output._f if lazy else output
+    assert atomic._f.closed
+    output.close()
+    if fail and not existing:
+        assert not destination.exists()
+    else:
+        assert destination.read_bytes() == (b"original" if fail else b"replacement")
+    if existing and os.name != "nt":
+        assert stat.S_IMODE(destination.stat().st_mode) == 0o640
+    assert list(tmp_path.iterdir()) == ([destination] if destination.exists() else [])
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("binary", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize(
+    "outcome", ["return", "error", "click-error", "abort", "exit-zero", "exit-error"]
+)
+@pytest.mark.parametrize("standalone", [False, True])
+def test_command_atomic_transaction(
+    runner, tmp_path, lazy, binary, existing, outcome, standalone
+):
+    destination = tmp_path / "output"
+    if existing:
+        destination.write_bytes(b"original")
+        destination.chmod(0o640)
+    handles = []
+    error = RuntimeError("callback failed")
+
+    @click.command()
+    @click.argument(
+        "output", type=click.File("wb" if binary else "w", lazy=lazy, atomic=True)
+    )
+    @click.pass_context
+    def cli(ctx, output):
+        handles.append(output)
+        output.write(b"replacement" if binary else "replacement")
+        output.flush()
+        if existing:
+            assert destination.read_bytes() == b"original"
+        else:
+            assert not destination.exists()
+        if outcome == "error":
+            raise error
+        if outcome == "click-error":
+            raise click.ClickException("callback failed")
+        if outcome == "abort":
+            ctx.abort()
+        if outcome.startswith("exit-"):
+            ctx.exit(0 if outcome == "exit-zero" else 3)
+
+    result = runner.invoke(cli, [str(destination)], standalone_mode=standalone)
+    success = outcome in {"return", "exit-zero"}
+    if success:
+        assert result.exit_code == 0
+        assert result.exception is None
+    elif outcome == "exit-error" and not standalone:
+        assert result.return_value == 3
+    else:
+        assert result.exit_code != 0
+    if outcome == "error":
+        assert result.exception is error
+    assert handles[0].closed
+    atomic = handles[0]._f if lazy is not False else handles[0]
+    assert atomic._f.closed
+    handles[0].close()
+    if not success and not existing:
+        assert not destination.exists()
+    else:
+        assert destination.read_bytes() == (b"replacement" if success else b"original")
+    if existing and os.name != "nt":
+        assert stat.S_IMODE(destination.stat().st_mode) == 0o640
+    assert list(tmp_path.iterdir()) == ([destination] if destination.exists() else [])
+    assert click.get_current_context(silent=True) is None
+
