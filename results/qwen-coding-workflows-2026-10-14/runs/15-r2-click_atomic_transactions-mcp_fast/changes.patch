+    else:
+        with pytest.raises(ValueError) as caught:
+            with click.open_file(
+                destination, "w", lazy=lazy is not False, atomic=True
+            ) as output:
+                body(output)
+        assert caught.value is error
+    assert (
+        error.__cause__ is cleanup_error
+        or error.__context__ is cleanup_error
+        or any(
+            "cannot remove temporary file" in note
+            for note in getattr(error, "__notes__", [])
+        )
+    )
+    assert handles[0].closed
+    handles[0].close()
+    assert destination.read_text() == "original"
+    assert click.get_current_context(silent=True) is None
