+    monkeypatch.setattr(click.utils, "open_stream", unexpected_open)
+
+    def body(output):
+        assert output._f is None
+        if fail:
+            raise ValueError("unused output")
+
+    if command:
+
+        @click.command()
+        @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+        def cli(output):
+            body(output)
+
+        result = runner.invoke(cli, [str(destination)])
+        assert result.exit_code == int(fail)
+    else:
+
+        def run():
+            with click.open_file(
+                destination, "w", lazy=lazy is not False, atomic=True
+            ) as output:
+                body(output)
+
+        if fail:
+            with pytest.raises(ValueError):
+                run()
+        else:
