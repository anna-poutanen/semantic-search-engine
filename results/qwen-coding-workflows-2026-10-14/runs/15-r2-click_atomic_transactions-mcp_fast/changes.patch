+@pytest.mark.parametrize("command", [False, True])
+@pytest.mark.parametrize("lazy", [False, True, None])
+def test_abort_cleanup_error_preserves_callback(
+    runner, tmp_path, monkeypatch, command, lazy
+):
+    destination = tmp_path / "output"
+    destination.write_text("original")
+    error = ValueError("primary failure")
+    cleanup_error = PermissionError("cannot remove temporary file")
+    handles = []
+
+    def unlink(filename):
+        raise cleanup_error
+
+    monkeypatch.setattr(os, "unlink", unlink)
+
+    def body(output):
+        handles.append(output)
+        output.write("replacement")
+        raise error
+
+    if command:
+
+        @click.command()
+        @click.argument("output", type=click.File("w", lazy=lazy, atomic=True))
+        def cli(output):
+            body(output)
+
+        result = runner.invoke(cli, [str(destination)])
