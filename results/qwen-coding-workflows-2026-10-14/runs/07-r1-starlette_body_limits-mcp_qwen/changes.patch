+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import Response
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "limit,chunks",
+    [
+        (None, [b"abc", b"def"]),
+        (10, [b"abc", b"def"]),
+        (6, [b"abc", b"def"]),
+        (6, [b"", b"abc", b"", b"def", b""]),
+        (0, [b""]),
+        (0, [b"", b""]),
+    ],
+)
+async def test_body_limit_accepts_complete_body(limit: int | None, chunks: list[bytes]) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    request = Request({"type": "http"}, receive)
+    body = await request.body(max_bytes=limit)
+    assert body == b"".join(chunks)
+    assert await request.body() is body
+    assert await request.body(max_bytes=len(body)) is body
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+    assert not messages
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("cached", [False, True])
+@pytest.mark.parametrize("limit", [-1, True, False, 1.0, float("inf"), float("nan"), "3", b"3", object()])
+async def test_invalid_body_limit_never_receives(limit: Any, cached: bool) -> None:
+    calls = 0
+
+    async def receive() -> Message:
+        nonlocal calls
+        calls += 1
+        return {"type": "http.request", "body": b"abc"}
+
+    request = Request({"type": "http"}, receive)
+    if cached:
+        assert await request.body() == b"abc"
+    calls_before = calls
+    with pytest.raises(ValueError, match="max_bytes"):
+        await request.body(max_bytes=limit)
+    assert calls == calls_before
+    assert await request.body() == b"abc"
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("content_length", [None, b"0", b"99999"])
+@pytest.mark.parametrize(
+    "limit,chunks,crossing,received",
+    [
+        (0, [b"a", b"later"], 1, 1),
+        (3, [b"ab", b"cd", b"later"], 2, 4),
+        (3, [b"abc", b"", b"d", b"later"], 3, 4),
+        (3, [b"ab", b"cd"], 2, 4),
+        (1, ["é".encode(), b"later"], 1, 2),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    content_length: bytes | None, limit: int, chunks: list[bytes], crossing: int, received: int
+) -> None:
+    calls = 0
+
+    async def receive() -> Message:
+        nonlocal calls
+        chunk = chunks[calls]
+        calls += 1
+        return {"type": "http.request", "body": chunk, "more_body": calls < len(chunks)}
+
+    headers = [] if content_length is None else [(b"content-length", content_length)]
+    request = Request({"type": "http", "headers": headers}, receive)
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=limit)
+    assert isinstance(caught.value, HTTPException)
+    assert caught.value.status_code == 413
+    assert caught.value.detail == "Request body too large"
+    assert caught.value.limit == limit
+    assert caught.value.received == received
+    assert calls == crossing
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_body_limit_checks_cached_body_without_receiving(json_first: bool) -> None:
+    calls = 0
+    content = b'{"a":1}'
+
+    async def receive() -> Message:
+        nonlocal calls
+        calls += 1
+        assert calls == 1
+        return {"type": "http.request", "body": content}
+
+    request = Request({"type": "http"}, receive)
+    if json_first:
+        assert await request.json() == {"a": 1}
+    else:
+        assert await request.body(max_bytes=len(content)) == content
+    with pytest.raises(RequestBodyTooLarge) as caught:
+        await request.body(max_bytes=len(content) - 1)
+    assert caught.value.limit == len(content) - 1
+    assert caught.value.received == len(content)
+    assert await request.body(max_bytes=len(content)) == content
+    assert await request.body() == content
+    data = await request.json()
+    assert data == {"a": 1}
+    assert await request.json() is data
+    assert calls == 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("partial", [False, True])
+async def test_body_limit_preserves_client_disconnect(partial: bool) -> None:
+    messages: list[Message] = [{"type": "http.disconnect"}]
+    if partial:
+        messages.insert(0, {"type": "http.request", "body": b"a", "more_body": True})
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    request = Request({"type": "http"}, receive)
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=3)
+    assert await request.is_disconnected()
+    assert not hasattr(request, "_body")
+    assert not messages
+
+
+def test_body_limit_is_handled_as_http_exception(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        return Response(await request.body(max_bytes=3))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    with test_client_factory(app) as client:
+        assert client.post("/", content=b"abc").content == b"abc"
+        response = client.post("/", content=b"abcd")
+    assert response.status_code == 413
+    assert response.text == "Request body too large"
