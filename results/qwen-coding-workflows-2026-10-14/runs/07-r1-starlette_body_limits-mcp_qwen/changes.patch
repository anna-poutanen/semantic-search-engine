+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import RequestBodyTooLarge
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, Response
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+@pytest.mark.parametrize("limit", [-1, True, False, 1.0, float("inf"), float("nan"), "3", b"3", object()])
+def test_body_limit_validated_at_construction(limit: Any) -> None:
+    with pytest.raises(ValueError, match="max_bytes"):
+        RequestBodyLimitMiddleware(Starlette(), max_bytes=limit)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("content_length", [None, b"0", b"99999"])
+@pytest.mark.parametrize(
+    "limit,chunks,reads",
+    [(0, [b"a", b"later"], 1), (3, [b"ab", b"cd", b"later"], 2), (3, [b"ab", b"cd"], 2)],
+)
+async def test_body_limit_rejects_before_calling_app(
+    content_length: bytes | None, limit: int, chunks: list[bytes], reads: int
+) -> None:
+    calls = 0
+    sent: list[Message] = []
+
+    async def receive() -> Message:
+        nonlocal calls
+        chunk = chunks[calls]
+        calls += 1
+        return {"type": "http.request", "body": chunk, "more_body": calls < len(chunks)}
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Oversized requests must not reach the app")
+
+    headers = [] if content_length is None else [(b"content-length", content_length)]
+    await RequestBodyLimitMiddleware(app, max_bytes=limit)({"type": "http", "headers": headers}, receive, send)
+    assert calls == reads
+    assert sent[0]["type"] == "http.response.start"
+    assert sent[0]["status"] == 413
+    assert (b"content-type", b"text/plain; charset=utf-8") in sent[0]["headers"]
+    assert sent[1] == {"type": "http.response.body", "body": b"Request body too large"}
+    assert len(sent) == 2
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("chunks,limit", [([b"ab", b"", b"cd"], 4), ([b"ab"], 3), ([b"", b""], 0)])
+async def test_body_limit_buffers_then_replays_and_delegates(chunks: list[bytes], limit: int) -> None:
+    calls = 0
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    messages.append({"type": "http.disconnect"})
+
+    async def receive() -> Message:
+        nonlocal calls
+        calls += 1
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        pytest.fail("No response expected")
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        assert calls == len(chunks)
+        # A deliberately oversized Content-Length must not cause rejection.
+        assert scope["headers"] == [(b"content-length", b"99999")]
+        request = Request(scope, receive)
+        body = await request.body()
+        assert body == b"".join(chunks)
+        assert await request.body() is body
+        assert await request.body(max_bytes=limit) is body
+        assert calls == len(chunks)
+        assert await receive() == {"type": "http.disconnect"}
+        assert calls == len(chunks) + 1
+
+    scope = {"type": "http", "headers": [(b"content-length", b"99999")]}
+    await RequestBodyLimitMiddleware(app, max_bytes=limit)(scope, receive, send)
+    assert not messages
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("scope_type,limit", [("http", None), ("websocket", 0), ("lifespan", 0)])
+async def test_body_limit_passes_through_without_reading(scope_type: str, limit: int | None) -> None:
+    scope = {"type": scope_type}
+    called = False
+
+    async def receive() -> Message:
+        pytest.fail("Pass-through middleware must not receive")
+
+    async def send(message: Message) -> None:
+        pytest.fail("No response expected")
+
+    async def app(app_scope: Scope, app_receive: Receive, app_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert app_scope is scope
+        assert app_receive is receive
+        assert app_send is send
+
+    await RequestBodyLimitMiddleware(app, max_bytes=limit)(scope, receive, send)
+    assert called
+
+
+@pytest.mark.anyio
+async def test_body_limit_preserves_disconnect_during_buffering() -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"a", "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        pytest.fail("No response expected")
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Incomplete requests must not reach the app")
+
+    with pytest.raises(ClientDisconnect):
+        await RequestBodyLimitMiddleware(app, max_bytes=3)({"type": "http"}, receive, send)
+    assert not messages
+
+
+@pytest.mark.parametrize("limit", [None, 7, 8])
+def test_body_limit_body_and_json_caches(test_client_factory: TestClientFactory, limit: int | None) -> None:
+    async def endpoint(request: Request) -> Response:
+        assert await request.body() == b'{"a":1}'
+        data = await request.json()
+        assert await request.json() is data
+        assert await request.body() == b'{"a":1}'
+        return JSONResponse(data)
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=limit)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b'{"a":1}')
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+
+def test_body_limit_http_rejection_and_zero_boundary(test_client_factory: TestClientFactory) -> None:
+    calls = 0
+
+    async def endpoint(request: Request) -> Response:
+        nonlocal calls
+        calls += 1
+        return Response(await request.body())
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=0)],
+    )
+    with test_client_factory(app) as client:
+        empty = client.post("/", content=b"")
+        assert empty.status_code == 200
+        assert empty.content == b""
+        oversized = client.post("/", content=b"a")
+        assert oversized.status_code == 413
+        assert oversized.content == b"Request body too large"
+    assert calls == 1
+
+
+@pytest.mark.parametrize("failure", [RuntimeError("endpoint failed"), RequestBodyTooLarge(limit=1, received=2)])
+def test_body_limit_preserves_endpoint_failures(test_client_factory: TestClientFactory, failure: Exception) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        assert await Request(scope, receive).body() == b"abc"
+        raise failure
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=3)
+    client = test_client_factory(middleware)
+    with pytest.raises(type(failure)) as caught:
+        client.post("/", content=b"abc")
+    assert caught.value is failure
+
+
+def test_body_limit_preserves_starlette_endpoint_failure(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        assert await request.body() == b"abc"
+        raise RuntimeError("endpoint failed")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=3)],
+    )
+    with test_client_factory(app) as client:
+        with pytest.raises(RuntimeError, match="endpoint failed"):
+            client.post("/", content=b"abc")
