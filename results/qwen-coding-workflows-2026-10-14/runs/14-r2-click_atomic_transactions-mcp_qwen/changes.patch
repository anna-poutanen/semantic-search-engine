+        output.write("message")
+        if fail:
+            raise error
+
+    result = runner.invoke(cli)
+    assert result.exception is (error if fail else None)
+    assert not stream.closed
+    assert stream.getvalue() == "message"
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("fail", [False, True])
+def test_group_atomic_parameter_waits_for_subcommand(runner, tmp_path, lazy, fail):
+    path = tmp_path / "output"
+    path.write_text("original")
+    error = RuntimeError("subcommand failed")
+    opened = []
+
+    @click.group()
+    @click.option("--output", type=click.File("w", atomic=True, lazy=lazy))
+    @click.pass_context
+    def cli(ctx, output):
+        opened.append(output)
+        ctx.obj = output
+        output.write("group ")
+
+    @cli.command()
+    @click.pass_obj
+    def sub(output):
+        assert path.read_text() == "original"
+        output.write("subcommand")
+        if fail:
+            raise error
+
+    result = runner.invoke(cli, ["--output", str(path), "sub"])
+    assert result.exception is (error if fail else None)
+    assert path.read_text() == ("original" if fail else "group subcommand")
+    assert opened[0].closed
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert click.get_current_context(silent=True) is None
