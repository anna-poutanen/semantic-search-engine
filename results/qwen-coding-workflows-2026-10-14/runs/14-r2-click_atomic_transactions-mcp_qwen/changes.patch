+import io
+import os
+import stat
+import sys
+
+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+def assert_destination(path, exists, content=b"original"):
+    if exists:
+        assert path.read_bytes() == content
+    else:
+        assert not path.exists()
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_direct_atomic_transaction(tmp_path, lazy, mode, exists, fail):
+    path = tmp_path / "output"
+    if exists:
+        path.write_bytes(b"original")
+    error = RuntimeError("body failed")
+    file = click.open_file(path, mode, lazy=lazy, atomic=True)
+
+    def write():
+        with file as output:
+            output.write(b"replacement" if "b" in mode else "replacement")
+            output.flush()
+            assert_destination(path, exists)
+            if fail:
+                raise error
+
+    if fail:
+        with pytest.raises(RuntimeError) as caught:
+            write()
+        assert caught.value is error
+        assert_destination(path, exists)
+    else:
+        write()
+        assert path.read_bytes() == b"replacement"
+
+    assert file.closed
+    file.close()
+    file.close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("error", [KeyboardInterrupt(), SystemExit(1), Exit(0)])
+def test_direct_atomic_body_exception_aborts(tmp_path, lazy, error):
+    path = tmp_path / "output"
+    path.write_text("original")
+    with pytest.raises(type(error)) as caught:
+        with click.open_file(path, "w", atomic=True, lazy=lazy) as file:
+            file.write("replacement")
+            raise error
+    assert caught.value is error
+    assert path.read_text() == "original"
+    assert file.closed
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("exists", [False, True])
+@pytest.mark.parametrize("parameter", ["argument", "option"])
+@pytest.mark.parametrize("outcome", ["return", "error", "exit_zero", "exit_nonzero"])
+def test_command_atomic_transaction(
+    runner, tmp_path, lazy, mode, exists, parameter, outcome
+):
+    path = tmp_path / "output"
+    if exists:
+        path.write_bytes(b"original")
+    error = RuntimeError("callback failed")
+    opened = []
+    file_type = click.File(mode, atomic=True, lazy=lazy)
+    decorator = (
+        click.argument("output", type=file_type)
+        if parameter == "argument"
+        else click.option("--output", type=file_type)
+    )
+
+    @click.command()
+    @decorator
+    @click.pass_context
+    def cli(ctx, output):
+        opened.append(output)
+        output.write(b"replacement" if "b" in mode else "replacement")
+        output.flush()
+        assert_destination(path, exists)
+        if outcome == "error":
+            raise error
+        if outcome == "exit_zero":
+            ctx.exit(0)
+        if outcome == "exit_nonzero":
+            ctx.exit(3)
+
+    args = [str(path)] if parameter == "argument" else ["--output", str(path)]
+    result = runner.invoke(cli, args)
+    if outcome in {"return", "exit_zero"}:
+        assert result.exit_code == 0
+        assert result.exception is None
+        assert path.read_bytes() == b"replacement"
+    else:
+        assert result.exit_code == (3 if outcome == "exit_nonzero" else 1)
+        if outcome == "error":
+            assert result.exception is error
+        assert_destination(path, exists)
+    assert opened[0].closed
+    opened[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    assert click.get_current_context(silent=True) is None
+
