+from contextlib import contextmanager
+
+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+@pytest.mark.parametrize(
+    "error", [None, RuntimeError("callback failed"), Exit(0), Exit(2)]
+)
+def test_context_resource_receives_exception_at_outermost_exit(error):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    seen = []
+
+    class Resource:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, exc_type, exc_value, tb):
+            assert click.get_current_context() is ctx
+            seen.append((exc_type, exc_value, tb))
+
+    def run():
+        with ctx:
+            resource = ctx.with_resource(Resource())
+            assert isinstance(resource, Resource)
+            with ctx:
+                with ctx.scope(cleanup=False):
+                    assert seen == []
+                assert seen == []
+                if error is not None:
+                    raise error
+            assert seen == []
+
+    with outer:
+        if error is None:
+            run()
+        else:
+            with pytest.raises(type(error)) as caught:
+                run()
+            assert caught.value is error
+        assert click.get_current_context() is outer
+
+    assert click.get_current_context(silent=True) is None
+    assert ctx._depth == 0
+    assert len(seen) == 1
+    assert seen[0][0] is (type(error) if error is not None else None)
+    assert seen[0][1] is error
+    if error is not None:
+        assert seen[0][2] is not None
+    ctx.close()
+    assert len(seen) == 1
+
+
+def test_generator_resource_receives_callback_exception(runner):
+    error = RuntimeError("callback failed")
+    caught = []
+
+    @contextmanager
+    def resource():
+        try:
+            yield "resource"
+        except RuntimeError as exc:
+            caught.append(exc)
+            raise
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        assert ctx.with_resource(resource()) == "resource"
+        raise error
+
+    result = runner.invoke(cli)
+    assert result.exception is error
+    assert caught == [error]
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("cleanup_kind", ["resource", "callback"])
+def test_cleanup_failure_restores_context_stack_and_resets_resources(cleanup_kind):
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    error = FileNotFoundError("cleanup failed")
+    seen = []
+
+    def cleanup():
+        assert click.get_current_context() is ctx
+        seen.append("cleanup")
+        raise error
+
+    @contextmanager
+    def resource():
+        yield
+        cleanup()
+
+    with outer:
+        with pytest.raises(FileNotFoundError) as caught:
+            with ctx:
+                if cleanup_kind == "resource":
+                    ctx.with_resource(resource())
+                else:
+                    ctx.call_on_close(cleanup)
+        assert caught.value is error
+        assert click.get_current_context() is outer
+        assert ctx._depth == 0
+
+        with ctx:
+            ctx.call_on_close(lambda: seen.append("reused"))
+        assert click.get_current_context() is outer
+
+    assert seen == ["cleanup", "reused"]
+    assert click.get_current_context(silent=True) is None
