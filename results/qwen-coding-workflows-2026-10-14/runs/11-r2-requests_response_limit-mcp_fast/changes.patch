+@pytest.mark.parametrize("path", ["/gzip", "/deflate"])
+@pytest.mark.parametrize("stream", [False, True])
+def test_budget_counts_decompressed_bytes(response_server, path, stream):
+    url = response_server.url + path
+    with pytest.raises(ResponseTooLarge) as caught:
+        response = requests.get(url, max_response_bytes=32, stream=stream, timeout=2)
+        response.content
+    assert int(caught.value.response.headers["Content-Length"]) < 32
+    assert caught.value.received == 64
+    assert caught.value.response.raw.closed
+    with requests.get(url, max_response_bytes=64, stream=stream, timeout=2) as response:
+        assert response.content == b"a" * 64
