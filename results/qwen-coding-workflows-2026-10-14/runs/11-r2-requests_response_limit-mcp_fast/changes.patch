+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("replace", [False, True])
+@pytest.mark.parametrize("limit", [5, 6])
+def test_hooks_returning_cached_content(stream, replace, limit):
+    session, original, _ = make_session(limit=limit)
+    replacement = requests.Response() if replace else original
+    replacement.status_code = 200
+    replacement.raw = RecordingRaw(b"")
+    observed = []
+
+    def cache(response, **kwargs):
+        replacement._content = b"abcdef"
+        replacement._content_consumed = True
+        return replacement if replace else None
+
+    def read_cache(response, **kwargs):
+        observed.append(response.content)
+
+    with session:
+
+        def send():
+            return session.get(
+                original.url, stream=stream, hooks={"response": [cache, read_cache]}
+            )
+
+        if limit == 5:
+            with pytest.raises(ResponseTooLarge) as caught:
+                send()
+            assert caught.value.received == 6
+            assert caught.value.response is replacement
+            assert caught.value.request is original.request
+            assert replacement.raw.release_calls == 1
+            assert observed == []
+        else:
+            assert send().content == b"abcdef"
+            assert observed == [b"abcdef"]
+            assert list(replacement.iter_content(2)) == [b"ab", b"cd", b"ef"]
+
