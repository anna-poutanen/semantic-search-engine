+@pytest.mark.parametrize("decode_unicode", [False, True])
+def test_streaming_decompression_withholds_crossing_chunk(
+    response_server, path, decode_unicode
+):
+    with requests.get(
+        response_server.url + path, max_response_bytes=32, stream=True, timeout=2
+    ) as response:
+        chunks = response.iter_content(7, decode_unicode=decode_unicode)
+        expected = "a" * 7 if decode_unicode else b"a" * 7
+        assert [next(chunks) for _ in range(4)] == [expected] * 4
+        with pytest.raises(ResponseTooLarge) as caught:
+            next(chunks)
+        assert caught.value.received == 35
+        with pytest.raises(ResponseTooLarge) as repeated:
+            next(chunks)
+        assert repeated.value is caught.value
