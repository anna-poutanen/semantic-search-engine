+@pytest.mark.parametrize("owner", ["module", "session"])
+@pytest.mark.parametrize(
+    "method", ["get", "options", "post", "put", "patch", "delete", "head"]
+)
+def test_method_helpers_accept_budget(response_server, owner, method):
+    with requests.Session() as session:
+        session.trust_env = False
+        helper = getattr(requests if owner == "module" else session, method)
+        url = response_server.url + "/body"
+        if method == "head":
+            # A nonzero Content-Length does not make a HEAD body nonempty.
+            assert helper(url, max_response_bytes=0, timeout=2).content == b""
+        else:
+            with pytest.raises(ResponseTooLarge) as caught:
+                helper(url, max_response_bytes=5, timeout=2)
+            assert caught.value.received == 6
+            assert caught.value.response.raw.closed
