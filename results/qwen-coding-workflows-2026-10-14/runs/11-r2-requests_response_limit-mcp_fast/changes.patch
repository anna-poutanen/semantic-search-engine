new file mode 100644
index 0000000..a49703f
--- /dev/null
+++ b/tests/test_response_limit.py
@@ -0,0 +1,562 @@
+"""Regression tests for decoded, response-wide byte budgets."""
+
+import gzip
+import io
+import pickle
+import threading
+import zlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from types import SimpleNamespace
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter, HTTPAdapter
+from requests.exceptions import RequestException, ResponseTooLarge
+
+
+class RecordingRaw(io.BytesIO):
+    def __init__(self, body, close_error=None):
+        super().__init__(body)
+        self.read_calls = 0
+        self.close_calls = 0
+        self.release_calls = 0
+        self.close_error = close_error
+
+    def read(self, size=-1):
+        self.read_calls += 1
+        return super().read(size)
+
+    def close(self):
+        self.close_calls += 1
+        if self.close_error is not None:
+            raise self.close_error
+        super().close()
+
+    def release_conn(self):
+        self.release_calls += 1
+
+
+class StreamingRaw(RecordingRaw):
+    def stream(self, amt, decode_content):
+        assert decode_content is True
+        while True:
+            chunk = self.read(amt)
+            if not chunk:
+                return
+            yield chunk
+
+
+class StaticAdapter(BaseAdapter):
+    def __init__(self, response):
+        self.response = response
+        self.calls = []
+
+    # An explicit transport signature catches any leaked budget keyword.
+    def send(
+        self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None
+    ):
+        self.calls.append(request)
+        self.response.request = request
+        return self.response
+
+    def close(self):
+        pass
+
+
+def make_session(raw=None, limit=None):
+    response = requests.Response()
+    response.status_code = 200
+    response.url = "http://127.0.0.1/body"
+    response.raw = raw if raw is not None else RecordingRaw(b"abcdef")
+    adapter = StaticAdapter(response)
+    session = requests.Session(max_response_bytes=limit)
+    session.trust_env = False
+    session.mount("http://", adapter)
+    return session, response, adapter
+
+
+@pytest.fixture(scope="module")
+def response_server():
+    paths = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def respond(self):
+            paths.append(self.path)
+            body = b"abcdef"
+            status = 200
+            headers = {"Content-Type": "text/plain; charset=utf-8"}
+            if self.path == "/empty":
+                body = b""
+            elif self.path == "/utf8":
+                body = "é🐍".encode()
+            elif self.path in (
+                "/gzip",
+                "/gzip-empty",
+                "/deflate",
+                "/compressed-redirect",
+            ):
+                body = b"" if self.path == "/gzip-empty" else b"a" * 64
+                encoding = "deflate" if self.path == "/deflate" else "gzip"
+                body = (
+                    zlib.compress(body)
+                    if encoding == "deflate"
+                    else gzip.compress(body)
+                )
+                headers["Content-Encoding"] = encoding
+            if self.path in (
+                "/redirect",
+                "/large-redirect",
+                "/redirect-chain",
+                "/compressed-redirect",
+            ):
+                status = 302
+                headers["Location"] = (
+                    "/redirect" if self.path == "/redirect-chain" else "/body"
+                )
+                if self.path != "/compressed-redirect":
+                    body = b"abcdefg" if self.path == "/large-redirect" else b"abcd"
+            if self.path == "/chunked":
+                headers["Transfer-Encoding"] = "chunked"
+            else:
+                headers["Content-Length"] = str(len(body))
+            self.send_response(status)
+            for name, value in headers.items():
+                self.send_header(name, value)
+            self.end_headers()
+            if self.command != "HEAD":
+                if self.path == "/chunked":
+                    self.wfile.write(b"2\r\nab\r\n4\r\ncdef\r\n0\r\n\r\n")
+                else:
+                    self.wfile.write(body)
+
+        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = do_HEAD = (
+            respond
+        )
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(
+        target=server.serve_forever, kwargs={"poll_interval": 0.01}
+    )
+    thread.start()
+    try:
+        yield SimpleNamespace(url=f"http://127.0.0.1:{server.server_port}", paths=paths)
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=5)
+
+
+def test_exception_is_public_and_has_request_context():
+    assert requests.ResponseTooLarge is ResponseTooLarge
+    assert issubclass(ResponseTooLarge, RequestException)
+    session, response, adapter = make_session(limit=5)
+    with session, pytest.raises(ResponseTooLarge) as caught:
+        session.get(response.url)
+    assert caught.value.limit == 5
+    assert caught.value.received == 6
+    assert caught.value.response is response
+    assert caught.value.request is adapter.calls[0]
+    assert response.raw.closed
+
+
+@pytest.mark.parametrize("value", [None, 0, 6])
+def test_session_setting_and_pickling(value):
+    with requests.Session(max_response_bytes=value) as session:
+        assert session.max_response_bytes == value
+        with pickle.loads(pickle.dumps(session)) as restored:
+            assert restored.max_response_bytes == value
+    assert requests.Session().max_response_bytes is None
+
+
+@pytest.mark.parametrize("value", [-1, True, False, 1.0, 1.5, "6", b"6", {}, object()])
+@pytest.mark.parametrize(
+    "entry", ["constructor", "request", "send", "setting", "helper"]
+)
+def test_invalid_limits_fail_before_transport(monkeypatch, value, entry):
+    calls = []
+
+    def transport(*args, **kwargs):
+        calls.append((args, kwargs))
+        raise AssertionError("Invalid budgets must not reach the transport")
+
+    monkeypatch.setattr(HTTPAdapter, "send", transport)
+    with pytest.raises(ValueError, match="max_response_bytes"):
+        if entry == "constructor":
+            requests.Session(max_response_bytes=value)
+        elif entry == "helper":
+            requests.get("http://127.0.0.1/", max_response_bytes=value)
+        else:
+            with requests.Session() as session:
+                session.trust_env = False
+                if entry == "setting":
+                    session.max_response_bytes = value
+                    session.get("http://127.0.0.1/")
+                elif entry == "request":
+                    session.request(
+                        "GET", "http://127.0.0.1/", max_response_bytes=value
+                    )
+                else:
+                    prepared = requests.Request("GET", "http://127.0.0.1/").prepare()
+                    session.send(prepared, max_response_bytes=value)
+    assert calls == []
+
+
+@pytest.mark.parametrize("entry", ["request", "send"])
+@pytest.mark.parametrize("override", ["omitted", None, 0, 6, 10])
+def test_per_request_inheritance_and_overrides(entry, override):
+    session, response, adapter = make_session(limit=3)
+    kwargs = {} if override == "omitted" else {"max_response_bytes": override}
+    if entry == "send":
+        prepared = requests.Request("GET", response.url).prepare()
+
+        def send():
+            return session.send(prepared, **kwargs)
+
+    else:
+
+        def send():
+            return session.request("GET", response.url, **kwargs)
+
+    with session:
+        if override in ("omitted", 0):
+            with pytest.raises(ResponseTooLarge) as caught:
+                send()
+            assert caught.value.limit == (3 if override == "omitted" else 0)
+        else:
+            assert send().content == b"abcdef"
+    assert len(adapter.calls) == 1
+    assert session.max_response_bytes == 3
+
+
+@pytest.mark.parametrize("raw_type", [RecordingRaw, StreamingRaw])
+@pytest.mark.parametrize("cleanup_fails", [False, True])
+def test_response_wide_total_and_sticky_failure(raw_type, cleanup_fails):
+    cleanup_error = OSError("close failed") if cleanup_fails else None
+    raw = raw_type(b"abcdefgh", close_error=cleanup_error)
+    session, response, _ = make_session(raw, limit=5)
+    with session:
+        response = session.get(response.url, stream=True)
+        old_iterator = response.iter_content(2)
+        other_iterator = response.iter_content(2)
+        assert next(old_iterator) == b"ab"
+        assert next(other_iterator) == b"cd"
+        with pytest.raises(ResponseTooLarge) as caught:
+            next(other_iterator)
+        assert caught.value.received == 6
+        assert raw.close_calls == 1
+        if cleanup_fails:
+            assert caught.value.__cause__ is cleanup_error
+        else:
+            assert raw.closed
+            assert raw.release_calls == 1
+        read_calls = raw.read_calls
+        readers = [
+            lambda: next(old_iterator),
+            lambda: next(other_iterator),
+            lambda: response.content,
+            lambda: response.text,
+            lambda: response.json(),
+            lambda: response.apparent_encoding,
+            lambda: response.iter_content(2),
+            lambda: next(response.iter_lines()),
+        ]
+        for read in readers:
+            with pytest.raises(ResponseTooLarge) as repeated:
+                read()
+            assert repeated.value is caught.value
+            assert raw.read_calls == read_calls
+            assert raw.close_calls == 1
+            assert repeated.value.received == 6
+
