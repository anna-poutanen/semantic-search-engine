+
+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize("fail", [False, True])
+def test_direct_atomic_transaction(tmp_path, lazy, mode, existing, fail):
+    destination = tmp_path / "output"
+    if existing:
+        destination.write_bytes(b"original")
+        destination.chmod(0o640)
+    error = RuntimeError("body failed")
+    stream = click.open_file(destination, mode, lazy=lazy, atomic=True)
+
+    def write():
+        with stream:
+            stream.write(b"replacement" if "b" in mode else "replacement")
+            stream.flush()
+            if existing:
+                assert destination.read_bytes() == b"original"
+            else:
+                assert not destination.exists()
+            if fail:
+                raise error
+
+    if fail:
+        with pytest.raises(RuntimeError) as caught:
+            write()
+        assert caught.value is error
+    else:
+        write()
+
+    assert stream.closed
+    with pytest.raises(ValueError):
+        stream.fileno()
+    stream.close()
+    stream.close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
+    if fail and not existing:
+        assert not destination.exists()
+    else:
+        assert destination.read_bytes() == (b"original" if fail else b"replacement")
+        if existing and os.name != "nt":
+            assert stat.S_IMODE(destination.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize("lazy", [False, True, None])
+@pytest.mark.parametrize("mode", ["w", "wb"])
+@pytest.mark.parametrize("existing", [False, True])
+@pytest.mark.parametrize(
+    "outcome",
+    ["return", "exit-zero", "exit-error", "system-zero", "system-error", "error"],
+)
+def test_command_atomic_transaction(runner, tmp_path, lazy, mode, existing, outcome):
+    destination = tmp_path / "output"
+    if existing:
+        destination.write_bytes(b"original")
+        destination.chmod(0o640)
+    error = RuntimeError("callback failed")
+    streams = []
+
+    @click.command()
+    @click.argument("output", type=click.File(mode, lazy=lazy, atomic=True))
+    @click.pass_context
+    def cli(ctx, output):
+        streams.append(output)
+        output.write(b"replacement" if "b" in mode else "replacement")
+        output.flush()
+        if existing:
+            assert destination.read_bytes() == b"original"
+        else:
+            assert not destination.exists()
+        if outcome.startswith("exit"):
+            ctx.exit(0 if outcome == "exit-zero" else 7)
+        if outcome.startswith("system"):
+            raise SystemExit(0 if outcome == "system-zero" else 7)
+        if outcome == "error":
+            raise error
+
+    result = runner.invoke(cli, [str(destination)])
+    success = outcome in {"return", "exit-zero", "system-zero"}
+    assert result.exit_code == (0 if success else 1 if outcome == "error" else 7)
+    if outcome == "error":
+        assert result.exception is error
+    assert click.get_current_context(silent=True) is None
+    assert streams[0].closed
+    with pytest.raises(ValueError):
+        streams[0].fileno()
+    streams[0].close()
+    assert not list(tmp_path.glob(".__atomic-write*"))
