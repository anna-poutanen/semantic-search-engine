+def _add_exception_note(exc: BaseException, cleanup_error: BaseException) -> None:
+    """Report a cleanup failure without replacing the original exception."""
+    if hasattr(exc, "add_note"):
+        exc.add_note(f"Error during cleanup: {cleanup_error!r}")
