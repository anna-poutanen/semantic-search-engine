@@ -0,0 +1,129 @@
+import pytest
+
+import click
+from click.exceptions import Exit
+
+
+class RecordingResource:
+    def __init__(self, events, error=None):
+        self.events = events
+        self.error = error
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, tb):
+        if exc_value is not None:
+            assert tb is exc_value.__traceback__
+        self.events.append((click.get_current_context(), exc_type, exc_value, tb))
+        if self.error is not None:
+            raise self.error
+
+
+@pytest.mark.parametrize("error", [None, RuntimeError("callback"), Exit(7)])
+def test_nested_context_passes_exception_and_restores_stack(error):
+    events = []
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    before = click.get_current_context(silent=True)
+
+    def run():
+        with ctx:
+            resource = ctx.with_resource(RecordingResource(events))
+            assert isinstance(resource, RecordingResource)
+            try:
+                with ctx:
+                    if error is not None:
+                        raise error
+            finally:
+                assert not events
+                assert click.get_current_context() is ctx
+
+    with outer:
+        if error is None:
+            run()
+        else:
+            with pytest.raises(type(error)) as caught:
+                run()
+            assert caught.value is error
+        assert click.get_current_context() is outer
+
+    assert click.get_current_context(silent=True) is before
+    assert len(events) == 1
+    current, exc_type, exc_value, tb = events[0]
+    assert current is ctx
+    assert exc_type is (None if error is None else type(error))
+    assert exc_value is error
+    assert (tb is None) == (error is None)
+
+
+@pytest.mark.parametrize("primary", [None, RuntimeError("callback")])
+def test_context_cleanup_failure_restores_stack_and_can_be_reused(primary):
+    events = []
+    cleanup_error = OSError("cleanup failed")
+    outer = click.Context(click.Command("outer"))
+    ctx = click.Context(click.Command("inner"), parent=outer)
+    before = click.get_current_context(silent=True)
+    with outer:
+        with pytest.raises(type(primary or cleanup_error)) as caught:
+            with ctx:
+                ctx.with_resource(RecordingResource(events, cleanup_error))
+                if primary is not None:
+                    raise primary
+        assert caught.value is (primary or cleanup_error)
+        assert click.get_current_context() is outer
+        with ctx:
+            ctx.with_resource(RecordingResource(events))
+        assert click.get_current_context() is outer
+
+    assert click.get_current_context(silent=True) is before
+    assert len(events) == 2
+    assert events[0][2] is primary
+    assert events[1][2] is None
+    if primary is not None:
+        assert any(
+            "cleanup failed" in note for note in getattr(primary, "__notes__", ())
+        ) or (
+            primary.__context__ is cleanup_error or primary.__cause__ is cleanup_error
+        )
+
+
+@pytest.mark.parametrize("exit_error", [Exit(0), SystemExit(0), SystemExit(None)])
+def test_successful_command_exit_does_not_hide_cleanup_failure(runner, exit_error):
+    cleanup_error = FileNotFoundError("commit failed")
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(RecordingResource([], cleanup_error))
+        raise exit_error
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 1
+    assert result.exception is cleanup_error
+    assert click.get_current_context(silent=True) is None
+
+
+def test_cleanup_failure_is_chained_without_exception_notes():
+    class ErrorWithoutNotes(RuntimeError):
+        def __getattribute__(self, name):
+            if name == "add_note":
+                raise AttributeError(name)
+            return super().__getattribute__(name)
+
