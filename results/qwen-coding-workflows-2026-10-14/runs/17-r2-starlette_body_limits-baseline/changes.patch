+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import Response
+from starlette.routing import Route
+from starlette.types import Message
+from tests.types import TestClientFactory
+
+pytestmark = pytest.mark.anyio
+
+
+def request_from_messages(messages: list[Message]) -> Request:
+    async def receive() -> Message:
+        assert messages, "Unexpected receive call"
+        return messages.pop(0)
+
+    return Request({"type": "http"}, receive)
+
+
+def body_messages(chunks: list[bytes]) -> list[Message]:
+    return [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+
+
+@pytest.mark.parametrize(
+    ("max_bytes", "chunks"),
+    [
+        (None, [b"ab", b"cd"]),
+        (0, [b""]),
+        (0, [b"", b""]),
+        (3, [b"abc"]),
+        (3, [b"a", b"", b"bc"]),
+        (4, [b"a", b"bc"]),
+        (2, ["é".encode()]),
+    ],
+)
+async def test_body_limit_accepts_and_caches(max_bytes: int | None, chunks: list[bytes]) -> None:
+    messages = body_messages(chunks)
+    request = request_from_messages(messages)
+    body = await request.body(max_bytes=max_bytes)
+    assert body == b"".join(chunks)
+    assert await request.body() is body
+    assert await request.body(None) is body
+    assert await request.body(len(body)) is body
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+    assert messages == []
+
+
+@pytest.mark.parametrize("cached", [False, True])
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, float("inf"), "1", b"1", [], {}, object()])
+async def test_body_limit_validation_precedes_receive(max_bytes: Any, cached: bool) -> None:
+    messages = body_messages([b"abc"])
+    request = request_from_messages(messages)
+    if cached:
+        assert await request.body() == b"abc"
+    expected_messages = messages.copy()
+    with pytest.raises(ValueError, match="max_bytes"):
+        await request.body(max_bytes=max_bytes)
+    assert messages == expected_messages
+    assert await request.body(max_bytes=3) == b"abc"
+
+
+@pytest.mark.parametrize(
+    ("max_bytes", "chunks", "received", "unread"),
+    [
+        (0, [b"x", b"later"], 1, [b"later"]),
+        (3, [b"ab", b"", b"cd", b"later"], 4, [b"later"]),
+        (3, [b"ab", b"cdef", b"later"], 6, [b"later"]),
+        (3, [b"abcd"], 4, []),
+        (1, ["é".encode()], 2, []),
+    ],
+)
+async def test_body_limit_stops_at_first_crossing(
+    max_bytes: int, chunks: list[bytes], received: int, unread: list[bytes]
+) -> None:
+    messages = body_messages(chunks)
+    request = request_from_messages(messages)
+    with pytest.raises(RequestBodyTooLarge) as exc:
+        await request.body(max_bytes=max_bytes)
+    assert isinstance(exc.value, HTTPException)
+    assert exc.value.status_code == 413
+    assert exc.value.detail == "Request body too large"
+    assert exc.value.limit == max_bytes
+    assert exc.value.received == received
+    assert [message["body"] for message in messages] == unread
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_cached_body_and_json_preserved_after_stricter_limit(json_first: bool) -> None:
+    content = b'{"a":1}'
+    messages = body_messages([content[:3], content[3:]])
+    request = request_from_messages(messages)
+    if json_first:
+        assert await request.json() == {"a": 1}
+    body = await request.body(max_bytes=len(content))
+    data = await request.json()
+    with pytest.raises(RequestBodyTooLarge) as exc:
+        await request.body(max_bytes=len(content) - 1)
+    assert exc.value.limit == len(content) - 1
+    assert exc.value.received == len(content)
+    assert await request.body() is body
+    assert await request.json() is data
+    assert messages == []
+
+
+@pytest.mark.parametrize("max_bytes", [None, 0, 3])
+async def test_body_limit_preserves_disconnect(max_bytes: int | None) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"", "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+    request = request_from_messages(messages)
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+    assert not hasattr(request, "_body")
+    assert await request.is_disconnected()
+
+
+async def test_body_limit_preserves_disconnect_after_partial_body() -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"ab", "more_body": True},
+        {"type": "http.disconnect"},
+    ]
+    request = request_from_messages(messages)
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=3)
+    assert not hasattr(request, "_body")
+
+
+async def test_body_limit_accepts_missing_body() -> None:
+    request = request_from_messages([{"type": "http.request"}])
+    assert await request.body(max_bytes=0) == b""
+
+
+def test_body_limit_http_exception_response(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        return Response(await request.body(max_bytes=3))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"abcd")
+        assert response.status_code == 413
+        assert response.text == "Request body too large"
+        response = client.post("/", content=b"abc")
+        assert response.status_code == 200
+        assert response.content == b"abc"
