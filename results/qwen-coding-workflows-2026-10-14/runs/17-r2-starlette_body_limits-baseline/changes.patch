+@pytest.mark.parametrize("max_bytes", [None, 7])
+def test_body_limit_json_and_body_cache_http_integration(
+    test_client_factory: TestClientFactory, max_bytes: int | None
+) -> None:
+    async def endpoint(request: Request) -> JSONResponse:
+        body = await request.body()
+        assert await request.body(max_bytes=7) is body
+        data = await request.json()
+        assert await request.json() is data
+        return JSONResponse({"body": body.decode(), "data": data})
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    with test_client_factory(app) as client:
+        for content, data in [(b'{"a":1}', {"a": 1}), (b'{"b":2}', {"b": 2})]:
+            response = client.post("/", content=content)
+            assert response.status_code == 200
+            assert response.json() == {"body": content.decode(), "data": data}
+
+
+def test_body_limit_rejection_http_integration(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        return PlainTextResponse("accepted")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=3)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"abcd", headers={"content-length": "0"})
+        assert response.status_code == 413
+        assert response.content == b"Request body too large"
+        assert client.post("/", content=b"abc").text == "accepted"
+
+
+@pytest.mark.parametrize("failure", [RuntimeError("endpoint failed"), RequestBodyTooLarge(limit=1, received=2)])
+def test_body_limit_preserves_endpoint_failures(test_client_factory: TestClientFactory, failure: Exception) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        assert await Request(scope, receive).body() == b"abc"
+        raise failure
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=3)
+    client = test_client_factory(middleware)
+    with pytest.raises(type(failure)) as exc:
+        client.post("/", content=b"abc")
+    assert exc.value is failure
