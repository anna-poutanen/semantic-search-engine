+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import RequestBodyTooLarge
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+pytestmark = pytest.mark.anyio
+
+
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, float("inf"), "1", b"1", [], {}, object()])
+def test_body_limit_validated_at_construction(max_bytes: Any) -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Downstream app called during validation")
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        RequestBodyLimitMiddleware(app, max_bytes=max_bytes)
+
+
+@pytest.mark.parametrize("headers", [[], [(b"content-length", b"0")], [(b"content-length", b"999")]])
+@pytest.mark.parametrize("max_bytes", [0, 3])
+async def test_body_limit_rejects_observed_bytes_without_reading_later_chunks(
+    headers: list[tuple[bytes, bytes]], max_bytes: int
+) -> None:
+    messages: list[Message] = [
+        {"type": "http.request", "body": b"ab", "more_body": True},
+        {"type": "http.request", "body": b"cdef", "more_body": True},
+        {"type": "http.request", "body": b"later"},
+    ]
+    sent: list[Message] = []
+
+    async def receive() -> Message:
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        pytest.fail("Oversize input reached downstream app")
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=max_bytes)
+    await middleware({"type": "http", "headers": headers}, receive, send)
+    assert sent[0]["type"] == "http.response.start"
+    assert sent[0]["status"] == 413
+    assert (b"content-type", b"text/plain; charset=utf-8") in sent[0]["headers"]
+    assert sent[1] == {"type": "http.response.body", "body": b"Request body too large"}
+    assert len(sent) == 2
+    assert [message["body"] for message in messages] == ([b"cdef", b"later"] if max_bytes == 0 else [b"later"])
+
+
+@pytest.mark.parametrize("chunks", [[b"abc"], [b"a", b"", b"bc"], [b"", b""]])
+async def test_body_limit_buffers_before_app_and_replays_bytes_then_disconnect(chunks: list[bytes]) -> None:
+    body = b"".join(chunks)
+    messages: list[Message] = [
+        {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+        for index, chunk in enumerate(chunks)
+    ]
+    disconnect = {"type": "http.disconnect"}
+    messages.append(disconnect)
+
+    async def receive() -> Message:
+        assert messages, "Unexpected receive call"
+        return messages.pop(0)
+
+    async def send(message: Message) -> None:
+        pytest.fail("Unexpected response")
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        assert messages == [disconnect]
+        assert await receive() == {"type": "http.request", "body": body, "more_body": False}
+        assert messages == [disconnect]
+        assert await receive() is disconnect
+
+    middleware = RequestBodyLimitMiddleware(app, max_bytes=len(body))
+    await middleware({"type": "http", "headers": [(b"content-length", b"999")]}, receive, send)
+    assert messages == []
+
+
