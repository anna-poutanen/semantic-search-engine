+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.middleware import Middleware
+from starlette.middleware.body_limit import RequestBodyLimitMiddleware
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import JSONResponse, PlainTextResponse
+from starlette.routing import Route
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, 0.0, "1", b"1", [], {}, object(), float("inf")])
+def test_middleware_invalid_limit_at_construction(max_bytes: Any) -> None:
+    with pytest.raises(ValueError, match="max_bytes"):
+        RequestBodyLimitMiddleware(AsyncMock(), max_bytes=max_bytes)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("content_length", [None, b"0", b"1", b"1000000", b"invalid"])
+@pytest.mark.parametrize(
+    "chunks,max_bytes,reads",
+    [([b"ab", b"cde", b"unread"], 4, 2), ([b"abc", b"unread"], 0, 1), ([b"abc"], 2, 1)],
+)
+async def test_middleware_rejects_before_app_and_stops_receiving(
+    content_length: bytes | None, chunks: list[bytes], max_bytes: int, reads: int
+) -> None:
+    scope: Scope = {"type": "http", "headers": []}
+    if content_length is not None:
+        scope["headers"].append((b"content-length", content_length))
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+    app = AsyncMock()
+    send = AsyncMock()
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+
+    app.assert_not_awaited()
+    assert receive.await_count == reads
+    start, body = [call.args[0] for call in send.await_args_list]
+    assert start["type"] == "http.response.start"
+    assert start["status"] == 413
+    assert (b"content-type", b"text/plain; charset=utf-8") in start["headers"]
+    assert body == {"type": "http.response.body", "body": b"Request body too large"}
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "messages,max_bytes,expected",
+    [
+        ([{"type": "http.request"}], 0, b""),
+        (
+            [
+                {"type": "http.request", "body": b"", "more_body": True},
+                {"type": "http.request", "body": b""},
+            ],
+            0,
+            b"",
+        ),
+        (
+            [
+                {"type": "http.request", "body": b"ab", "more_body": True},
+                {"type": "http.request", "more_body": True},
+                {"type": "http.request", "body": "é".encode()},
+            ],
+            4,
+            b"ab" + "é".encode(),
+        ),
+    ],
+)
+async def test_middleware_replays_body_then_original_disconnect(
+    messages: list[Message], max_bytes: int, expected: bytes
+) -> None:
+    disconnect: Message = {"type": "http.disconnect"}
+    receive = AsyncMock(side_effect=[*messages, disconnect])
+    scope: Scope = {"type": "http", "headers": [(b"content-length", b"999999")]}
+    send = AsyncMock()
+    called = False
+
+    async def app(app_scope: Scope, app_receive: Receive, app_send: Send) -> None:
+        nonlocal called
+        called = True
+        assert app_scope is scope
+        assert app_send is send
+        assert receive.await_count == len(messages)
+        replay = await app_receive()
+        assert replay == {"type": "http.request", "body": expected, "more_body": False}
+        assert receive.await_count == len(messages)
+        assert await app_receive() is disconnect
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+    assert called
+    assert receive.await_count == len(messages) + 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("scope_type,max_bytes", [("http", None), ("websocket", 0), ("lifespan", 0)])
+async def test_middleware_passes_through_without_buffering(scope_type: str, max_bytes: int | None) -> None:
+    scope: Scope = {"type": scope_type}
+    receive = AsyncMock()
+    send = AsyncMock()
+    app = AsyncMock()
+
+    await RequestBodyLimitMiddleware(app, max_bytes=max_bytes)(scope, receive, send)
+
+    app.assert_awaited_once_with(scope, receive, send)
+    receive.assert_not_awaited()
+    send.assert_not_awaited()
+
+
+@pytest.mark.anyio
+async def test_middleware_preserves_disconnect_while_buffering() -> None:
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": b"ab", "more_body": True},
+            {"type": "http.disconnect"},
+        ]
+    )
+    app = AsyncMock()
+    send = AsyncMock()
+    with pytest.raises(ClientDisconnect):
+        await RequestBodyLimitMiddleware(app, max_bytes=2)({"type": "http"}, receive, send)
+    app.assert_not_awaited()
+    send.assert_not_awaited()
+    assert receive.await_count == 2
+
+
+def test_middleware_body_json_and_cached_reads(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> JSONResponse:
+        body = await request.body()
+        assert await request.body(max_bytes=len(body)) is body
+        data = await request.json()
+        assert await request.json() is data
+        assert await request.body() is body
+        return JSONResponse(data)
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=11)],
+    )
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b'{"ok":true}')
+        assert response.status_code == 200
+        assert response.json() == {"ok": True}
+        response = client.post("/", content=b'{"too":"large"}')
+        assert response.status_code == 413
+        assert response.text == "Request body too large"
+        # Buffer and replay state must be local to each request.
+        assert client.post("/", content=b'{"ok":true}').json() == {"ok": True}
+
+
+@pytest.mark.parametrize("max_bytes", [None, 0, 3])
+@pytest.mark.parametrize("read_body", [False, True])
+def test_middleware_preserves_endpoint_failures(
+    test_client_factory: TestClientFactory, max_bytes: int | None, read_body: bool
+) -> None:
+    async def endpoint(request: Request) -> PlainTextResponse:
+        if read_body:
+            await request.body()
+        raise RuntimeError("endpoint failed")
+
+    app = Starlette(
+        routes=[Route("/", endpoint, methods=["POST"])],
+        middleware=[Middleware(RequestBodyLimitMiddleware, max_bytes=max_bytes)],
+    )
+    with test_client_factory(app) as client:
+        with pytest.raises(RuntimeError, match="endpoint failed"):
+            client.post("/", content=b"")
+
+    with test_client_factory(app, raise_server_exceptions=False) as client:
+        response = client.post("/", content=b"")
+    assert response.status_code == 500
+    assert response.text == "Internal Server Error"
