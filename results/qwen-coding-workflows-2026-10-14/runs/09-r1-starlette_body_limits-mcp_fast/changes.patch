@@ -0,0 +1,149 @@
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+
+from starlette.applications import Starlette
+from starlette.exceptions import HTTPException, RequestBodyTooLarge
+from starlette.requests import ClientDisconnect, Request
+from starlette.responses import Response
+from starlette.routing import Route
+from tests.types import TestClientFactory
+
+
+def test_request_body_too_large_exception() -> None:
+    exc = RequestBodyTooLarge(limit=4, received=7)
+    assert isinstance(exc, HTTPException)
+    assert exc.status_code == 413
+    assert exc.detail == "Request body too large"
+    assert exc.limit == 4
+    assert exc.received == 7
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [-1, True, False, 1.0, 0.0, "1", b"1", [], {}, object(), float("inf")])
+@pytest.mark.parametrize("cached", [False, True])
+async def test_body_invalid_limit_does_not_receive(max_bytes: Any, cached: bool) -> None:
+    receive = AsyncMock(return_value={"type": "http.request", "body": b"abc"})
+    request = Request({"type": "http"}, receive)
+    if cached:
+        assert await request.body() == b"abc"
+        receive.reset_mock()
+
+    with pytest.raises(ValueError, match="max_bytes"):
+        await request.body(max_bytes=max_bytes)
+    receive.assert_not_awaited()
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,max_bytes",
+    [
+        ([b"ab", b"", b"c"], 3),
+        ([b"", b""], 0),
+        ([b""], 0),
+        (["é".encode(), b"!"], 3),
+        ([b"abc", b"def"], None),
+        ([b"abc", b"def"], 100),
+        ([b"abc"], 10**100),
+    ],
+)
+async def test_body_accepts_limit_and_caches(chunks: list[bytes], max_bytes: int | None) -> None:
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+    request = Request({"type": "http", "headers": [(b"content-length", b"999999")]}, receive)
+
+    body = await request.body(max_bytes=max_bytes)
+    assert body == b"".join(chunks)
+    assert await request.body() is body
+    assert await request.body(max_bytes=len(body)) is body
+    assert b"".join([chunk async for chunk in request.stream()]) == body
+    assert receive.await_count == len(chunks)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "chunks,max_bytes,received,reads",
+    [
+        ([b"ab", b"cde", b"unread"], 4, 5, 2),
+        ([b"", b"ab", b"cde", b"unread"], 4, 5, 3),
+        ([b"abc", b"unread"], 0, 3, 1),
+        ([b"ab", "é".encode(), b"unread"], 3, 4, 2),
+        ([b"abc"], 2, 3, 1),
+    ],
+)
+async def test_body_rejects_first_crossing_without_partial_cache(
+    chunks: list[bytes], max_bytes: int, received: int, reads: int
+) -> None:
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": chunk, "more_body": index < len(chunks) - 1}
+            for index, chunk in enumerate(chunks)
+        ]
+    )
+    request = Request({"type": "http", "headers": [(b"content-length", b"0")]}, receive)
+
+    with pytest.raises(RequestBodyTooLarge) as exc_info:
+        await request.body(max_bytes=max_bytes)
+
+    assert exc_info.value.limit == max_bytes
+    assert exc_info.value.received == received
+    assert receive.await_count == reads
+    assert not hasattr(request, "_body")
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("json_first", [False, True])
+async def test_stricter_limit_checks_body_and_json_cache(json_first: bool) -> None:
+    content = b'{"ok":true}'
+    receive = AsyncMock(return_value={"type": "http.request", "body": content})
+    request = Request({"type": "http"}, receive)
+    if json_first:
+        data = await request.json()
+    else:
+        assert await request.body(max_bytes=len(content)) == content
+        data = await request.json()
+
+    with pytest.raises(RequestBodyTooLarge) as exc_info:
+        await request.body(max_bytes=len(content) - 1)
+
+    assert exc_info.value.limit == len(content) - 1
+    assert exc_info.value.received == len(content)
+    assert await request.body() == content
+    assert await request.body(max_bytes=len(content)) == content
+    assert await request.json() is data
+    receive.assert_awaited_once()
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("max_bytes", [None, 3])
+async def test_body_limit_preserves_disconnect(max_bytes: int | None) -> None:
+    receive = AsyncMock(
+        side_effect=[
+            {"type": "http.request", "body": b"ab", "more_body": True},
+            {"type": "http.disconnect"},
+        ]
+    )
+    request = Request({"type": "http"}, receive)
+    with pytest.raises(ClientDisconnect):
+        await request.body(max_bytes=max_bytes)
+    assert not hasattr(request, "_body")
+    assert await request.is_disconnected()
+    assert receive.await_count == 2
+
+
+def test_body_limit_is_handled_as_http_exception(test_client_factory: TestClientFactory) -> None:
+    async def endpoint(request: Request) -> Response:
+        return Response(await request.body(max_bytes=2))
+
+    app = Starlette(routes=[Route("/", endpoint, methods=["POST"])])
+    with test_client_factory(app) as client:
+        response = client.post("/", content=b"abc")
+    assert response.status_code == 413
+    assert response.text == "Request body too large"
