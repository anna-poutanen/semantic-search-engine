+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("use_output", [False, True])
+def test_lazy_file_option_cleanup(runner, tmp_path, atomic, use_output):
+    path = tmp_path / "output.txt"
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=True, atomic=atomic))
+    def cli(output):
+        if use_output:
+            output.write("Hello!\n")
+        return output
+
+    result = runner.invoke(
+        cli, ["--output", str(path)], standalone_mode=False, catch_exceptions=False
+    )
+    assert result.exit_code == 0
+
+    if use_output:
+        assert result.return_value.closed
+        assert path.read_text() == "Hello!\n"
+    else:
+        assert not path.exists()
+
+    assert not list(tmp_path.glob(".__atomic-write*"))
+
