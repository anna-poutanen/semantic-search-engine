+@pytest.mark.parametrize("status_code", (301, 302, 303, 307, 308))
+@pytest.mark.parametrize(
+    "method, expected_301, expected_302_303",
+    (
+        ("GET", "GET", "GET"),
+        ("HEAD", "HEAD", "HEAD"),
+        ("POST", "GET", "GET"),
+        ("PUT", "PUT", "GET"),
+        ("PATCH", "PATCH", "GET"),
+        ("DELETE", "DELETE", "GET"),
+        ("OPTIONS", "OPTIONS", "GET"),
+        ("TRACE", "TRACE", "GET"),
+        ("CUSTOM", "CUSTOM", "GET"),
+    ),
+)
+def test_redirect_method_and_body(status_code, method, expected_301, expected_302_303):
+    session = RedirectSession([status_code])
+    body = b"test body"
+    prep = requests.Request(
+        method,
+        "http://example.test/start",
+        data=body,
+        headers={"Content-Type": "text/plain"},
+    ).prepare()
+    response = session.send(prep)
+
+    responses = list(session.resolve_redirects(response, prep))
+    assert len(responses) == 1
+    redirected = responses[0].request
+    expected_method = {
+        301: expected_301,
+        302: expected_302_303,
+        303: expected_302_303,
+        307: method,
+        308: method,
+    }[status_code]
+    assert redirected.method == expected_method
+    assert redirected.url == "http://example.test/"
+    if status_code in (307, 308):
+        assert redirected.body == body
+        assert redirected.headers["Content-Length"] == prep.headers["Content-Length"]
+        assert redirected.headers["Content-Type"] == prep.headers["Content-Type"]
+    else:
+        assert redirected.body is None
+        assert "Content-Length" not in redirected.headers
+        assert "Content-Type" not in redirected.headers
+    assert prep.method == method
+    assert prep.body == body
+
+
 def test_requests_are_updated_each_time(httpbin):
