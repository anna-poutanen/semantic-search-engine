+    @pytest.mark.parametrize("scheme, port", (("http", 80), ("https", 443)))
+    @pytest.mark.parametrize("reverse", (False, True))
+    def test_auth_is_retained_for_redirect_with_default_port(self, scheme, port, reverse):
+        old_uri = f"{scheme}://example.com/foo"
+        new_uri = f"{scheme}://example.com:{port}/bar"
+        if reverse:
+            old_uri, new_uri = new_uri, old_uri
+
+        s = requests.Session()
+        s.trust_env = False
+        request = requests.Request("GET", old_uri, auth=("user", "pass")).prepare()
+        response = requests.Response()
+        response.request = request
+        redirected = request.copy()
+        redirected.url = new_uri
+
+        s.rebuild_auth(redirected, response)
+
+        assert redirected.headers["Authorization"] == request.headers["Authorization"]
+
