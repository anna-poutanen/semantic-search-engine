diff --git a/src/requests/sessions.py b/src/requests/sessions.py
index 8093b03..e8c963c 100644
--- a/src/requests/sessions.py
+++ b/src/requests/sessions.py
@@ -172,6 +172,15 @@ class SessionRedirectMixin:
         changed_port = old_parsed.port != new_parsed.port
         changed_scheme = old_parsed.scheme != new_parsed.scheme
 
+        # Treat omitted and explicit default ports as equivalent for the same scheme.
+        default_port = (DEFAULT_PORTS.get(old_parsed.scheme), None)
+        if (
+            not changed_scheme
+            and old_parsed.port in default_port
+            and new_parsed.port in default_port
+        ):
+            return False
+
         # Standard case: root URI must match
         return changed_port or changed_scheme
 
