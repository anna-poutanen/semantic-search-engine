@@ -106,6 +106,45 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+@pytest.mark.parametrize(
+    ("exists", "dir_okay", "path_kind", "error"),
+    [
+        (True, False, "file", None),
+        (True, False, "directory", "is a directory"),
+        (False, False, "directory", "is a directory"),
+        (True, True, "directory", None),
+        (False, False, "missing", None),
+        (True, False, "missing", "does not exist"),
+    ],
+)
+def test_path_argument_validation(runner, tmp_path, exists, dir_okay, path_kind, error):
+    path = tmp_path / path_kind
+
+    if path_kind == "file":
+        path.touch()
+    elif path_kind == "directory":
+        path.mkdir()
+
+    calls = []
+    cli = click.Command(
+        "cli",
+        params=[
+            click.Argument(["p"], type=click.Path(exists=exists, dir_okay=dir_okay))
+        ],
+        callback=lambda p: calls.append(p),
+    )
+    result = runner.invoke(cli, [str(path)])
+
+    if error is not None:
+        assert result.exit_code == 2
+        assert "Usage: cli [OPTIONS] P" in result.output
+        assert f"Invalid value for 'P': File {str(path)!r} {error}." in result.output
+        assert calls == []
+    else:
+        assert result.exit_code == 0
+        assert calls == [str(path)]
+
+
