+def test_multiple_tasks_run_in_order(test_client_factory: TestClientFactory) -> None:
+    events: list[str] = []
+
+    def sync_task(name: str) -> None:
+        events.append(f"{name} started")
+        events.append(f"{name} finished")
+
+    async def async_task(name: str) -> None:
+        events.append(f"{name} started")
+        await anyio.sleep(0)
+        events.append(f"{name} finished")
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        async def record_send(message: Message) -> None:
+            await send(message)
+            events.append(message["type"])
+
+        tasks = BackgroundTasks([BackgroundTask(sync_task, "first")])
+        tasks.add_task(async_task, name="second")
+        tasks.add_task(sync_task, "third")
+        tasks.add_task(async_task, name="fourth")
+        response = Response("tasks initiated", media_type="text/plain", background=tasks)
+        await response(scope, receive, record_send)
+
+    client = test_client_factory(app)
+    response = client.get("/")
+    assert response.text == "tasks initiated"
+    assert events == [
+        "http.response.start",
+        "http.response.body",
+        "first started",
+        "first finished",
+        "second started",
+        "second finished",
+        "third started",
+        "third finished",
+        "fourth started",
+        "fourth finished",
+    ]
+
+
+def test_empty_tasks(test_client_factory: TestClientFactory) -> None:
+    response = Response("no tasks", media_type="text/plain", background=BackgroundTasks())
+    client = test_client_factory(response)
+    assert client.get("/").text == "no tasks"
+
+
