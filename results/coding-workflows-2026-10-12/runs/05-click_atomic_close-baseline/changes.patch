+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("lazy", [None, True])
+def test_file_lazy_output_cleanup(runner, tmp_path, atomic, lazy):
+    path = tmp_path / "output.txt"
+    path.write_text("old content", encoding="utf-8")
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=lazy, atomic=atomic))
+    def cli(output):
+        output.write("new content")
+
+        if atomic:
+            assert path.read_text(encoding="utf-8") == "old content"
+
+        return output
+
+    result = runner.invoke(cli, ["--output", str(path)], standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value.closed
+    assert path.read_text(encoding="utf-8") == "new content"
+    assert list(tmp_path.iterdir()) == [path]
+
+
+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("lazy", [None, True])
+def test_file_lazy_output_unused(runner, tmp_path, atomic, lazy):
+    path = tmp_path / "output.txt"
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=lazy, atomic=atomic))
+    def cli(output):
+        pass
+
+    result = runner.invoke(cli, ["--output", str(path)])
+    assert result.exit_code == 0
+    assert not path.exists()
+    assert list(tmp_path.iterdir()) == []
+
