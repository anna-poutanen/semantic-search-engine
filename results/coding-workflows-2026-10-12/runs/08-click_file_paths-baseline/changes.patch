@@ -106,6 +106,44 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+@pytest.mark.parametrize(
+    ("kind", "exists", "dir_okay", "accepted"),
+    [
+        ("directory", True, False, False),
+        ("directory", False, False, False),
+        ("file", True, False, True),
+        ("directory", True, True, True),
+        ("missing", False, False, True),
+    ],
+)
+def test_path_argument_validation(runner, tmp_path, kind, exists, dir_okay, accepted):
+    path = tmp_path / kind
+
+    if kind == "directory":
+        path.mkdir()
+    elif kind == "file":
+        path.touch()
+
+    calls = []
+
+    @click.command()
+    @click.argument("path", type=click.Path(exists=exists, dir_okay=dir_okay))
+    def cli(path):
+        calls.append(path)
+
+    path = str(path)
+    result = runner.invoke(cli, [path])
+
+    if accepted:
+        assert result.exit_code == 0
+        assert calls == [path]
+    else:
+        assert result.exit_code == 2
+        assert "Usage: cli [OPTIONS] PATH" in result.output
+        assert f"Invalid value for 'PATH': File {path!r} is a directory." in result.output
+        assert calls == []
+
+
