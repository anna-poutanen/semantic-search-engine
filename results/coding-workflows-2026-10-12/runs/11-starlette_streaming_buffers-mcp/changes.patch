+@pytest.mark.anyio
+@pytest.mark.parametrize("is_async", [False, True], ids=["sync", "async"])
+@pytest.mark.parametrize("spec_version", ["2.0", "2.4"])
+async def test_streaming_response_mixed_chunks(is_async: bool, spec_version: str) -> None:
+    chunks: list[str | bytes | memoryview] = [memoryview(b"\xc0"), b"\x00", "café", memoryview(b"\xf5")]
+    messages: list[Message] = []
+    background_calls = 0
+
+    async def async_chunks() -> AsyncIterator[str | bytes | memoryview]:
+        for chunk in chunks:
+            yield chunk
+
+    async def receive() -> Message:
+        await anyio.sleep_forever()
+        return {"type": "http.disconnect"}  # pragma: no cover
+
+    async def send(message: Message) -> None:
+        assert background_calls == 0
+        messages.append(message)
+
+    async def on_complete() -> None:
+        nonlocal background_calls
+        assert messages[-1] == {"type": "http.response.body", "body": b"", "more_body": False}
+        background_calls += 1
+
+    response = StreamingResponse(
+        content=async_chunks() if is_async else iter(chunks), background=BackgroundTask(on_complete)
+    )
+    with anyio.fail_after(1):
+        await response({"type": "http", "asgi": {"spec_version": spec_version}}, receive, send)
+
+    assert messages == [
+        {"type": "http.response.start", "status": 200, "headers": []},
+        {"type": "http.response.body", "body": b"\xc0", "more_body": True},
+        {"type": "http.response.body", "body": b"\x00", "more_body": True},
+        {"type": "http.response.body", "body": b"caf\xc3\xa9", "more_body": True},
+        {"type": "http.response.body", "body": b"\xf5", "more_body": True},
+        {"type": "http.response.body", "body": b"", "more_body": False},
+    ]
+    assert background_calls == 1
+
+
