+@pytest.mark.parametrize(
+    "method, expected_301, expected_302_303",
+    (
+        ("GET", "GET", "GET"),
+        ("HEAD", "HEAD", "HEAD"),
+        ("POST", "GET", "GET"),
+        ("PUT", "PUT", "GET"),
+        ("PATCH", "PATCH", "GET"),
+        ("DELETE", "DELETE", "GET"),
+        ("OPTIONS", "OPTIONS", "GET"),
+        ("TRACE", "TRACE", "GET"),
+        ("PROPFIND", "PROPFIND", "GET"),
+    ),
+)
+@pytest.mark.parametrize(
+    "status_code, expected_body",
+    ((301, None), (302, None), (303, None), (307, b"test"), (308, b"test")),
+)
+def test_redirect_method_and_body(
+    method, expected_301, expected_302_303, status_code, expected_body
+):
+    session = RedirectSession([status_code])
+    prep = requests.Request(
+        method,
+        "http://example.test/original",
+        data=b"test",
+        headers={"Content-Type": "text/plain"},
+    ).prepare()
+    response = session.send(prep)
+
+    redirected_responses = list(session.resolve_redirects(response, prep))
+    assert len(redirected_responses) == 1
+    redirected_request = redirected_responses[0].request
+    expected_method = {
+        301: expected_301,
+        302: expected_302_303,
+        303: expected_302_303,
+        307: method,
+        308: method,
+    }[status_code]
+    assert redirected_request.method == expected_method
+    assert redirected_request.body == expected_body
+    for header in ("Content-Length", "Content-Type"):
+        if expected_body is None:
+            assert header not in redirected_request.headers
+        else:
+            assert redirected_request.headers[header] == prep.headers[header]
+
+
