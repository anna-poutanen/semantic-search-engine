+
+    async def async_fail() -> None:
+        await anyio.sleep(0)
+        fail()
+
+    tasks = BackgroundTasks()
+    tasks.add_task(record, "first")
+    tasks.add_task(async_fail if is_async else fail)
+    tasks.add_task(record, "last")
+
