+    @pytest.mark.parametrize("scheme, port", (("http", 80), ("https", 443)))
+    @pytest.mark.parametrize("explicit_port_first", (True, False))
+    def test_auth_is_retained_for_redirect_with_default_port(
+        self, scheme, port, explicit_port_first
+    ):
+        old_url = f"{scheme}://example.com:{port}/foo"
+        new_url = f"{scheme}://example.com/bar"
+        if not explicit_port_first:
+            old_url, new_url = new_url, old_url
+
+        s = requests.Session()
+        s.trust_env = False
+        req = requests.Request("GET", old_url, auth=("user", "pass")).prepare()
+        resp = requests.Response()
+        resp.request = req
+        resp.status_code = 302
+        resp.headers["Location"] = new_url
+        resp._content = b""
+
+        redirected = next(s.resolve_redirects(resp, req, yield_requests=True))
+        assert redirected.headers["Authorization"] == req.headers["Authorization"]
+
     def test_manual_redirect_with_partial_body_read(self, httpbin):
