@@ -1985,6 +1985,30 @@ class TestRequests:
         s = requests.Session()
         assert not s.should_strip_auth(old_uri, new_uri)
 
+    @pytest.mark.parametrize(
+        "old_uri, new_uri",
+        (
+            ("https://example.com:443/foo", "https://example.com/bar"),
+            ("http://example.com:80/foo", "http://example.com/bar"),
+            ("https://example.com/foo", "https://example.com:443/bar"),
+            ("http://example.com/foo", "http://example.com:80/bar"),
+        ),
+    )
+    def test_rebuild_auth_default_port(self, old_uri, new_uri):
+        s = requests.Session()
+        s.trust_env = False
+        original = requests.Request(
+            "GET", old_uri, headers={"Authorization": "Bearer token"}
+        ).prepare()
+        redirected = original.copy()
+        redirected.prepare_url(new_uri, None)
+        response = requests.Response()
+        response.request = original
+
+        s.rebuild_auth(redirected, response)
+
+        assert redirected.headers["Authorization"] == "Bearer token"
+
     def test_manual_redirect_with_partial_body_read(self, httpbin):
