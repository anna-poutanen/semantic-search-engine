+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("lazy", [None, True])
+def test_file_lazy_close(runner, tmp_path, atomic, lazy):
+    path = tmp_path / "output.txt"
+    path.write_text("original")
+    files = []
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=lazy, atomic=atomic))
+    def cli(output):
+        files.append(output)
+        output.write("updated")
+        if atomic:
+            output.flush()
+            assert path.read_text() == "original"
+
+    try:
+        result = runner.invoke(cli, ["--output", str(path)], catch_exceptions=False)
+        assert result.exit_code == 0
+        assert path.read_text() == "updated"
+        assert files[0].closed
+        assert list(tmp_path.iterdir()) == [path]
+    finally:
+        for file in files:
+            file.close()
+
+
+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("lazy", [None, True])
+def test_file_lazy_unused(runner, tmp_path, atomic, lazy):
+    path = tmp_path / "output.txt"
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=lazy, atomic=atomic))
+    def cli(output):
+        pass
+
+    result = runner.invoke(cli, ["--output", str(path)], catch_exceptions=False)
+    assert result.exit_code == 0
+    assert not path.exists()
+    assert not list(tmp_path.iterdir())
+
