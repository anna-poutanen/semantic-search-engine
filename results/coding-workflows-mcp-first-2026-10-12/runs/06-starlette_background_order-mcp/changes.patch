+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "async_callbacks",
+    [
+        pytest.param((), id="empty"),
+        pytest.param((False, False, False), id="sync"),
+        pytest.param((True, True, True), id="async"),
+        pytest.param((False, True, False), id="mixed"),
+    ],
+)
+async def test_multiple_tasks_run_in_registration_order(async_callbacks: tuple[bool, ...]) -> None:
+    events: list[str] = []
+
+    def sync_task(index: int) -> None:
+        events.append(f"start {index}")
+        anyio.from_thread.run(anyio.sleep, 0)
+        events.append(f"end {index}")
+
+    async def async_task(index: int) -> None:
+        events.append(f"start {index}")
+        await anyio.sleep(0)
+        events.append(f"end {index}")
+
+    async def receive() -> Message:
+        raise AssertionError("Response should not call receive")
+
+    async def send(message: Message) -> None:
+        await anyio.sleep(0)
+        events.append(message["type"])
+
+    tasks = BackgroundTasks()
+    for index, is_async in enumerate(async_callbacks):
+        tasks.add_task(async_task if is_async else sync_task, index)
+    response = Response("tasks initiated", background=tasks)
+    await response({"type": "http"}, receive, send)
+
+    assert events == ["http.response.start", "http.response.body"] + [
+        event for index in range(len(async_callbacks)) for event in (f"start {index}", f"end {index}")
+    ]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("is_async", [False, True])
+async def test_multi_tasks_failure_avoids_next_execution(is_async: bool) -> None:
+    events: list[str] = []
+
+    def fail() -> None:
+        events.append("failed")
+        raise RuntimeError("task failed")
+
+    async def async_fail() -> None:
+        await anyio.sleep(0)
+        fail()
+
+    tasks = BackgroundTasks()
+    tasks.add_task(events.append, "first")
+    tasks.add_task(async_fail if is_async else fail)
+    tasks.add_task(events.append, "last")
+
+    with pytest.raises(RuntimeError, match="task failed"):
+        await tasks()
+    assert events == ["first", "failed"]
