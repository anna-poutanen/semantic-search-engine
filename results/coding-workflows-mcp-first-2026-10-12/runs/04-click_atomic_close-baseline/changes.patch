+@pytest.mark.parametrize("atomic", [False, True])
+@pytest.mark.parametrize("existing", [False, True])
+def test_file_lazy_output_cleanup(runner, tmp_path, atomic, existing):
+    path = tmp_path / "output.txt"
+
+    if existing:
+        path.write_text("old content", encoding="utf-8")
+
+    outputs = []
+
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=True, atomic=atomic))
+    def cli(output):
+        # Retain the file so garbage collection cannot close it for Click.
+        outputs.append(output)
+        output.write("new content")
+        output.flush()
+
+        if atomic:
+            if existing:
+                assert path.read_text(encoding="utf-8") == "old content"
+            else:
+                assert not path.exists()
+
+    result = runner.invoke(cli, ["--output", str(path)])
+    assert result.exit_code == 0
+    assert outputs[0].closed
+    assert path.read_text(encoding="utf-8") == "new content"
+    assert list(tmp_path.iterdir()) == [path]
+
+
+@pytest.mark.parametrize("atomic", [False, True])
+def test_file_lazy_output_unused(runner, tmp_path, atomic):
+    @click.command()
+    @click.option("--output", type=click.File("w", lazy=True, atomic=atomic))
+    def cli(output):
+        pass
+
+    result = runner.invoke(cli, ["--output", str(tmp_path / "output.txt")])
+    assert result.exit_code == 0
+    assert not list(tmp_path.iterdir())
+
