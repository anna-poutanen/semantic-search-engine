    {
      "id": "requests_response_limit",
      "corpus_id": "requests",
      "corpus": ".cache/corpora/requests",
      "repo_url": "https://github.com/psf/requests",
      "revision": "611c6162cbc4ac2020a2f91c7cfa4f3abf9bbb60",
