+    def iter_json_lines(self, chunk_size=512, *, skip_blank=True):
+        """Lazily consume UTF-8 NDJSON, preserving physical line context."""
+        if type(chunk_size) is not int or chunk_size <= 0:
+            raise ValueError("chunk_size must be a positive integer")
+        if type(skip_blank) is not bool:
+            raise ValueError("skip_blank must be a boolean")
+        def decoded():
+            pending = b""
+            line_number = 0
+            def parse(line, number):
+                try:
+                    text = line.decode("utf-8-sig" if number == 1 else "utf-8")
+                    if skip_blank and not text.strip():
+                        return False, None
+                    return True, complexjson.loads(text)
+                except (UnicodeDecodeError, JSONDecodeError) as error:
+                    raise JSONLineDecodeError(str(error), line_number=number,
+                                              line=line, response=self) from error
+            for chunk in self.iter_content(chunk_size=chunk_size, decode_unicode=False):
+                pending += chunk
+                while b"\n" in pending:
+                    line, pending = pending.split(b"\n", 1)
+                    if line.endswith(b"\r"):
+                        line = line[:-1]
+                    line_number += 1
+                    present, value = parse(line, line_number)
+                    if present:
+                        yield value
+            if pending:
+                line_number += 1
+                present, value = parse(pending, line_number)
+                if present:
+                    yield value
+        return decoded()
